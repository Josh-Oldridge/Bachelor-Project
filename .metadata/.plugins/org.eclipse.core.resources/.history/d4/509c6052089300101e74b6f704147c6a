/* Show window stamps without unsigned wrap confusion when Z occurs inside */
/* Show window stamps without unsigned wrap confusion when Z occurs inside */
static void print_winstamp_smart(void)
{
  uint32_t s4    = win_stamp_ab_start_x4;
  uint32_t e4    = win_stamp_ab_end_x4;
  int16_t  zrow  = win_stamp_z_row;     /* -1 = none */
  uint32_t epoch = win_stamp_z_epoch;
  uint32_t zseq  = win_stamp_z_seq_end; /* total Zs accepted so far (monotonic) */

  if (zrow < 0) {
    uint32_t d4 = win_stamp_ab_delta_x4;
    uint32_t s2 = s4 >> 1, e2 = e4 >> 1, d2 = d4 >> 1;

    ai_log("WINSTAMP: Zepoch=%lu Zrow=-1 Zseq=%lu ABx4:%lu->%lu (+%lu)  ABx2:%lu->%lu (+%lu)\r\n",
           (unsigned long)epoch, (unsigned long)zseq,
           (unsigned long)s4, (unsigned long)e4, (unsigned long)d4,
           (unsigned long)s2, (unsigned long)e2, (unsigned long)d2);
    return;
  }

  /* Z inside this window: split at row zrow */
  uint32_t pre_rows  = (uint32_t)zrow;
  uint32_t post_rows = (uint32_t)(SEQ_LEN - zrow);
  uint32_t pre_x4    = pre_rows  * X4_PER_ROW;  /* X4_PER_ROW == 2 */
  uint32_t post_x4   = post_rows * X4_PER_ROW;
  uint32_t tot_x4    = pre_x4 + post_x4;

  ai_log("WINSTAMP: Zepoch=%lu Zrow=%d Zseq=%lu ABx4: pre=+%lu post=+%lu total=+%lu"
         "  (ABx2: pre=+%lu post=+%lu total=+%lu)\r\n",
         (unsigned long)epoch, (int)zrow, (unsigned long)zseq,
         (unsigned long)pre_x4, (unsigned long)post_x4, (unsigned long)tot_x4,
         (unsigned long)(pre_x4>>1), (unsigned long)(post_x4>>1), (unsigned long)(tot_x4>>1));
}


/* Compact INF line + window/diag dump using the fast logger */
static void snapshot_and_print(void) {
	inf_seq++;

	int best = 0;
	for (int i = 1; i < AI_NETWORK_OUT_1_SIZE; ++i)
		if (last_y_raw[i] > last_y_raw[best])
			best = i;

	Diag_NotifyInferenceTop((uint32_t) best);

	float p_ms = last_y_raw[C_MISSINGSTEP];
	float p_n = last_y_raw[C_NORMAL];
	float p_z = last_y_raw[C_ZINDEX];

	/* If you want to avoid any time reads, you can remove ms_now() */
	uint32_t tms = ms_now();
	ai_log(
			"INF#%lu t=%lums TOP=%s P=[MS:%.3f, N:%.3f, Z:%.3f] flags(win)=0x%08lX flags(live)=0x%08lX\r\n",
			(unsigned long) inf_seq, (unsigned long) tms, MODEL_CLASSES[best],
			p_ms, p_n, p_z, (unsigned long) win_rule_flags,
			(unsigned long) enc_rule_flags);

	/* Per-window, perfectly aligned metadata */
	//print_winstamp_smart();

	/* Optional: direction + traces (no live Z_DIAG here) */
	//print_dir_and_trace_only();
}

