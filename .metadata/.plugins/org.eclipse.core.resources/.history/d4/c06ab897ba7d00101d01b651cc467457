volatile uint32_t       inf_total = 0;                 // owned here
volatile float          last_y[AI_NETWORK_OUT_1_SIZE]; // owned here

static int acquire_and_process_data(ai_float* data[])
{
  /* Returns 0 on success, -1 if no window ready */
  return EncSampler_CopyWindowLinear((float*)data[0]);
}

static void clamp_and_renorm(volatile float* y, int n)
{
  float s = 0.0f;
  for (int i = 0; i < n; ++i) {
    if (y[i] < 0.0f) y[i] = 0.0f;
    if (y[i] > 1.0f) y[i] = 1.0f;
    s += y[i];
  }
  if (s > 1e-12f) {
    for (int i = 0; i < n; ++i) y[i] /= s;
  }
}

/* class indices for readability (from model_meta.h order) */
#define C_JITTER       0
#define C_MISSINGSTEP  1
#define C_NORMAL       2
#define C_ZINDEX       3

extern volatile uint32_t enc_rule_flags;

static int post_process(ai_float* data[])
{
  const ai_float* out = data[0];
  for (int i = 0; i < AI_NETWORK_OUT_1_SIZE; ++i)
    last_y[i] = out[i];

  /* Rule-based guardrails */
  uint32_t rf = enc_rule_flags;

  if (rf & RS_A_STUCK) {
    last_y[C_MISSINGSTEP] = 0.999f;
    last_y[C_NORMAL]      = 0.001f;
  }
  if (rf & RS_B_STUCK) {
    last_y[C_MISSINGSTEP] = 0.999f;
    last_y[C_NORMAL]      = 0.001f;
  }
  if (rf & RS_QUAD_BAD) {
    if (last_y[C_JITTER] < 0.95f) {
      last_y[C_JITTER] = 0.95f;
      last_y[C_NORMAL] = 1.0f - last_y[C_JITTER];
    }
  }
  if (rf & RS_Z_MISSED) {
    if (last_y[C_ZINDEX] < 0.95f) last_y[C_ZINDEX] = 0.95f;
    last_y[C_NORMAL] = 1.0f - last_y[C_ZINDEX];
  }

  /* keep probs sane */
  clamp_and_renorm(last_y, AI_NETWORK_OUT_1_SIZE);

  inf_total++;
  return 0;
}




