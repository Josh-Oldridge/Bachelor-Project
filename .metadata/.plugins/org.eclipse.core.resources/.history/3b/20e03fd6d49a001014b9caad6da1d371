#include "mem_diag.h"
#include "stm32n6xx_hal.h"
#include <stdio.h>
#include <sys/unistd.h>   // _sbrk
#include "core_cm55.h"    // __get_MSP()

/* ----- Linker symbols from STM32N657X0HXQ_LRUN.ld ----- */
extern uint8_t _estack;        /* end of RAM (stack top, highest addr) */
extern uint8_t _sstack;        /* stack bottom = _estack - _Min_Stack_Size */
extern uint8_t _end;           /* end of .bss/.data; start of heap */

extern uint8_t __ram_start__[], __ram_end__[];                  /* MEMORY(RAM) bounds */
extern uint8_t __axis_start__[] __attribute__((weak));          /* MEMORY(AXISRAM123456) bounds */
extern uint8_t __axis_end__[]   __attribute__((weak));

/* section bounds in RAM */
extern uint8_t __isr_start__[], __isr_end__[];
extern uint8_t __text_start__[], __text_end__[];
extern uint8_t __rodata_start__[], __rodata_end__[];
extern uint8_t _sdata[], _edata[];
extern uint8_t __bss_start__[], __bss_end__[];

/* your names for noncacheable + winring */
extern uint32_t __snoncacheable;   // start address anchor
extern uint32_t __enoncacheable;   // end   address anchor
extern uint8_t __winring_start__[] __attribute__((weak));
extern uint8_t __winring_end__[]   __attribute__((weak));

/* newlib sbrk hook (provided by HAL/retarget) */
extern void* _sbrk(ptrdiff_t incr);

/* Paint value for stack watermarking */
#ifndef STACK_WM_BYTE
#define STACK_WM_BYTE 0xA5
#endif

static inline size_t udiff(const void* hi, const void* lo) {
  return (size_t)((uintptr_t)hi - (uintptr_t)lo);
}

static inline unsigned long span_bytes(const void* hi, const void* lo) {
  return (unsigned long)((uintptr_t)hi - (uintptr_t)lo);
}

/* Fill MSP region with watermark. Call VERY early. */
void MemDiag_Init(void)
{
  // Paint only the *unused* lower part of the MSP stack, not the live frames.
  uint32_t msp = __get_MSP();
  volatile uint8_t* bot = &_sstack;        // lowest stack address
  volatile uint8_t* top = &_estack;        // highest stack address

  // Leave a safety margin (current frames, interrupts, etc.)
  const uint32_t SAFETY = 256;             // adjust if you want (128..512)
  volatile uint8_t* safe_end = (volatile uint8_t*)((msp > SAFETY) ? (msp - SAFETY) : msp);

  if (safe_end < bot) safe_end = bot;
  if (safe_end > top) safe_end = top;

  for (volatile uint8_t* p = bot; p < safe_end; ++p) {
    *p = STACK_WM_BYTE;
  }
}
/* Current MSP stack usage (bytes) */
static void stack_now(size_t* used, size_t* total, size_t* free_now)
{
  const uint32_t msp = __get_MSP();
  const uint8_t* top   = &_estack;  /* highest address */
  const uint8_t* bot   = &_sstack;  /* lowest address of stack region */
  const size_t   tot   = udiff(top, bot);

  size_t used_now;
  if (msp < (uint32_t)bot)        used_now = tot;     /* overflowed */
  else if (msp > (uint32_t)top)   used_now = 0;       /* not running on MSP? */
  else                            used_now = udiff(top, (void*)msp);

  if (used)    *used    = used_now;
  if (total)   *total   = tot;
  if (free_now)*free_now= (tot > used_now) ? (tot - used_now) : 0;
}

/* High-water MSP usage by scanning from bottom (_sstack) */
static size_t stack_hwm(void)
{
  const uint8_t* p   = &_sstack;
  const uint8_t* end = &_estack;
  while ((p < end) && (*p == STACK_WM_BYTE)) p++;
  return udiff(end, p);
}

/* Heap stats from sbrk break; heap grows up from &_end to &_sstack */
static void heap_now(size_t* used, size_t* total, size_t* free_now)
{
  uint8_t* brk = (uint8_t*)_sbrk(0);
  const uint8_t* base  = &_end;
  const uint8_t* limit = &_sstack;   /* don’t collide with stack region */
  const size_t tot = udiff(limit, base);
  size_t used_now = (brk > base) ? (size_t)(brk - base) : 0;

  if (used)    *used    = used_now;
  if (total)   *total   = tot;
  if (free_now)*free_now= (used_now <= tot) ? (tot - used_now) : 0;
}

/* Optional: static section sizes */
static void static_sections(size_t* data_sz, size_t* bss_sz)
{
  if (data_sz) *data_sz = udiff(&_edata,       &_sdata);        // .data size
  if (bss_sz)  *bss_sz  = udiff(&__bss_end__,  &__bss_start__); // .bss size
}

void MemDiag_Get(MemDiag_Stats* out)
{
  if (!out) return;
  size_t st_used, st_tot, st_free, st_hwm;
  size_t hp_used, hp_tot, hp_free;
  size_t sz_data, sz_bss;

  stack_now(&st_used, &st_tot, &st_free);
  st_hwm = stack_hwm();
  heap_now(&hp_used, &hp_tot, &hp_free);
  static_sections(&sz_data, &sz_bss);

  out->stack_total  = st_tot;
  out->stack_used_now = st_used;
  out->stack_free_now = st_free;
  out->stack_hwm    = st_hwm;

  out->heap_total   = hp_tot;
  out->heap_used_now= hp_used;
  out->heap_free_now= hp_free;

  out->data_size    = sz_data;
  out->bss_size     = sz_bss;

  /* quick estimator: free heap + free stack (now) */
  out->heap_free_plus_stack_free_now = hp_free + st_free;
}

void MemDiag_PrintSummary(void)
{
  MemDiag_Stats s;
  MemDiag_Get(&s);

  /* --- Your existing summary prints --- */
  printf("MEM: stack used=%lu/%lu (free=%lu)  HWM=%lu\n",
         (unsigned long)s.stack_used_now,
         (unsigned long)s.stack_total,
         (unsigned long)s.stack_free_now,
         (unsigned long)s.stack_hwm);

  printf("MEM: heap  used=%lu/%lu (free=%lu)\n",
         (unsigned long)s.heap_used_now,
         (unsigned long)s.heap_total,
         (unsigned long)s.heap_free_now);

  printf("MEM: static data=%lu  bss=%lu\n",
         (unsigned long)s.data_size,
         (unsigned long)s.bss_size);

  printf("MEM: est free now (heap+stack)=%lu\n",
         (unsigned long)s.heap_free_plus_stack_free_now);

  /* --- Extra: address-resolved RAM/AXIS map --- */
  const unsigned long ram_total =
      span_bytes(__ram_end__, __ram_start__);

  const unsigned long sz_isr  = span_bytes(__isr_end__,    __isr_start__);
  const unsigned long sz_text = span_bytes(__text_end__,   __text_start__);
  const unsigned long sz_ro   = span_bytes(__rodata_end__, __rodata_start__);
  const unsigned long sz_data = span_bytes(_edata,         _sdata);
  const unsigned long sz_bss  = span_bytes(__bss_end__,    __bss_start__);
  const void* nco_lo = (const void*)&__snoncacheable;
  const void* nco_hi = (const void*)&__enoncacheable;
  const unsigned long sz_nco = (nco_hi > nco_lo) ? span_bytes(nco_hi, nco_lo) : 0UL;

  const unsigned long ram_used_now =
        sz_isr + sz_text + sz_ro + sz_data + sz_bss + sz_nco
      + (unsigned long)s.heap_used_now
      + (unsigned long)s.stack_used_now;

  const unsigned long ram_free_now =
      (unsigned long)s.heap_free_now + (unsigned long)s.stack_free_now;

  const unsigned long accounted = ram_used_now + ram_free_now;

  printf("=== RAM MAP ================================================\n");
  printf("RAM      : 0x%08lX..0x%08lX  (%lu bytes)\n",
         (unsigned long)(uintptr_t)__ram_start__,
         (unsigned long)(uintptr_t)__ram_end__,
         ram_total);
  printf("  .isr_vector : %7lu B  [%p .. %p)\n", sz_isr,  __isr_start__,    __isr_end__);
  printf("  .text       : %7lu B  [%p .. %p)\n", sz_text, __text_start__,   __text_end__);
  printf("  .rodata     : %7lu B  [%p .. %p)\n", sz_ro,   __rodata_start__, __rodata_end__);
  printf("  .data       : %7lu B  [%p .. %p)\n", sz_data, _sdata,           _edata);
  printf("  .bss        : %7lu B  [%p .. %p)\n", sz_bss,  __bss_start__,    __bss_end__);
  if (sz_nco)
    printf("  .noncache   : %7lu B  [%p .. %p)\n", sz_nco, nco_lo, nco_hi);

  printf("  heap used   : %7lu B  (room-to-stack: %lu B, free now: %lu B)\n",
         (unsigned long)s.heap_used_now,
         (unsigned long)s.heap_total,
         (unsigned long)s.heap_free_now);

  printf("  stack used  : %7lu B  (total: %lu B, free now: %lu B, HWM: %lu B)\n",
         (unsigned long)s.stack_used_now,
         (unsigned long)s.stack_total,
         (unsigned long)s.stack_free_now,
         (unsigned long)s.stack_hwm);

  printf("  -----------------------------------------------------------\n");
  printf("  RAM used now: %7lu B\n", ram_used_now);
  printf("  RAM free now: %7lu B\n", ram_free_now);
  printf("  Accounted   : %7lu B  (%s)\n",
         accounted, (accounted == ram_total) ? "OK" : "MISMATCH!");

  if (__axis_start__ && __axis_end__) {
    const unsigned long axis_total = span_bytes(__axis_end__, __axis_start__);
    printf("AXISRAM   : 0x%08lX..0x%08lX  (%lu bytes)\n",
           (unsigned long)__axis_start__, (unsigned long)__axis_end__, axis_total);

    if (__winring_start__ && __winring_end__) {
      const unsigned long sz_winring = span_bytes(__winring_end__, __winring_start__);
      printf("  .winring    : %7lu B  [%p .. %p)  (NOLOAD)\n",
             sz_winring, __winring_start__, __winring_end__);
    }
  }
  printf("=============================================================\n");
}

