// enc_sampler.c — X4 encoder drain (TIM1 encoder mode) with DIR from hardware
// - Hardware counts X4; we IRQ on CC1/CC2 rising.
// - Direction from TIM1->CR1.DIR (optional flip via ENC_DIR_REVERSED).
// - Z handled first (IDX). We timestamp/capture CNT at the Z IRQ itself.
// - AB state is READ FROM GPIO each CC (no synthetic toggling for the model).
// - "AB since Z" (X4) is computed once in the ISR from CNT+DIR and mirrored to main.
// - A synthesized Gray stream is generated ONLY for printing traces, phase-locked at Z,
// and stepped by DIR so prints show 0132 (FWD) / 0213 (REV) even with rising-edge-only IRQs.
// - Startup: Z is BLOCKED during warmup. We require both a min edge count and a min time before
// exiting warmup (with a max timeout), then we drop the first few full windows to avoid "rushed"
// first inferences. The old "steps since" is removed; keep "AB since Z (X4)" only.

#include "enc_sampler.h"
#include <string.h>
#include <math.h>
#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include "model_meta.h"
#include "main.h"
#include "stm32n6xx_hal.h"

/* ============================= Config ================================== */

#ifndef CPR
#define CPR 500u
#endif

#ifndef HAVE_Z_INDEX
#define HAVE_Z_INDEX 1
#endif
#if !defined(TIM_SR_IDXF) || !defined(TIM_IT_IDX)
# undef HAVE_Z_INDEX
# define HAVE_Z_INDEX 0
# warning "No TIM1 IDXF/IDX in headers -> Z gated off at build time"
#endif

#ifndef FORCE_IGNORE_Z
#define FORCE_IGNORE_Z 0
#endif

/* Keep filter at 0 per your request */
#ifndef ENC_IC_FILTER
#define ENC_IC_FILTER 0
#endif

#ifndef ENC_DIR_REVERSED
#define ENC_DIR_REVERSED 0
#endif

#define QUAD_EDGES_PER_REV (4u * CPR)

/* Startup settling: tiny pre-delay + warmup gates */
#ifndef ENC_STARTUP_DELAY_MS
#define ENC_STARTUP_DELAY_MS 5u
#endif
#ifndef ENC_STARTUP_MIN_MS
#define ENC_STARTUP_MIN_MS 60u /* must wait at least this long */
#endif
#ifndef ENC_STARTUP_EDGE_MIN
#define ENC_STARTUP_EDGE_MIN 64u /* must see at least this many CC edges */
#endif
#ifndef ENC_STARTUP_MAX_MS
#define ENC_STARTUP_MAX_MS 250u /* fail-safe cap */
#endif
#ifndef ENC_STARTUP_DROP_WINDOWS
#define ENC_STARTUP_DROP_WINDOWS 3u /* drop this many full windows after warmup */
#endif

/* Z acceptance hygiene */
#ifndef Z_SOFT_DEBOUNCE_MS
#define Z_SOFT_DEBOUNCE_MS 10u
#endif
#ifndef Z_MIN_AB_EDGES
#define Z_MIN_AB_EDGES 2u
#endif
#ifndef Z_MIN_GAP_EDGES
#define Z_MIN_GAP_EDGES 2u
#endif
#ifndef Z_MISS_EDGE_LIMIT
#define Z_MISS_EDGE_LIMIT (QUAD_EDGES_PER_REV + QUAD_EDGES_PER_REV/8u)
#endif
#ifndef Z_MISS_MS_LIMIT
#define Z_MISS_MS_LIMIT 0u
#endif

/* ======================== Globals / Exposed state ====================== */

extern TIM_HandleTypeDef htim1;

enum {
  WR_SKIP2 = 1u<<0,
  WR_ZMISS = 1u<<1,
  WR_ZDOUBLE = 1u<<2,
  WR_ZMISALIGN = 1u<<3,
};

volatile uint32_t enc_rule_flags = 0;
volatile uint32_t win_rule_flags = 0;

volatile uint32_t win_ready = 0;
volatile uint32_t win_total = 0;
volatile uint32_t event_drops = 0;

#define SEQ_LEN (MODEL_SEQ_LEN)
#define FEAT_DIM (MODEL_FEAT_DIM)
static float feat_win[SEQ_LEN][FEAT_DIM];

#if ENABLE_TRACE_WIN
static uint8_t trace_ab[SEQ_LEN];
static uint8_t trace_src[SEQ_LEN];
static uint8_t trace_z[SEQ_LEN];

static uint8_t last_trace_ab[SEQ_LEN];
static uint8_t last_trace_src[SEQ_LEN];
static uint8_t last_trace_z[SEQ_LEN];
#endif

typedef struct {
  uint8_t last_AB_state; /* GRAY digit (bit1=A, bit0=B): 0,1,3,2 */
  float speed_change_rate; /* |interval_ratio - 1| */
  uint32_t last_update_ms; /* ms at last packed feature */
  float baseline_interval; /* EWMA baseline step interval (ms) */
} encoder_state_t;

static encoder_state_t enc_state = { 0 };

/* Sticky last direction: +1 = forward, -1 = backward */
static volatile int8_t enc_latched_dir = +1;
int8_t EncSampler_GetLatchedDir(void) { return enc_latched_dir; }

/* Summarized window direction */
static volatile int8_t last_window_dir = +1;
int8_t EncSampler_GetLastWindowDir(void) { return last_window_dir; }

/* CNT wrap (ARR+1) and last CNT seen (for ordering) */
static volatile uint16_t enc_cnt_wrap = 0;
static volatile uint16_t last_cnt_isr = 0;

/* Last accepted Z CNT (ISR) and a main-thread mirror */
static volatile uint16_t last_z_cnt_isr = 0;
static volatile uint16_t last_z_cnt_pub = 0;

/* Startup warmup timing + Z block */
static volatile uint32_t enc_warmup_min_until_ms = 0;
static volatile uint32_t enc_warmup_max_until_ms = 0;
static volatile uint8_t enc_block_z = 1; /* 1 = ignore Z in ISR during warmup */

/* ---- Z sequence + per-window diag snapshots ---- */
volatile uint32_t z_seq_isr = 0;  /* bump on each accepted Z (ISR) */
volatile uint32_t z_seq_pub = 0;  /* mirror for main */

/* Diag snapshot captured at window commit (use these for printing) */
volatile uint32_t z_diag_seen_win = 0;
volatile uint32_t z_diag_acc_win = 0;
volatile uint32_t z_diag_ab_since_win = 0;
volatile uint32_t z_diag_lastZ_ms_win = 0;

/* ===================== Synth Gray (for printing only) =================== */
/* Gray ring order with (bit1=A, bit0=B): 0,1,3,2 */
static inline uint8_t gray_to_ring_idx(uint8_t g) {
  switch (g & 3u) { case 0: return 0; case 1: return 1; case 3: return 2; case 2: return 3; default: return 0; }
}
static const uint8_t GRAY_RING[4] = {0, 1, 3, 2};
static volatile uint8_t synth_ring_idx = 0; /* phase on ring */
static volatile uint8_t synth_gray = 0; /* synthesized Gray we print */

/* ============================ Window FIFO ============================== */

#define WINFIFO_LOG2 5
#define WINFIFO (1u << WINFIFO_LOG2)
static float win_fifo[WINFIFO][SEQ_LEN * FEAT_DIM];
static uint32_t flags_fifo[WINFIFO];
static uint32_t seq_fifo[WINFIFO];  /* sequence numbers for duplicate detection */

/* CRITICAL FIX: Make ring indices volatile since they're shared across contexts */
static volatile uint8_t wf_w = 0, wf_r = 0, wf_count = 0;
static volatile uint32_t win_seq = 0;  /* monotonic sequence counter */

/* ============================ Event ring =============================== */

typedef struct {
  int8_t delta; /* +1 / -1 per edge, 0 for Z-only */
  uint8_t z_pulse; /* 1 if Z accepted in ISR */
  uint8_t src; /* 1=CC1(A), 2=CC2(B), 3=IDX */
  uint8_t ab_state; /* Gray at event (bit1=A, bit0=B) */
  uint32_t timestamp_ms; /* HAL_GetTick at capture */
  uint16_t ccr; /* CNT snapshot at event */
} encoder_event_t;

#define EVENT_BUF_BITS 12
#define EVENT_BUFFER_SIZE (1u << EVENT_BUF_BITS)
#define EVENT_IDX_MASK (EVENT_BUFFER_SIZE - 1u)

static encoder_event_t event_buffer[EVENT_BUFFER_SIZE];
static volatile uint32_t event_write = 0;
static volatile uint32_t event_read = 0;

/* ISR-side Z acceptance book-keeping */
static volatile uint32_t z_last_ms_isr = 0;
/* canonical X4 AB edges since Z (DIR-aware) */
static volatile uint32_t ab_edges_since_z_isr = 0;

/* public diagnostics */
volatile uint32_t z_diag_isr_seen = 0;
volatile uint32_t z_diag_isr_accepted = 0;
volatile uint32_t z_diag_ab_since_isr = 0;
/* DEPRECATED: kept as a mirror for compatibility; identical to z_diag_ab_since_isr */
volatile uint32_t z_diag_steps_since_main = 0;
volatile uint32_t z_diag_last_z_ms = 0;
volatile uint32_t z_diag_last_z_age_ms = 0;

/* ============================ Helpers ================================== */

static inline float scale_feat(int j, float x) {
  float y = (x - MODEL_FEAT_MIN[j]) * MODEL_FEAT_SCALE[j];
  if (y < 0.f) y = 0.f;
  if (y > 1.f) y = 1.f;
  return y;
}

/* Read present AB from pins (A on bit1, B on bit0) */
static inline uint8_t enc_read_AB(void) {
  const uint8_t a = (HAL_GPIO_ReadPin(ENC_A_GPIO_Port, ENC_A_Pin) != GPIO_PIN_RESET) ? 1u : 0u;
  const uint8_t b = (HAL_GPIO_ReadPin(ENC_B_GPIO_Port, ENC_B_Pin) != GPIO_PIN_RESET) ? 1u : 0u;
  return (uint8_t)((a << 1) | b); /* Gray digit: 0,1,3,2 */
}

/* wrap-aware signed difference in (-wrap/2, +wrap/2] */
static inline int16_t mod_diff_u16(uint16_t now, uint16_t prev, uint16_t wrap) {
  int32_t d = (int32_t)now - (int32_t)prev;
  if (d > (int32_t)wrap/2) d -= wrap;
  if (d < -(int32_t)wrap/2) d += wrap;
  return (int16_t)d;
}

/* Apply hardware digital filters on IC1/IC2 (kept at 0 per request) */
#ifndef TIM_CCMR1_IC1F_Pos
#define TIM_CCMR1_IC1F_Pos 4U
#endif
#ifndef TIM_CCMR1_IC2F_Pos
#define TIM_CCMR1_IC2F_Pos 12U
#endif
static inline void EncSampler_ApplyTIM1ICFilter(void) {
  uint32_t ccer = TIM1->CCER;
  TIM1->CCER &= ~(TIM_CCER_CC1E | TIM_CCER_CC2E);
  uint32_t ccmr1 = TIM1->CCMR1;
  ccmr1 &= ~(TIM_CCMR1_IC1F | TIM_CCMR1_IC2F);
  ccmr1 |= ((ENC_IC_FILTER & 0xF) << TIM_CCMR1_IC1F_Pos) |
           ((ENC_IC_FILTER & 0xF) << TIM_CCMR1_IC2F_Pos);
  TIM1->CCMR1 = ccmr1;
  TIM1->CCER = ccer;
}

/* Enable only the IRQs we consume */
static inline void EncSampler_ConfigIRQs(void) {
  __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2);
#if HAVE_Z_INDEX && !FORCE_IGNORE_Z
  __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_IDX);
#endif
  __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_UPDATE | TIM_IT_TRIGGER | TIM_IT_COM);
  __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_UIF | TIM_SR_TIF | TIM_SR_COMIF);
}

/* Direction from hardware DIR bit at capture time */
static inline int8_t dir_from_hw(void) {
  int8_t dir = ((TIM1->CR1 & TIM_CR1_DIR) == 0) ? +1 : -1; /* DIR=0 => up */
#if ENC_DIR_REVERSED
  dir = (int8_t)-dir;
#endif
  return dir;
}

/* Compute (X4) edges since last Z, oriented by DIR (ISR side) */
static inline uint16_t since_z_from_cnt_isr(uint16_t cnt, int8_t dir) {
  const uint16_t base = last_z_cnt_isr;
  uint16_t diff;
  if (dir > 0) { /* UP */
    diff = (cnt >= base) ? (uint16_t)(cnt - base) : (uint16_t)(cnt + enc_cnt_wrap - base);
  } else { /* DOWN */
    diff = (base >= cnt) ? (uint16_t)(base - cnt) : (uint16_t)(base + enc_cnt_wrap - cnt);
  }
  return diff;
}

/* ======================== IRQ Drain (encoder) ========================== */

#if ENC_IS_LIVE
static volatile uint8_t last_ab_isr = 0;

static inline void push_event_isr(int delta, int z, uint16_t ccr_sample,
                                 uint8_t src, uint8_t ab_state) {
  uint32_t next = (event_write + 1u) & EVENT_IDX_MASK;
  if (next == event_read) { event_drops++; return; }
  encoder_event_t *e = &event_buffer[event_write];
  e->timestamp_ms = HAL_GetTick();
  e->ccr = ccr_sample;
  e->delta = (int8_t)delta;
  e->z_pulse = (uint8_t)z;
  e->src = src;
  e->ab_state = ab_state;
  event_write = next;
}

void EncSampler_EncoderIRQ_Drain(void) {
  for (int guard = 0; guard < 256; ++guard) {
    uint32_t sr = TIM1->SR;
    uint32_t pending = sr & (TIM_SR_CC1IF | TIM_SR_CC2IF | TIM_SR_CC1OF | TIM_SR_CC2OF);
#if HAVE_Z_INDEX && !FORCE_IGNORE_Z && defined(TIM_SR_IDXF)
    pending |= (sr & TIM_SR_IDXF);
#endif
    if (!pending) break;

    /* Overcapture flags: count them */
    if (sr & TIM_SR_CC1OF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC1OF); event_drops++; }
    if (sr & TIM_SR_CC2OF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC2OF); event_drops++; }

    /* ---- Z FIRST ---- */
#if HAVE_Z_INDEX && defined(TIM_SR_IDXF)
    if (sr & TIM_SR_IDXF) {
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_IDX);
# ifdef TIM_SR_IDXF
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
# endif
      z_diag_isr_seen++;
# if !FORCE_IGNORE_Z
      const uint32_t now_ms = HAL_GetTick();
      const int32_t dt_ms = (int32_t)(now_ms - z_last_ms_isr);
      if (!enc_block_z && (dt_ms >= (int32_t)Z_SOFT_DEBOUNCE_MS) && (ab_edges_since_z_isr >= Z_MIN_AB_EDGES)) {
        const uint16_t ccrz = (uint16_t)TIM1->CNT; /* CNT at Z */
        const uint8_t abz = enc_read_AB() & 0x3u; /* AB at Z */
        push_event_isr(0, 1, ccrz, 3, abz); /* src=3 => IDX */
        last_z_cnt_isr = ccrz; /* reset base */
        last_z_cnt_pub = ccrz;
        z_last_ms_isr = now_ms;
        z_diag_last_z_ms = now_ms; /* publish immediately */
        ab_edges_since_z_isr = 0;
        z_diag_ab_since_isr = 0;
        z_diag_steps_since_main = 0; /* deprecated mirror */
        z_diag_isr_accepted++;
        z_seq_isr++;                   // Bump Z sequence
        z_seq_pub = z_seq_isr;         // Publish to main
      }
# endif
    }
#endif

    /* Refresh SR after possible Z clear */
    sr = TIM1->SR;

    /* ---- CC1 pending ---- */
    if (sr & TIM_SR_CC1IF) {
      const uint16_t c1 = (uint16_t)TIM1->CCR1;
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC1);
      const uint8_t ab = enc_read_AB() & 0x3u; /* real pins */
      const int8_t dir = dir_from_hw();
      last_cnt_isr = c1; last_ab_isr = ab; enc_latched_dir = dir;
      push_event_isr(dir, 0, c1, 1, ab);
      /* canonical X4 AB edges since Z (for both ISR + main prints) */
      ab_edges_since_z_isr = since_z_from_cnt_isr(c1, dir);
      z_diag_ab_since_isr = ab_edges_since_z_isr;
      z_diag_steps_since_main = z_diag_ab_since_isr; /* deprecated mirror */
      continue; /* let loop re-check if CC2 also pending */
    }

    /* ---- CC2 pending ---- */
    if (sr & TIM_SR_CC2IF) {
      const uint16_t c2 = (uint16_t)TIM1->CCR2;
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC2);
      const uint8_t ab = enc_read_AB() & 0x3u; /* real pins */
      const int8_t dir = dir_from_hw();
      last_cnt_isr = c2; last_ab_isr = ab; enc_latched_dir = dir;
      push_event_isr(dir, 0, c2, 2, ab);
      ab_edges_since_z_isr = since_z_from_cnt_isr(c2, dir);
      z_diag_ab_since_isr = ab_edges_since_z_isr;
      z_diag_steps_since_main = z_diag_ab_since_isr; /* deprecated mirror */
      continue;
    }

#ifdef TIM_SR_TERRF
    if (sr & TIM_SR_TERRF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_TERRF); }
#endif
#ifdef TIM_SR_IERRF
    if (sr & TIM_SR_IERRF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IERRF); }
#endif
  }
  __DSB();
}
#endif /* ENC_IS_LIVE */

/* ============================ Public API =============================== */

void EncSampler_Init(void) {
  memset(&enc_state, 0, sizeof(enc_state));
  enc_state.last_update_ms = HAL_GetTick();
  enc_state.baseline_interval = 10.0f;

  /* tiny settle before enabling IRQs */
#if (ENC_STARTUP_DELAY_MS > 0)
  HAL_Delay(ENC_STARTUP_DELAY_MS);
#endif
  const uint32_t now = HAL_GetTick();
  enc_warmup_min_until_ms = now + ENC_STARTUP_MIN_MS;
  enc_warmup_max_until_ms = now + ENC_STARTUP_MAX_MS;
  enc_block_z = 1; /* block Z until warmup exit */

  /* Seed GRAY from real pins so first row matches physical phase */
  enc_state.last_AB_state = (enc_read_AB() & 0x3u);

  /* Seed synthesized Gray (for prints) from real pins */
  {
    uint8_t seed = enc_state.last_AB_state & 3u;
    synth_ring_idx = gray_to_ring_idx(seed);
    synth_gray = seed;
  }

#if ENC_IS_LIVE
  enc_cnt_wrap = (uint32_t)__HAL_TIM_GET_AUTORELOAD(&htim1) + 1u;
  last_cnt_isr = (uint16_t)TIM1->CNT;
  last_ab_isr = enc_state.last_AB_state;
  last_z_cnt_isr = last_cnt_isr; /* seed Z base = current CNT */
  last_z_cnt_pub = last_z_cnt_isr;

  EncSampler_ApplyTIM1ICFilter(); /* filter remains 0 */
  EncSampler_ConfigIRQs();
  __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_TIF | TIM_SR_COMIF);
#endif

  printf("ENC: IRQ=CC1/CC2(rising) DIR=CR1.DIR (rev=%d) CNT_WRAP=%lu EDGES/REV=%lu (CPR=%lu)\r\n",
         (int)ENC_DIR_REVERSED, (unsigned long)enc_cnt_wrap,
         (unsigned long)QUAD_EDGES_PER_REV, (unsigned long)CPR);
}

#if ENC_IS_LIVE
void EncSampler_Process(void) {
  static uint8_t win_fill = 0;
  static uint32_t last_ms = 0;

  static uint8_t z_latch = 0;
  static uint32_t ab_since_z = 0; /* canonical AB since Z (X4), mirrored from ISR */
  static uint32_t last_z_ms = 0;

  static uint32_t gray_skip2 = 0;
  static uint8_t last_src = 0;

  static uint32_t rule_flags_live = 0;
  static int32_t dir_sum = 0;

  /* startup warmup gate */
  static uint8_t in_warmup = 1;
  static uint32_t startup_edges = 0;

  /* drop a few windows right after warmup */
  static uint8_t drop_windows = 0;

  /* main-thread mirror of last Z CNT from ISR (safe 16-bit read) */
  static uint16_t last_z_cnt_main = 0;
  static uint8_t last_z_inited = 0;
  if (!last_z_inited) { last_z_cnt_main = last_z_cnt_pub; last_z_inited = 1; }

  /* Z single-shot gate across windows */
  static uint8_t z_have_pending = 0;      /* Z seen but not yet consumed by an AB row */
  static uint32_t z_pending_seq = 0;      /* which Z (sequence number) is pending */
  static uint32_t z_seq_consumed = 0;     /* last Z sequence actually used in a window */
  static uint8_t z_carry_budget = 0;      /* allow Z to carry into at most the next window */

  while (event_read != event_write) {
    encoder_event_t evt = event_buffer[event_read];
    event_read = (event_read + 1u) & EVENT_IDX_MASK;

    /* keep the public Z time fresh even between windows */
    z_diag_last_z_ms = z_last_ms_isr;

    /* optional: maintain "age since last Z" for UI/prints */
    {
      uint32_t nowt = HAL_GetTick();
      z_diag_last_z_age_ms = (z_diag_last_z_ms == 0) ? 0 : (nowt - z_diag_last_z_ms);
    }

    /* Handle Z events immediately: update time + base CNT, then latch for next AB row */
    if (evt.z_pulse) {
      /* Latch Z for the very next AB row, and remember which Z this is */
      z_latch = 1u;
      z_have_pending = 1u;
      z_pending_seq = z_seq_pub;     /* sequence number from ISR */
      z_carry_budget = 1u;            /* allow carry into at most ONE subsequent window */

      last_z_cnt_main = evt.ccr;     /* exact CNT at Z */
      last_z_ms = evt.timestamp_ms;  /* exact ms at Z IRQ */
      z_diag_last_z_ms = last_z_ms;  /* publish right away */

      /* Phase-lock synthesized Gray to the actual AB at Z for pretty prints */
      synth_ring_idx = gray_to_ring_idx(evt.ab_state & 3u);
      synth_gray = GRAY_RING[synth_ring_idx];
      ab_since_z = 0;                /* for UI; next AB recomputes */
      continue;
    }

    /* AB edge? */
    if (!((evt.src == 1u) || (evt.src == 2u))) continue;

    /* Ensure per-window Z trace cannot leak across windows */
#if ENABLE_TRACE_WIN
    if (win_fill == 0) {
      memset(trace_z, 0, SEQ_LEN);
    }
#endif

    const uint8_t current_GRAY = (evt.ab_state & 0x3u);
    const int8_t dir = (evt.delta > 0) ? +1 : -1;
    const uint8_t dir_fwd = (dir > 0);
    const uint8_t dir_bwd = (dir < 0);

    if (dir > 0) dir_sum += 1;
    else if (dir < 0) dir_sum -= 1;

    /* Consume Z latch at the first AB row after Z.
       We also guard so a given Z sequence can only stamp ONE window. */
    const uint8_t chanZ = z_latch;    /* latched by a prior Z event */
    z_latch = 0u;

    const uint8_t src_A = (evt.src == 1u);
    const uint8_t src_B = (evt.src == 2u);
    const uint8_t is_same_src = (last_src != 0 && evt.src == last_src) ? 1u : 0u;

    const uint32_t now_ms = evt.timestamp_ms;
    int32_t dms = (int32_t)(now_ms - last_ms);
    if (dms <= 0) dms = 1;
    const float dt_ms = (float)dms;

    if (enc_state.baseline_interval < 1.0f) enc_state.baseline_interval = dt_ms;
    const float ratio = dt_ms / enc_state.baseline_interval;
    enc_state.speed_change_rate = fabsf(ratio - 1.0f);
    enc_state.baseline_interval = 0.9f * enc_state.baseline_interval + 0.1f * dt_ms;
    last_ms = now_ms;

    /* ===== Startup warmup gate ===== */
    if (in_warmup) {
      startup_edges++;

      /* keep internal trackers in sync, but don't publish rows yet */
      enc_state.last_AB_state = current_GRAY;
      last_src = evt.src;
      /* stay phase-locked for pretty prints */
      synth_ring_idx = gray_to_ring_idx(current_GRAY);
      synth_gray = GRAY_RING[synth_ring_idx];
      /* mirror the ISR-computed AB distance so console counters look sane */
      ab_since_z = ab_edges_since_z_isr;
      z_diag_steps_since_main = z_diag_ab_since_isr; /* deprecated mirror already set in ISR */

      const uint32_t now_gate = HAL_GetTick();
      const uint8_t edges_ready = (startup_edges >= ENC_STARTUP_EDGE_MIN);
      const uint8_t min_time_ok = (now_gate >= enc_warmup_min_until_ms);
      const uint8_t timed_out = (now_gate >= enc_warmup_max_until_ms);

      /* Exit warmup only when BOTH edges and min time are satisfied, or on max timeout */
      if (!(edges_ready && min_time_ok) && !timed_out) {
        continue; /* stay in warmup, consume events but publish nothing */
      }

      /* exit warmup just before first publish */
      in_warmup = 0;
      enc_block_z = 0; /* allow Z now */
      drop_windows = ENC_STARTUP_DROP_WINDOWS; /* drop this many complete windows */

      win_fill = 0;
      gray_skip2 = 0;
      rule_flags_live = 0;
      dir_sum = 0;
      last_src = 0;
      synth_ring_idx = gray_to_ring_idx(current_GRAY);
      synth_gray = GRAY_RING[synth_ring_idx];
      z_latch = 0; /* don't carry Z across the boundary */
      continue; /* take the next event cleanly */
    }

    /* ===== Canonical AB-since-Z (X4) from ISR ===== */
    (void)last_z_cnt_main;
    ab_since_z = ab_edges_since_z_isr;
    z_diag_steps_since_main = z_diag_ab_since_isr; /* deprecated mirror */

    /* Z single-shot rules */
    uint8_t packZ = 0u;
    if (chanZ && z_have_pending && (z_pending_seq != z_seq_consumed)) {
      packZ = 1u;                    /* stamp Z ONCE in this window */
      z_seq_consumed = z_pending_seq;
      z_have_pending = 0u;           /* fully consumed */
      z_carry_budget = 0u;
    }

    /* Z hygiene flags (use the canonical distance) */
    if (packZ && (ab_since_z < Z_MIN_GAP_EDGES)) { rule_flags_live |= WR_ZDOUBLE; }
    if (ab_since_z > Z_MISS_EDGE_LIMIT) { rule_flags_live |= WR_ZMISS; }
#if (Z_MISS_MS_LIMIT > 0)
    if (last_z_ms != 0u && (uint32_t)(now_ms - last_z_ms) > (uint32_t)Z_MISS_MS_LIMIT) {
      rule_flags_live |= WR_ZMISS;
    }
#endif

    /* adjacency check (one-bit Gray move) using real pins */
    const uint8_t prev_gray = enc_state.last_AB_state;
    const uint8_t diff_bits = (prev_gray ^ current_GRAY) & 3u;
    const uint8_t adjacent = (uint8_t)((diff_bits == 1u) || (diff_bits == 2u));

    /* ===== Synth Gray step for printing (DIR-aware, rising-edge-only) ===== */
    {
      uint8_t expect_src = (dir > 0)
                           ? ((synth_ring_idx & 1u) ? 1u : 2u) /* FWD: odd->A(1), even->B(2) */
                           : ((synth_ring_idx & 1u) ? 2u : 1u); /* REV: odd->B(2), even->A(1) */
      if (evt.src != expect_src) {
        synth_ring_idx = gray_to_ring_idx(current_GRAY);
      }
      if (dir > 0) synth_ring_idx = (uint8_t)((synth_ring_idx + 1) & 3u); /* 0->1->3->2->0 */
      else synth_ring_idx = (uint8_t)((synth_ring_idx + 3) & 3u); /* reverse */
      synth_gray = GRAY_RING[synth_ring_idx];
    }

    /* ======================= Pack features for the model ================== */
    float *f = feat_win[win_fill];
    f[0] = scale_feat(0, (float)current_GRAY); /* AB_State (real pins for model) */
    f[1] = scale_feat(1, (float)src_A); /* SRC_A */
    f[2] = scale_feat(2, (float)src_B); /* SRC_B */
    f[3] = scale_feat(3, (float)dir_fwd); /* dir_fwd */
    f[4] = scale_feat(4, (float)dir_bwd); /* dir_bwd */
    f[5] = scale_feat(5, enc_state.speed_change_rate);/* SCR */
    f[6] = scale_feat(6, (float)packZ); /* Z (latched) */
    f[7] = scale_feat(7, (float)ab_since_z); /* AB since Z (X4) — replaces "steps since" */
    f[8] = scale_feat(8, (float)is_same_src); /* same_src */
    f[9] = scale_feat(9, (float)adjacent); /* adjacent? */

#if ENABLE_TRACE_WIN
    /* For prints: show synthesized Gray so you get 0132 (FWD) / 0213 (REV) */
    trace_ab[win_fill] = (synth_gray & 3u);
    trace_src[win_fill] = evt.src; /* 1 or 2 */
    trace_z[win_fill] = packZ ? 1u : 0u;
#endif

    if (is_same_src) { gray_skip2++; }
    last_src = evt.src;

    /* Commit row */
    win_fill++;
    enc_state.last_AB_state = current_GRAY; /* keep model state on real pins */
    enc_state.last_update_ms = now_ms;

    if (win_fill >= SEQ_LEN) {
      /* Drop the first few full windows right after warmup */
      if (drop_windows) {
        drop_windows--;
        win_fill = 0;
        gray_skip2 = 0;
        rule_flags_live = 0;
        last_src = 0;
        dir_sum = 0;
        z_latch = 0; /* ensure no Z carries into the next window */
        continue;
      }

      /* CRITICAL FIX: Minimize IRQ disable time - only bump indices under IRQ lock */
      uint8_t w_local;
      __disable_irq();
      w_local = wf_w;
      seq_fifo[w_local] = ++win_seq;  /* assign sequence number */
      wf_w = (wf_w + 1u) & (WINFIFO - 1u);
      if (wf_count < WINFIFO) wf_count++;
      else wf_r = (wf_r + 1u) & (WINFIFO - 1u);
      win_ready = wf_count;
      __enable_irq();

      /* Big memcpy with IRQs enabled */
      memcpy(win_fifo[w_local], &feat_win[0][0], sizeof(win_fifo[0]));
      const uint32_t flags = ((gray_skip2 >= 2u) ? WR_SKIP2 : 0u) | rule_flags_live;
      flags_fifo[w_local] = flags;
      enc_rule_flags = flags;

#if ENABLE_TRACE_WIN
      memcpy(last_trace_ab, trace_ab, SEQ_LEN);
      memcpy(last_trace_src, trace_src, SEQ_LEN);
      memcpy(last_trace_z, trace_z, SEQ_LEN);
#endif

      if (dir_sum > 0) last_window_dir = +1;
      else if (dir_sum < 0) last_window_dir = -1;
      else last_window_dir = enc_latched_dir;

      dir_sum = 0;
      win_total++;

      /* Per-window diag snapshot for printing */
      z_diag_seen_win = z_diag_isr_seen;
      z_diag_acc_win = z_diag_isr_accepted;
      z_diag_ab_since_win = z_diag_ab_since_isr;
      z_diag_lastZ_ms_win = z_diag_last_z_ms;

      /* Limit Z carryover to at most ONE subsequent window */
      if (z_have_pending) {
        if (z_carry_budget > 0u) {
          z_carry_budget--;            /* allow exactly one carry */
        } else {
          z_have_pending = 0u;         /* force-drop stale Z */
        }
      }

      /* reset per-window state */
      win_fill = 0;
      gray_skip2 = 0;
      rule_flags_live = 0;
      last_src = 0;
      z_latch = 0; /* <- hard-stop any lingering Z for the next window */
    }
  }
}
#endif /* ENC_IS_LIVE */

/* =============================== Copy ================================== */

int EncSampler_CopyWindowLinear(float *dst, uint32_t *out_flags) {
  uint8_t r_local;
  uint32_t flags, seq;

  /* CRITICAL FIX: Tiny critical section - just pop the indices */
  __disable_irq();
  if (wf_count == 0) {
    __enable_irq();
    return -1;
  }
  r_local = wf_r;
  flags = flags_fifo[r_local];
  seq = seq_fifo[r_local];  /* for duplicate detection */

  wf_r = (wf_r + 1u) & (WINFIFO - 1u);
  wf_count--;
  win_ready = wf_count;
  __enable_irq();

  /* CRITICAL FIX: Big memcpy with IRQs enabled */
  memcpy(dst, win_fifo[r_local], sizeof(win_fifo[0]));

  win_rule_flags = flags;
  if (out_flags) *out_flags = flags;

  /* Optional: print sequence for duplicate detection */
  static uint32_t last_seq = 0;
  if (seq == last_seq) {
    printf("WARNING: Duplicate window seq=%lu detected!\r\n", (unsigned long)seq);
  }
  last_seq = seq;

  return 0;
}

/* =============================== Stop / Flush =========================== */

void EncSampler_StopHardware(void) {
  /* CRITICAL FIX: Don't use global IRQ disable - just disable timer IRQs */
  uint32_t dier = TIM1->DIER;
  TIM1->DIER &= ~(TIM_DIER_CC1IE | TIM_DIER_CC2IE
#if HAVE_Z_INDEX && !FORCE_IGNORE_Z
                | TIM_DIER_IDXIE
#endif
                );

  if (htim1.Instance) {
    __HAL_TIM_DISABLE(&htim1);
    __HAL_TIM_CLEAR_FLAG(&htim1,
      TIM_SR_CC1IF | TIM_SR_CC1OF |
      TIM_SR_CC2IF | TIM_SR_CC2OF |
      TIM_SR_UIF | TIM_SR_TIF | TIM_SR_COMIF);
#ifdef TIM_SR_IDXF
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
#endif
  }

#ifdef TIM1_CC_IRQn
  NVIC_DisableIRQ(TIM1_CC_IRQn);
#endif
#if defined(TIM1_TRG_CCU_IRQn)
  NVIC_DisableIRQ(TIM1_TRG_CCU_IRQn);
#elif defined(TIM1_TRG_COM_IRQn)
  NVIC_DisableIRQ(TIM1_TRG_COM_IRQn);
#endif

  TIM1->DIER = dier;  /* restore original state */
}

void EncSampler_FlushWindows(void) {
  /* CRITICAL FIX: Minimal IRQ disable - just gate timer briefly */
  uint32_t dier = TIM1->DIER;
  TIM1->DIER &= ~(TIM_DIER_CC1IE | TIM_DIER_CC2IE
#if HAVE_Z_INDEX && !FORCE_IGNORE_Z
                | TIM_DIER_IDXIE
#endif
                );

  wf_w = wf_r = 0; wf_count = 0;
  win_ready = 0; win_total = 0;

  event_read = event_write = 0; event_drops = 0;

  z_last_ms_isr = 0;
  ab_edges_since_z_isr = 0;
  z_diag_isr_seen = z_diag_isr_accepted = 0;
  z_diag_ab_since_isr = 0;
  z_diag_steps_since_main = 0;
  z_diag_last_z_ms = z_diag_last_z_age_ms = 0;

  last_z_cnt_isr = (uint16_t)TIM1->CNT;
  last_z_cnt_pub = last_z_cnt_isr;

  const uint32_t nowr = HAL_GetTick();
  enc_warmup_min_until_ms = nowr + ENC_STARTUP_MIN_MS;
  enc_warmup_max_until_ms = nowr + ENC_STARTUP_MAX_MS;
  enc_block_z = 1;

  TIM1->DIER = dier;  /* restore timer IRQs */
}

/* ============================== Trace API ============================== */
#if ENABLE_TRACE_WIN
void EncSampler_DebugGetLastTrace(uint8_t *ab, uint8_t *src, uint8_t *z) {
  if (ab) memcpy(ab, last_trace_ab, SEQ_LEN);
  if (src) memcpy(src, last_trace_src, SEQ_LEN);
  if (z) memcpy(z, last_trace_z, SEQ_LEN);
}
#else
void EncSampler_DebugGetLastTrace(uint8_t *ab, uint8_t *src, uint8_t *z) {
  if (ab) memset(ab, 0, SEQ_LEN);
  if (src) memset(src, 0, SEQ_LEN);
  if (z) memset(z, 0, SEQ_LEN);
}
#endif
