#include <stdint.h>
#include <stdbool.h>
#include <string.h>
#include <stdio.h>
#include "model_meta.h"
#include "synthetic.h"

/* Forward Gray 0->2->3->1 ; Backward Gray 0->1->3->2 */
static const uint8_t GRAY_FWD[4] = {0, 2, 3, 1};
static const uint8_t GRAY_BWD[4] = {0, 1, 3, 2};

static inline int bitA(uint8_t g) { return (g >> 1) & 1; }  // AB_State = (A<<1)|B
static inline int bitB(uint8_t g) { return g & 1; }

/* Flat, already-scaled window buffer */
static float   g_synth_flat[MODEL_SEQ_LEN * MODEL_FEAT_DIM];
/* Debug traces (AB digit, source ?/A/B, Z caret) */
static uint8_t s_ab[MODEL_SEQ_LEN], s_src[MODEL_SEQ_LEN], s_z[MODEL_SEQ_LEN];

const float* EncSynth_GetFlat(void) { return g_synth_flat; }

void EncSynth_DebugPrint(void) {
  char ab_s[MODEL_SEQ_LEN+1], src_s[MODEL_SEQ_LEN+1], z_s[MODEL_SEQ_LEN+1];
  for (int i = 0; i < MODEL_SEQ_LEN; ++i) {
    ab_s[i]  = "0123"[s_ab[i] & 3u];
    src_s[i] = (s_src[i] == 1 ? 'A' : (s_src[i] == 2 ? 'B' : '?'));
    z_s[i]   = s_z[i] ? '^' : '.';
  }
  ab_s[MODEL_SEQ_LEN] = src_s[MODEL_SEQ_LEN] = z_s[MODEL_SEQ_LEN] = '\0';
  printf("WIN AB : %s\r\n", ab_s);
  printf("WIN SRC: %s\r\n", src_s);
  printf("WIN  Z : %s\r\n", z_s);
}

/* ----------------------- helpers ------------------------ */

static inline float scale_feat(int j, float x) {
  float y = (x - MODEL_FEAT_MIN[j]) * MODEL_FEAT_SCALE[j];
  if (y < 0.f) y = 0.f;
  if (y > 1.f) y = 1.f;
  return y;
}

static void emit_row(int t_out,
                     uint8_t g_cur,
                     int dirF, int dirB,
                     float scr,     /* speed change rate */
                     int chA, int chB,
                     int zpulse,
                     int rising,
                     float *flat_out,
                     int *ssz)
{
  /* Feature order:
     0 AB_State, 1 State_Change, 2 Direction_forward, 3 Direction_backward,
     4 Speed_Change_Rate, 5 Channel_A, 6 Channel_B, 7 Channel_Z,
     8 Edge_RISING, 9 Steps_Since_Z
  */
  float raw[MODEL_FEAT_DIM];

  /* AB state shown as 0..3 (Gray digit) */
  raw[0] = (float)g_cur;

  /* State change: 0 for very first row; otherwise 1 if any channel flagged */
  raw[1] = (t_out == 0) ? 0.f : ((chA || chB) ? 1.f : 0.f);

  raw[2] = (float)!!dirF;
  raw[3] = (float)!!dirB;
  raw[4] = scr;

  raw[5] = (float)!!chA;
  raw[6] = (float)!!chB;
  raw[7] = (float)!!zpulse;
  raw[8] = (float)!!rising;

  raw[9] = (float)(*ssz);

  /* Pack + scale into flat T×F */
  int idx0 = t_out * MODEL_FEAT_DIM;
  for (int f = 0; f < MODEL_FEAT_DIM; ++f)
    g_synth_flat[idx0 + f] = scale_feat(f, raw[f]);

  /* debug traces */
  s_ab[t_out]  = g_cur & 3u;
  s_src[t_out] = (chA ? 1 : (chB ? 2 : 0));
  s_z[t_out]   = zpulse ? 1 : 0;

  /* advance SSZ after we emitted */
  if (zpulse) *ssz = 0;
  else (*ssz)++;
}

/* advance Gray index by one logical state */
static inline uint8_t gray_step(const uint8_t *LUT, int *idx) {
  uint8_t g = LUT[*idx & 3];
  (*idx)++;
  return g;
}

/* decide rising/falling per channel between two Gray states */
static inline void edge_kind(uint8_t g_prev, uint8_t g_cur,
                             int *chA, int *chB, int *rise)
{
  int a1 = bitA(g_prev), b1 = bitB(g_prev);
  int a2 = bitA(g_cur),  b2 = bitB(g_cur);
  *chA = (a2 != a1);
  *chB = (b2 != b1);
  int riseA = (a1 == 0 && a2 == 1);
  int riseB = (b1 == 0 && b2 == 1);
  *rise = (riseA || riseB);
}

/* set Channel_A/B for “rising-only” hardware: only 1 on rising edges */
static inline void apply_rising_only(uint8_t g_prev, uint8_t g_cur, int *chA, int *chB)
{
  int a1 = bitA(g_prev), b1 = bitB(g_prev);
  int a2 = bitA(g_cur),  b2 = bitB(g_cur);
  int riseA = (a1 == 0 && a2 == 1);
  int riseB = (b1 == 0 && b2 == 1);
  *chA = riseA ? 1 : 0;
  *chB = riseB ? 1 : 0;
}

/* ------------------- generators ------------------------ */

void EncSynth_MakeNormalWindow(int forward, int start_state, int steps0, int rising_only)
{
  if (start_state < 0) start_state = 0;
  if (start_state > 3) start_state = 3;
  if (steps0 < 0) steps0 = 0;

  const uint8_t *LUT = forward ? GRAY_FWD : GRAY_BWD;
  int dirF = forward ? 1 : 0;
  int dirB = forward ? 0 : 1;

  /* clear traces */
  memset(s_ab,  0, sizeof(s_ab));
  memset(s_src, 0, sizeof(s_src));
  memset(s_z,   0, sizeof(s_z));

  int ssz = steps0;
  int gidx = start_state;
  uint8_t g_prev = LUT[(gidx - 1) & 3];

  int t_out = 0;
  while (t_out < MODEL_SEQ_LEN) {
    uint8_t g_cur = gray_step(LUT, &gidx);

    int chA, chB, rising;
    edge_kind(g_prev, g_cur, &chA, &chB, &rising);

    if (rising_only) {
      /* Only emit rows when the transition was rising; otherwise skip */
      int rA = 0, rB = 0;
      apply_rising_only(g_prev, g_cur, &rA, &rB);
      if (!(rA || rB)) { g_prev = g_cur; continue; }
      chA = rA; chB = rB; rising = 1;
    }

    emit_row(t_out, g_cur, dirF, dirB,
             /*SCR*/0.0f, chA, chB, /*Z*/0, /*ER*/rising,
             g_synth_flat, &ssz);

    g_prev = g_cur;
    t_out++;
  }
}

void EncSynth_MakeBounceWindow(int forward, int start_state, int steps0,
                               int which_channel, int t_beg, int n_bounces,
                               int rising_only)
{
  if (which_channel != 1 && which_channel != 2) which_channel = 1;
  if (t_beg < 2) t_beg = 2;
  if (t_beg > (MODEL_SEQ_LEN-3)) t_beg = MODEL_SEQ_LEN-3;
  if (n_bounces < 2) n_bounces = 2;
  if (n_bounces > 5) n_bounces = 5;

  const uint8_t *LUT = forward ? GRAY_FWD : GRAY_BWD;
  int dirF = forward ? 1 : 0;
  int dirB = forward ? 0 : 1;

  memset(s_ab,  0, sizeof(s_ab));
  memset(s_src, 0, sizeof(s_src));
  memset(s_z,   0, sizeof(s_z));

  int ssz = steps0;
  int gidx = start_state;
  uint8_t g_prev = LUT[(gidx - 1) & 3];

  int t_out = 0;
  while (t_out < MODEL_SEQ_LEN) {
    /* before/after the bounce cluster: emit normal edges */
    if (t_out < t_beg || t_out >= (t_beg + n_bounces)) {
      /* normal advance, possibly skip non-rising if rising_only */
      uint8_t g_cur = gray_step(LUT, &gidx);
      int chA, chB, rising;
      edge_kind(g_prev, g_cur, &chA, &chB, &rising);
      if (rising_only) {
        int rA=0, rB=0; apply_rising_only(g_prev, g_cur, &rA, &rB);
        if (!(rA || rB)) { g_prev = g_cur; continue; }
        chA=rA; chB=rB; rising=1;
      }
      emit_row(t_out, g_cur, dirF, dirB, 0.0f, chA, chB, 0, rising, g_synth_flat, &ssz);
      g_prev = g_cur;
      t_out++;
      continue;
    }

    /* inside the bounce cluster: repeat edges on same channel, spike SCR,
       keep Steps_Since_Z constant (matches your CSV bounce behavior) */
    const uint8_t mask = (which_channel == 1) ? 0x2u : 0x1u;
    float scr_spike = (t_out == t_beg) ? 0.95f : ((t_out == t_beg+1) ? 0.06f : 0.009f);

    if (rising_only) {
      /* Rising-only “bounce”: synthesize multiple *rising* crossings on same channel.
         We fake it by momentarily “dropping” the bit before re-rising for the next row. */
      uint8_t g_hi = g_prev ^ mask;     // first rise
      int chA = (which_channel==1), chB = (which_channel==2);
      emit_row(t_out, g_hi, dirF, dirB, scr_spike, chA, chB, 0, /*ER*/1, g_synth_flat, &ssz);
      t_out++;
      g_prev = g_hi;

      /* additional rises: pretend the line bounced below threshold then rose again.
         We keep AB the same (high) in the snapshot, but still flag Channel_X and ER=1. */
      for (; t_out < (t_beg + n_bounces) && t_out < MODEL_SEQ_LEN; ++t_out) {
        emit_row(t_out, g_hi, dirF, dirB, scr_spike, chA, chB, 0, /*ER*/1, g_synth_flat, &ssz);
      }
    } else {
      /* Rise/fall toggling on the same bit */
      uint8_t g_cur = g_prev ^ mask;   // toggle same channel
      int chA = (which_channel==1), chB = (which_channel==2);
      /* First edge in cluster is rising if the bit goes 0->1; detect it from prev bits */
      int a1 = bitA(g_prev), b1 = bitB(g_prev);
      int a2 = bitA(g_cur),  b2 = bitB(g_cur);
      int rising = ((a1==0 && a2==1) || (b1==0 && b2==1));
      emit_row(t_out, g_cur, dirF, dirB, scr_spike, chA, chB, 0, rising, g_synth_flat, &ssz);
      t_out++; g_prev = g_cur;

      /* remaining quick flips */
      for (; t_out < (t_beg + n_bounces) && t_out < MODEL_SEQ_LEN; ++t_out) {
        g_cur = g_prev ^ mask;
        a1 = bitA(g_prev); b1 = bitB(g_prev);
        a2 = bitA(g_cur);  b2 = bitB(g_cur);
        rising = ((a1==0 && a2==1) || (b1==0 && b2==1));
        emit_row(t_out, g_cur, dirF, dirB, scr_spike, chA, chB, 0, rising, g_synth_flat, &ssz);
        g_prev = g_cur;
      }
    }
  }
}

void EncSynth_MakeMissingStepWindow(int forward, int start_state, int steps0,
                                    int which_channel, int t_at, int rising_only)
{
  if (which_channel != 1 && which_channel != 2) which_channel = 1;
  if (t_at < 1) t_at = 1;
  if (t_at > (MODEL_SEQ_LEN-2)) t_at = MODEL_SEQ_LEN-2;

  const uint8_t *LUT = forward ? GRAY_FWD : GRAY_BWD;
  int dirF = forward ? 1 : 0;
  int dirB = forward ? 0 : 1;

  memset(s_ab,  0, sizeof(s_ab));
  memset(s_src, 0, sizeof(s_src));
  memset(s_z,   0, sizeof(s_z));

  int ssz = steps0;
  int gidx = start_state;
  uint8_t g_prev = LUT[(gidx - 1) & 3];

  int t_out = 0;
  while (t_out < MODEL_SEQ_LEN) {
    /* up to t_at-1 : normal emission */
    if (t_out < t_at) {
      uint8_t g_cur = gray_step(LUT, &gidx);
      int chA, chB, rising; edge_kind(g_prev, g_cur, &chA, &chB, &rising);
      if (rising_only) { int rA=0,rB=0; apply_rising_only(g_prev,g_cur,&rA,&rB);
        if (!(rA||rB)) { g_prev=g_cur; continue; } chA=rA; chB=rB; rising=1; }
      emit_row(t_out, g_cur, dirF, dirB, 0.0f, chA, chB, 0, rising, g_synth_flat, &ssz);
      g_prev = g_cur; t_out++; continue;
    }

    /* At t_at: repeat same channel as the previous emitted row (skip the other one).
       We do it by flipping the same bit again (two edges on same channel in a row).
       Also give a modest SCR bump so the model has a timing cue. */
    const uint8_t mask = (which_channel == 1) ? 0x2u : 0x1u;
    /* Step the Gray *as if* we saw the next logical state, then force same channel again. */
    uint8_t g_next = gray_step(LUT, &gidx);
    (void)g_next; /* unused on purpose: we synthesize anomaly instead */

    /* First anomaly edge: force a flip on requested channel relative to g_prev */
    uint8_t g_cur = g_prev ^ mask;
    int chA = (which_channel==1), chB = (which_channel==2);
    int a1 = bitA(g_prev), b1 = bitB(g_prev);
    int a2 = bitA(g_cur),  b2 = bitB(g_cur);
    int rising = ((a1==0 && a2==1) || (b1==0 && b2==1));
    float scr1 = 0.15f; /* small spike */
    if (rising_only) { /* enforce rising-only channel flags */
      int rA=0,rB=0; apply_rising_only(g_prev,g_cur,&rA,&rB);
      chA = rA; chB = rB; rising = 1;
      if (!(rA||rB)) { chA=(which_channel==1); chB=(which_channel==2); rising=1; }
    }
    emit_row(t_out, g_cur, dirF, dirB, scr1, chA, chB, 0, rising, g_synth_flat, &ssz);
    t_out++; g_prev = g_cur;

    /* Immediately repeat same channel again to signal the “skip2” pattern */
    g_cur = g_prev ^ mask;
    a1 = bitA(g_prev); b1 = bitB(g_prev);
    a2 = bitA(g_cur);  b2 = bitB(g_cur);
    rising = ((a1==0 && a2==1) || (b1==0 && b2==1));
    float scr2 = 0.08f;
    if (rising_only) { int rA=0,rB=0; apply_rising_only(g_prev,g_cur,&rA,&rB);
      chA = rA; chB = rB; rising = 1;
      if (!(rA||rB)) { chA=(which_channel==1); chB=(which_channel==2); rising=1; }
    }
    if (t_out < MODEL_SEQ_LEN) {
      emit_row(t_out, g_cur, dirF, dirB, scr2, chA, chB, 0, rising, g_synth_flat, &ssz);
      t_out++; g_prev = g_cur;
    }

    /* After the anomaly rows, continue normally to fill the remainder */
    while (t_out < MODEL_SEQ_LEN) {
      uint8_t g_ok = gray_step(LUT, &gidx);
      int cA,cB,er; edge_kind(g_prev, g_ok, &cA, &cB, &er);
      if (rising_only) { int rA=0,rB=0; apply_rising_only(g_prev,g_ok,&rA,&rB);
        if (!(rA||rB)) { g_prev=g_ok; continue; } cA=rA; cB=rB; er=1; }
      emit_row(t_out, g_ok, dirF, dirB, 0.0f, cA, cB, 0, er, g_synth_flat, &ssz);
      g_prev = g_ok; t_out++;
    }
  }
}

void EncSynth_MakeZIndexWindow(int forward, int start_state, int steps0,
                               int t_z, int rising_only)
{
  if (t_z < 1) t_z = 1;
  if (t_z > (MODEL_SEQ_LEN-2)) t_z = MODEL_SEQ_LEN-2;

  const uint8_t *LUT = forward ? GRAY_FWD : GRAY_BWD;
  int dirF = forward ? 1 : 0;
  int dirB = forward ? 0 : 1;

  memset(s_ab,  0, sizeof(s_ab));
  memset(s_src, 0, sizeof(s_src));
  memset(s_z,   0, sizeof(s_z));

  int ssz = steps0;
  int gidx = start_state;
  uint8_t g_prev = LUT[(gidx - 1) & 3];

  int t_out = 0;
  while (t_out < MODEL_SEQ_LEN) {
    uint8_t g_cur = gray_step(LUT, &gidx);
    int chA, chB, rising; edge_kind(g_prev, g_cur, &chA, &chB, &rising);
    if (rising_only) {
      int rA=0,rB=0; apply_rising_only(g_prev,g_cur,&rA,&rB);
      if (!(rA||rB)) { g_prev=g_cur; continue; }
      chA=rA; chB=rB; rising=1;
    }
    int z = (t_out == t_z) ? 1 : 0;
    emit_row(t_out, g_cur, dirF, dirB, 0.0f, chA, chB, z, rising, g_synth_flat, &ssz);
    g_prev = g_cur;
    t_out++;
  }
}
