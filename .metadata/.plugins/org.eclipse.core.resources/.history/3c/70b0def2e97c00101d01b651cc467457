/* LSTM window = 10 samples (model input is 1x10x1) */
#define WIN 10
static float          win_buf[WIN];
static volatile uint8_t win_fill = 0;
static volatile uint8_t run_infer = 0;

static uint16_t last_cnt = 0;
static volatile uint8_t z_seen = 0;

static volatile uint32_t tim7_ticks = 0;     // TIM7 ISR hit counter
static volatile uint32_t win_ready  = 0;     // windows completed (optional)
static volatile uint32_t inf_total  = 0;     // # of successful inferences
static volatile ai_float last_y     = 0.0f;  // last model output (for display)

