static ai_handle net = AI_HANDLE_NULL;

/* 360 bytes per your generated headers */
static AI_ALIGNED(4) uint8_t ai_activations[AI_NETWORK_DATA_ACTIVATION_1_SIZE];

/* tables expected by ai_network_create_and_init() */
static const ai_handle act_tab[AI_NETWORK_DATA_ACTIVATIONS_COUNT] = { ai_activations };
static const ai_handle* wgt_tab = AI_NETWORK_DATA_WEIGHTS_TABLE_GET();

static ai_buffer *ai_in  = NULL;
