static void AI_LogError(const char* tag)
{
    ai_error e = ai_network_get_error(net);
    printf("[%s] AI error: type=%d code=%d\r\n", tag, (int)e.type, (int)e.code);
}

static void AI_Init(void)
{
    ai_error err = ai_network_create_and_init(&net, act_tab, wgt_tab);
    if (err.type != AI_ERROR_NONE) {
        AI_LogError("create_and_init");
        Error_Handler();
    }
    ai_in  = ai_network_inputs_get(net, NULL);
    ai_out = ai_network_outputs_get(net, NULL);

    printf("AI init OK. IN=%u OUT=%u, act=%uB\r\n",
           (unsigned)AI_NETWORK_IN_1_SIZE,
           (unsigned)AI_NETWORK_OUT_1_SIZE,
           (unsigned)AI_NETWORK_DATA_ACTIVATION_1_SIZE);
}

/* HAL calls this from TIM7_IRQHandler via HAL_TIM_IRQHandler */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM7)
    {
        tim7_ticks++;  // <--- add this line

        uint16_t cnt = __HAL_TIM_GET_COUNTER(&htim1);
        const int MOD = 2000;
        int16_t d = (int16_t)cnt - (int16_t)last_cnt;
        if (d >  MOD/2) d -= MOD;
        if (d < -MOD/2) d += MOD;
        last_cnt = cnt;

#ifdef TIM_FLAG_IDX
        if (__HAL_TIM_GET_FLAG(&htim1, TIM_FLAG_IDX) != RESET) {
            __HAL_TIM_CLEAR_FLAG(&htim1, TIM_FLAG_IDX);
            z_seen = 1;
        }
#endif
        float sample = (float)d;
        win_buf[win_fill++] = sample;

        if (win_fill >= WIN) {
            win_fill = 0;
            win_ready++;            // <--- optional, for stats
            run_infer = 1;
        }
    }
}
