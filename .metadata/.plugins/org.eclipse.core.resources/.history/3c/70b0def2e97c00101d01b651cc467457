/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_LPUART1_UART_Init();
  MX_CACHEAXI_Init();
  MX_TIM1_Init();
  MX_TIM7_Init();
  MX_RAMCFG_Init();
  MX_X_CUBE_AI_Init();
  SystemIsolation_Config();
  /* USER CODE BEGIN 2 */
  PeriphCommonClock_Config();  // safe to call again here; keeps TIM clock div at DIV1

  AI_Init();

  /* Start the encoder and its index feature */
  HAL_TIM_Encoder_Start(&htim1, TIM_CHANNEL_ALL);
  HAL_TIMEx_EnableEncoderIndex(&htim1);

  /* Start the periodic sampler (TIM7 @ your current 10 kHz) */
  HAL_TIM_Base_Start_IT(&htim7);

  printf("Init done\r\n");

  uint32_t next_blink_ms  = HAL_GetTick() + 250;   // 4 Hz heartbeat
  uint32_t next_report_ms = HAL_GetTick() + 1000;  // 1 Hz stats

  uint32_t last_ticks = 0, last_inf = 0, last_win = 0;
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

  MX_X_CUBE_AI_Process();
    /* USER CODE BEGIN 3 */
	  if (run_infer) {
	      __disable_irq();
	      float in_local[WIN];
	      for (int i = 0; i < WIN; ++i) in_local[i] = win_buf[i];
	      (void)z_seen;  // if you want to use it, keep it; else suppress warning
	      z_seen = 0;
	      run_infer = 0;
	      __enable_irq();

	      ai_float out[AI_NETWORK_OUT_1_SIZE];
	      ai_in[0].data  = (ai_handle)in_local;
	      ai_out[0].data = (ai_handle)out;

	      ai_i32 nb = ai_network_run(net, ai_in, ai_out);
	      if (nb == 1) {
	          last_y = out[0];
	          inf_total++;
	      } else {
	          AI_LogError("run");
	      }
	  }

	  /* Non-blocking LED heartbeat (every 250 ms) */
	  uint32_t now = HAL_GetTick();
	  if ((int32_t)(now - next_blink_ms) >= 0) {
	      HAL_GPIO_TogglePin(LED1_GREEN_GPIO_Port, LED1_GREEN_Pin);
	      next_blink_ms += 250;
	  }

	  /* 1 Hz stats: shows timer rate, windows, infer rate, last output */
	  if ((int32_t)(now - next_report_ms) >= 0) {
	      uint32_t dt_ticks = tim7_ticks - last_ticks;
	      uint32_t dt_inf   = inf_total  - last_inf;
	      uint32_t dt_win   = win_ready  - last_win;

	      printf("TIM7=%lu/s  windows=%lu/s  inf=%lu/s  y=%.5f\r\n",
	             (unsigned long)dt_ticks,
	             (unsigned long)dt_win,
	             (unsigned long)dt_inf,
	             (double)last_y);

	      last_ticks = tim7_ticks;
	      last_inf   = inf_total;
	      last_win   = win_ready;
	      next_report_ms += 1000;
	  }
  }
  /* USER CODE END 3 */
}

