#ifndef ENABLE_RAW_LOG
#define ENABLE_RAW_LOG 0
#endif

#ifndef ENC_DEBUG_EDGE_COUNT
#define ENC_DEBUG_EDGE_COUNT 0
#endif

#ifndef CPR
#define CPR 500u
#endif

#ifndef HAVE_Z_INDEX
#define HAVE_Z_INDEX 1
#endif

#if !defined(TIM_SR_IDXF) || !defined(TIM_IT_IDX)
#  undef  HAVE_Z_INDEX
#  define HAVE_Z_INDEX 0
#  warning "No TIM1 IDXF/IDX in headers -> Z gated off at build time"
#endif

#ifndef FORCE_IGNORE_Z
#define FORCE_IGNORE_Z 0
#endif

#ifndef Z_SOFT_DEBOUNCE_MS
#define Z_SOFT_DEBOUNCE_MS  0u
#endif

/* *** x4 counting (BOTHEDGE on A & B) => 4*CPR edges per rev *** */
#undef  QUAD_EDGES_PER_REV
#define QUAD_EDGES_PER_REV  (4u * CPR)

/* Z acceptance hygiene */
#undef  Z_MIN_AB_EDGES
#define Z_MIN_AB_EDGES      0u

#undef  Z_MISS_EDGE_LIMIT
#define Z_MISS_EDGE_LIMIT   (QUAD_EDGES_PER_REV + QUAD_EDGES_PER_REV/8u)

#ifndef Z_MISS_MS_LIMIT
#define Z_MISS_MS_LIMIT     0u
#endif

#undef  Z_MIN_GAP_EDGES
#define Z_MIN_GAP_EDGES     20u

#ifndef EXPECT_Z_AB_ENABLE
#define EXPECT_Z_AB_ENABLE  0
#endif
#ifndef EXPECT_Z_AB_VALUE
#define EXPECT_Z_AB_VALUE   0u
#endif

#ifndef ENC_DIR_REVERSED
#define ENC_DIR_REVERSED 0
#endif

/* ---------- Direction debug (non-intrusive; no printing from ISR) ---------- */
#ifndef ENC_DIR_DEBUG
#define ENC_DIR_DEBUG 1     /* 0 = off, 1 = capture + print a few edges from main */
#endif
#ifndef ENC_DIR_DEBUG_MAX
#define ENC_DIR_DEBUG_MAX 200   /* how many edges to print then stop */
#endif

/* ======================== Globals / Exposed state ====================== */

extern TIM_HandleTypeDef htim1;

volatile uint32_t cc1_overruns = 0, cc2_overruns = 0;
volatile uint32_t enc_rule_flags = 0;
volatile uint32_t win_rule_flags = 0;

volatile uint32_t tim7_ticks = 0;
volatile uint32_t win_ready = 0;
volatile uint32_t win_total = 0;

static float feat_win[MODEL_SEQ_LEN][MODEL_FEAT_DIM];
#define SEQ_LEN  (MODEL_SEQ_LEN)
#define FEAT_DIM (MODEL_FEAT_DIM)

/* ======================== Encoder state tracking ======================= */
typedef struct {
  int32_t  last_position;
  int32_t  current_position;
  uint8_t  last_AB_state;      /* Last GRAY digit (bit1=A, bit0=B): 0,1,3,2 */
  uint32_t z_count;
  float    speed_change_rate;  /* |interval_ratio - 1| */
  uint32_t last_update_ms;     /* ms at last packed feature */
  float    baseline_interval;  /* EWMA baseline step interval (ms) */
} encoder_state_t;

static encoder_state_t enc_state = { 0 };

/* Sticky last decoded direction: +1 = forward, -1 = backward */
static volatile int8_t enc_latched_dir = +1;
int8_t EncSampler_GetLatchedDir(void) { return enc_latched_dir; }

/* Also keep last CNT we saw in ISR to compute direction from deltas */
static volatile uint16_t last_cnt_isr = 0;

/* ============================ Window FIFO ============================== */
/* Bumped to 32 to tolerate NN decimation without reusing slots */
#define WINFIFO_LOG2 5
#define WINFIFO      (1u << WINFIFO_LOG2)
static float    win_fifo[WINFIFO][SEQ_LEN * FEAT_DIM];
static uint32_t flags_fifo[WINFIFO];
static uint8_t  wf_w = 0, wf_r = 0, wf_count = 0;

/* ============================ Event ring =============================== */
typedef struct {
  int8_t   delta;           /* +1 / -1 per edge, 0 for Z-only */
  uint8_t  z_pulse;         /* 1 if IDXF (accepted in ISR) */
  uint8_t  src;             /* 1=CC1(A), 2=CC2(B), 3=IDX */
  uint8_t  ab_state;        /* Gray at event (bit1=A, bit0=B) */
  uint32_t timestamp_ms;    /* coarse (HAL_GetTick) */
  uint16_t ccr;             /* fine snapshot (CNT in encoder mode) */
} encoder_event_t;

/* 65536 events × 12 bytes ≈ 768 KiB (see console print) */
#define EVENT_BUF_BITS     16
#define EVENT_BUFFER_SIZE  (1u << EVENT_BUF_BITS)
#define EVENT_IDX_MASK     (EVENT_BUFFER_SIZE - 1u)

static encoder_event_t event_buffer[EVENT_BUFFER_SIZE];
static volatile uint32_t event_write = 0;
static volatile uint32_t event_read  = 0;
volatile uint32_t event_drops = 0;

/* ISR-side Z acceptance book-keeping */
static volatile uint32_t z_last_ms_isr        = 0;
static volatile uint32_t ab_edges_since_z_isr = 0;
/* diagnostics */
static volatile uint32_t z_isr_seen = 0;
static volatile uint32_t z_isr_accepted = 0;

/* ---- Public Z diagnostics ---- */
volatile uint32_t z_diag_isr_seen = 0;
volatile uint32_t z_diag_isr_accepted = 0;
volatile uint32_t z_diag_ab_since_isr = 0;
volatile uint32_t z_diag_steps_since_main = 0;
volatile uint32_t z_diag_last_z_ms = 0;

#if ENABLE_TRACE_WIN
static uint8_t trace_ab [WINFIFO][SEQ_LEN];
static uint8_t trace_src[WINFIFO][SEQ_LEN];
static uint8_t trace_z  [WINFIFO][SEQ_LEN];
static uint8_t last_pop_ab[SEQ_LEN], last_pop_src[SEQ_LEN], last_pop_z[SEQ_LEN];
#endif

/* Optional debug counters for BOTHEDGE proof (not used by dir method) */
#if ENC_DEBUG_EDGE_COUNT
static volatile uint32_t dbg_cc1_rise=0, dbg_cc1_fall=0, dbg_cc2_rise=0, dbg_cc2_fall=0;
#endif

/* ====================== Direction debug ring (non-ISR printing) ================== */
#if ENC_DIR_DEBUG
typedef struct {
  uint32_t t_ms;
  char     src;          /* 'A' or 'B' */
  uint16_t cnt_prev;
  uint16_t cnt_now;
  int16_t  d16;
  int8_t   dir;          /* +1/-1 after ENC_DIR_REVERSED */
  uint8_t  cr1_dir;      /* snapshot of CR1.DIR (0=up,1=down) for comparison */
  uint8_t  ab;           /* Gray at this edge */
} dbg_edge_t;

/* Rule bits (must match app_x-cube-ai.c expectations) */
enum {
  WR_SKIP2     = 1u<<0,
  WR_ZMISS     = 1u<<1,
  WR_ZDOUBLE   = 1u<<2,
  WR_ZMISALIGN = 1u<<3,
};

static volatile uint16_t enc_cnt_wrap = 0x10000u;


#define DBG_RING_SZ 256u
static volatile uint32_t dbg_w = 0, dbg_r = 0, dbg_printed = 0;
static dbg_edge_t dbg_ring[DBG_RING_SZ];

static inline void dbg_push_isr(char src, uint16_t prev, uint16_t now, int16_t d16,
                                int8_t dir, uint8_t cr1dir, uint8_t ab) {
  if (dbg_printed >= ENC_DIR_DEBUG_MAX) return;           /* stop capturing */
  uint32_t w = dbg_w + 1u;
  if ((w - dbg_r) >= DBG_RING_SZ) return;                 /* drop if full */
  uint32_t idx = (dbg_w & (DBG_RING_SZ - 1u));
  dbg_ring[idx].t_ms    = HAL_GetTick();
  dbg_ring[idx].src     = src;
  dbg_ring[idx].cnt_prev= prev;
  dbg_ring[idx].cnt_now = now;
  dbg_ring[idx].d16     = d16;
  dbg_ring[idx].dir     = dir;
  dbg_ring[idx].cr1_dir = cr1dir;
  dbg_ring[idx].ab      = ab;
  dbg_w = w;
}

static void dbg_drain_print_main(void) {
  while ((dbg_r != dbg_w) && (dbg_printed < ENC_DIR_DEBUG_MAX)) {
    uint32_t idx = (dbg_r & (DBG_RING_SZ - 1u));
    const dbg_edge_t e = dbg_ring[idx];
    dbg_r++;
    dbg_printed++;
    printf("DIRDBG #%lu t=%lums CC%c CNT:%u->%u d=%d dir=%s CR1.DIR=%u AB=%u\n",
           (unsigned long)dbg_printed,
           (unsigned long)e.t_ms,
           e.src,
           (unsigned)e.cnt_prev, (unsigned)e.cnt_now, (int)e.d16,
           (e.dir>0?"FWD":"BWD"),
           (unsigned)e.cr1_dir,
           (unsigned)e.ab);
  }
}
#else
static inline void dbg_push_isr(char src, uint16_t prev, uint16_t now, int16_t d16,
                                int8_t dir, uint8_t cr1dir, uint8_t ab) { (void)src;(void)prev;(void)now;(void)d16;(void)dir;(void)cr1dir;(void)ab; }
static inline void dbg_drain_print_main(void) { }
#endif /* ENC_DIR_DEBUG */

/* ============================ Helpers ================================== */

static inline float scale_feat(int j, float x) {
  float y = (x - MODEL_FEAT_MIN[j]) * MODEL_FEAT_SCALE[j];
  if (y < 0.f) y = 0.f;
  if (y > 1.f) y = 1.f;
  return y;
}

/* Pin read helpers (CubeMX symbols: ENC_A_GPIO_Port/Pin, ENC_B_...) */
static inline uint8_t enc_read_A(void) {
  return (HAL_GPIO_ReadPin(ENC_A_GPIO_Port, ENC_A_Pin) != GPIO_PIN_RESET) ? 1u : 0u;
}
static inline uint8_t enc_read_B(void) {
  return (HAL_GPIO_ReadPin(ENC_B_GPIO_Port, ENC_B_Pin) != GPIO_PIN_RESET) ? 1u : 0u;
}
static inline uint8_t enc_read_AB(void) {
  const uint8_t a = enc_read_A();
  const uint8_t b = enc_read_B();
  return (uint8_t)((a << 1) | b);  /* Gray digit: 0,1,3,2 */
}

static inline void push_event_isr(int delta, int z, uint16_t ccr_sample,
                                  uint8_t src, uint8_t ab_state) {
  uint32_t next = (event_write + 1u) & EVENT_IDX_MASK;
  if (next == event_read) { event_drops++; return; }
  encoder_event_t *e = &event_buffer[event_write];
  e->timestamp_ms = HAL_GetTick();
  e->ccr          = ccr_sample;
  e->delta        = (int8_t)delta;
  e->z_pulse      = (uint8_t)z;
  e->src          = src;
  e->ab_state     = ab_state;
  event_write = next;
}

/* Optional: scrub non-index TRG flags so TRG_CCU doesn’t re-fire */
static inline void scrub_trg_flags(void) {
  uint32_t sr = TIM1->SR;
  if (sr & TIM_SR_TIF)   { __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_TRIGGER);
                           __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_TIF); }
  if (sr & TIM_SR_COMIF) { __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_COM);
                           __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_COMIF); }
}

/* derive ±1 direction from counter delta (CCR is a CNT snapshot) */
static inline int8_t dir_from_cnt_delta(uint16_t now, uint16_t prev)
{
  uint16_t wrap = enc_cnt_wrap;
  uint16_t half = wrap >> 1;
  uint16_t d = (uint16_t)(now - prev);   // modulo wrap naturally
  if (d == 0) return enc_latched_dir;    // same CNT twice -> keep last
  return (d < half) ? +1 : -1;           // if crossed wrap, treat as negative
}

/* ======================== IRQ Drain (encoder) ========================== */
#if ENC_IS_LIVE
/* ISR-side last AB to build a clean Gray stream by toggling the seen channel */
static volatile uint8_t last_ab_isr = 0;

void EncSampler_EncoderIRQ_Drain(void) {
  for (int guard = 0; guard < 64; ++guard) {
    const uint32_t sr = TIM1->SR;
    uint32_t pending = sr & (TIM_SR_CC1IF | TIM_SR_CC2IF |
                             TIM_SR_CC1OF | TIM_SR_CC2OF);
#if HAVE_Z_INDEX && !FORCE_IGNORE_Z && defined(TIM_SR_IDXF)
    pending |= (sr & TIM_SR_IDXF);
#endif
    if (!pending) break;

    /* Overruns */
    if (sr & TIM_SR_CC1OF) { cc1_overruns++; __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC1OF); }
    if (sr & TIM_SR_CC2OF) { cc2_overruns++; __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC2OF); }

    /* ---- Z / index FIRST ---- */
#if HAVE_Z_INDEX && defined(TIM_SR_IDXF)
    if (sr & TIM_SR_IDXF) {
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_IDX);
# ifdef TIM_SR_IDXF
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
# endif
      z_isr_seen++; z_diag_isr_seen = z_isr_seen;

# if !FORCE_IGNORE_Z
      const uint32_t now_ms = HAL_GetTick();
      const int32_t  dt_ms  = (int32_t)(now_ms - z_last_ms_isr);
      if ((dt_ms >= (int32_t)Z_SOFT_DEBOUNCE_MS) &&
          (ab_edges_since_z_isr >= Z_MIN_AB_EDGES)) {
        const uint16_t ccrz = (uint16_t)TIM1->CNT; /* CNT is fine here */
        const uint8_t  abz  = last_ab_isr;         /* latched Gray */
        push_event_isr(0, 1, ccrz, 3, abz);
        z_last_ms_isr = now_ms;
        ab_edges_since_z_isr = 0;
        z_isr_accepted++; z_diag_isr_accepted = z_isr_accepted;
        z_diag_ab_since_isr = ab_edges_since_z_isr;
      }
# endif
    }
#endif /* Z */

    /* ---- A (CC1) ---- */
    if (sr & TIM_SR_CC1IF) {
      const uint16_t ccr1    = (uint16_t)TIM1->CCR1;
      const uint16_t prevcnt = last_cnt_isr;
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC1);
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC1OF);

      const uint8_t prev_ab = last_ab_isr;
      const uint8_t ab      = (uint8_t)(prev_ab ^ 0x2u);   /* toggle A bit (bit1) */

      int8_t dir  = dir_from_cnt_delta(ccr1, prevcnt);
#if ENC_DIR_REVERSED
      dir = -dir;
#endif
      last_cnt_isr = ccr1;
      last_ab_isr  = ab;
      enc_latched_dir = dir;

      /* debug capture (compare to CR1.DIR snapshot only for visibility) */
      dbg_push_isr('A', prevcnt, ccr1, (int16_t)((uint16_t)(ccr1 - prevcnt)),
                   dir, (uint8_t)((TIM1->CR1 & TIM_CR1_DIR)?1u:0u), ab);

      push_event_isr(dir, 0, ccr1, 1, ab);
      ab_edges_since_z_isr++; z_diag_ab_since_isr = ab_edges_since_z_isr;
    }

    /* ---- B (CC2) ---- */
    if (sr & TIM_SR_CC2IF) {
      const uint16_t ccr2    = (uint16_t)TIM1->CCR2;
      const uint16_t prevcnt = last_cnt_isr;
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC2);
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC2OF);

      const uint8_t prev_ab = last_ab_isr;
      const uint8_t ab      = (uint8_t)(prev_ab ^ 0x1u);   /* toggle B bit (bit0) */

      int8_t dir  = dir_from_cnt_delta(ccr2, prevcnt);
#if ENC_DIR_REVERSED
      dir = -dir;
#endif
      last_cnt_isr = ccr2;
      last_ab_isr  = ab;
      enc_latched_dir = dir;

      dbg_push_isr('B', prevcnt, ccr2, (int16_t)((uint16_t)(ccr2 - prevcnt)),
                   dir, (uint8_t)((TIM1->CR1 & TIM_CR1_DIR)?1u:0u), ab);

      push_event_isr(dir, 0, ccr2, 2, ab);
      ab_edges_since_z_isr++; z_diag_ab_since_isr = ab_edges_since_z_isr;
    }

    scrub_trg_flags();
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_TERRF | TIM_SR_IERRF);
  }
  __DSB();
}
#endif /* ENC_IS_LIVE */

/* ============================ Public API =============================== */

void EncSampler_Init(void) {
  memset(&enc_state, 0, sizeof(enc_state));
  enc_state.last_update_ms = HAL_GetTick();
  enc_state.baseline_interval = 10.0f;

  /* Seed GRAY from real pins so first row is consistent with physical phase */
  enc_state.last_AB_state = (enc_read_AB() & 0x3u);
#if ENC_IS_LIVE
  last_ab_isr   = enc_state.last_AB_state;
  last_cnt_isr  = (uint16_t)TIM1->CNT;     /* seed CNT baseline for deltas */
#endif

  printf("ENC: EDGE_MODE=BOTHEDGE -> EDGES/REV=%lu (CPR=%lu)\n",
         (unsigned long)QUAD_EDGES_PER_REV, (unsigned long)CPR);
  printf("Z THRESHOLDS: MIN_AB=%lu  MISS_EDGE_LIMIT=%lu  DOUBLE_GAP=%lu  MISS_MS=%lu  DEBOUNCE_MS=%lu\n",
         (unsigned long)Z_MIN_AB_EDGES, (unsigned long)Z_MISS_EDGE_LIMIT,
         (unsigned long)Z_MIN_GAP_EDGES, (unsigned long)Z_MISS_MS_LIMIT,
         (unsigned long)Z_SOFT_DEBOUNCE_MS);
  printf("EVBUF: %lu events × %lu bytes = %lu KiB\r\n",
         (unsigned long)EVENT_BUFFER_SIZE,
         (unsigned long)sizeof(encoder_event_t),
         (unsigned long)((EVENT_BUFFER_SIZE * sizeof(encoder_event_t)) / 1024));
}

void EncSampler_TIM7_Callback(void) { tim7_ticks++; }

/* ======================== Main-side processing ========================= */
#if ENC_IS_LIVE
void EncSampler_Process(void) {
  static uint8_t  win_fill = 0;
  static uint32_t last_ms  = 0;

  static uint8_t  z_latch = 0;
  static uint32_t steps_since_z = 0;

  static uint32_t gray_skip2 = 0;
  static uint8_t  last_src = 0;

  static uint32_t rule_flags_live = 0;
  static uint32_t last_z_ms = 0;

  while (event_read != event_write) {
    encoder_event_t evt = event_buffer[event_read];
    event_read = (event_read + 1u) & EVENT_IDX_MASK;

    /* Apply direction to position (0 delta = Z-only) */
    if (evt.delta != 0) {
      enc_state.current_position += evt.delta;
    }

    if (evt.z_pulse) {
      enc_state.z_count++;
      z_latch = 1u;  /* apply to next AB row */
    }

    const uint8_t is_ab_edge = (evt.src == 1u) || (evt.src == 2u);
    if (!is_ab_edge)
      continue;

    const uint8_t current_GRAY = (evt.ab_state & 0x3u);

    const uint8_t dir_fwd = (evt.delta > 0);
    const uint8_t dir_bwd = (evt.delta < 0);

    const uint8_t chanZ = z_latch;
    z_latch = 0u;

    const uint8_t src_A = (evt.src == 1u);
    const uint8_t src_B = (evt.src == 2u);

    const uint8_t is_same_src = (last_src != 0 && evt.src == last_src) ? 1u : 0u;

    /* -------- timing → SCR (ms only) -------- */
    const uint32_t now_ms = evt.timestamp_ms;
    int32_t dms = (int32_t)(now_ms - last_ms);
    if (dms <= 0) dms = 1;
    const float dt_ms = (float)dms;

    if (enc_state.baseline_interval < 1.0f) {
      enc_state.baseline_interval = dt_ms;
    }
    const float ratio = dt_ms / enc_state.baseline_interval;
    enc_state.speed_change_rate = fabsf(ratio - 1.0f);
    enc_state.baseline_interval = 0.9f * enc_state.baseline_interval + 0.1f * dt_ms;

    last_ms  = now_ms;

    /* ------------------- Z health rules ------------------- */
    uint8_t packZ = 0u;
    if (chanZ) {
      if (steps_since_z < Z_MIN_GAP_EDGES) {
        rule_flags_live |= WR_ZDOUBLE;      /* flag only */
      }
      packZ = 1u;                            /* always pack Z row */
      last_z_ms = now_ms;
      steps_since_z = 0;                     /* reset gap counter */
    } else {
      steps_since_z++;
    }

    if (steps_since_z > Z_MISS_EDGE_LIMIT) {
      rule_flags_live |= WR_ZMISS;
    }
#if (Z_MISS_MS_LIMIT > 0)
    if (last_z_ms != 0u && (uint32_t)(now_ms - last_z_ms) > (uint32_t)Z_MISS_MS_LIMIT) {
      rule_flags_live |= WR_ZMISS;
    }
#endif

    /* -------------------- Pack features ------------------- */
    /* adjacent: neighbor on Gray ring if exactly one bit changed */
    const uint8_t prev_gray = enc_state.last_AB_state;
    const uint8_t diff = (prev_gray ^ current_GRAY) & 3u;
    const uint8_t adjacent = (uint8_t)((diff == 1u) || (diff == 2u));

    float *f = feat_win[win_fill];
    f[0] = scale_feat(0, (float)current_GRAY);      /* AB_State (Gray digit)   */
    f[1] = scale_feat(1, (float)src_A);             /* SRC_A                   */
    f[2] = scale_feat(2, (float)src_B);             /* SRC_B                   */
    f[3] = scale_feat(3, (float)dir_fwd);           /* dir_fwd                 */
    f[4] = scale_feat(4, (float)dir_bwd);           /* dir_bwd                 */
    f[5] = scale_feat(5, enc_state.speed_change_rate); /* SCR                  */
    f[6] = scale_feat(6, (float)packZ);             /* Z (latched to next AB)  */
    f[7] = scale_feat(7, (float)steps_since_z);     /* SSZ                     */
    f[8] = scale_feat(8, (float)is_same_src);       /* same_src                */
    f[9] = scale_feat(9, (float)adjacent);          /* adjacent (neighbor?)    */

    if (is_same_src) { gray_skip2++; }
    last_src = evt.src;

#if ENABLE_TRACE_WIN
    trace_ab [wf_w][win_fill] = current_GRAY;
    trace_src[wf_w][win_fill] = evt.src;
    trace_z  [wf_w][win_fill] = packZ;
#endif

    /* Commit row */
    win_fill++;
    enc_state.last_AB_state = current_GRAY;  /* keep Gray state */
    enc_state.last_update_ms = now_ms;

    if (win_fill >= SEQ_LEN) {
      memcpy(win_fifo[wf_w], &feat_win[0][0], sizeof(win_fifo[0]));
      const uint32_t flags = ((gray_skip2 >= 2u) ? WR_SKIP2 : 0u) | rule_flags_live;

      flags_fifo[wf_w] = flags;
      enc_rule_flags   = flags;

      wf_w = (wf_w + 1u) & (WINFIFO - 1u);
      if (wf_count < WINFIFO) wf_count++; else wf_r = (wf_r + 1u) & (WINFIFO - 1u);

      win_ready = wf_count;
      win_total++;

      /* reset per-window accumulators */
      win_fill = 0;
      gray_skip2 = 0;
      rule_flags_live = 0;
      last_src = 0;
    }
  }

  /* drain a few debug lines (non-ISR) */
  dbg_drain_print_main();
}
#endif /* ENC_IS_LIVE */

/* =============================== Copy ================================== */

int EncSampler_CopyWindowLinear(float *dst, uint32_t *out_flags) {
  /* Copy payload under IRQ mask BEFORE releasing the slot to avoid overwrite */
  float    scratch[SEQ_LEN * FEAT_DIM];
  uint32_t flags;

  __disable_irq();
  if (wf_count == 0) { __enable_irq(); return -1; }

  const uint8_t r = wf_r;

  /* copy out while protected */
  memcpy(scratch, win_fifo[r], sizeof(win_fifo[0]));
  flags = flags_fifo[r];

#if ENABLE_TRACE_WIN
  memcpy(last_pop_ab , trace_ab [r], SEQ_LEN);
  memcpy(last_pop_src, trace_src[r], SEQ_LEN);
  memcpy(last_pop_z  , trace_z  [r], SEQ_LEN);
#endif

  /* now release the slot */
  wf_r = (wf_r + 1u) & (WINFIFO - 1u);
  wf_count--;
  win_ready = wf_count;
  __enable_irq();

  memcpy(dst, scratch, sizeof(win_fifo[0]));

  win_rule_flags = flags;
  if (out_flags) *out_flags = flags;
  return 0;
}

/* =============================== Stop / Flush =========================== */

void EncSampler_StopHardware(void) {
  __disable_irq();

  if (htim1.Instance) {
    __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2 | TIM_IT_UPDATE | TIM_IT_TRIGGER | TIM_IT_COM);
#ifdef TIM_IT_IDX
    __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_IDX);
#endif
    __HAL_TIM_DISABLE(&htim1);

    __HAL_TIM_CLEAR_FLAG(&htim1,
      TIM_SR_CC1IF | TIM_SR_CC1OF |
      TIM_SR_CC2IF | TIM_SR_CC2OF |
      TIM_SR_UIF   | TIM_SR_TIF   | TIM_SR_COMIF);
#ifdef TIM_SR_IDXF
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
#endif
  }

#ifdef TIM1_CC_IRQn
  NVIC_DisableIRQ(TIM1_CC_IRQn);
#endif
#if defined(TIM1_TRG_CCU_IRQn)
  NVIC_DisableIRQ(TIM1_TRG_CCU_IRQn);
#elif defined(TIM1_TRG_COM_IRQn)
  NVIC_DisableIRQ(TIM1_TRG_COM_IRQn);
#endif

  __enable_irq();
}

void EncSampler_FlushWindows(void) {
  __disable_irq();

  wf_w = 0; wf_r = 0; wf_count = 0;
  win_ready = 0; win_total = 0;

  event_read = 0; event_write = 0; event_drops = 0;

  z_last_ms_isr = 0;
  ab_edges_since_z_isr = 0;
  z_isr_seen = 0;
  z_isr_accepted = 0;
  z_diag_isr_seen = 0;
  z_diag_isr_accepted = 0;
  z_diag_ab_since_isr = 0;
  z_diag_steps_since_main = 0;
  z_diag_last_z_ms = 0;

#if ENC_DIR_DEBUG
  dbg_w = dbg_r = dbg_printed = 0;
#endif

#if ENABLE_TRACE_WIN
  memset(last_pop_ab , 0, sizeof(last_pop_ab));
  memset(last_pop_src, 0, sizeof(last_pop_src));
  memset(last_pop_z  , 0, sizeof(last_pop_z));
#endif

  __enable_irq();
}

#if ENABLE_TRACE_WIN
void EncSampler_DebugGetLastTrace(uint8_t *ab, uint8_t *src, uint8_t *z) {
  memcpy(ab , last_pop_ab , SEQ_LEN);
  memcpy(src, last_pop_src, SEQ_LEN);
  memcpy(z  , last_pop_z  , SEQ_LEN);
}
#else
void EncSampler_DebugGetLastTrace(uint8_t *ab, uint8_t *src, uint8_t *z) {
  if (ab)  memset(ab,  0, SEQ_LEN);
  if (src) memset(src, 0, SEQ_LEN);
  if (z)   memset(z,   0, SEQ_LEN);
}
#endif
