// enc_sampler.c — x4 BOTHEDGE encoder drain using CNT-delta direction (authoritative)
// - Direction comes from sign(CCRx - last_cnt_isr), with optional ENC_DIR_REVERSED.
// - Z/IDX handled first; enqueued with last latched Gray (no GPIO race).
// - AB Gray digit advanced deterministically by toggling the A/B bit per CCx.
// - Feature packing & flags compatible with previous code.
// - Debug ring (ENC_DIR_DEBUG) shows per-edge CNT deltas & CR1.DIR snapshot (comparison only).

#include "enc_sampler.h"
#include <string.h>
#include <math.h>
#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>
#include "model_meta.h"
#include "main.h"
#include "synthetic.h"
#include "stm32n6xx_hal.h"

