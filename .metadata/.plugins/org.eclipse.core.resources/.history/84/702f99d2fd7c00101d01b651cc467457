/* Globals for inference (shared with main.c via extern) */
extern float rolling_buf[20];
extern volatile uint8_t run_infer;
extern volatile uint32_t inf_total;
extern volatile float last_y[AI_NETWORK_OUT_1_SIZE];

/* State for feature engineering (persistent across inferences) */
static float prev_interval = 1.0f;  // Assume initial stable
static uint32_t steps_since_z = 0;
static uint8_t z_expected = 0;  // Simple: expect every ~2000 steps
static uint8_t z_overdue = 0;
static float revolution_progress = 0.0f;
static uint32_t cumulative_error = 0;
static int8_t direction = 1;  // 1 forward, -1 backward (detect from delta sign)
static uint8_t sequence_valid = 1;  // Assume valid
static float phase_lag = 0.0f;  // Simple avg
static float speed_change_rate = 0.0f;
static uint8_t speed_stable = 1;
static uint8_t speed_category = 2;  // Assume medium
static uint8_t recent_stability = 0;
static uint8_t state_change = 1;
static uint8_t valid = 1;
static uint32_t revolution = 0;

int acquire_and_process_data(ai_float* data[])
{
  if (!run_infer) return -1;

  ai_float* input_data = data[0];
  memset(input_data, 0, AI_NETWORK_IN_1_SIZE * sizeof(ai_float));

  // Compute features for each timestep in window
  for (int t = 0; t < 20; ++t) {
	  float delta = rolling_buf[t];  // Raw sample
    float interval_ratio = (prev_interval > 0) ? delta / prev_interval : 1.0f;  // Example
    prev_interval = delta;

    steps_since_z++;
    revolution_progress = (float)steps_since_z / 2000.0f;
    if (steps_since_z >= 2000) z_expected = 1;
    if (z_expected && !z_seen) z_overdue = 1;
    if (z_seen) {
      steps_since_z = 0;
      z_expected = 0;
      z_overdue = 0;
      revolution++;
      z_seen = 0;
    }

    direction = (delta > 0) ? 1 : -1;  // Simple sign
    speed_change_rate = abs(interval_ratio - 1.0f);  // Variation
    speed_stable = (speed_change_rate < 0.01) ? 1 : 0;
    // ... Compute other features similarly (Sequence_Valid from state transitions, etc.)

    // Fill timestep features (match training order)
    int offset = t * 25;
    input_data[offset + 0] = interval_ratio;  // Interval_Ratio
    input_data[offset + 1] = speed_stable;    // Speed_Stable
    // ... Fill all 25 (adjust indices from notebook)
    input_data[offset + 17] = (float)steps_since_z;  // Steps_Since_Z
    input_data[offset + 18] = z_expected;
    input_data[offset + 19] = z_overdue;
    input_data[offset + 20] = revolution_progress;
    input_data[offset + 21] = (float)cumulative_error;
    input_data[offset + 22] = phase_lag;
    // Categorical one-hot: e.g., Channel A=1 0 0, B=0 1 0, Z=0 0 1 (but since no Channel in input, pad or skip)
  }

  run_infer = 0;
  return 0;
}

int post_process(ai_float* data[])  // Changed to ai_float*
{
  /* Handle predictions (e.g., store last output) */
  ai_float* out = data[0];
  for (int i = 0; i < AI_NETWORK_OUT_1_SIZE; ++i) {
    last_y[i] = out[i];
  }
  inf_total++;  /* Increment inference count */

  return 0;
}
