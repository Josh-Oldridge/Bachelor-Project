#include "enc_sampler.h"
#include <string.h>
#include <math.h>
#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>
#include "model_meta.h"

#include "stm32n6xx_hal.h"   // for registers/macros

extern TIM_HandleTypeDef htim1;

#ifndef ENABLE_RAW_LOG
#define ENABLE_RAW_LOG 1
#endif

/* --- Public/live flags --- */
volatile uint32_t enc_rule_flags = 0;
volatile uint32_t win_rule_flags = 0;

/* --- Exposed state --- */
volatile uint32_t tim7_ticks = 0; // compatibility counter only
volatile uint32_t win_ready = 0;
volatile uint32_t win_total = 0;
volatile float    feat_win[MODEL_SEQ_LEN][MODEL_FEAT_DIM];

#define SEQ_LEN  (MODEL_SEQ_LEN)
#define FEAT_DIM (MODEL_FEAT_DIM)

/* --- Encoder state tracking --- */
typedef struct {
    int32_t  last_position;
    int32_t  current_position;
    uint8_t  last_AB_state;
    uint32_t z_count;
    float    speed_change_rate;   // |interval_ratio - 1|
    uint32_t last_update_ms;      // ms at last packed feature
    float    baseline_interval;   // EWMA baseline step interval (ms)
} encoder_state_t;

static encoder_state_t enc_state = {0};

/* --- Window FIFO (producer: EncSampler_Process, consumer: CopyWindow) --- */
#define WINFIFO_LOG2 2
#define WINFIFO      (1u << WINFIFO_LOG2)
static float    win_fifo[WINFIFO][SEQ_LEN * FEAT_DIM];
static uint32_t flags_fifo[WINFIFO];
static uint8_t  wf_w = 0, wf_r = 0, wf_count = 0;

/* --- Event ring from IRQ -> main --- */
typedef struct {
    int8_t   delta;         // +1 or -1 per edge, 0 for Z-only
    uint8_t  z_pulse;       // 1 if IDXF
    uint32_t timestamp_ms;  // HAL_GetTick() snapshot
} encoder_event_t;

#ifndef EVENT_BUFFER_SIZE
#define EVENT_BUFFER_SIZE 2048    // large enough for your peak edge rate
#endif

static encoder_event_t event_buffer[EVENT_BUFFER_SIZE];
static volatile uint32_t event_write = 0;
static volatile uint32_t event_read  = 0;
volatile uint32_t event_drops        = 0;   // for diagnostics

/* --- Gray code helpers: 00,01,11,10 encoded as 0,1,3,2 --- */
static inline uint8_t position_to_AB_state(int32_t pos) {
    static const uint8_t gray_lut[4] = {0,1,3,2};
    return gray_lut[(uint8_t)(pos & 3)];
}

/* --- Scaling helper --- */
static inline float scale_feat(int j, float x) {
    float y = (x - MODEL_FEAT_MIN[j]) * MODEL_FEAT_SCALE[j];
    if (y < 0.f) y = 0.f;
    if (y > 1.f) y = 1.f;
    return y;
}

/* ============================ IRQ side =================================== */

static inline void push_event_isr(int delta, int z)
{
    uint32_t next = (event_write + 1u) % EVENT_BUFFER_SIZE;
    if (next == event_read) { event_drops++; return; }
    encoder_event_t *e = &event_buffer[event_write];
    e->timestamp_ms = HAL_GetTick();   // cheap, SysTick based
    e->delta        = (int8_t)delta;
    e->z_pulse      = (uint8_t)z;
    event_write     = next;
}

/* Drain CC1/CC2/IDX flags: one queued event per set flag, with CCRx read
   to *really* clear CCxIF/CCxOF in input-capture/encoder mode. */
void EncSampler_EncoderIRQ_Drain(void)
{
    // Limit iterations per IRQ entry to avoid livelock if input chatters
    for (int guard = 0; guard < 32; ++guard) {
        uint32_t sr = TIM1->SR;
        uint32_t pending = sr & (TIM_SR_CC1IF | TIM_SR_CC2IF | TIM_SR_IDXF);
        if (pending == 0) break;

        // Direction at this instant
        int dir = (TIM1->CR1 & TIM_CR1_DIR) ? -1 : 1;

        if (sr & TIM_SR_CC1IF) {
            (void)TIM1->CCR1;                        // mandatory read
            __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC1);  // clear CC1IF
            __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC1OF);
            push_event_isr(dir, 0);
        }
        if (sr & TIM_SR_CC2IF) {
            (void)TIM1->CCR2;                        // mandatory read
            __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC2);  // clear CC2IF
            __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC2OF);
            push_event_isr(dir, 0);
        }
        if (sr & TIM_SR_IDXF) {
            __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_IDX);  // clear IDXF
            push_event_isr(0, 1);
        }

        // Clear transition/index errors if any
        __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_TERRF | TIM_SR_IERRF);
    }
}

/* ============================ Public API ================================= */

void EncSampler_Init(void)
{
    memset(&enc_state, 0, sizeof(enc_state));
    enc_state.last_update_ms   = HAL_GetTick();
    enc_state.baseline_interval = 10.0f;   // starting guess in ms (tuned)
}

/* Keep only for your rate print compatibility */
void EncSampler_TIM7_Callback(void) { tim7_ticks++; }

/* ============================ Main-side processing ======================= */

void EncSampler_Process(void)
{
    static uint8_t win_fill = 0;
    static uint8_t t_in_win = 0;   // window-local step index (0..SEQ_LEN-1)

    while (event_read != event_write) {
        encoder_event_t evt = event_buffer[event_read];
        event_read = (event_read + 1u) % EVENT_BUFFER_SIZE;

        /* Update software position */
        enc_state.current_position += evt.delta;

        /* Handle Z */
        if (evt.z_pulse) {
            enc_state.z_count++;
            // If you want to sync position on Z, do it here.
        }

        /* Gray-code derived AB and state change */
        uint8_t current_AB = position_to_AB_state(enc_state.current_position);
        uint8_t state_change = (current_AB != enc_state.last_AB_state) || evt.z_pulse;

        if (state_change) {
            /* Direction flags from delta */
            uint8_t dir_fwd = (evt.delta > 0);
            uint8_t dir_bwd = (evt.delta < 0);

            /* Channel bits from Gray state */
            uint8_t A = (current_AB >> 1) & 1u;
            uint8_t B =  current_AB       & 1u;

            /* Edge presence (align with your synthetic training = every step) */
            uint8_t edge_present = 1u;

            /* Speed change rate based on inter-step time (EWMA baseline) */
            uint32_t now_ms = evt.timestamp_ms;
            uint32_t dt = now_ms - enc_state.last_update_ms;   // wraps ok for ms tick
            if (dt == 0) dt = 1;
            float ratio = ((float)dt) / (enc_state.baseline_interval > 0.5f ? enc_state.baseline_interval : (float)dt);
            enc_state.speed_change_rate = fabsf(ratio - 1.0f);
            // EWMA baseline (slowly track typical step interval)
            enc_state.baseline_interval = 0.9f * enc_state.baseline_interval + 0.1f * (float)dt;

            /* Pack scaled features (match model_meta order) */
            volatile float* f = feat_win[win_fill];
            f[0] = scale_feat(0, (float)current_AB);            // AB_State (0..3)
            f[1] = scale_feat(1, 1.0f);                         // State_Change (always 1 on a packed row)
            f[2] = scale_feat(2, (float)dir_fwd);
            f[3] = scale_feat(3, (float)dir_bwd);
            f[4] = scale_feat(4, enc_state.speed_change_rate);  // Speed_Change_Rate
            f[5] = scale_feat(5, (float)A);
            f[6] = scale_feat(6, (float)B);
            f[7] = scale_feat(7, (float)evt.z_pulse);           // Channel_Z (0/1)
            f[8] = scale_feat(8, (float)edge_present);          // Edge_RISING → edge_present
            f[9] = scale_feat(9, (float)t_in_win);              // Steps_Since_Z → window-local step idx

            win_fill++;
            t_in_win++;
            enc_state.last_AB_state = current_AB;
            enc_state.last_update_ms = now_ms;

            if (win_fill >= SEQ_LEN) {
                /* Emit a complete window into FIFO */
                uint32_t idx = 0;
                for (int t = 0; t < SEQ_LEN; ++t) {
                    volatile float* src = feat_win[t];
                    for (int j = 0; j < FEAT_DIM; ++j)
                        win_fifo[wf_w][idx++] = src[j];
                }

                flags_fifo[wf_w] = 0;  // set any rule flags here if desired

                // Advance FIFO
                wf_w = (wf_w + 1u) & (WINFIFO - 1u);
                if (wf_count < WINFIFO) wf_count++;
                else                    wf_r = (wf_r + 1u) & (WINFIFO - 1u);

                win_ready = wf_count;
                win_total++;
                win_fill = 0;
                t_in_win = 0;

#if ENABLE_RAW_LOG
                printf("CLEAN_SIGNALS [WIN #%lu]: AB_end=%u z_total=%lu drops=%lu\r\n",
                       (unsigned long)win_total, (unsigned)current_AB,
                       (unsigned long)enc_state.z_count,
                       (unsigned long)event_drops);
#endif
            }
        }
    }
}

int EncSampler_CopyWindowLinear(float* dst, uint32_t* out_flags)
{
    EncSampler_Process();  // drain any pending events

    __disable_irq();
    if (wf_count == 0) { __enable_irq(); return -1; }
    uint8_t r = wf_r;
    wf_r = (wf_r + 1u) & (WINFIFO - 1u);
    wf_count--;
    win_ready = wf_count;
    uint32_t flags = flags_fifo[r];
    __enable_irq();

    for (int i = 0; i < (SEQ_LEN * FEAT_DIM); ++i)
        dst[i] = win_fifo[r][i];

    win_rule_flags = flags;
    if (out_flags) *out_flags = flags;
    return 0;
}
