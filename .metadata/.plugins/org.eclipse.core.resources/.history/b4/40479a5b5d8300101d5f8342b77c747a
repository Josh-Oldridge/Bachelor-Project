#include ""
#include "model_meta.h"
#include <string.h>
#include <stdbool.h>

extern volatile uint32_t win_ready;
extern volatile uint32_t win_total;

/* If your feature window buffer has a public symbol, reuse it.
   Otherwise declare a local and provide an accessor used by your AI code. */
static float synth_win[MODEL_SEQ_LEN][MODEL_FEAT_DIM];

static inline float scale_feat(int idx, float v) {
  // (v - min) * scale; your exported mins are all 0.0f
  return (v - MODEL_FEAT_MIN[idx]) * MODEL_FEAT_SCALE[idx];
}

static inline int bitA(int ab) { return (ab >> 1) & 1; } // AB bits: A=MSB, B=LSB
static inline int bitB(int ab) { return ab & 1; }

/* Gray forward order in numeric AB_State coding: 0,1,3,2,0,1,3,2,... */
static const uint8_t GRAY_FWD[4] = {0,1,3,2};

/* Fill one row (t) of feature vector with *unscaled* values; we apply scaling here. */
static void put_row(int t,
                    int AB_State,
                    int State_Change,
                    int dir_fwd,
                    int dir_bwd,
                    float Speed_Change_Rate,
                    int chA, int chB, int chZ,
                    int edge_rising,
                    int steps_since_z)
{
  float *dst = synth_win[t];

  // order MUST match model_meta.h (your exported arrays)
  dst[0] = scale_feat(0,  (float)AB_State);          // AB_State
  dst[1] = (float)State_Change;                      // State_Change (binary)
  dst[2] = (float)dir_fwd;                           // Direction_forward
  dst[3] = (float)dir_bwd;                           // Direction_backward
  dst[4] = scale_feat(4,  Speed_Change_Rate);        // Speed_Change_Rate
  dst[5] = (float)chA;                               // Channel_A
  dst[6] = (float)chB;                               // Channel_B
  dst[7] = (float)chZ;                               // Channel_Z
  dst[8] = (float)edge_rising;                       // Edge_RISING
  dst[9] = scale_feat(9,  (float)steps_since_z);     // Steps_Since_Z
}

/* PUBLIC: make a perfect window and expose it to your inference loop.
   - rising_falling: true → include both edge polarities (matches training best)
                      false → keep only rising events (matches TIM IC “RISING” only)
   - start_state   : 0|1|3|2 (AB numeric)
   - steps0        : starting Steps_Since_Z counter (e.g., 100)
   - forward       : true = forward rotation sequence; false = backward
*/
void EncSynth_MakePerfectWindow(bool rising_falling,
                                int  start_state,
                                int  steps0,
                                bool forward)
{
  int T = MODEL_SEQ_LEN;
  int ab = start_state;
  // Find index in Gray ring
  int ring = 0;
  for (int i=0;i<4;i++) if (GRAY_FWD[i]==ab) { ring=i; break; }

  int steps = steps0;
  int prev_ab = ab;

  int t = 0;
  while (t < T) {
    // advance one Gray-neighbor step (+1 or -1 around the ring)
    ring = forward ? (ring + 1) & 3 : (ring + 3) & 3;
    int nxt = GRAY_FWD[ring];

    // which channel toggled? (exactly one bit differs in Gray neighbor)
    int a0 = bitA(ab), b0 = bitB(ab);
    int a1 = bitA(nxt), b1 = bitB(nxt);

    int chA = 0, chB = 0, chZ = 0;
    int edge_rising = 0;

    if (a1 != a0) {
      chA = 1;
      edge_rising = (a0==0 && a1==1);
    } else {
      chB = 1;
      edge_rising = (b0==0 && b1==1);
    }

    // Device derive logic (match your notebook): diff & 3
    // NOTE: This will yield 1 or 3 for some steps, and 2 for others (which you treat as "skip2").
    int diff = (nxt - prev_ab) & 3;
    int dir_fwd = (diff == 1);
    int dir_bwd = (diff == 3);

    // State_Change is 1 for every event in this synthetic stream
    int state_change = (nxt != prev_ab);

    // we *don’t* put Z inside the window (keeps class away from z_index)
    // Steps_Since_Z increases monotonically
    steps += 1;

    // simple constant-speed → SCR = 0
    float scr = 0.0f;

    put_row(t, nxt, state_change, dir_fwd, dir_bwd, scr,
            chA, chB, chZ, edge_rising, steps);

    prev_ab = nxt;
    ab = nxt;
    t++;

    if (!rising_falling) {
      // If we want “rising-only”, skip the *next* neighbor whenever it would be a falling edge
      // by fast-forwarding through it without recording a row. We still keep counters coherent.
      // Peek next neighbor:
      int ring2 = forward ? ((ring + 1) & 3) : ((ring + 3) & 3);
      int peek  = GRAY_FWD[ring2];
      int a2 = bitA(peek), b2 = bitB(peek);
      int chA2 = (a2 != a1), chB2 = (b2 != b1);
      int edge_rising2 = (chA2 ? (a1==0 && a2==1) : (b1==0 && b2==1));

      if (!edge_rising2) {
        // consume this falling step silently (it *happens* physically)
        ring = ring2;
        prev_ab = ab;
        ab = peek;
        steps += 1;
      }
    }
  }

  // Expose the window to your usual consumer
  // If your inference path pulls from an internal FIFO, copy synth_win there instead.
  // For the simplest smoke test, pretend one window is ready now:
  win_ready = 1;
  win_total += 1;
}

/* OPTIONAL: pretty-print helpers to mirror your WIN AB / WIN SRC lines for sanity */
void EncSynth_DebugPrint(void) {
  char ab_s[MODEL_SEQ_LEN+1] = {0};
  char ch_s[MODEL_SEQ_LEN+1] = {0};
  for (int i=0;i<MODEL_SEQ_LEN;i++) {
    int ab_scaled = (int)(synth_win[i][0] / MODEL_FEAT_SCALE[0] + 0.5f); // inverse of scale
    int chA = (synth_win[i][5] > 0.5f);
    int chB = (synth_win[i][6] > 0.5f);
    ab_s[i] = "0123"[ab_scaled & 3];
    ch_s[i] = chA ? 'A' : (chB ? 'B' : 'Z');
  }
  printf("WIN AB : %s\r\n", ab_s);
  printf("WIN SRC: %s\r\n", ch_s);
}
