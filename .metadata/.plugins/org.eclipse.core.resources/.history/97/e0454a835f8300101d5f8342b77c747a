#include <stdint.h>
#include <stdbool.h>
#include <stdio.h>
#include <string.h>

#include "model_meta.h"   // MODEL_SEQ_LEN / MODEL_FEAT_DIM / MODEL_FEAT_MIN / MODEL_FEAT_SCALE
#include "synthetic.h"

/* Internal flat buffer (T×F) already scaled like firmware expects. */
static float g_synth_flat[MODEL_SEQ_LEN * MODEL_FEAT_DIM];

/* Keep a simple trace for debug prints */
static uint8_t s_ab[MODEL_SEQ_LEN];   /* 0,1,3,2 */
static uint8_t s_src[MODEL_SEQ_LEN];  /* 1='A', 2='B' */
static uint8_t s_z[MODEL_SEQ_LEN];    /* 0/1 */

static const uint8_t GRAY_FWD[4] = {0,1,3,2};
static const uint8_t GRAY_BWD[4] = {0,2,3,1};

/* Helpers to get A/B bits from Gray state (00,01,11,10 mapped as 0,1,3,2) */
static inline int bitA(uint8_t g) { return (g == 0 || g == 1) ? 0 : 1; }
static inline int bitB(uint8_t g) { return (g == 0 || g == 3) ? 0 : 1; }

void EncSynth_MakePerfectWindow(int rising_falling, int start_state,
                                int steps0, int forward)
{
  if (start_state < 0) start_state = 0;
  if (start_state > 3) start_state = 3;
  if (steps0 < 0) steps0 = 0;

  const uint8_t *gray = forward ? GRAY_FWD : GRAY_BWD;

  int idx = 0;
  uint8_t prev = (uint8_t)start_state;
  int ssz = steps0;

  for (int t = 0; t < MODEL_SEQ_LEN; ++t) {
    uint8_t g = gray[( (int)(start_state + t) ) & 3];

    /* AB_State 0..3; State_Change: 1 when state changes in this sample */
    float AB   = (float)g;
    float dchg = (t == 0) ? 1.f : ((g != prev) ? 1.f : 0.f);

    float dirF = forward ? 1.f : 0.f;
    float dirB = forward ? 0.f : 1.f;

    float SCR  = 0.f;   /* steady */
    float A    = (float)bitA(g);
    float B    = (float)bitB(g);
    float Z    = 0.f;   /* no Z pulses here by default */

    /* Edge_RISING: if both edges requested, mark rising on every step.
       If rising-only mode, still mark rising on state change.
       (This matches training “perfect” windows with clean transitions.) */
    float ER   = rising_falling ? 1.f : ((t == 0) ? 1.f : ((g != prev) ? 1.f : 0.f));

    float SSZ  = (float)(ssz++);

    /* Keep a tiny trace for printing */
    s_ab[t]  = g & 3u;
    s_src[t] = (t == 0) ? 0 :   /* first row no specific channel */
               ((bitA(prev) != bitA(g)) ? 1 : 2); /* 1=A, 2=B */
    s_z[t]   = 0;

    /* Pack in model feature order and scale to [0,1] using MODEL_FEAT_MIN/SCALE */
    const float raw[MODEL_FEAT_DIM] = {
      AB, dchg, dirF, dirB, SCR, A, B, Z, ER, SSZ
    };

    for (int f = 0; f < MODEL_FEAT_DIM; ++f) {
      float y = (raw[f] - MODEL_FEAT_MIN[f]) * MODEL_FEAT_SCALE[f];
      if (y < 0.f) y = 0.f;
      if (y > 1.f) y = 1.f;
      g_synth_flat[idx++] = y;
    }

    prev = g;
  }
}

const float* EncSynth_GetFlat(void)
{
  return g_synth_flat;
}

void EncSynth_DebugPrint(void)
{
  char ab_s[MODEL_SEQ_LEN+1], src_s[MODEL_SEQ_LEN+1], z_s[MODEL_SEQ_LEN+1];
  for (int i = 0; i < MODEL_SEQ_LEN; ++i) {
    /* Render AB as 0/1/2/3 (your code uses 0,1,2,3 directly) */
    switch (s_ab[i] & 3u) {
      case 0: ab_s[i]='0'; break;
      case 1: ab_s[i]='1'; break;
      case 2: ab_s[i]='2'; break;
      default: ab_s[i]='3'; break;
    }
    src_s[i] = (s_src[i]==1?'A':(s_src[i]==2?'B':'?'));
    z_s[i]   = s_z[i] ? '^' : '.';
  }
  ab_s[MODEL_SEQ_LEN] = src_s[MODEL_SEQ_LEN] = z_s[MODEL_SEQ_LEN] = '\0';

  printf("WIN AB : %s\r\n", ab_s);
  printf("WIN SRC: %s\r\n", src_s);
  printf("WIN  Z : %s\r\n", z_s);
}
