#ifndef INC_ENC_SAMPLER_H_
#define INC_ENC_SAMPLER_H_

#include <stdint.h>
#include "model_meta.h"   // MODEL_SEQ_LEN / MODEL_FEAT_DIM

#ifdef __cplusplus
extern "C" {
#endif

/* ========= Public constants ========= */
#define SEQ_LEN   (MODEL_SEQ_LEN)
#define FEAT_DIM  (MODEL_FEAT_DIM)

/* Build-time options (safe defaults) */
#ifndef ENABLE_TRACE_WIN
#define ENABLE_TRACE_WIN 1   /* enable per-window AB/SRC/Z trace */
#endif
#ifndef ENC_IS_LIVE
#define ENC_IS_LIVE 1        /* live encoder vs synthetic feed */
#endif

/* Live/window rule flags exported to the app */
extern volatile uint32_t enc_rule_flags;   /* rolling/live flags */
extern volatile uint32_t win_rule_flags;   /* flags for the last window copied */

/* FIFO flow control */
extern volatile uint32_t win_ready;        /* # of windows available in FIFO */
extern volatile uint32_t win_total;        /* total produced windows */

/* Z-path diagnostics (consumed by the app logger) */
extern volatile uint32_t z_diag_isr_seen;          /* ISR: IDXF hits */
extern volatile uint32_t z_diag_isr_accepted;      /* ISR: Z accepted */
extern volatile uint32_t z_diag_ab_since_isr;      /* ISR: AB edges since Z */
extern volatile uint32_t z_diag_steps_since_main;  /* main: mirror of above */
extern volatile uint32_t z_diag_last_z_ms;         /* last accepted Z time */

/* Optional: show event drops in app if you want to log them */
extern volatile uint32_t event_drops;

/* ============================== API ============================= */
void EncSampler_Init(void);
void EncSampler_StopHardware(void);
void EncSampler_FlushWindows(void);

/* Call from the TIM1 IRQ handler (or an IRQ dispatcher) */
void EncSampler_EncoderIRQ_Drain(void);

/* Call regularly from the main context to consume events and build windows */
void EncSampler_Process(void);

/* Direction helpers */
int8_t EncSampler_GetLatchedDir(void);     /* last edge-latched direction (+1/-1) */
int8_t EncSampler_GetLastWindowDir(void);  /* summarized direction for last full window */

/* Copy the oldest ready window as a linear buffer (SEQ_LEN*FEAT_DIM floats).
   Returns 0 on success, -1 if no window available. If out_flags!=NULL, the
   same flags are also returned there. win_rule_flags is updated as well. */
int EncSampler_CopyWindowLinear(float *dst, uint32_t *out_flags);

/* Last-window trace (always available; stubbed when ENABLE_TRACE_WIN=0) */
void EncSampler_DebugGetLastTrace(uint8_t *ab, uint8_t *src, uint8_t *z);

#ifdef __cplusplus
}
#endif
#endif /* INC_ENC_SAMPLER_H_ */
