/**
 * @file    mem_diag.c
 * @brief   MSP stack watermarking and heap/section accounting utilities.
 * @details
 *   - Paints MSP stack early so high-water usage can be measured later.
 *   - Computes stack/heap usage without double counting.
 *   - Prints a RAM/AXISRAM map with section boundaries when available.
 */

#include "mem_diag.h"
#include "stm32n6xx_hal.h"
#include <stdio.h>
#include <sys/unistd.h>   // _sbrk
#include "core_cm55.h"    // __get_MSP()

/* ----- Linker symbols from STM32N657X0HXQ_LRUN.ld ----- */
extern uint8_t _estack;        /* end of RAM (stack top, highest addr) */
extern uint8_t _sstack;        /* stack bottom = _estack - _Min_Stack_Size */
extern uint8_t _end;           /* end of .bss/.data; start of heap */

extern uint8_t __ram_start__[], __ram_end__[];                  /* MEMORY(RAM) bounds */
extern uint8_t __axis_start__[] __attribute__((weak));          /* MEMORY(AXISRAM123456) bounds */
extern uint8_t __axis_end__[]   __attribute__((weak));

/* section bounds in RAM */
extern uint8_t __isr_start__[], __isr_end__[];
extern uint8_t __text_start__[], __text_end__[];
extern uint8_t __rodata_start__[], __rodata_end__[];
extern uint8_t _sdata[], _edata[];
extern uint8_t __bss_start__[], __bss_end__[];

/* your names for noncacheable + winring */
extern uint32_t __snoncacheable;   // start address anchor
extern uint32_t __enoncacheable;   // end   address anchor
extern uint8_t __winring_start__[] __attribute__((weak));
extern uint8_t __winring_end__[]   __attribute__((weak));

/* newlib sbrk hook (provided by HAL/retarget) */
extern void* _sbrk(ptrdiff_t incr);

/* Paint value for stack watermarking */
#ifndef STACK_WM_BYTE
#define STACK_WM_BYTE 0xA5
#endif

/* ----- Small helpers ----- */
static inline size_t udiff(const void* hi, const void* lo) {
  return (size_t)((uintptr_t)hi - (uintptr_t)lo);
}
static inline unsigned long span_bytes(const void* hi, const void* lo) {
  return (unsigned long)((uintptr_t)hi - (uintptr_t)lo);
}

/**
 * @brief Paint the unused lower MSP region with a known byte pattern.
 * @note  Leave a safety margin to avoid stomping current frames/ISRs.
 */
void MemDiag_Init(void)
{
  // Paint only the *unused* lower part of the MSP stack, not the live frames.
  uint32_t msp = __get_MSP();
  volatile uint8_t* bot = &_sstack;        // lowest stack address
  volatile uint8_t* top = &_estack;        // highest stack address

  // Leave a safety margin (current frames, interrupts, etc.)
  const uint32_t SAFETY = 256;             // adjust if you want (128..512)
  volatile uint8_t* safe_end = (volatile uint8_t*)((msp > SAFETY) ? (msp - SAFETY) : msp);

  if (safe_end < bot) safe_end = bot;
  if (safe_end > top) safe_end = top;

  for (volatile uint8_t* p = bot; p < safe_end; ++p) {
    *p = STACK_WM_BYTE;
  }
}

/**
 * @brief Compute current MSP usage and totals.
 * @param[out] used     Current MSP bytes used.
 * @param[out] total    Total MSP region bytes.
 * @param[out] free_now Current free bytes in MSP.
 */
static void stack_now(size_t* used, size_t* total, size_t* free_now)
{
  const uint32_t msp = __get_MSP();
  const uint8_t* top   = &_estack;  /* highest address */
  const uint8_t* bot   = &_sstack;  /* lowest address of stack region */
  const size_t   tot   = udiff(top, bot);

  size_t used_now;
  if (msp < (uint32_t)bot)        used_now = tot;     /* overflowed */
  else if (msp > (uint32_t)top)   used_now = 0;       /* not running on MSP? */
  else                            used_now = udiff(top, (void*)msp);

  if (used)    *used    = used_now;
  if (total)   *total   = tot;
  if (free_now)*free_now= (tot > used_now) ? (tot - used_now) : 0;
}

/**
 * @brief Scan the MSP region for the first overwritten byte (high-water mark).
 * @return Max MSP usage (bytes) since it was watermarked.
 */
static size_t stack_hwm(void)
{
  const uint8_t* p   = &_sstack;
  const uint8_t* end = &_estack;
  while ((p < end) && (*p == STACK_WM_BYTE)) p++;
  return udiff(end, p);
}

/**
 * @brief Heap usage from the program break (newlib _sbrk).
 * @param[out] used     Bytes allocated from heap base.
 * @param[out] total    Contiguous room from heap base to stack.
 * @param[out] free_now Remaining bytes before colliding with stack.
 */
static void heap_now(size_t* used, size_t* total, size_t* free_now)
{
  uint8_t* brk = (uint8_t*)_sbrk(0);
  const uint8_t* base  = &_end;
  const uint8_t* limit = &_sstack;   /* don’t collide with stack region */
  const size_t tot = udiff(limit, base);
  size_t used_now = (brk > base) ? (size_t)(brk - base) : 0;

  if (used)    *used    = used_now;
  if (total)   *total   = tot;
  if (free_now)*free_now= (used_now <= tot) ? (tot - used_now) : 0;
}

/**
 * @brief Return .data and .bss sizes (display purposes).
 */
static void static_sections(size_t* data_sz, size_t* bss_sz)
{
  if (data_sz) *data_sz = udiff(&_edata,       &_sdata);        // .data size
  if (bss_sz)  *bss_sz  = udiff(&__bss_end__,  &__bss_start__); // .bss size
}

