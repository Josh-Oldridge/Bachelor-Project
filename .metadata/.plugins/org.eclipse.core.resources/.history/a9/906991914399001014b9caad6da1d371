static volatile uint8_t ab_irqs_on = 1;  /* mirror state for AB (CC1/CC2) */

ALWAYS_INLINE void EncSampler_ConfigIRQs(void) {
  __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2);
#if HAVE_Z_INDEX
  __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_IDX);
  #ifdef TIM_SR_IDXF
  __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
  #endif
#endif
  __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_UPDATE | TIM_IT_TRIGGER | TIM_IT_COM);
  __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_UIF | TIM_SR_TIF | TIM_SR_COMIF);
}

void EncSampler_SetABIrqs(uint8_t on)
{
  __disable_irq();
  if (on) {
    __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2);
#if HAVE_Z_INDEX
    __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_IDX);
    #ifdef TIM_SR_IDXF
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
    #endif
#endif
  } else {
    __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2 | TIM_IT_IDX);
    __HAL_TIM_CLEAR_FLAG(&htim1,
                         TIM_SR_CC1IF | TIM_SR_CC1OF |
                         TIM_SR_CC2IF | TIM_SR_CC2OF);
    #ifdef TIM_SR_IDXF
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
    #endif
  }
  ab_irqs_on = on ? 1u : 0u;
  __enable_irq();
}

void EncSampler_EncoderIRQ_Drain(void)
{
  HAL_GPIO_WritePin(INT_PIN_GPIO_Port, INT_PIN_Pin, GPIO_PIN_SET);
  DiagTiming_Start(DIAG_T_ISR_TOTAL);

  /* Tight drain loop; bail if nothing pending */
  for (int guard = 0; guard < 128; ++guard) {
    uint32_t sr = TIM1->SR;
    uint32_t pending = (sr & (TIM_SR_CC1IF | TIM_SR_CC2IF | TIM_SR_CC1OF | TIM_SR_CC2OF));
#if HAVE_Z_INDEX && defined(TIM_SR_IDXF)
    pending |= (sr & TIM_SR_IDXF);
#endif
    if (!pending) break;

    /* --- Handle CC overcapture (cheap path) --- */
    if (sr & (TIM_SR_CC1OF | TIM_SR_CC2OF)) {
      if (sr & TIM_SR_CC1OF) { event_drops++; Diag_AddEventDrops(1); }
      if (sr & TIM_SR_CC2OF) { event_drops++; Diag_AddEventDrops(1); }
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC1OF | TIM_SR_CC2OF);
      /* do not 'continue'; still service CC1/CC2 flags in same pass */
    }

#if HAVE_Z_INDEX && defined(TIM_SR_IDXF)
    /* --- Index (Z) --- */
    if (sr & TIM_SR_IDXF) {
      /* Clear first to stop re-entry */
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_IDX);
# ifdef TIM_SR_IDXF
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
# endif
      z_diag_isr_seen++;

      /* Only care about Z during arm/active window */
      if ((cap_active || cap_armed) && !z_need_low_since_arm) {
        const uint32_t now_ms = uwTick;
        const int32_t  dt_ms  = (int32_t)(now_ms - (int32_t)z_last_ms_isr);
        const uint8_t  ab_now = enc_read_AB() & 0x3u;

        if ((dt_ms >= (int32_t)Z_SOFT_DEBOUNCE_MS) &&
            (ab_edges_since_z_isr >= Z_MIN_AB_EDGES))
        {
          if (ab_now != 0u) {
            /* Wait until pins pass through 00; CC will serialize it */
            z_align_pending_isr = 1u;
          } else {
            /* Accept Z immediately (already at AB=00) */
            z_align_pending_isr = 0u;

            /* latch gap BEFORE reset (diag) */
            z_last_gap_edges_isr = ab_edges_since_z_isr;

            /* canonical resets */
            ab_edges_since_z_isr = 0u;
            z_diag_ab_since_isr  = 0u;
            z_diag_steps_x4      = 0u;

            z_last_ms_isr    = now_ms;
            z_diag_last_z_ms = now_ms;
            z_diag_isr_accepted++;
            z_epoch_isr++;

            /* Gate/live mirroring */
            Gate_OnAcceptedZ(now_ms, ab_now, dir_from_hw());
          }
        }
      } else {
        /* Still waiting for Z to go low once after arm? */
        if (z_need_low_since_arm && (z_pin_now() == 0u)) {
          z_need_low_since_arm = 0u;
        }
      }
      /* fall-through to handle CC events in same loop pass */
    }
#endif

    /* Refresh SR after the Z branch so we react to fresh CCIF bits */
    sr = TIM1->SR;

    /* --- Unified CC handler (service one channel per pass for latency) --- */
    const uint32_t have_cc1 = (sr & TIM_SR_CC1IF);
    const uint32_t have_cc2 = (sr & TIM_SR_CC2IF);

    if (have_cc1 | have_cc2) {
      const uint8_t  src_code = have_cc1 ? 1u : 2u;
      const uint16_t ccr      = have_cc1 ? (uint16_t)TIM1->CCR1 : (uint16_t)TIM1->CCR2;

      /* Clear the corresponding CC interrupt */
      __HAL_TIM_CLEAR_IT(&htim1, have_cc1 ? TIM_IT_CC1 : TIM_IT_CC2);

      /* Snapshot inputs */
      const uint8_t  ab  = enc_read_AB() & 0x3u;
      const int8_t   dir = dir_from_hw();
      const uint32_t tms = uwTick;
      enc_latched_dir    = dir;

      /* Clear the “need-low” guard as soon as we see Z=0 on pins */
      if (z_need_low_since_arm && (z_pin_now() == 0u)) {
        z_need_low_since_arm = 0u;
      }

      /* If alignment was pending and pins are 00 now, stamp Z FIRST */
      if (z_align_pending_isr && (ab == 0u)) {
        z_last_gap_edges_isr = ab_edges_since_z_isr;
        ab_edges_since_z_isr = 0u;
        z_diag_ab_since_isr  = 0u;
        z_diag_steps_x4      = 0u;

        z_last_ms_isr    = tms;
        z_diag_last_z_ms = tms;
        z_diag_isr_accepted++;
        z_epoch_isr++;

        Gate_OnAcceptedZ(tms, ab, dir);
        z_align_pending_isr = 0u;
      }

      /* Live/capture mirroring (only during active slice) */
      Gate_PushAB(src_code, dir, ccr, ab, tms);

      /* canonical counters for diagnostics */
      ab_edges_since_z_isr++;
      z_diag_ab_since_isr = ab_edges_since_z_isr;
      z_diag_steps_x4     = ab_edges_since_z_isr * STEPS_PER_AB_EVENT;

      /* Service only one CC per loop; re-check SR immediately */
      continue;
    }

#ifdef TIM_SR_TERRF
    if (sr & TIM_SR_TERRF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_TERRF); }
#endif
#ifdef TIM_SR_IERRF
    if (sr & TIM_SR_IERRF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IERRF); }
#endif
  }

  /* health (cheap sampling) */
  {
    const uint32_t level = (event_write - event_read) & EVENT_IDX_MASK;
    if (level > event_ring_hwm) event_ring_hwm = level;   /* NEW */
    Diag_ObserveEventBufLevel(level);
  }
  DiagTiming_Stop(DIAG_T_ISR_TOTAL);
  HAL_GPIO_WritePin(INT_PIN_GPIO_Port, INT_PIN_Pin, GPIO_PIN_RESET);
  __DSB();
}

void EncSampler_Init(void)
{
  /* Only cold-init the big NOLOAD buffers once to save time / bus bandwidth */
  static uint8_t cold_init_done = 0u;

  /* Seed encoder state (no IRQs needed for this) */
  memset(&enc_state, 0, sizeof(enc_state));
  enc_state.baseline_interval = 10.0f;

  /* Reset all window-stamp metadata and soft counters */
  WinStamp_InitAll();

  /* Fast-path clears that don't touch the big buffers */
  z_align_pending_isr   = 0u;
  z_epoch_seen_main     = z_epoch_isr;
  z_last_gap_edges_isr  = 0u;
  suppress_until_first_Z= 1u;

  /* Indices / counters (protect with IRQ off once, not in pieces) */
  __disable_irq();
  wf_w = wf_r = 0; wf_count = 0; win_row = 0;
  win_ready = 0;   win_total = 0;
  event_read = event_write = 0; event_drops = 0;

  /* Capture state */
  cap_armed = cap_active = cap_done = 0u;
  cap_w = cap_r = 0u; cap_count = 0u; cap_drops = 0u;
  cap_start_ms = cap_end_ms = cap_duration_ms = 0u;
  __enable_irq();

  /* One-time zero of large buffers (keep for ECC/init, but not every init) */
  if (!cold_init_done) {
    memset((void*)win_ring,   0, sizeof(win_ring));
    memset((void*)flags_ring, 0, sizeof(flags_ring));
    memset((void*)event_buffer, 0, sizeof(event_buffer));
    memset((void*)cap_buf,    0, sizeof(cap_buf));
    cold_init_done = 1u;
  }

  /* Configure and sanitize timer IRQ sources after we’ve reset our state */
  EncSampler_ConfigIRQs();
  __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_TIF | TIM_SR_COMIF);
}

void EncSampler_Process(void)
{
  /* LIVE processing with PRE-Z semantics */

  /* Per-run statics stay in .bss and keep state across calls */
  static uint32_t last_ms = 0;
  static uint32_t gray_skip2   = 0;
  static uint8_t  last_src     = 0;
  static int32_t  dir_sum      = 0;
  static uint32_t rule_flags_live = 0;
  static uint8_t  had_z_in_win = 0;

  /* adjacency computed on the same gray the model sees */
  static uint8_t  last_model_gray = 0;
  static uint8_t  have_last_model_gray = 0;

  /* Precompute scaled 0/1 once for boolean-like features to avoid repeat scaling */
  static uint8_t s01_init = 0;
  static float S0[FEAT_DIM], S1[FEAT_DIM];
  if (!s01_init) {
    for (int j = 0; j < FEAT_DIM; ++j) {
      S0[j] = scale_feat(j, 0.f);
      S1[j] = scale_feat(j, 1.f);
    }
    s01_init = 1;
  }

  /* keep the “capture window” timeout snappy */
  if (cap_active) {
    uint32_t now = uwTick;                 /* faster than HAL_GetTick() */
    if ((int32_t)(now - cap_end_ms) >= 0) {
      __disable_irq();
      cap_active = 0u;
      cap_done   = 1u;
      __enable_irq();
    }
  }

  while (event_read != event_write) {
    /* Pull one event from the SPSC ring */
    encoder_event_t evt = event_buffer[event_read];
    event_read = (event_read + 1u) & EVENT_IDX_MASK;

    /* === Handle queued Z (src==0) BEFORE any A/B work — PRE-Z stamping === */
    if (evt.src == 0u) {
      z_diag_last_z_ms = z_last_ms_isr;

#if ENABLE_TRACE_WIN
      if (win_row == 0) memset(trace_z, 0, SEQ_LEN);
#endif

      /* FIRST Z since init/arm -> drop partial window and start clean after this Z */
      if (suppress_until_first_Z) {
        z_epoch_seen_main = z_epoch_isr;
        z_seq_main++;

        g_ws.ab_since_z_soft = 0u;      /* next AB row sees SSZ=1 */

        /* throw away partial */
        win_row = 0;
        gray_skip2 = 0;
        rule_flags_live = 0;
        last_src = 0;
        had_z_in_win = 0;

        have_last_model_gray = 0;       /* clean first row continuity */
        suppress_until_first_Z = 0u;
        continue;                       /* do NOT stamp any row/window for this Z */
      }

      /* Normal Z */
      z_epoch_seen_main = z_epoch_isr;
      z_seq_main++;

      /* Optional double/miss flags */
      if (z_last_gap_edges_isr < Z_MIN_GAP_EDGES)   rule_flags_live |= WR_ZDOUBLE;
      if (g_ws.ab_since_z_soft > Z_MISS_EDGE_LIMIT) rule_flags_live |= WR_ZMISS;

      if (win_row > 0) {
        /* in-window PRE-Z: stamp Z on the previous row */
        const uint8_t zrow = (uint8_t)(win_row - 1u);

        /* Z feature to 1 on that row */
        float *fz = &win_ring[wf_w][((uint32_t)zrow * FEAT_DIM)];
        fz[6] = S1[6];

#if ENABLE_TRACE_WIN
        trace_z[zrow] = 1u;
#endif
        WinStamp_OnZStampedInStream(zrow, z_seq_main);
        had_z_in_win = 1u;

        /* PRE-Z semantics: Z occurs AFTER that row -> next AB row must see SSZ=1 */
        g_ws.ab_since_z_soft = 0u;

      } else {
        /* cross-window PRE-Z (previous window’s last row) */
        if (win_total == 0) {
          /* no previous window yet; just reset SSZ */
          g_ws.ab_since_z_soft = 0u;
          had_z_in_win = 0u;
        } else {
          uint16_t pw = (uint16_t)((wf_w - 1u) & WINMASK);
          float *fp = &win_ring[pw][((uint32_t)(SEQ_LEN - 1u) * FEAT_DIM)];
          fp[6] = S1[6];
          win_z_row[pw]      = (uint16_t)(SEQ_LEN - 1u);
          win_z_epoch[pw]    = z_seq_main;
          win_z_seq_end[pw]  = z_seq_main;
          flags_ring[pw]    |= WR_ZINWIN;

          g_ws.ab_since_z_soft = 0u;
          had_z_in_win = 0u;
        }
        continue; /* done with Z */
      }
    }

    /* keep public Z time fresh for UI (coarse) */
    z_diag_last_z_ms = z_last_ms_isr;

#if ENABLE_TRACE_WIN
    if (win_row == 0) memset(trace_z, 0, SEQ_LEN);
#endif

    /* First AB of a window: stamp begin metadata now */
    if (win_row == 0) {
      had_z_in_win = 0;
      DiagTiming_Start(DIAG_T_E2E_WINDOW);
      WinStamp_BeginWindow(wf_w);
    }

    /* Unpack event fields once */
    const uint8_t current_gray = (uint8_t)(evt.ab_state & 0x3u);
    const int8_t  dir          = evt.dir;
    const uint8_t dir_fwd      = (dir > 0);
    const uint8_t dir_bwd      = (dir < 0);
    if (dir_fwd)      dir_sum++;
    else if (dir_bwd) dir_sum--;

    /* --- timing features (EWMA) --- */
    const uint32_t now_ms = evt.timestamp_ms;          /* producer filled with uwTick in ISR */
    int32_t dms = (int32_t)(now_ms - last_ms);
    if (dms <= 0) dms = 1;
    const float dt_ms = (float)dms;
    if (enc_state.baseline_interval < 1.0f) enc_state.baseline_interval = dt_ms;
    const float ratio = dt_ms / enc_state.baseline_interval;
    enc_state.speed_change_rate = fabsf(ratio - 1.0f);
    enc_state.baseline_interval = 0.9f * enc_state.baseline_interval + 0.1f * dt_ms;
    last_ms = now_ms;

    const uint8_t model_gray = current_gray;        /* 0,1,3,2 directly from pins */
    uint8_t src_A_model = 0, src_B_model = 0;
    uint8_t adjacent = 1u;

    if (have_last_model_gray) {
      /* For a valid quadrature step, exactly one bit toggles */
      const uint8_t diff = (uint8_t)((last_model_gray ^ model_gray) & 0x3u);
      adjacent = (uint8_t)((diff == 1u) || (diff == 2u));
      gray_step_to_src(last_model_gray, model_gray, &src_A_model, &src_B_model);

      /* If it wasn’t adjacent (glitch: both bits or none), zero SRC_* for this row */
      if (!adjacent) { src_A_model = 0; src_B_model = 0; }
    } else {
      /* First row in the whole stream: seed with the event’s channel for one step */
      src_A_model = (evt.src == 1u);
      src_B_model = (evt.src == 2u);
      have_last_model_gray = 1u;
    }

    /* remember for the next row */
    last_model_gray = model_gray;

    /* === pack features (use FILLED gray, stream-aligned counters) === */
    DiagTiming_Start(DIAG_T_PACK_AB);

    float *f = &win_ring[wf_w][((uint32_t)win_row * FEAT_DIM)];

    /* Modeled Gray (filled: alternates rise/fall 1,3,2,0 …) */
    const uint8_t model_gray = (uint8_t)(synth_gray & 0x3u);

    /* Derive SRC_A/SRC_B from modeled gray transition */
    uint8_t src_A_model = 0, src_B_model = 0;
    if (have_last_model_gray) {
      gray_step_to_src(last_model_gray, model_gray, &src_A_model, &src_B_model);
    } else {
      /* first row fallback: use this rising edge once */
      src_A_model = (evt.src == 1u);
      src_B_model = (evt.src == 2u);
      have_last_model_gray = 1u;
    }

    /* adjacency based on modeled gray */
    uint8_t adjacent = 1u;
    if (have_last_model_gray) {
      const uint8_t diff_bits = (uint8_t)((last_model_gray ^ model_gray) & 3u);
      adjacent = (uint8_t)((diff_bits == 1u) || (diff_bits == 2u));
    }
    last_model_gray = model_gray;

    uint32_t ab_for_model = (g_ws.ab_since_z_soft * STEPS_PER_AB_EVENT) + 1u;                        /* 1..2000.. */

    /* Build same_src from modeled source code (1=A, 2=B) */
    const uint8_t src_code_model = src_A_model ? 1u : (src_B_model ? 2u : 0u);
    const uint8_t is_same_src    = (uint8_t)(last_src && (src_code_model == last_src));

    /* Write features (use precomputed S0/S1 for boolean-like lanes) */
    f[0] = scale_feat(0, (float)model_gray);      /* modeled AB state (0,1,3,2) */
    f[1] = src_A_model ? S1[1] : S0[1];           /* SRC_A (modeled) */
    f[2] = src_B_model ? S1[2] : S0[2];           /* SRC_B (modeled) */
    f[3] = dir_fwd ? S1[3] : S0[3];
    f[4] = dir_bwd ? S1[4] : S0[4];
    f[5] = scale_feat(5, enc_state.speed_change_rate);
    f[6] = S0[6];                                 /* PRE-Z: 0 here; set to 1 only when stamping */
    f[7] = scale_feat(7, (float)ab_for_model);    /* SSZ (1-based) */
    f[8] = is_same_src ? S1[8] : S0[8];           /* same_src (modeled) */
    f[9] = adjacent ? S1[9] : S0[9];              /* adjacency (modeled) */

#if ENABLE_TRACE_WIN
    trace_ab[win_row]  = model_gray;
    /* log modeled source so the trace matches the shown gray step */
    trace_src[win_row] = src_code_model ? src_code_model : evt.src;
    trace_z[win_row]   = 0u;  /* set to 1 only when PRE-Z stamps */
#endif

    if (is_same_src) gray_skip2++;
    last_src = src_code_model ? src_code_model : evt.src;

    DiagTiming_Stop(DIAG_T_PACK_AB);

    enc_state.last_AB_state = current_gray;

    WinStamp_OnEdge();

    /* advance row, publish window if full */
    win_row++;

    if (win_row >= SEQ_LEN) {
      uint32_t flags = rule_flags_live;
      if (gray_skip2 >= 2) flags |= WR_SKIP2;
      if (had_z_in_win)    flags |= WR_ZINWIN;
      const uint32_t win_last_ms = last_ms;                 // last event that went into this window
      if (Diag_IsTrialCovering(win_last_ms)) {
          flags |= RF_TRIAL;
      }
      enc_rule_flags = flags;

      /* summarize direction */
      if      (dir_sum > 0) last_window_dir = +1;
      else if (dir_sum < 0) last_window_dir = -1;
      else                  last_window_dir = enc_latched_dir;
      dir_sum = 0;

      DiagTiming_Stop(DIAG_T_E2E_WINDOW);
      DiagTiming_Start(DIAG_T_WIN_PUBLISH);

      if (suppress_until_first_Z && (z_seq_main == 0u)) {
        /* don’t publish this window; reset accumulators and continue */
        win_row = 0;
        gray_skip2 = 0;
        rule_flags_live = 0;
        last_src = 0;
        had_z_in_win = 0;
        DiagTiming_Stop(DIAG_T_WIN_PUBLISH);
        continue;
      }
      if (suppress_until_first_Z && (z_seq_main > 0u)) {
        suppress_until_first_Z = 0u;
      }

      /* publish stamped metadata BEFORE rotating wf_w */
      WinStamp_PublishWindow(wf_w);
      flags_ring[wf_w] = flags;

#if ENABLE_TRACE_WIN
  memcpy(last_trace_ab,  trace_ab,  SEQ_LEN);
  memcpy(last_trace_src, trace_src, SEQ_LEN);
  memcpy(last_trace_z,   trace_z,   SEQ_LEN);
#endif

      uint8_t dropped_oldest = 0;

      __disable_irq();
      wf_w = (uint16_t)((wf_w + 1u) & WINMASK);
      if (wf_count < WINFIFO) {
        wf_count++;
      } else {
        wf_r = (uint16_t)((wf_r + 1u) & WINMASK);  // overwrite oldest
        dropped_oldest = 1;
      }
      win_ready = wf_count;
      __enable_irq();

      if (wf_count > winfifo_hwm) winfifo_hwm = wf_count;   /* NEW */

      if (dropped_oldest) {
        Diag_AddWinOverwrites(1);
      }

      Diag_ObserveWinFifoLevel(wf_count);
      win_total++;

      DiagTiming_Stop(DIAG_T_WIN_PUBLISH);
      Diag_NotifyWindowPublished();

      /* reset window accumulators */
      win_row = 0;
      gray_skip2 = 0;
      rule_flags_live = 0;
      last_src = 0;
      had_z_in_win = 0;
      /* keep last_model_gray & have_last_model_gray across windows */
    }
  }
}

int EncSampler_CopyWindowLinear(float *dst, uint32_t *out_flags)
{
  uint16_t r;
  uint32_t flags;

  __disable_irq();
  if (wf_count == 0) { __enable_irq(); return -1; }
  r     = wf_r;
  flags = flags_ring[r];
  wf_r  = (uint16_t)((wf_r + 1u) & WINMASK);
  wf_count--;
  win_ready = wf_count;
  __enable_irq();

  memcpy(dst, win_ring[r], sizeof(win_ring[0]));
  win_rule_flags = flags;
  if (out_flags) *out_flags = flags;

  /* hand off the stamps for this window */
  WinStamp_CopyOut(r);
  return 0;
}
void EncSampler_StopHardware(void)
{
  __disable_irq();

  if (!htim1.Instance) { __enable_irq(); return; }

  /* If already disabled, skip heavy work */
  if ((htim1.Instance->DIER & (TIM_DIER_CC1IE | TIM_DIER_CC2IE)) == 0u) {
    __enable_irq();
    return;
  }

  __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2 | TIM_IT_UPDATE | TIM_IT_TRIGGER | TIM_IT_COM);
#ifdef TIM_IT_IDX
  __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_IDX);
#endif
  __HAL_TIM_DISABLE(&htim1);

  __HAL_TIM_CLEAR_FLAG(&htim1,
    TIM_SR_CC1IF | TIM_SR_CC1OF |
    TIM_SR_CC2IF | TIM_SR_CC2OF |
    TIM_SR_UIF   | TIM_SR_TIF   | TIM_SR_COMIF);
#ifdef TIM_SR_IDXF
  __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
#endif

#ifdef TIM1_CC_IRQn
  NVIC_DisableIRQ(TIM1_CC_IRQn);
#endif
#if defined(TIM1_TRG_CCU_IRQn)
  NVIC_DisableIRQ(TIM1_TRG_CCU_IRQn);
#elif defined(TIM1_TRG_COM_IRQn)
  NVIC_DisableIRQ(TIM1_TRG_COM_IRQn);
#endif

  ab_irqs_on = 0;
  __enable_irq();
}



void EncSampler_FlushWindows(void)
{
  __disable_irq();

  wf_w = wf_r = 0; wf_count = 0;
  win_ready = 0; win_total = 0;
  win_row = 0;

  event_read = event_write = 0; event_drops = 0;

  z_last_ms_isr = 0;
  ab_edges_since_z_isr = 0;
  z_last_gap_edges_isr = 0;
  z_diag_isr_seen = 0;
  z_diag_isr_accepted = 0;
  z_diag_ab_since_isr = 0;
  z_diag_steps_x4 = 0;
  z_diag_last_z_ms = 0;
  z_align_pending_isr = 0u;

  z_epoch_isr = 0;
  z_epoch_seen_main = 0;

  cap_armed = 0u; cap_active = 0u; cap_done = 0u;
  cap_w = cap_r = cap_count = cap_drops = 0u;
  cap_start_ms = cap_end_ms = cap_duration_ms = 0u;

  suppress_until_first_Z = 1u;
  event_ring_hwm = 0;
  winfifo_hwm    = 0;
  WinStamp_InitAll();

  __enable_irq();
}


void EncSampler_CaptureArmOnNextZ(uint32_t duration_ms)
{
  __disable_irq();
  cap_duration_ms = duration_ms ? duration_ms : 1000u;
  cap_armed  = 1u;
  cap_active = 0u;
  cap_done   = 0u;
  cap_w = cap_r = cap_count = cap_drops = 0u;

  /* if Z is currently high at arm time, force a low first */
  z_need_low_since_arm = z_pin_now();  // 1 if high, 0 if already low
  suppress_until_first_Z = 1u;
  __enable_irq();
}

void EncSampler_CaptureCancel(void)
{
  __disable_irq();
  cap_armed  = 0u;
  cap_active = 0u;
  __enable_irq();
}


bool     EncSampler_CaptureActive(void) { return cap_active != 0u; }
bool     EncSampler_CaptureDone(void)   { return cap_done   != 0u; }
uint32_t EncSampler_CaptureCount(void)  { return cap_count; }
uint32_t EncSampler_CaptureDrops(void)  { return cap_drops; }

uint32_t EncSampler_CaptureRead(enc_capture_evt_t *dst, uint32_t max)
{
  if (!dst || !max) return 0u;

  uint32_t r, w, available;

  __disable_irq();
  r = cap_r;
  w = cap_w;
  __enable_irq();

  if (r == w) return 0u;

  /* compute available in ring */
  if (w >= r) available = w - r;
  else        available = CAPTURE_MAX_EVENTS - r + w;

  if (available > max) available = max;

  /* copy in up to two blocks */
  uint32_t first = available;
  uint32_t till_end = CAPTURE_MAX_EVENTS - r;
  if (first > till_end) first = till_end;

  memcpy(dst, &cap_buf[r], first * sizeof(enc_capture_evt_t));

  uint32_t second = available - first;
  if (second) {
    memcpy(dst + first, &cap_buf[0], second * sizeof(enc_capture_evt_t));
  }

  /* advance read index once, atomically */
  __disable_irq();
  uint32_t new_r = r + available;
  if (new_r >= CAPTURE_MAX_EVENTS) new_r -= CAPTURE_MAX_EVENTS;
  cap_r = new_r;
  __enable_irq();

  return available;
}

void EncSampler_GetLastCaptureStats(uint32_t* edges, uint32_t* dur_ms,
                                    uint32_t* first_ms, uint32_t* last_ms,
                                    uint32_t* z_marks)
{
  uint32_t r, w;

  __disable_irq();
  r = cap_r;
  w = cap_w;
  __enable_irq();

  if (r == w) {
    if (edges)    *edges    = 0u;
    if (dur_ms)   *dur_ms   = 0u;
    if (first_ms) *first_ms = 0u;
    if (last_ms)  *last_ms  = 0u;
    if (z_marks)  *z_marks  = 0u;
    return;
  }

  uint32_t e=0, f=0, l=0, z=0;
  uint8_t started = 0u;

  /* head -> end */
  while (r != w) {
    const enc_capture_evt_t *ev = &cap_buf[r];
    if (!started) { f = ev->t_ms; started = 1u; }
    l = ev->t_ms;
    e++;
    if (ev->src == 0u) z++;
    r++;
    if (r >= CAPTURE_MAX_EVENTS) r = 0u;
  }

  if (edges)    *edges    = e;
  if (dur_ms)   *dur_ms   = (l >= f) ? (l - f) : 0u;
  if (first_ms) *first_ms = f;
  if (last_ms)  *last_ms  = l;
  if (z_marks)  *z_marks  = z;
}


uint8_t EncSampler_HasPending(void)
{
  uint8_t p;
  __disable_irq();
  p = ((event_write != event_read) || ((win_row != 0) && ab_irqs_on)) ? 1u : 0u;
  __enable_irq();
  return p;
}

