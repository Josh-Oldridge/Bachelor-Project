ALWAYS_INLINE void WinStamp_InitAll(void) {
  memset(win_ab_start_x4, 0, sizeof(win_ab_start_x4));
  memset(win_ab_end_x4,   0, sizeof(win_ab_end_x4));
  for (uint32_t i=0; i<WINFIFO; ++i) win_z_row[i] = 0xFFFFu;
  memset(win_z_epoch,     0, sizeof(win_z_epoch));

  win_stamp_ab_start_x4 = 0;
  win_stamp_ab_end_x4   = 0;
  win_stamp_ab_delta_x4 = 0;
  win_stamp_z_epoch     = 0;
  win_stamp_z_row       = -1;

  g_ws.ab_since_z_soft     = 0;
  g_ws.z_row_this_window   = 0xFFFFu;
  g_ws.z_epoch_this_window = 0;
  z_seq_main               = 0;
}

ALWAYS_INLINE void WinStamp_BeginWindow(uint16_t wf_w_local) {
  const uint16_t prev = (uint16_t)((wf_w_local - 1u) & WINMASK);
  if (wf_w_local == 0 && wf_count == 0) {
    win_ab_start_x4[wf_w_local] = g_ws.ab_since_z_soft * STEPS_PER_AB_EVENT;
  } else {
    win_ab_start_x4[wf_w_local] = win_ab_end_x4[prev];
  }
  g_ws.z_row_this_window   = 0xFFFFu;
  g_ws.z_epoch_this_window = 0;
}

ALWAYS_INLINE void WinStamp_OnZStampedInStream(uint8_t row, uint32_t epoch_seq) {
  if (g_ws.z_row_this_window == 0xFFFFu) {
    g_ws.z_row_this_window   = row;
    g_ws.z_epoch_this_window = epoch_seq;
  }
}

ALWAYS_INLINE void WinStamp_OnEdge(void) {
  g_ws.ab_since_z_soft++;
}

ALWAYS_INLINE void WinStamp_PublishWindow(uint16_t wf_w_local) {
  win_ab_end_x4[wf_w_local] = g_ws.ab_since_z_soft * STEPS_PER_AB_EVENT;
  win_z_row[wf_w_local]     = g_ws.z_row_this_window;
  win_z_epoch[wf_w_local]   = g_ws.z_epoch_this_window;
  win_z_seq_end[wf_w_local] = z_seq_main;
}

ALWAYS_INLINE void WinStamp_CopyOut(uint16_t r) {
  win_stamp_ab_start_x4 = win_ab_start_x4[r];
  win_stamp_ab_end_x4   = win_ab_end_x4[r];
  win_stamp_ab_delta_x4 = (win_stamp_ab_end_x4 - win_stamp_ab_start_x4);
  win_stamp_z_epoch     = win_z_epoch[r];
  win_stamp_z_row       = (win_z_row[r] == 0xFFFFu) ? -1 : (int16_t)win_z_row[r];
  win_stamp_z_seq_end   = win_z_seq_end[r];
}

ALWAYS_INLINE void cap_push_isr(uint8_t src, int8_t dir, uint16_t ccr,
                                uint8_t ab, uint32_t t_ms, uint8_t flags)
{
  uint32_t next = cap_w + 1u;
  if (next >= CAPTURE_MAX_EVENTS) next = 0u;
  if (UNLIKELY(next == cap_r)) { cap_drops++; return; }

  enc_capture_evt_t *e = &cap_buf[cap_w];
  e->t_ms     = t_ms;
  e->ccr      = ccr;
  e->src      = src;      /* 0 = Z, 1 = A(CC1), 2 = B(CC2) */
  e->dir      = 0;
  e->ab_state = ab;
  e->flags    = flags;

  cap_w = next;
  cap_count++;
}


ALWAYS_INLINE void push_event_isr(uint8_t src, int8_t dir, uint16_t ccr_sample,
                                  uint8_t ab_state)
{
  const uint32_t next = (event_write + 1u) & EVENT_IDX_MASK;
  if (UNLIKELY(next == event_read)) { event_drops++; Diag_AddEventDrops(1); return; }

  encoder_event_t *e = &event_buffer[event_write];
  e->timestamp_ms = uwTick;     /* faster than HAL_GetTick() */
  e->ccr          = ccr_sample;
  e->src          = src;        /* 0=Z, 1=A, 2=B */
  e->dir          = dir;
  e->ab_state     = ab_state;

  event_write = next;
}


ALWAYS_INLINE void Gate_OnAcceptedZ(uint32_t now_ms, uint8_t ab_post, int8_t dir)
{
  /* Arm-to-active transition costs */
  if (UNLIKELY(cap_armed & !cap_active)) {
    cap_active   = 1u;
    cap_armed    = 0u;
    cap_done     = 0u;
    cap_start_ms = now_ms;
    cap_end_ms   = now_ms + cap_duration_ms;
  }

  /* Diagnostics: keep (you want prints later) */
  Diag_NotifyZAccepted(now_ms);

  if (LIKELY(cap_active)) {
    push_event_isr(0u, dir, 0u, ab_post);
    cap_push_isr(0u, dir, 0u, ab_post, now_ms, 1u);  /* CAP_F_Z == 1 */
  }
}

ALWAYS_INLINE void Gate_PushAB(uint8_t src_code /*1=A,2=B*/, int8_t dir, uint16_t ccr,
                               uint8_t ab_post, uint32_t tms)
{
  if (LIKELY(cap_active)) {
    cap_push_isr(src_code, dir, ccr, ab_post, tms, 0u);
    push_event_isr(src_code, dir, ccr, ab_post);
    Diag_NotifyABEdgeAt(tms);
    if (UNLIKELY((int32_t)(tms - cap_end_ms) >= 0)) {
      cap_active = 0u;
      cap_done   = 1u;
      __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2 | TIM_IT_IDX);
    }
  }
}

/* ============================ Helpers ================================== */

ALWAYS_INLINE void gray_step_to_src(uint8_t prev_gray, uint8_t curr_gray,
                                    uint8_t *srcA, uint8_t *srcB)
{
  const uint8_t toggled = (uint8_t)((prev_gray ^ curr_gray) & 0x3u);
  *srcA = (toggled & 0x2u) ? 1u : 0u;
  *srcB = (toggled & 0x1u) ? 1u : 0u;
}

ALWAYS_INLINE float scale_feat(int j, float x) {
  float y = (x - MODEL_FEAT_MIN[j]) * MODEL_FEAT_SCALE[j];
  if (y < 0.f) y = 0.f;
  if (y > 1.f) y = 1.f;
  return y;
}

ALWAYS_INLINE uint8_t enc_read_AB(void) {
  const uint32_t idr = GPIOE->IDR;              /* A=PE9, B=PE11 */
  return (uint8_t)(((idr & ENC_A_Pin) ? 2u : 0u) | ((idr & ENC_B_Pin) ? 1u : 0u));
}

ALWAYS_INLINE int8_t dir_from_hw(void) {
  return ((TIM1->CR1 & TIM_CR1_DIR) == 0) ? +1 : -1; /* DIR=0 => up */
}

