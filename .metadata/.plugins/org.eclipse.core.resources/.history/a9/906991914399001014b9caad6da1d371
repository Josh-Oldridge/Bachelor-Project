/* Forward ring: 0 -> 1 -> 3 -> 2 -> 0
   Return +1 (forward), -1 (backward), 0 (invalid/no change). */
ALWAYS_INLINE int8_t quad_dir_from_transition(uint8_t prev_g, uint8_t curr_g)
{
  prev_g &= 3u; curr_g &= 3u;
  if (prev_g == curr_g) return 0;              /* no change */
  /* adjacent means exactly one bit toggled */
  const uint8_t diff = (prev_g ^ curr_g) & 3u;
  const uint8_t adjacent = (diff == 1u) || (diff == 2u);
  if (!adjacent) return 0;                      /* glitch: both bits -> reject */

  /* forward adjacency pairs */
  if ((prev_g == 0 && curr_g == 1) ||
      (prev_g == 1 && curr_g == 3) ||
      (prev_g == 3 && curr_g == 2) ||
      (prev_g == 2 && curr_g == 0)) return +1;

  /* reverse adjacency is the opposite edges */
  return -1;
}


