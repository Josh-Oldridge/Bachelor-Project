void MX_X_CUBE_AI_Init(void)
{
    __HAL_RCC_AXISRAM2_MEM_CLK_ENABLE();
    __HAL_RCC_AXISRAM3_MEM_CLK_ENABLE();
    __HAL_RCC_AXISRAM4_MEM_CLK_ENABLE();
    __HAL_RCC_AXISRAM5_MEM_CLK_ENABLE();
    __HAL_RCC_AXISRAM6_MEM_CLK_ENABLE();
    RAMCFG_SRAM2_AXI->CR &= ~RAMCFG_CR_SRAMSD;
    RAMCFG_SRAM3_AXI->CR &= ~RAMCFG_CR_SRAMSD;
    RAMCFG_SRAM4_AXI->CR &= ~RAMCFG_CR_SRAMSD;
    RAMCFG_SRAM5_AXI->CR &= ~RAMCFG_CR_SRAMSD;
    RAMCFG_SRAM6_AXI->CR &= ~RAMCFG_CR_SRAMSD;
    /* USER CODE BEGIN 5 */
    printf("AI: init\r\n");
    if (ai_boostrap(data_activations0) != 0) {
      ai_log_err(ai_network_get_error(network), "ai_boostrap");
      return;
    }

    /* Hard assert the model expects float tensors (fast path) */
    const uint32_t in_type  = AI_BUFFER_FMT_GET_TYPE(ai_input[0].format);
    const uint32_t out_type = AI_BUFFER_FMT_GET_TYPE(ai_output[0].format);
    if (in_type != AI_BUFFER_FORMAT_FLOAT || out_type != AI_BUFFER_FORMAT_FLOAT) {
      ai_log_err((ai_error){AI_ERROR_INVALID_PARAM, AI_ERROR_CODE_INVALID_SIZE},
                 "Model I/O not float — re-export as float or add quant path");
    }
    /* USER CODE END 5 */
}

void MX_X_CUBE_AI_Process(void)
{
    /* USER CODE BEGIN 6 */
	if (!network) return;

	/* Run one inference iff a full window is ready */
	if (acquire_and_process_data((ai_float**)data_ins) == 0) {
	  if (ai_run() == 0) {
	    post_process((ai_float**)data_outs);
	  }
	}
    /* USER CODE END 6 */
}
