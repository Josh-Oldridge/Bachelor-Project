/* keep these globals as you have them */
extern volatile float    feat_win[SEQ_LEN][FEAT_DIM];
extern volatile uint32_t win_ready;
volatile uint32_t       inf_total = 0;
volatile float          last_y[AI_NETWORK_OUT_1_SIZE];

static float in_float[AI_NETWORK_IN_1_SIZE];  // 20*10

static int acquire_and_process_data(ai_float* data[])
{
  /* Fill our float scratch window; return -1 if no window ready */
  int r = EncSampler_CopyWindowLinear(in_float);
  if (r) return r;

  /* Copy into the model input (which is float in activations) */
  memcpy(data[0], in_float, sizeof(in_float));
  return 0;
}

static inline void force_vs_normal(int cls, float p)
{
  for (int k = 0; k < AI_NETWORK_OUT_1_SIZE; ++k) last_y[k] = 0.0f;
  last_y[cls]      = p;
  last_y[2/*NORMAL*/] = 1.0f - p;
}

static int post_process(ai_float* data[])
{
  const ai_float* out = data[0];                  // float32 output
  for (int i = 0; i < AI_NETWORK_OUT_1_SIZE; ++i)
    last_y[i] = out[i];

  /* rule flags still apply as guardrails */
  const uint32_t rf = win_rule_flags;
  enum { C_JITTER=0, C_MISSINGSTEP=1, C_NORMAL=2, C_ZINDEX=3 };

  if (rf & RS_A_STUCK)       { force_vs_normal(C_MISSINGSTEP, 0.999f); }
  else if (rf & RS_B_STUCK)  { force_vs_normal(C_MISSINGSTEP, 0.999f); }
  else if (rf & RS_QUAD_BAD) {
    float p = last_y[C_JITTER]; if (p < 0.95f) p = 0.95f; force_vs_normal(C_JITTER, p);
  } else if (rf & RS_Z_MISSED) {
    float p = last_y[C_ZINDEX]; if (p < 0.95f) p = 0.95f; force_vs_normal(C_ZINDEX, p);
  }

  inf_total++;
  return 0;
}







