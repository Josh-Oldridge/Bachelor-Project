/**
 * @brief  The application entry point.
 * @retval int
 */
int main(void) {

	/* USER CODE BEGIN 1 */

	/* USER CODE END 1 */

	/* Enable the CPU Cache */

	/* Enable I-Cache---------------------------------------------------------*/
	SCB_EnableICache();

	/* Enable D-Cache---------------------------------------------------------*/
	SCB_EnableDCache();

	/* MCU Configuration--------------------------------------------------------*/
	HAL_Init();

	/* USER CODE BEGIN Init */

	/* USER CODE END Init */

	/* USER CODE BEGIN SysInit */

	/* USER CODE END SysInit */

	/* Initialize all configured peripherals */
	MX_GPIO_Init();
	MX_LPUART1_UART_Init();
	MX_CACHEAXI_Init();
	MX_TIM1_Init();
	MX_RAMCFG_Init();
	MX_TIM2_Init();
	MX_X_CUBE_AI_Init();
	SystemIsolation_Config();
	/* USER CODE BEGIN 2 */
	EncSampler_Init();
	DiagTiming_Init();
	Diag_SetEventBufCaps(1u << 16);
	Diag_SetWinFifoCaps(1u << 10);
	Diag_ArmTrialAfterNextZ(TRIAL_MS);
	EncSampler_CaptureArmOnNextZ(TRIAL_MS); // 1 s diag capture

	uint32_t next_blink_ms = HAL_GetTick() + 250;
	HAL_Delay(200);

	HAL_TIM_Encoder_Start(&htim1, TIM_CHANNEL_ALL);
	HAL_TIMEx_EnableEncoderIndex(&htim1);
	__HAL_TIM_ENABLE(&htim1);

	printf("ENC MODE: LIVE (TIM1 enabled)\r\n");
	printf("Init done\r\n");
	printf("SEQ_LEN=%d FEAT_DIM=%d\r\n", (int) MODEL_SEQ_LEN,
			(int) MODEL_FEAT_DIM);

	/* USER CODE END 2 */

	/* Initialize leds */
	BSP_LED_Init(LED_BLUE);
	BSP_LED_Init(LED_RED);
	BSP_LED_Init(LED_GREEN);

	/* Infinite loop */
	/* USER CODE BEGIN WHILE */
	while (1) {
		/* USER CODE END WHILE */

//  MX_X_CUBE_AI_Process();
		/* USER CODE BEGIN 3 */

		 EncSampler_Process();

		    /* Drain windows immediately so every inference gets printed */
		 EncSampler_SetABIrqs(0);

		 /* Hard drain: keep pumping sampler to make windows, then run model on them,
		    until BOTH the event queue and the window FIFO are empty. */
		 while (EncSampler_HasPending() || win_ready) {
		     EncSampler_Process();                // events -> features -> windows
		     while (win_ready) {
		         MX_X_CUBE_AI_Process();          // windows -> model + prints
		     }
		 }

		#if ONE_SHOT_TRIAL
		    /* End-of-trial: once the 1 s capture finishes, freeze, drain, summarize */
		    static uint8_t printed_summary = 0;
		    if (!printed_summary && EncSampler_CaptureDone()) {
		        EncSampler_SetABIrqs(0);          // stop generating new events
		        while (win_ready) {               // drain anything left
		            MX_X_CUBE_AI_Process();
		        }

		        diag_snapshot_t snap;
		        Diag_GetAndResetSnapshot(&snap);
		        Diag_PrintSnapshot(&snap);

		        float rps_inst = 0.f, rps_avg = 0.f;
		        Diag_GetRps(&rps_inst, &rps_avg);
		        printf("SPEED: RPS_inst=%.2f  RPS=%.2f  RPM=%.1f\r\n",
		               (double)rps_inst, (double)rps_avg, (double)(rps_avg * 60.f));

		        EncSampler_StopHardware();        // fully stop after summary
		        printed_summary = 1;
		    }
		#endif

		    /* Blink + sleep */
		    if (next_blink_ms == 0) next_blink_ms = HAL_GetTick() + 250;
		    if ((int32_t)(HAL_GetTick() - next_blink_ms) >= 0) {
		        BSP_LED_Toggle(LED_RED);
		        next_blink_ms += 250;
		    }
		    if (win_ready == 0) {
		        __DSB(); __WFI(); __ISB();
		    }
		}
	/* USER CODE END 3 */
}

