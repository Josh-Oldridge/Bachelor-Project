void calculate_simple_features(float features[NUM_FEATURES], int16_t delta) {

    // Initialize all features to safe values
    for (int i = 0; i < NUM_FEATURES; i++) {
        features[i] = 0.0f;
    }

    // Update step counter
    encoder_steps++;
    steps_since_z++;

    // Basic encoder state simulation (A/B pattern)
    features[0] = (encoder_steps % 4 == 1 || encoder_steps % 4 == 2) ? 1.0f : 0.0f; // A_State
    features[1] = (encoder_steps % 4 == 2 || encoder_steps % 4 == 3) ? 1.0f : 0.0f; // B_State
    features[2] = (float)(encoder_steps % 4); // AB_State

    // Interval ratio - simplified
    features[3] = 1.0f + 0.1f * sinf(encoder_steps * 0.01f); // Slight variation

    // Basic feature values
    features[4] = 0.05f; // Speed_Change_Rate
    features[5] = 1.0f;  // Speed_Stable
    features[6] = 1.0f;  // Speed_Category
    features[7] = 1.0f;  // Recent_Stability
    features[8] = 1.0f;  // Sequence_Valid
    features[9] = (delta != 0) ? 1.0f : 0.0f; // State_Change
    features[10] = 0.0f; // Phase_Lag

    // Z-pulse simulation
    if (steps_since_z > 2000) {
        steps_since_z = 0;
        z_seen = 1;
    }

    features[11] = (float)steps_since_z; // Steps_Since_Z
    features[12] = (steps_since_z > 1800) ? 1.0f : 0.0f; // Z_Expected
    features[13] = (steps_since_z > 2200) ? 1.0f : 0.0f; // Z_Overdue
    features[14] = (float)steps_since_z / 2000.0f; // Revolution_Progress

    // Fill remaining features with safe values
    for (int i = 15; i < NUM_FEATURES; i++) {
        features[i] = 0.1f * (i % 10); // Some variation
    }
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM7)
    {
        tim7_ticks++;

        // Get encoder delta (keep this simple)
        uint16_t cnt = __HAL_TIM_GET_COUNTER(&htim1);
        int16_t d = (int16_t)cnt - (int16_t)last_cnt;
        if (d > 1000) d -= 2000;
        if (d < -1000) d += 2000;
        last_cnt = cnt;

        // Simple feature calculation
        calculate_simple_features(feature_buffer[feature_fill], d);

        feature_fill++;
        if (feature_fill >= WIN) {
            feature_fill = 0;
            win_ready++;
            run_infer = 1;
        }
    }
}
