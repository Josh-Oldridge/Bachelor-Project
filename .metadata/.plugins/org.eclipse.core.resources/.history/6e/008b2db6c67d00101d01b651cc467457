/* Globals for inference (shared with main.c via extern) */
extern volatile float    feat_win[SEQ_LEN][FEAT_DIM];  // from enc_sampler.c
extern volatile uint32_t win_ready;                    // from enc_sampler.c
volatile uint32_t       inf_total = 0;                 // owned here
volatile float          last_y[AI_NETWORK_OUT_1_SIZE]; // owned here

static int acquire_and_process_data(ai_float* data[])
{
  /* Returns 0 on success, -1 if no window ready */
  return EncSampler_CopyWindowLinear((float*)data[0]);
}



/* class indices for readability (from model_meta.h order) */
#define C_JITTER       0
#define C_MISSINGSTEP  1
#define C_NORMAL       2
#define C_ZINDEX       3

static inline void force_vs_normal(int cls, float p)
{
  for (int k = 0; k < AI_NETWORK_OUT_1_SIZE; ++k) last_y[k] = 0.0f;
  last_y[cls]      = p;           // e.g. 0.95..0.999
  last_y[C_NORMAL] = 1.0f - p;    // remainder goes to NORMAL
}

static int post_process(ai_float* data[])
{
  const ai_float* out = data[0];

  for (int i = 0; i < AI_NETWORK_OUT_1_SIZE; ++i)
    last_y[i] = out[i];

  const uint32_t rf = win_rule_flags;

  if (rf & RS_A_STUCK) {
    force_vs_normal(C_MISSINGSTEP, 0.999f);
  } else if (rf & RS_B_STUCK) {
    force_vs_normal(C_MISSINGSTEP, 0.999f);
  } else if (rf & RS_QUAD_BAD) {
    float p = last_y[C_JITTER]; if (p < 0.95f) p = 0.95f;
    force_vs_normal(C_JITTER, p);
  } else if (rf & RS_Z_MISSED) {
    float p = last_y[C_ZINDEX]; if (p < 0.95f) p = 0.95f;
    force_vs_normal(C_ZINDEX, p);
  }

  inf_total++;
  return 0;
}






