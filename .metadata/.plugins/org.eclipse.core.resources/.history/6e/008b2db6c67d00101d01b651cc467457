void MX_X_CUBE_AI_Process(void)
{
  if (!network) return;

  int res;
  uint32_t drained = 0;

  for (;;)
  {
    // non-blocking: returns 0 when a window was copied, -1 if none ready
    res = acquire_and_process_data(data_ins);
    if (res != 0) break;

    // --- time the network run
    //uint32_t t0 = HAL_GetTick();
    res = ai_run();
    //uint32_t dt = HAL_GetTick() - t0;

    if (res != 0) {  // ai_run error
      ai_error err = ai_network_get_error(network);
      ai_log_err(err, "ai_network_run");
      break;
    }

    post_process(data_outs);  // increments inf_total
    drained++;

