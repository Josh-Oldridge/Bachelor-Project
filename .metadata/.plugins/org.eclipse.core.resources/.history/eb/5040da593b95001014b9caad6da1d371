/* AB×2-based synthetic Z every 2000 AB×2 steps (PRE-Z latch, Z row at window end) */
void EncSampler_SynthFeed_Z2000_Once(void)
{
  static uint32_t ab_x2 = 0;   /* since-Z counter in AB×2, 0..1999 */
  static uint32_t z_seq = 0;

#ifndef STAMP_MOD_X2
#define STAMP_MOD_X2  2000u
#endif

#if SYNTH_FORCE_Z_EVERY_WINDOW
  ab_x2 = 0;
#endif

  const uint16_t w = wf_w;
  const uint32_t win_span_x2 = (uint32_t)SEQ_LEN;   /* 1 AB×2 per row */

  /* Place Z on the LAST row if a wrap happens inside this window */
  int16_t z_row = -1;
  if (ab_x2 + win_span_x2 >= STAMP_MOD_X2) {
    z_row = (int16_t)(SEQ_LEN - 1);   /* put PRE-Z row at the very end */
  }

#if ENABLE_TRACE_WIN
  memset(trace_z, 0, SEQ_LEN);
#endif

  const uint32_t start_ab_x2 = ab_x2;

  for (uint8_t row = 0; row < SEQ_LEN; ++row) {
    const uint8_t packZ = (row == z_row) ? 1u : 0u;

    /* Current edge: prev_gray -> curr_gray (advance by one AB×2) */
    const uint8_t prev_gray = GRAY_RING[(uint8_t)(ab_x2 & 3u)];
    const uint8_t curr_gray = GRAY_RING[(uint8_t)((ab_x2 + 1u) & 3u)];

    /* Which bit toggled? A=bit1, B=bit0 (00→01 B↑, 01→11 A↑, 11→10 B↓, 10→00 A↓) */
    const uint8_t toggled = (uint8_t)(prev_gray ^ curr_gray);
    const uint8_t src_A   = (toggled & 0x2u) ? 1u : 0u;
    const uint8_t src_B   = (toggled & 0x1u) ? 1u : 0u;

    /* PRE-Z SSZ in AB×2: 1..2000; the PRE-Z row will read 2000 */
    const uint32_t ssz_ab2 = (uint32_t)(ab_x2 + 1u);

    /* Write features for this row */
    float *f = &win_ring[w][(uint32_t)row * FEAT_DIM];
    f[0] = scale_feat(0, (float)curr_gray);  /* AB_State (0,1,3,2) */
    f[1] = scale_feat(1, (float)src_A);      /* SRC_A */
    f[2] = scale_feat(2, (float)src_B);      /* SRC_B */
    f[3] = scale_feat(3, 1.0f);              /* dir_fwd */
    f[4] = scale_feat(4, 0.0f);              /* dir_bwd */
    f[5] = scale_feat(5, 0.0f);              /* SCR */
    f[6] = scale_feat(6, (float)packZ);      /* Z (PRE-Z on this AB row) */
    f[7] = scale_feat(7, (float)ssz_ab2);    /* SSZ (AB×2 units) */
    f[8] = scale_feat(8, 0.0f);              /* same_src */
    f[9] = scale_feat(9, 1.0f);              /* adjacent */

#if ENABLE_TRACE_WIN
    trace_ab[row]  = curr_gray;
    trace_src[row] = src_A ? 1u : 2u;        /* 1=A, 2=B */
    trace_z[row]   = packZ;
#endif

    /* advance one AB×2 and wrap at 2000 */
    ab_x2 += 1u;
    if (ab_x2 >= STAMP_MOD_X2) ab_x2 = 0u;
  }

  /* Legacy AB×4 bookkeeping (derived from AB×2) */
  const uint32_t end_ab_x2   = ab_x2;
  const uint32_t start_ab_x4 = start_ab_x2 << 1;
  const uint32_t end_ab_x4   = end_ab_x2   << 1;
  win_ab_start_x4[w] = start_ab_x4;
  win_ab_end_x4[w]   = end_ab_x4;

  if (z_row >= 0) {
    win_z_row[w]   = (uint16_t)z_row;  /* = SEQ_LEN-1 */
    win_z_epoch[w] = ++z_seq;
  } else {
    win_z_row[w]   = 0xFFFFu;
    win_z_epoch[w] = 0u;
  }
  win_z_seq_end[w] = z_seq;

  uint32_t flags = 0;
  if (z_row >= 0) flags |= WR_ZINWIN;
  flags_ring[w] = flags;

  last_window_dir = +1;
  enc_latched_dir = +1;

  /* publish window */
  __disable_irq();
  wf_w = (uint16_t)((wf_w + 1u) & WINMASK);
  if (wf_count < WINFIFO) { wf_count++; } else { wf_r = (uint16_t)((wf_r + 1u) & WINMASK); }
  win_ready = wf_count;
#if ENABLE_TRACE_WIN
  memcpy(last_trace_ab,  trace_ab,  SEQ_LEN);
  memcpy(last_trace_src, trace_src, SEQ_LEN);
  memcpy(last_trace_z,   trace_z,   SEQ_LEN);
#endif
  __enable_irq();

  win_total++;
}

/* (Optional) PRE/POST counters for logs, counting the PRE-Z row inside PRE */
static inline void ComputePrePostForLog_PREZ(uint16_t z_row, uint32_t *pre_ab2, uint32_t *post_ab2)
{
  if (z_row != 0xFFFFu) {
    *pre_ab2  = (uint32_t)z_row + 1u;         /* include Z row */
    *post_ab2 = (uint32_t)SEQ_LEN - *pre_ab2; /* likely 0 when z_row==SEQ_LEN-1 */
  } else {
    *pre_ab2 = SEQ_LEN;
    *post_ab2 = 0u;
  }
}
