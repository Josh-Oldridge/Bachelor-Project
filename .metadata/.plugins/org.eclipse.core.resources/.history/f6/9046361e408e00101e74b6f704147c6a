#ifndef DIAG_TIMING_H
#define DIAG_TIMING_H

#ifdef __cplusplus
extern "C" {
#endif

#include <stdint.h>
#include <stdbool.h>
#include "main.h"   // uses INT_PIN_*, MODEL_PIN_* and HAL_RCC_GetHCLKFreq()

/* Gate all instrumentation (0 = compile out / no-ops) */
#ifndef DIAG_ENABLE
#define DIAG_ENABLE 1
#endif

typedef struct {
  uint32_t count;
  uint64_t cycles_total;
  uint32_t cycles_max;
} diag_metric_cycles_t;

typedef struct {
  uint32_t count;
  uint64_t us_total;
  uint32_t us_max;
} diag_metric_us_t;

typedef struct {
  diag_metric_cycles_t isr;          // EncSampler_EncoderIRQ_Drain() total service
  diag_metric_cycles_t pack;         // per AB event -> features packed
  diag_metric_cycles_t win_publish;  // window publish section
  diag_metric_cycles_t model;        // ai_run() wall time in cycles
  diag_metric_us_t     win_wall;     // first-row -> publish (us)

  /* Health / saturation */
  uint32_t eventbuf_max_used;
  uint32_t eventbuf_capacity;
  uint32_t winfifo_max_ready;
  uint32_t winfifo_capacity;
  uint32_t event_drops_total;
} diag_timing_metrics_t;

/* Init / dump */
void diag_init(void);
void diag_reset_metrics(void);
void diag_get_metrics(diag_timing_metrics_t *out);
void diag_dump_metrics(void); /* uses printf() */

/* ISR timing + IRQ pin (INT_PIN) */
void diag_irq_enter(void);
void diag_irq_exit(void);

/* Packing (per AB event) */
void diag_pack_start(void);
void diag_pack_end(void);

/* Window publish */
void diag_winpub_start(void);
void diag_winpub_end(void);

/* Window wall time */
void diag_window_first_row_mark(void);
void diag_window_published_mark(void);

/* Model inference + MODEL_PIN */
void diag_model_start(void);
void diag_model_end(void);

/* Watermarks (call from your code paths) */
void diag_mark_eventbuf(uint32_t used, uint32_t capacity);
void diag_mark_winfifo(uint32_t ready, uint32_t capacity);
void diag_add_event_drops(uint32_t drops_inc);

/* Helpers */
uint32_t diag_cycles_per_us(void);

#ifdef __cplusplus
}
#endif
#endif /* DIAG_TIMING_H */
