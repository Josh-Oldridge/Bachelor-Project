#ifndef SYNTHETIC_H
#define SYNTHETIC_H

#include <stdint.h>

/* ======================= Z test modes (compile-time) =======================
   Select with -DSYNTH_Z_MODE=... when SYNTH_CLASS==C_ZINDEX
     ZMODE_SINGLE   : one Z caret in the window (baseline z_index)
     ZMODE_ZMISS    : no Z caret + flags→WR_ZMISS
     ZMODE_ZDOUBLE  : two carets within a short gap + flags→WR_ZDOUBLE
     ZMODE_ZMISALIGN: one caret but flags→WR_ZMISALIGN (to exercise guardrail)
*/
#ifndef SYNTH_Z_MODE
#define SYNTH_Z_MODE 2
#endif

enum { ZMODE_SINGLE = 0, ZMODE_ZMISS = 1, ZMODE_ZDOUBLE = 2, ZMODE_ZMISALIGN = 3 };

/* Rows between the two carets for ZDOUBLE (keep small, e.g., 1..3) */
#ifndef SYNTH_Z_GAP_ROWS
#define SYNTH_Z_GAP_ROWS 1
#endif

/* Core helpers */
const float* EncSynth_GetFlat(void);
void EncSynth_DebugPrint(void);

/* NEW: expose rule flags for the last synthetic window so post-proc floors apply */
uint32_t EncSynth_GetFlags(void);

/* Normal: perfect Gray sequence
   - forward: 1=fwd 0=bwd
   - start_state: 0..3  (Gray)
   - steps0: initial Steps_Since_Z
   - rising_only: 1 => only rising edges become rows; 0 => rise+fall become rows
*/
void EncSynth_MakeNormalWindow(int forward, int start_state, int steps0, int rising_only);

/* Missing-step: “skip” the other channel once so the same channel fires twice in a row */
void EncSynth_MakeMissingStepWindow(int forward, int start_state, int steps0,
                                    int which_channel, int t_at, int rising_only);

/* Z-index: generates one window and (based on SYNTH_Z_MODE) emits:
     SINGLE   : one Z caret at t_z
     ZMISS    : no Z caret (flags set)
     ZDOUBLE  : two carets (t_z and t_z+SYNTH_Z_GAP_ROWS) (flags set)
     ZMISALIGN: one caret at t_z (flags set) */
void EncSynth_MakeZIndexWindow(int forward, int start_state, int steps0,
                               int t_z, int rising_only);

#endif /* SYNTHETIC_H */
