// enc_sampler.c — X4 encoder (TIM1 encoder mode) with DIR from hardware
// Lossless 1s capture at high rates + post-trial replay into windows.
// - IRQ on CC1/CC2 rising edges; Z (IDX) handled first.
// - Direction comes only from TIM1->CR1.DIR (optional ENC_DIR_REVERSED).
// - AB state for model = read GPIO A/B directly (no synthetic toggling).
// - During a 1s trial (cap_active==1), every edge is stored into cap_buf
//   and NOT mirrored into the live event FIFO -> zero drops in trial.
// - After the trial, EncSampler_Process() will automatically replay
//   the raw capture into windows at the pace the model can drain.
//
// Memory knobs (override in your build or before including this file):
//   - CAPTURE_MAX_EDGES_PER_SEC (default 200000) and CAPTURE_SEC (default 1)
//   - CAPTURE_BYTES (defaults to edges_per_sec*sec*sizeof(event) + margin)
//   - WINFIFO_LOG2 (default 10 -> 1024 windows ~ 800 KB)
//   - EVENT_BUF_BITS (default 15 -> 32768 events)
//
// If you want to place the big buffers into a specific RAM bank, define
//   WIN_RING_ATTR  and  CAPTURE_ATTR  e.g.  __attribute__((section(".sram5"),aligned(32)))

#include "enc_sampler.h"
#include <string.h>
#include <math.h>
#include <stdbool.h>
#include "model_meta.h"
#include "main.h"
#include "diag_timing.h"
#include "stm32n6xx_hal.h"

/* ============================= Config ================================== */

#ifndef CPR
#define CPR 500u
#endif

#ifndef HAVE_Z_INDEX
#define HAVE_Z_INDEX 1
#endif
#if !defined(TIM_SR_IDXF) || !defined(TIM_IT_IDX)
# undef HAVE_Z_INDEX
# define HAVE_Z_INDEX 0
# warning "No TIM1 IDXF/IDX in headers -> Z gated off at build time"
#endif

#ifndef FORCE_IGNORE_Z
#define FORCE_IGNORE_Z 0
#endif

#ifndef ENC_DIR_REVERSED
#define ENC_DIR_REVERSED 0
#endif

#ifndef STEPS_PER_AB_EVENT
#define STEPS_PER_AB_EVENT 2u
#endif

/* NOTE: with rising-only CC1/CC2 we observe ~2*CPR edges per rev.
 * If you later capture BOTH edges, set this back to (4u*CPR). */
#ifndef QUAD_EDGES_PER_REV
#define QUAD_EDGES_PER_REV (2u * CPR)
#endif

/* Z acceptance hygiene */
#ifndef Z_SOFT_DEBOUNCE_MS
#define Z_SOFT_DEBOUNCE_MS 0u
#endif
#ifndef Z_MIN_AB_EDGES
#define Z_MIN_AB_EDGES 2u
#endif
#ifndef Z_MIN_GAP_EDGES
#define Z_MIN_GAP_EDGES 3u  /* slightly stricter than 2 */
#endif
#ifndef Z_MISS_EDGE_LIMIT
#define Z_MISS_EDGE_LIMIT (QUAD_EDGES_PER_REV + QUAD_EDGES_PER_REV/8u)
#endif

/* Optional: warn if fixed-column Z due to commensurate lengths */
#if ((2u * CPR) % MODEL_SEQ_LEN) == 0
#warning "SEQ_LEN divides (2*CPR): Z will appear in a fixed column each window."
#endif

/* Optional Z-stamp debug print (off by default) */
#ifndef ENC_ZSTAMP_DEBUG
#define ENC_ZSTAMP_DEBUG 0
#endif
#if ENC_ZSTAMP_DEBUG
#include <stdio.h>
#define ENC_DEBUG_PRINTF(...) do { printf(__VA_ARGS__); } while(0)
#else
#define ENC_DEBUG_PRINTF(...) do { } while(0)
#endif

#ifndef ENABLE_TRACE_WIN
#define ENABLE_TRACE_WIN 0
#endif

/* ======================== Globals / Exposed state ====================== */

extern TIM_HandleTypeDef htim1;

enum {
  WR_SKIP2   = 1u<<0,
  WR_ZMISS   = 1u<<1,
  WR_ZDOUBLE = 1u<<2,
  WR_ZINWIN  = 1u<<3,   /* window contained a stamped Z row */
};

volatile uint32_t enc_rule_flags = 0;
volatile uint32_t win_rule_flags = 0;

/* FIFO flow control (windows) */
volatile uint32_t win_ready = 0;
volatile uint32_t win_total = 0;   /* optional running total */
volatile uint32_t event_drops = 0;

/* Feature sizes */
#define SEQ_LEN  (MODEL_SEQ_LEN)
#define FEAT_DIM (MODEL_FEAT_DIM)

/* ===================== SPSC window ring (zero-copy) ==================== */
/* Producer fills win_ring[wf_w] row-by-row; publishes by advancing wf_w. */
#ifndef WINFIFO_LOG2
#define WINFIFO_LOG2 10          /* 1024 windows (~800 KB). Raise to 11/12 for more. */
#endif
#define WINFIFO      (1u << WINFIFO_LOG2)
#define WINMASK      (WINFIFO - 1u)

#ifndef WIN_RING_ATTR
#define WIN_RING_ATTR __attribute__((aligned(32)))
#endif

static float    WIN_RING_ATTR win_ring[WINFIFO][SEQ_LEN * FEAT_DIM];
static uint32_t flags_ring[WINFIFO];
static uint16_t wf_w = 0, wf_r = 0, wf_count = 0;

/* Current in-construction window row index */
static uint8_t  win_row = 0;

/* ========================= Optional per-window trace =================== */
#if ENABLE_TRACE_WIN
static uint8_t trace_ab[SEQ_LEN];
static uint8_t trace_src[SEQ_LEN];
static uint8_t trace_z[SEQ_LEN];

static uint8_t last_trace_ab[SEQ_LEN];
static uint8_t last_trace_src[SEQ_LEN];
static uint8_t last_trace_z[SEQ_LEN];
#endif

/* ============================ Encoder state ============================ */

typedef struct {
  uint8_t  last_AB_state;       /* Gray digit (bit1=A, bit0=B) */
  float    speed_change_rate;   /* |interval_ratio - 1| */
  float    baseline_interval;   /* EWMA step interval (ms) */
} encoder_state_t;

static encoder_state_t enc_state = { 0 };

/* Direction tracking (+1 forward, -1 backward), always from HW DIR bit */
static volatile int8_t enc_latched_dir = +1;
int8_t EncSampler_GetLatchedDir(void) { return enc_latched_dir; }

/* Last window summarized direction */
static volatile int8_t last_window_dir = +1;
int8_t EncSampler_GetLastWindowDir(void) { return last_window_dir; }

/* Z timing (ISR) */
static volatile uint32_t z_last_ms_isr = 0;

/* Canonical edges since last accepted Z (monotonic 32-bit) */
static volatile uint32_t ab_edges_since_z_isr = 0;

/* Z epoch: increments ONCE per accepted Z in ISR */
volatile uint32_t z_epoch_isr = 0;
/* Main-side last seen epoch (kept equal to z_epoch_isr when stamped) */
static uint32_t z_epoch_seen_main = 0;

/* Public diagnostics (read by app) */
volatile uint32_t z_diag_isr_seen         = 0;
volatile uint32_t z_diag_isr_accepted     = 0;
volatile uint32_t z_diag_ab_since_isr     = 0;
/* steps since last accepted Z (scaled by STEPS_PER_AB_EVENT) */
volatile uint32_t z_diag_steps_x4 = 0;
volatile uint32_t z_diag_last_z_ms        = 0;

/* ===================== Synth Gray (for printing only) =================== */
/* Ring order: 0,1,3,2  (bit1=A, bit0=B) */
static inline uint8_t gray_to_ring_idx(uint8_t g) {
  switch (g & 3u) { case 0: return 0; case 1: return 1; case 3: return 2; case 2: return 3; default: return 0; }
}
static const uint8_t GRAY_RING[4] = {0, 1, 3, 2};
static volatile uint8_t synth_ring_idx = 0;
static volatile uint8_t synth_gray     = 0;

/* ============================ Events =================================== */

typedef struct {
  uint8_t  src;           /* 1=CC1(A), 2=CC2(B) */
  int8_t   dir;           /* +1/-1 from hardware DIR at capture time */
  uint8_t  ab_state;      /* Gray at capture */
  uint16_t ccr;           /* captured counter (debug/optional) */
  uint32_t timestamp_ms;  /* HAL_GetTick() */
} encoder_event_t;

#ifndef EVENT_BUF_BITS
#define EVENT_BUF_BITS    15       /* 32768 live events. */
#endif
#define EVENT_BUFFER_SIZE (1u << EVENT_BUF_BITS)
#define EVENT_IDX_MASK    (EVENT_BUFFER_SIZE - 1u)

static encoder_event_t event_buffer[EVENT_BUFFER_SIZE];
static volatile uint32_t event_write = 0;
static volatile uint32_t event_read  = 0;

/* =========================== 1s RAW CAPTURE ============================ */
/* Lossless capture of every event for 1s, then post-trial replay.       */
#ifndef CAPTURE_MAX_EDGES_PER_SEC
#define CAPTURE_MAX_EDGES_PER_SEC 200000u    /* budget ~200k/s */
#endif
#ifndef CAPTURE_SEC
#define CAPTURE_SEC 1u
#endif

#ifndef CAPTURE_BYTES
/* event struct is small; add margin to avoid wrap */
#define CAPTURE_BYTES ((CAPTURE_MAX_EDGES_PER_SEC * CAPTURE_SEC + 4096u) * (uint32_t)sizeof(enc_capture_evt_t))
#endif

enum { CAP_F_Z = 1u << 0 };

#ifndef CAPTURE_MAX_EVENTS
#define CAPTURE_MAX_EVENTS   (CAPTURE_BYTES / sizeof(enc_capture_evt_t))
#endif

#ifndef CAPTURE_ATTR
#define CAPTURE_ATTR __attribute__((aligned(32)))
#endif

static enc_capture_evt_t CAPTURE_ATTR cap_buf[CAPTURE_MAX_EVENTS];
_Static_assert(CAPTURE_MAX_EVENTS > 0, "CAPTURE_MAX_EVENTS must be > 0");

static volatile uint32_t cap_w = 0, cap_r = 0, cap_count = 0, cap_drops = 0;
static volatile uint8_t  cap_armed = 0, cap_active = 0, cap_done = 0;
static volatile uint32_t cap_start_ms = 0, cap_end_ms = 0, cap_duration_ms = 0;

static inline void cap_reset_locked(void) {
  cap_w = cap_r = cap_count = cap_drops = 0;
  cap_done = 0;
}

static inline void cap_push_isr(uint8_t src, int8_t dir, uint16_t ccr,
                                uint8_t ab, uint32_t t_ms, uint8_t flags)
{
  uint32_t next = cap_w + 1u;
  if (next >= CAPTURE_MAX_EVENTS) next = 0;
  if (next == cap_r) { cap_drops++; return; }

  enc_capture_evt_t *e = &cap_buf[cap_w];
  e->t_ms     = t_ms;
  e->ccr      = ccr;
  e->src      = src;
  e->dir      = dir;
  e->ab_state = ab;
  e->flags    = flags;

  cap_w = next;
  cap_count++;
}

/* ============================ Helpers ================================== */

static inline float scale_feat(int j, float x) {
  float y = (x - MODEL_FEAT_MIN[j]) * MODEL_FEAT_SCALE[j];
  if (y < 0.f) y = 0.f;
  if (y > 1.f) y = 1.f;
  return y;
}

static inline uint8_t enc_read_AB(void) {
  const uint32_t idr = GPIOE->IDR;              /* A=PE9, B=PE11 */
  const uint8_t a = (idr & ENC_A_Pin) ? 1u : 0u;
  const uint8_t b = (idr & ENC_B_Pin) ? 1u : 0u;
  return (uint8_t)((a << 1) | b);
}

/* Hardware DIR at capture time */
static inline int8_t dir_from_hw(void) {
  int8_t dir = ((TIM1->CR1 & TIM_CR1_DIR) == 0) ? +1 : -1; /* DIR=0 => up */
#if ENC_DIR_REVERSED
  dir = (int8_t)-dir;
#endif
  return dir;
}

/* ======================= IRQ enable helpers ============================ */

static volatile uint8_t ab_irqs_on = 1;  /* mirror state for AB (CC1/CC2) */

static inline void EncSampler_ConfigIRQs(void) {
  /* Enable AB by default here; user can gate later via EncSampler_SetABIrqs(0) */
  __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2);
#if HAVE_Z_INDEX && !FORCE_IGNORE_Z
  __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_IDX);  /* keep Z always enabled */
#endif
  __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_UPDATE | TIM_IT_TRIGGER | TIM_IT_COM);
  __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_UIF | TIM_SR_TIF | TIM_SR_COMIF);
}

void EncSampler_SetABIrqs(uint8_t on)
{
  __disable_irq();
  if (on) {
    __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2);
  } else {
    __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2);
    /* Clear any pending capture flags so we don't get a burst later */
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC1IF | TIM_SR_CC1OF |
                                TIM_SR_CC2IF | TIM_SR_CC2OF);
  }
  ab_irqs_on = on ? 1u : 0u;
  __enable_irq();
}

/* ======================== IRQ Drain (encoder) ========================== */

static inline void push_event_isr(uint8_t src, int8_t dir, uint16_t ccr_sample,
                                  uint8_t ab_state)
{
  const uint32_t next = (event_write + 1u) & EVENT_IDX_MASK;
  if (next == event_read) { event_drops++; Diag_AddEventDrops(1); return; }
  encoder_event_t *e = &event_buffer[event_write];
  e->timestamp_ms = HAL_GetTick();
  e->ccr          = ccr_sample;
  e->src          = src;
  e->dir          = dir;
  e->ab_state     = ab_state;
  event_write = next;
}

/* When capturing, we want lossless raw capture only; skip live event FIFO. */
#ifndef CAPTURE_STEALS_EVENTS
#define CAPTURE_STEALS_EVENTS 1
#endif

void EncSampler_EncoderIRQ_Drain(void) {
  /* Begin ISR timing + scope pulse */
  HAL_GPIO_WritePin(INT_PIN_GPIO_Port, INT_PIN_Pin, GPIO_PIN_SET);
  DiagTiming_Start(DIAG_T_ISR_TOTAL);

  for (int guard = 0; guard < 256; ++guard) {
    uint32_t sr = TIM1->SR;
    uint32_t pending = sr & (TIM_SR_CC1IF | TIM_SR_CC2IF | TIM_SR_CC1OF | TIM_SR_CC2OF);
#if HAVE_Z_INDEX && !FORCE_IGNORE_Z && defined(TIM_SR_IDXF)
    pending |= (sr & TIM_SR_IDXF);
#endif
    if (!pending) break;

    /* Overcapture flags */
    if (sr & TIM_SR_CC1OF) {
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC1OF);
      event_drops++; Diag_AddEventDrops(1);
    }
    if (sr & TIM_SR_CC2OF) {
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC2OF);
      event_drops++; Diag_AddEventDrops(1);
    }

    /* ----- Z FIRST (no enqueue; epoch bump only) ----- */
#if HAVE_Z_INDEX && !FORCE_IGNORE_Z && defined(TIM_SR_IDXF)
    if (sr & TIM_SR_IDXF) {
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_IDX);
# ifdef TIM_SR_IDXF
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
# endif
      z_diag_isr_seen++;

      const uint32_t now_ms = HAL_GetTick();
      const int32_t  dt_ms  = (int32_t)(now_ms - z_last_ms_isr);

      if ((dt_ms >= (int32_t)Z_SOFT_DEBOUNCE_MS) &&
          (ab_edges_since_z_isr >= Z_MIN_AB_EDGES)) {

        /* Accept Z: reset distance-from-Z, bump epoch */
        ab_edges_since_z_isr = 0;
        z_diag_ab_since_isr  = 0;
        z_diag_steps_x4 = 0;

        z_last_ms_isr    = now_ms;
        z_diag_last_z_ms = now_ms;
        z_diag_isr_accepted++;

        /* One-shot epoch bump; main loop will stamp on next AB row */
        z_epoch_isr++;

        /* Start raw capture exactly on accepted Z if armed */
        if (cap_armed && !cap_active) {
          cap_active   = 1u;
          cap_armed    = 0u;
          cap_done     = 0u;
          cap_start_ms = now_ms;
          cap_end_ms   = now_ms + cap_duration_ms;
          /* Record the Z itself as a mark */
          cap_push_isr(0u, dir_from_hw(), 0u, enc_read_AB() & 3u, now_ms, CAP_F_Z);
        }

        /* Trial controller: start 1s capture after Z if armed */
        Diag_NotifyZAccepted(now_ms);

#if ENC_ZSTAMP_DEBUG
        printf("Z_ISR accept @%lu ms, epoch=%lu\n",
               (unsigned long)now_ms, (unsigned long)z_epoch_isr);
#endif
      }
    }
#endif

    /* Refresh SR after Z clear */
    sr = TIM1->SR;

    /* ----- CC1 pending ----- */
    if (sr & TIM_SR_CC1IF) {
      const uint16_t c1 = (uint16_t)TIM1->CCR1;
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC1);
      const uint8_t ab  = enc_read_AB() & 0x3u;
      const int8_t  dir = dir_from_hw();
      enc_latched_dir = dir;

      /* Capture path: always record into cap_buf when active */
      if (cap_active) {
        uint32_t tms = HAL_GetTick();
        cap_push_isr(1u, dir, c1, ab, tms, 0u);
        if ((int32_t)(tms - cap_end_ms) >= 0) { cap_active = 0u; cap_done = 1u; }
      }
#if !CAPTURE_STEALS_EVENTS
      /* Mirror to live FIFO as well (optional, may drop if busy) */
      push_event_isr(1u, dir, c1, ab);
#else
      /* When capturing, we do NOT mirror to live FIFO -> no drops. */
      if (!cap_active) push_event_isr(1u, dir, c1, ab);
#endif

      /* Monotonic edges since last Z (32-bit, only reset on Z) */
      ab_edges_since_z_isr++;
      z_diag_ab_since_isr = ab_edges_since_z_isr;
      z_diag_steps_x4 = ab_edges_since_z_isr * STEPS_PER_AB_EVENT;
      continue;
    }

    /* ----- CC2 pending ----- */
    if (sr & TIM_SR_CC2IF) {
      const uint16_t c2 = (uint16_t)TIM1->CCR2;
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC2);
      const uint8_t ab  = enc_read_AB() & 0x3u;
      const int8_t  dir = dir_from_hw();
      enc_latched_dir = dir;

      /* Capture path */
      if (cap_active) {
        uint32_t tms = HAL_GetTick();
        cap_push_isr(2u, dir, c2, ab, tms, 0u);
        if ((int32_t)(tms - cap_end_ms) >= 0) { cap_active = 0u; cap_done = 1u; }
      }
#if !CAPTURE_STEALS_EVENTS
      push_event_isr(2u, dir, c2, ab);
#else
      if (!cap_active) push_event_isr(2u, dir, c2, ab);
#endif

      ab_edges_since_z_isr++;
      z_diag_ab_since_isr = ab_edges_since_z_isr;
      z_diag_steps_x4 = z_diag_ab_since_isr * STEPS_PER_AB_EVENT;
      continue;
    }

#ifdef TIM_SR_TERRF
    if (sr & TIM_SR_TERRF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_TERRF); }
#endif
#ifdef TIM_SR_IERRF
    if (sr & TIM_SR_IERRF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IERRF); }
#endif
  }

  /* Record backlog watermark after draining */
  {
    const uint32_t level = (event_write - event_read) & EVENT_IDX_MASK;
    Diag_ObserveEventBufLevel(level);
  }

  /* End ISR timing + scope pulse */
  DiagTiming_Stop(DIAG_T_ISR_TOTAL);
  HAL_GPIO_WritePin(INT_PIN_GPIO_Port, INT_PIN_Pin, GPIO_PIN_RESET);

  __DSB();
}

/* ============================ Replay state ============================= */
/* After cap_done, we can replay raw capture into windows losslessly.    */

static uint8_t  replay_active   = 0;
static uint8_t  replay_pendingZ = 0;
static uint32_t replay_pos      = 0;
static uint32_t replay_end      = 0;
/* keep own AB since Z for replay so features are consistent */
static uint32_t replay_ab_since_z = 0;

/* Start replay: compute linear range [replay_pos, replay_end) */
void EncSampler_ReplayStart(void)
{
  __disable_irq();
  if (!cap_done || replay_active) { __enable_irq(); return; }

  /* if ring wrapped, start is (cap_w - cap_count) modulo size */
  uint32_t start = (cap_w + CAPTURE_MAX_EVENTS - (cap_count % CAPTURE_MAX_EVENTS)) % CAPTURE_MAX_EVENTS;
  replay_pos = start;
  replay_end = cap_w;
  replay_active   = 1u;
  replay_pendingZ = 0u;
  replay_ab_since_z = 0u;

  /* Reset main-side Z stamp sync so we stamp exactly at first AB after CAP_F_Z */
  z_epoch_seen_main = z_epoch_isr;
  __enable_irq();
}

/* Pump up to max_events capture records into the window builder */
int EncSampler_ReplayStep(uint32_t max_events)
{
  if (!replay_active || max_events == 0) return 0;

  uint32_t processed = 0;

  while (processed < max_events) {
    if (replay_pos == replay_end) {
      replay_active = 0u;
      break;
    }

    enc_capture_evt_t e = cap_buf[replay_pos];
    replay_pos = (replay_pos + 1u);
    if (replay_pos >= CAPTURE_MAX_EVENTS) replay_pos = 0u;

    /* CAP_F_Z is a marker: stamp Z on the next AB edge */
    if (e.flags & CAP_F_Z) {
      replay_pendingZ = 1u;
      z_diag_last_z_ms = e.t_ms;
      continue;
    }

    /* Build a synthetic 'encoder_event_t' to reuse the packer below */
    encoder_event_t evt;
    evt.src = e.src;
    evt.dir = e.dir;
    evt.ab_state = e.ab_state;
    evt.ccr = e.ccr;
    evt.timestamp_ms = e.t_ms;

    /* Feed one event into the packer (replay mode) */
    /* Pack function below reads replay_pendingZ to stamp Z once */
    /* It also uses replay_ab_since_z instead of the ISR counter */
    /* and respects window FIFO backpressure. */
    /* If window ring is full, stop now and let the app drain. */
    if (wf_count >= WINFIFO - 1) break;

    /* Do the pack */
    {
      /* replicate the inner packer with replay-specific paths */
      static uint32_t last_ms = 0;
      static uint32_t gray_skip2   = 0;
      static uint8_t  last_src     = 0;
      static int32_t  dir_sum      = 0;
      static uint32_t rule_flags_live = 0;
      static uint8_t  had_z_in_win = 0;

      /* Start-of-window housekeeping */
      if (win_row == 0) {
        had_z_in_win = 0;
        DiagTiming_Start(DIAG_T_E2E_WINDOW);
      }

      const uint8_t current_gray = (evt.ab_state & 0x3u);
      const int8_t  dir          = evt.dir;
      const uint8_t dir_fwd = (dir > 0);
      const uint8_t dir_bwd = (dir < 0);
      if (dir_fwd) dir_sum++; else if (dir_bwd) dir_sum--;

      /* speed-change feature based on ms (same as live) */
      const uint32_t now_ms = evt.timestamp_ms;
      int32_t dms = (int32_t)(now_ms - last_ms);
      if (dms <= 0) dms = 1;
      const float dt_ms = (float)dms;
      if (enc_state.baseline_interval < 1.0f) enc_state.baseline_interval = dt_ms;
      const float ratio = dt_ms / enc_state.baseline_interval;
      enc_state.speed_change_rate = fabsf(ratio - 1.0f);
      enc_state.baseline_interval = 0.9f * enc_state.baseline_interval + 0.1f * dt_ms;
      last_ms = now_ms;

      /* Z stamp: in replay we stamp once on first AB after CAP_F_Z */
      uint8_t packZ = 0u;
      if (replay_pendingZ) {
        packZ = 1u;
        replay_pendingZ = 0u;
        had_z_in_win = 1u;
        /* reset distance-from-Z in replay domain */
        replay_ab_since_z = 0u;

        /* keep synth gray phase-locked for prints */
        synth_ring_idx = gray_to_ring_idx(current_gray & 3u);
        synth_gray     = GRAY_RING[synth_ring_idx];
      }

      /* Rule flags (diagnostic) */
      if (packZ && (replay_ab_since_z < Z_MIN_GAP_EDGES)) rule_flags_live |= WR_ZDOUBLE;
      if (replay_ab_since_z > Z_MISS_EDGE_LIMIT)          rule_flags_live |= WR_ZMISS;

      /* Adjacency check */
      const uint8_t prev_gray = enc_state.last_AB_state;
      const uint8_t diff_bits = (prev_gray ^ current_gray) & 3u;
      const uint8_t adjacent  = (diff_bits == 1u) || (diff_bits == 2u);

      /* Synth gray just for traces */
      {
        uint8_t expect_src = (dir > 0)
                             ? ((synth_ring_idx & 1u) ? 1u : 2u)
                             : ((synth_ring_idx & 1u) ? 2u : 1u);
        if (evt.src != expect_src) synth_ring_idx = gray_to_ring_idx(current_gray);
        if (dir > 0) synth_ring_idx = (uint8_t)((synth_ring_idx + 1) & 3u);
        else         synth_ring_idx = (uint8_t)((synth_ring_idx + 3) & 3u);
        synth_gray = GRAY_RING[synth_ring_idx];
      }

      /* Pack features */
      DiagTiming_Start(DIAG_T_PACK_AB);
      float *slot = &win_ring[wf_w][0];
      float *f    = slot + ((uint32_t)win_row * FEAT_DIM);

      const uint8_t src_A = (evt.src == 1u);
      const uint8_t src_B = (evt.src == 2u);
      const uint8_t is_same_src = (last_src && (evt.src == last_src)) ? 1u : 0u;

      f[0] = scale_feat(0, (float)current_gray);
      f[1] = scale_feat(1, (float)src_A);
      f[2] = scale_feat(2, (float)src_B);
      f[3] = scale_feat(3, (float)dir_fwd);
      f[4] = scale_feat(4, (float)dir_bwd);
      f[5] = scale_feat(5, enc_state.speed_change_rate);
      f[6] = scale_feat(6, (float)packZ);
      f[7] = scale_feat(7, (float)replay_ab_since_z);
      f[8] = scale_feat(8, (float)is_same_src);
      f[9] = scale_feat(9, (float)adjacent);

      DiagTiming_Stop(DIAG_T_PACK_AB);

#if ENABLE_TRACE_WIN
      if (win_row == 0) memset(trace_z, 0, SEQ_LEN);
      trace_ab[win_row]  = (synth_gray & 3u);
      trace_src[win_row] = evt.src;
      trace_z[win_row]   = packZ;
#endif

      Diag_NotifyABEdge();

      if (is_same_src) gray_skip2++;
      last_src = evt.src;
      enc_state.last_AB_state = current_gray;

      /* Advance counters */
      win_row++;
      replay_ab_since_z++; /* distance since last Z in replay domain */

      /* Full window publish */
      if (win_row >= SEQ_LEN) {
        uint32_t flags = rule_flags_live;
        if (gray_skip2 >= 2) flags |= WR_SKIP2;
        if (had_z_in_win)    flags |= WR_ZINWIN;
        enc_rule_flags = flags;

        if (dir_sum > 0)      last_window_dir = +1;
        else if (dir_sum < 0) last_window_dir = -1;
        else                  last_window_dir = enc_latched_dir;

        dir_sum = 0;

        DiagTiming_Stop(DIAG_T_E2E_WINDOW);
        DiagTiming_Start(DIAG_T_WIN_PUBLISH);

        flags_ring[wf_w] = flags;

        __disable_irq();
        wf_w = (uint16_t)((wf_w + 1u) & WINMASK);
        if (wf_count < WINFIFO) {
          wf_count++;
        } else {
          /* overwrite oldest if full (shouldn't happen if app drains) */
          wf_r = (uint16_t)((wf_r + 1u) & WINMASK);
        }
        win_ready = wf_count;
#if ENABLE_TRACE_WIN
        memcpy(last_trace_ab,  trace_ab,  SEQ_LEN);
        memcpy(last_trace_src, trace_src, SEQ_LEN);
        memcpy(last_trace_z,   trace_z,   SEQ_LEN);
        memset(trace_z, 0, SEQ_LEN);
#endif
        __enable_irq();

        Diag_ObserveWinFifoLevel(wf_count);
        win_total++;

        DiagTiming_Stop(DIAG_T_WIN_PUBLISH);
        Diag_NotifyWindowPublished();

        win_row = 0;
        gray_skip2 = 0;
        rule_flags_live = 0;
        last_src = 0;
        had_z_in_win = 0;
      }
    }

    processed++;
  }

  return (int)processed;
}

/* ============================ Public API =============================== */

void EncSampler_Init(void) {
  memset(&enc_state, 0, sizeof(enc_state));
  enc_state.baseline_interval = 10.0f;

  /* Seed Gray from real pins */
  enc_state.last_AB_state = (enc_read_AB() & 0x3u);
  synth_ring_idx = gray_to_ring_idx(enc_state.last_AB_state);
  synth_gray     = enc_state.last_AB_state;

  /* Reset window ring state */
  __disable_irq();
  wf_w = wf_r = 0; wf_count = 0; win_row = 0;
  win_ready = 0; win_total = 0;
  __enable_irq();

  /* Align epochs so we don't spuriously stamp at startup */
  z_epoch_seen_main = z_epoch_isr;

  /* Reset capture state */
  __disable_irq();
  cap_armed = cap_active = cap_done = 0u;
  cap_w = cap_r = cap_count = cap_drops = 0u;
  cap_start_ms = cap_end_ms = cap_duration_ms = 0u;
  replay_active = 0u; replay_pendingZ = 0u; replay_pos = replay_end = 0u;
  replay_ab_since_z = 0u;
  __enable_irq();

  /* Initialize capture buffer (ECC/cache friendly) */
  memset((void*)cap_buf, 0, sizeof(cap_buf));

  EncSampler_ConfigIRQs();
  __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_TIF | TIM_SR_COMIF);
}

/* Automatic replay pump: if a capture has finished, feed windows whenever
 * there is headroom. Call EncSampler_Process() once per loop; this will
 * drain the raw capture into windows with zero loss. */
static inline void EncSampler_ReplayPumpAuto(void)
{
  if (!replay_active && cap_done) {
    EncSampler_ReplayStart();
  }
  if (replay_active) {
    /* Push a bounded chunk each call to avoid hogging the loop */
    const uint32_t free_slots = WINFIFO - wf_count - 1u;
    /* Convert windows->events budget: rough bound SEQ_LEN events per window */
    const uint32_t budget_events = (free_slots > 0) ? (free_slots * (uint32_t)SEQ_LEN) : 0u;
    if (budget_events) {
      (void)EncSampler_ReplayStep(budget_events);
    }
  }
}

void EncSampler_Process(void) {
  /* Automatic post-trial replay into windows */
  EncSampler_ReplayPumpAuto();

  static uint32_t last_ms = 0;

  static uint32_t gray_skip2   = 0;
  static uint8_t  last_src     = 0;
  static int32_t  dir_sum      = 0;
  static uint32_t rule_flags_live = 0;

  /* Track if this window actually contained a Z stamp */
  static uint8_t  had_z_in_win = 0;

  /* Close capture if time elapsed but edges stopped */
  if (cap_active) {
    uint32_t now = HAL_GetTick();
    if ((int32_t)(now - cap_end_ms) >= 0) {
      __disable_irq();
      cap_active = 0u;
      cap_done   = 1u;
      __enable_irq();
    }
  }

  while (event_read != event_write) {
    encoder_event_t evt = event_buffer[event_read];
    event_read = (event_read + 1u) & EVENT_IDX_MASK;

    /* Keep public Z time fresh for UI */
    z_diag_last_z_ms = z_last_ms_isr;

#if ENABLE_TRACE_WIN
    if (win_row == 0) memset(trace_z, 0, SEQ_LEN);
#endif
    if (win_row == 0) {
      had_z_in_win = 0;  /* start-of-window housekeeping */
      /* Start window end-to-end wall clock at first row */
      DiagTiming_Start(DIAG_T_E2E_WINDOW);
    }

    /* Only AB rows exist in buffer */
    const uint8_t current_gray = (evt.ab_state & 0x3u);
    const int8_t  dir = evt.dir;      /* from HW DIR */
    const uint8_t dir_fwd = (dir > 0);
    const uint8_t dir_bwd = (dir < 0);
    if (dir_fwd) dir_sum++; else if (dir_bwd) dir_sum--;

    /* compute speed-change feature (EWMA of step interval) */
    const uint32_t now_ms = evt.timestamp_ms;
    int32_t dms = (int32_t)(now_ms - last_ms);
    if (dms <= 0) dms = 1;
    const float dt_ms = (float)dms;
    if (enc_state.baseline_interval < 1.0f) enc_state.baseline_interval = dt_ms;
    const float ratio = dt_ms / enc_state.baseline_interval;
    enc_state.speed_change_rate = fabsf(ratio - 1.0f);
    enc_state.baseline_interval = 0.9f * enc_state.baseline_interval + 0.1f * dt_ms;
    last_ms = now_ms;

    /* Canonical distance since Z: use ISR mirror (monotonic 32-bit) */
    const uint32_t ab_since_z = ab_edges_since_z_isr;

    /* One-shot Z stamp using epoch handshake */
    uint8_t packZ = 0u;
    if (z_epoch_isr != z_epoch_seen_main) {
      packZ = 1u;
      z_epoch_seen_main = z_epoch_isr;
      had_z_in_win = 1u;
#if ENC_ZSTAMP_DEBUG
      ENC_DEBUG_PRINTF("Z_STAMP row=%u at t=%lu ms, ab_since=%lu\n",
                       (unsigned)win_row, (unsigned long)now_ms, (unsigned long)ab_since_z);
#endif
      /* Phase-lock printing synth gray to actual AB at Z moment */
      synth_ring_idx = gray_to_ring_idx(current_gray & 3u);
      synth_gray     = GRAY_RING[synth_ring_idx];
    }

    /* Rule flags (diagnostic) */
    if (packZ && (ab_since_z < Z_MIN_GAP_EDGES)) rule_flags_live |= WR_ZDOUBLE;
    if (ab_since_z > Z_MISS_EDGE_LIMIT)          rule_flags_live |= WR_ZMISS;

    /* Adjacency check */
    const uint8_t prev_gray = enc_state.last_AB_state;
    const uint8_t diff_bits = (prev_gray ^ current_gray) & 3u;
    const uint8_t adjacent  = (diff_bits == 1u) || (diff_bits == 2u);

    /* Synth Gray step just for prints/traces */
    {
      uint8_t expect_src = (dir > 0)
                           ? ((synth_ring_idx & 1u) ? 1u : 2u)
                           : ((synth_ring_idx & 1u) ? 2u : 1u);
      if (evt.src != expect_src) synth_ring_idx = gray_to_ring_idx(current_gray);
      if (dir > 0) synth_ring_idx = (uint8_t)((synth_ring_idx + 1) & 3u);
      else         synth_ring_idx = (uint8_t)((synth_ring_idx + 3) & 3u);
      synth_gray = GRAY_RING[synth_ring_idx];
    }

    /* === Pack features directly into the current ring slot (zero-copy) === */
    DiagTiming_Start(DIAG_T_PACK_AB);

    float *slot = &win_ring[wf_w][0];
    float *f    = slot + ((uint32_t)win_row * FEAT_DIM);

    /* Pack features for model */
    const uint8_t src_A = (evt.src == 1u);
    const uint8_t src_B = (evt.src == 2u);
    const uint8_t is_same_src = (last_src && (evt.src == last_src)) ? 1u : 0u;

    f[0] = scale_feat(0, (float)current_gray);          /* AB gray (real pins) */
    f[1] = scale_feat(1, (float)src_A);                 /* SRC A */
    f[2] = scale_feat(2, (float)src_B);                 /* SRC B */
    f[3] = scale_feat(3, (float)dir_fwd);               /* dir+ */
    f[4] = scale_feat(4, (float)dir_bwd);               /* dir- */
    f[5] = scale_feat(5, enc_state.speed_change_rate);  /* speed change rate */
    f[6] = scale_feat(6, (float)packZ);                 /* Z pulse (one-shot) */
    f[7] = scale_feat(7, (float)ab_since_z);            /* AB edges since Z (rising-only) */
    f[8] = scale_feat(8, (float)is_same_src);           /* same src? */
    f[9] = scale_feat(9, (float)adjacent);              /* gray adjacent? */

    DiagTiming_Stop(DIAG_T_PACK_AB);

#if ENABLE_TRACE_WIN
    trace_ab[win_row]  = (synth_gray & 3u);
    trace_src[win_row] = evt.src;
    trace_z[win_row]   = packZ;
#endif

    /* Trial accounting: one AB row packed */
    Diag_NotifyABEdge();

    if (is_same_src) gray_skip2++;
    last_src = evt.src;
    enc_state.last_AB_state = current_gray;

    /* Advance row */
    win_row++;

    /* Full window? publish the slot */
    if (win_row >= SEQ_LEN) {
      uint32_t flags = rule_flags_live;
      if (gray_skip2 >= 2) flags |= WR_SKIP2;
      if (had_z_in_win)    flags |= WR_ZINWIN;
      enc_rule_flags = flags;

      if (dir_sum > 0)      last_window_dir = +1;
      else if (dir_sum < 0) last_window_dir = -1;
      else                  last_window_dir = enc_latched_dir;

      dir_sum = 0;

      /* Stop wall-time for window */
      DiagTiming_Stop(DIAG_T_E2E_WINDOW);

      /* Publish timing */
      DiagTiming_Start(DIAG_T_WIN_PUBLISH);

      /* Publish: write flags, then advance write index atomically */
      flags_ring[wf_w] = flags;

      __disable_irq();
      wf_w = (uint16_t)((wf_w + 1u) & WINMASK);
      if (wf_count < WINFIFO) {
        wf_count++;
      } else {
        /* overwrite oldest if full */
        wf_r = (uint16_t)((wf_r + 1u) & WINMASK);
      }
      win_ready = wf_count;
#if ENABLE_TRACE_WIN
      memcpy(last_trace_ab,  trace_ab,  SEQ_LEN);
      memcpy(last_trace_src, trace_src, SEQ_LEN);
      memcpy(last_trace_z,   trace_z,   SEQ_LEN);
      memset(trace_z, 0, SEQ_LEN);
#endif
      __enable_irq();

      /* FIFO watermark */
      Diag_ObserveWinFifoLevel(wf_count);

      win_total++;

      DiagTiming_Stop(DIAG_T_WIN_PUBLISH);

      /* Trial accounting: one window published */
      Diag_NotifyWindowPublished();

      /* reset for next window */
      win_row = 0;
      gray_skip2 = 0;
      rule_flags_live = 0;
      last_src = 0;
      had_z_in_win = 0;
    }
  }
}

/* =============================== Copy ================================== */

int EncSampler_CopyWindowLinear(float *dst, uint32_t *out_flags) {
  uint16_t r;
  uint32_t flags;

  __disable_irq();
  if (wf_count == 0) { __enable_irq(); return -1; }
  r     = wf_r;
  flags = flags_ring[r];
  wf_r  = (uint16_t)((wf_r + 1u) & WINMASK);
  wf_count--;
  win_ready = wf_count;
  __enable_irq();

  memcpy(dst, win_ring[r], sizeof(win_ring[0]));
  win_rule_flags = flags;
  if (out_flags) *out_flags = flags;

  return 0;
}

/* =============================== Stop / Flush =========================== */

void EncSampler_StopHardware(void) {
  __disable_irq();

  if (htim1.Instance) {
    __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2 | TIM_IT_UPDATE | TIM_IT_TRIGGER | TIM_IT_COM);
#ifdef TIM_IT_IDX
    __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_IDX);
#endif
    __HAL_TIM_DISABLE(&htim1);

    __HAL_TIM_CLEAR_FLAG(&htim1,
      TIM_SR_CC1IF | TIM_SR_CC1OF |
      TIM_SR_CC2IF | TIM_SR_CC2OF |
      TIM_SR_UIF   | TIM_SR_TIF   | TIM_SR_COMIF);
#ifdef TIM_SR_IDXF
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
#endif
  }

#ifdef TIM1_CC_IRQn
  NVIC_DisableIRQ(TIM1_CC_IRQn);
#endif
#if defined(TIM1_TRG_CCU_IRQn)
  NVIC_DisableIRQ(TIM1_TRG_CCU_IRQn);
#elif defined(TIM1_TRG_COM_IRQn)
  NVIC_DisableIRQ(TIM1_TRG_COM_IRQn);
#endif

  ab_irqs_on = 0;
  __enable_irq();
}

void EncSampler_FlushWindows(void) {
  __disable_irq();

  wf_w = wf_r = 0; wf_count = 0;
  win_ready = 0; win_total = 0;
  win_row = 0;

  event_read = event_write = 0; event_drops = 0;

  /* Reset Z/AB diagnostics and epoch */
  z_last_ms_isr = 0;
  ab_edges_since_z_isr = 0;
  z_diag_isr_seen = 0;
  z_diag_isr_accepted = 0;
  z_diag_ab_since_isr = 0;
  z_diag_steps_x4 = 0;
  z_diag_last_z_ms = 0;

  z_epoch_isr = 0;
  z_epoch_seen_main = 0;

  /* reset raw capture + replay state */
  cap_armed = 0u; cap_active = 0u; cap_done = 0u;
  cap_w = cap_r = cap_count = cap_drops = 0u;
  cap_start_ms = cap_end_ms = cap_duration_ms = 0u;

  replay_active = 0u; replay_pendingZ = 0u;
  replay_pos = replay_end = 0u;
  replay_ab_since_z = 0u;

  __enable_irq();
}

/* ============================ Capture API ============================== */

void EncSampler_CaptureArmOnNextZ(uint32_t duration_ms)
{
  __disable_irq();
  cap_duration_ms = duration_ms ? duration_ms : 1000u;
  cap_armed  = 1u;
  cap_active = 0u;
  cap_done   = 0u;
  cap_reset_locked();
  __enable_irq();
}

void EncSampler_CaptureCancel(void)
{
  __disable_irq();
  cap_armed  = 0u;
  cap_active = 0u;
  __enable_irq();
}

bool EncSampler_CaptureActive(void) { return cap_active != 0u; }
bool EncSampler_CaptureDone(void)   { return cap_done   != 0u; }
uint32_t EncSampler_CaptureCount(void) { return cap_count; }
uint32_t EncSampler_CaptureDrops(void) { return cap_drops; }

uint32_t EncSampler_CaptureRead(enc_capture_evt_t *dst, uint32_t max)
{
  if (!dst || !max) return 0u;
  uint32_t copied = 0;
  __disable_irq();
  while ((copied < max) && (cap_r != cap_w)) {
    dst[copied++] = cap_buf[cap_r];
    cap_r = (cap_r + 1u);
    if (cap_r >= CAPTURE_MAX_EVENTS) cap_r = 0u;
  }
  __enable_irq();
  return copied;
}

/* ============================== Trace API ============================== */
#if ENABLE_TRACE_WIN
void EncSampler_DebugGetLastTrace(uint8_t *ab, uint8_t *src, uint8_t *z) {
  if (ab)  memcpy(ab,  last_trace_ab,  SEQ_LEN);
  if (src) memcpy(src, last_trace_src, SEQ_LEN);
  if (z)   memcpy(z,   last_trace_z,   SEQ_LEN);
}
#else
void EncSampler_DebugGetLastTrace(uint8_t *ab, uint8_t *src, uint8_t *z) {
  if (ab)  memset(ab,  0, SEQ_LEN);
  if (src) memset(src, 0, SEQ_LEN);
  if (z)   memset(z,   0, SEQ_LEN);
}
#endif
