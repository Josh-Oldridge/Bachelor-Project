/* build & run a clean forward Gray sequence to sanity-check model */
static void diag_run_synthetic_normal(void) {
  float *X = (float*) ai_input[0].data;

  int ab = 0;                 // Gray index: 0->00, 1->01, 3->11, 2->10
  int ssz = 0;
  static const uint8_t gray_next[4] = { 1, 3, 2, 0 };  // forward Gray sequence

  int idx = 0;
  for (int t = 0; t < SEQ_LEN; ++t) {
    /* Derive channel bits from Gray index value */
    const float AB  = (float)ab;               // AB_State (0,1,3,2)
    const float A   = (float)((ab >> 1) & 1);  // SRC_A
    const float B   = (float)( ab       & 1);  // SRC_B
    const float dirF= 1.0f;                    // dir_fwd
    const float dirB= 0.0f;                    // dir_bwd
    const float SCR = 0.0f;                    // speed_change_rate steady
    const float Z   = 0.0f;                    // no Z in plain normal
    const float SSZ = (float)ssz++;            // steps_since_z
    const float same_src = 0.0f;               // no repeated same channel here
    const float adjacent = 1.0f;               // edge row → adjacent=1

    /* Pack in EXACT firmware/metadata order */
    const float raw[FEAT_DIM] = {
      AB, A, B, dirF, dirB, SCR, Z, SSZ, same_src, adjacent
    };

    for (int f = 0; f < FEAT_DIM; ++f) {
      float y = (raw[f] - MODEL_FEAT_MIN[f]) * MODEL_FEAT_SCALE[f];
      if (y < 0.f) y = 0.f;
      if (y > 1.f) y = 1.f;
      X[idx++] = y;
    }

    ab = gray_next[ab];  // forward Gray step: 0→1→3→2→0...
  }

  if (ai_run() == 0) {
    const float *out = (const float*) ai_output[0].data;
    printf("SYNTH(norm) RAW = [%.3f %.3f %.3f]\r\n",
           (double)out[0], (double)out[1], (double)out[2]);
    diag_softmax_sum_check(out, "synth_raw");
  }
}


