/**
 * @brief  The application entry point.
 * @retval int
 */
int main(void) {

	/* USER CODE BEGIN 1 */

	/* USER CODE END 1 */

	/* Enable the CPU Cache */

	/* Enable I-Cache---------------------------------------------------------*/
	SCB_EnableICache();

	/* Enable D-Cache---------------------------------------------------------*/
	SCB_EnableDCache();

	/* MCU Configuration--------------------------------------------------------*/
	HAL_Init();

	/* USER CODE BEGIN Init */

	/* USER CODE END Init */

	/* USER CODE BEGIN SysInit */

	/* USER CODE END SysInit */

	/* Initialize all configured peripherals */
	MX_GPIO_Init();
	MX_LPUART1_UART_Init();
	MX_CACHEAXI_Init();
	MX_TIM1_Init();
	MX_RAMCFG_Init();
	MX_TIM2_Init();
	MX_X_CUBE_AI_Init();
	SystemIsolation_Config();
	/* USER CODE BEGIN 2 */
	EncSampler_Init();

	DiagTiming_Init();

	Diag_SetEventBufCaps(1u << 12);
	Diag_SetWinFifoCaps(1u << 10);

	uint32_t next_blink_ms = HAL_GetTick() + 250;
	uint32_t warmup_end_ms = HAL_GetTick() + 5000; /* 5s warm-up */
	uint32_t next_print_ms = HAL_GetTick() + 1000;

	/* USER CODE END 2 */

	/* Initialize leds */
	BSP_LED_Init(LED_BLUE);
	BSP_LED_Init(LED_RED);
	BSP_LED_Init(LED_GREEN);

	/* Infinite loop */
	/* USER CODE BEGIN WHILE */
	while (1) {
		/* USER CODE END WHILE */

//  MX_X_CUBE_AI_Process();
		/* USER CODE BEGIN 3 */

		uint32_t now = HAL_GetTick();
		EncSampler_Process();  // this drives replay too

		// Arm once after warmup
		if (tstate == ST_WARMUP && (int32_t) (now - warmup_end_ms) >= 0) {
			Diag_ArmTrialAfterNextZ(TRIAL_MS);
			EncSampler_CaptureArmOnNextZ(TRIAL_MS); // 1 s diag capture
			HAL_TIM_Encoder_Start(&htim1, TIM_CHANNEL_ALL);
												HAL_TIMEx_EnableEncoderIndex(&htim1);
												__HAL_TIM_ENABLE(&htim1);

												printf("ENC MODE: LIVE (TIM1 enabled)\r\n");

												printf("Init done\r\n");

												printf("SEQ_LEN=%d FEAT_DIM=%d\r\n", (int) MODEL_SEQ_LEN,
														(int) MODEL_FEAT_DIM);
			tstate = ST_CAPTURING;

		}

		const diag_trial_t *tr = Diag_TrialPeek();

		if (tstate == ST_CAPTURING) {

			// Expect NO windows if CAPTURE_STEALS_EVENTS=1
			if (EncSampler_CaptureDone()) {
				// 1 s captured; replay will start automatically
				tstate = ST_REPLAY;
			}
		}

		if (tstate == ST_REPLAY) {
			// Drain windows while replay runs
			while (win_ready) {
				MX_X_CUBE_AI_Process(); // or CopyWindowLinear if you’re just logging
			}
			// When replay finished and FIFO empty, now we can summarize & stop

			if (!EncSampler_ReplayActive() && win_ready == 0) {
				diag_snapshot_t snap;
				Diag_GetAndResetSnapshot(&snap);
				print_diag_snapshot(&snap);

				float rps_inst = 0.f, rps_avg = 0.f;
				Diag_GetRps(&rps_inst, &rps_avg);
				printf("SPEED: RPS_inst=%.2f  RPS=%.2f  RPM=%.1f\r\n",
						(double) rps_inst, (double) rps_avg,
						(double) (rps_avg * 60.f));

				EncSampler_StopHardware();       // stop only AFTER replay drain
				tstate = ST_DONE;
			}
		}

//      // Periodic 1 Hz diag prints (optional)
//      if (!trial_done && (int32_t)(now - next_print_ms) >= 0) {
//          diag_snapshot_t snap;
//          Diag_GetAndResetSnapshot(&snap);
//          print_diag_snapshot(&snap);
//
//          float rps_inst=0.f, rps_avg=0.f;
//          Diag_GetRps(&rps_inst, &rps_avg);
//          printf("SPEED: RPS_inst=%.2f  RPS=%.2f  RPM=%.1f\r\n",
//                 (double)rps_inst, (double)rps_avg, (double)(rps_avg*60.f));
//
//          next_print_ms += 1000;
//      }

		// Blink + sleep
		if (next_blink_ms == 0)
			next_blink_ms = HAL_GetTick() + 250;
		if ((int32_t) (HAL_GetTick() - next_blink_ms) >= 0) {
			BSP_LED_Toggle(LED_RED);
			next_blink_ms += 250;
		}
		if (win_ready == 0) {
			__DSB();
			__WFI();
			__ISB();
		}
	}
	/* USER CODE END 3 */
}

