static inline uint32_t cycles_to_us(uint64_t cycles) {
	return (uint32_t) ((cycles * 1000000ULL) / (uint64_t) SystemCoreClock);
}

static void print_one_timer(const char *name, const diag_timer_stat_t *s) {
	if (!s->count) {
		printf("%s: count=0\r\n", name);
		return;
	}
	uint64_t avg = s->sum_cycles / s->count;
	printf(
			"%s: n=%lu  min=%lu cyc (%lu us)  avg=%llu cyc (%lu us)  max=%lu cyc (%lu us)\r\n",
			name, (unsigned long) s->count, (unsigned long) s->min_cycles,
			cycles_to_us(s->min_cycles), (unsigned long long) avg,
			cycles_to_us(avg), (unsigned long) s->max_cycles,
			cycles_to_us(s->max_cycles));
}

static void print_diag_snapshot(const diag_snapshot_t *s) {
	print_one_timer("ISR_TOTAL", &s->timers[DIAG_T_ISR_TOTAL]);
	print_one_timer("PACK_AB", &s->timers[DIAG_T_PACK_AB]);
	print_one_timer("WIN_PUBLISH", &s->timers[DIAG_T_WIN_PUBLISH]);
	print_one_timer("MODEL", &s->timers[DIAG_T_MODEL]);
	print_one_timer("E2E_WINDOW", &s->timers[DIAG_T_E2E_WINDOW]);

	printf("HEALTH: event_buf: hwm=%lu/%lu  drops+=%lu ; "
			"winfifo: hwm=%lu/%lu ; inferences=%lu\r\n",
			(unsigned long) s->event_buf_hwm, (unsigned long) s->event_buf_cap,
			(unsigned long) s->event_drops, (unsigned long) s->winfifo_hwm,
			(unsigned long) s->winfifo_cap, (unsigned long) s->inferences);
}
