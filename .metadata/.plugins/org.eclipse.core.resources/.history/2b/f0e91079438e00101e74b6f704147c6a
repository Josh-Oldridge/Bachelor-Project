#ifndef INC_ENC_SAMPLER_H_
#define INC_ENC_SAMPLER_H_

#include <stdint.h>
#include "model_meta.h"   // MODEL_SEQ_LEN / MODEL_FEAT_DIM

#ifdef __cplusplus
extern "C" {
#endif

/* ========= Public constants ========= */
#define SEQ_LEN   (MODEL_SEQ_LEN)
#define FEAT_DIM  (MODEL_FEAT_DIM)

/* Build-time option */
#ifndef ENABLE_TRACE_WIN
#define ENABLE_TRACE_WIN 1   /* enable per-window AB/SRC/Z trace */
#endif

/* Live/window rule flags exported to the app */
extern volatile uint32_t enc_rule_flags;   /* rolling/live flags */
extern volatile uint32_t win_rule_flags;   /* flags for last window */

/* FIFO flow control */
extern volatile uint32_t win_ready;        /* # of windows available */
extern volatile uint32_t win_total;        /* total produced windows */
extern volatile uint32_t event_drops;      /* overcapture / ring overflow */

/* Z-path diagnostics consumed by the app logger */
extern volatile uint32_t z_diag_isr_seen;
extern volatile uint32_t z_diag_isr_accepted;
extern volatile uint32_t z_diag_ab_since_isr;
extern volatile uint32_t z_diag_steps_since_main;
extern volatile uint32_t z_diag_last_z_ms;

/* ============================== API ============================= */
void EncSampler_Init(void);
void EncSampler_StopHardware(void);
void EncSampler_FlushWindows(void);

/* IRQ drain (call from TIM1 CC and/or TRG/COM ISRs) */
void EncSampler_EncoderIRQ_Drain(void);

/* Run in main loop to consume events and build windows */
void EncSampler_Process(void);

/* Direction helpers */
int8_t EncSampler_GetLatchedDir(void);
int8_t EncSampler_GetLastWindowDir(void);

/* Copy the oldest ready window (SEQ_LEN*FEAT_DIM floats).
   Returns 0 on success, -1 if no window available.
   win_rule_flags is updated; optionally echoed via out_flags. */
int EncSampler_CopyWindowLinear(float *dst, uint32_t *out_flags);

/* Last-window trace (stubbed when ENABLE_TRACE_WIN=0) */
void EncSampler_DebugGetLastTrace(uint8_t *ab, uint8_t *src, uint8_t *z);

#ifdef __cplusplus
}
#endif
#endif /* INC_ENC_SAMPLER_H_ */
