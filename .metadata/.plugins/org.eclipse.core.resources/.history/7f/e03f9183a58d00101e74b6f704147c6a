// enc_sampler.c — Simplified X4 encoder with Z index for ML model
#include "enc_sampler.h"
#include <string.h>
#include <math.h>
#include <stdio.h>
#include <stdlib.h>
#include "model_meta.h"
#include "main.h"
#include "stm32n6xx_hal.h"

/* ============================= Config ================================== */
#ifndef CPR
#define CPR 500u
#endif

#ifndef HAVE_Z_INDEX
#define HAVE_Z_INDEX 1
#endif
#if !defined(TIM_SR_IDXF) || !defined(TIM_IT_IDX)
# undef HAVE_Z_INDEX
# define HAVE_Z_INDEX 0
#endif

#ifndef FORCE_IGNORE_Z
#define FORCE_IGNORE_Z 0
#endif

#define QUAD_EDGES_PER_REV (4u * CPR)
#define Z_SOFT_DEBOUNCE_MS 10u
#define Z_MIN_AB_EDGES 2u
#define Z_MISS_EDGE_LIMIT (QUAD_EDGES_PER_REV + QUAD_EDGES_PER_REV/8u)

/* ======================== Globals ====================================== */
extern TIM_HandleTypeDef htim1;

enum {
  WR_SKIP2 = 1u<<0,
  WR_ZMISS = 1u<<1,
};

volatile uint32_t enc_rule_flags = 0;
volatile uint32_t win_rule_flags = 0;
volatile uint32_t win_ready = 0;
volatile uint32_t win_total = 0;
volatile uint32_t event_drops = 0;

// Z diagnostics
volatile uint32_t z_diag_isr_seen = 0;
volatile uint32_t z_diag_isr_accepted = 0;
volatile uint32_t z_diag_ab_since_isr = 0;
volatile uint32_t z_diag_last_z_ms = 0;

#define SEQ_LEN (MODEL_SEQ_LEN)
#define FEAT_DIM (MODEL_FEAT_DIM)
static float feat_win[SEQ_LEN][FEAT_DIM];

typedef struct {
  uint8_t last_AB_state;
  float speed_change_rate;
  uint32_t last_update_ms;
  float baseline_interval;
} encoder_state_t;

static encoder_state_t enc_state = { 0 };
static volatile int8_t enc_latched_dir = +1;
static volatile int8_t last_window_dir = +1;

/* Hardware state */
static volatile uint16_t enc_cnt_wrap = 0;
static volatile uint16_t last_z_cnt_isr = 0xFFFF; // Invalid until first Z
static volatile uint32_t ab_edges_since_z_isr = 0xFFFF;
static volatile uint32_t z_last_ms_isr = 0;
static volatile uint8_t enc_block_z = 1; // Block Z during startup

/* ============================ Window FIFO ============================== */
#define WINFIFO_LOG2 5
#define WINFIFO (1u << WINFIFO_LOG2)
static float win_fifo[WINFIFO][SEQ_LEN * FEAT_DIM];
static uint32_t flags_fifo[WINFIFO];
static volatile uint8_t wf_w = 0, wf_r = 0, wf_count = 0;

/* ============================ Event Buffer ============================= */
typedef struct {
  int8_t delta;
  uint8_t z_pulse;
  uint8_t src;
  uint8_t ab_state;
  uint32_t timestamp_ms;
  uint16_t ccr;
} encoder_event_t;

#define EVENT_BUF_BITS 10
#define EVENT_BUFFER_SIZE (1u << EVENT_BUF_BITS)
#define EVENT_IDX_MASK (EVENT_BUFFER_SIZE - 1u)

static encoder_event_t event_buffer[EVENT_BUFFER_SIZE];
static volatile uint32_t event_write = 0;
static volatile uint32_t event_read = 0;

/* ============================ Helpers ================================== */
static inline float scale_feat(int j, float x) {
  float y = (x - MODEL_FEAT_MIN[j]) * MODEL_FEAT_SCALE[j];
  return (y < 0.f) ? 0.f : (y > 1.f) ? 1.f : y;
}

static inline uint8_t enc_read_AB(void) {
  const uint8_t a = (HAL_GPIO_ReadPin(ENC_A_GPIO_Port, ENC_A_Pin) != GPIO_PIN_RESET) ? 1u : 0u;
  const uint8_t b = (HAL_GPIO_ReadPin(ENC_B_GPIO_Port, ENC_B_Pin) != GPIO_PIN_RESET) ? 1u : 0u;
  return (uint8_t)((a << 1) | b);
}

static inline int8_t dir_from_hw(void) {
  return ((TIM1->CR1 & TIM_CR1_DIR) == 0) ? +1 : -1;
}

static inline uint32_t since_z_from_cnt_isr(uint16_t cnt, int8_t dir) {
  if (last_z_cnt_isr == 0xFFFF) return 0xFFFF; // No Z seen yet

  uint16_t base = last_z_cnt_isr;
  uint16_t diff;
  if (dir > 0) {
    diff = (cnt >= base) ? (cnt - base) : (cnt + enc_cnt_wrap - base);
  } else {
    diff = (base >= cnt) ? (base - cnt) : (base + enc_cnt_wrap - cnt);
  }
  return diff;
}

static inline void push_event_isr(int delta, int z, uint16_t ccr_sample,
                                 uint8_t src, uint8_t ab_state) {
  uint32_t next = (event_write + 1u) & EVENT_IDX_MASK;
  if (next == event_read) {
    event_drops++;
    return;
  }
  encoder_event_t *e = &event_buffer[event_write];
  e->timestamp_ms = HAL_GetTick();
  e->ccr = ccr_sample;
  e->delta = (int8_t)delta;
  e->z_pulse = (uint8_t)z;
  e->src = src;
  e->ab_state = ab_state;
  event_write = next;
}

/* ======================== IRQ Handler =================================== */
#if ENC_IS_LIVE
void EncSampler_EncoderIRQ_Drain(void) {
  for (int guard = 0; guard < 256; ++guard) {
    uint32_t sr = TIM1->SR;
    uint32_t pending = sr & (TIM_SR_CC1IF | TIM_SR_CC2IF | TIM_SR_CC1OF | TIM_SR_CC2OF);
#if HAVE_Z_INDEX && !FORCE_IGNORE_Z
    pending |= (sr & TIM_SR_IDXF);
#endif
    if (!pending) break;

    // Handle overcapture
    if (sr & TIM_SR_CC1OF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC1OF); event_drops++; }
    if (sr & TIM_SR_CC2OF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC2OF); event_drops++; }

    // Z index first
#if HAVE_Z_INDEX && !FORCE_IGNORE_Z
    if (sr & TIM_SR_IDXF) {
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_IDX);
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
      z_diag_isr_seen++;

      const uint32_t now_ms = HAL_GetTick();
      const int32_t dt_ms = (int32_t)(now_ms - z_last_ms_isr);
      if (!enc_block_z && (dt_ms >= Z_SOFT_DEBOUNCE_MS) && (ab_edges_since_z_isr >= Z_MIN_AB_EDGES)) {
        const uint16_t ccrz = (uint16_t)TIM1->CNT;
        const uint8_t abz = enc_read_AB() & 0x3u;
        push_event_isr(0, 1, ccrz, 3, abz);
        last_z_cnt_isr = ccrz;
        z_last_ms_isr = now_ms;
        z_diag_last_z_ms = now_ms;
        ab_edges_since_z_isr = 0;
        z_diag_ab_since_isr = 0;
        z_diag_isr_accepted++;
      }
    }
#endif

    sr = TIM1->SR; // Refresh after Z clear

    // A channel
    if (sr & TIM_SR_CC1IF) {
      const uint16_t c1 = (uint16_t)TIM1->CCR1;
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC1);
      const uint8_t ab = enc_read_AB() & 0x3u;
      const int8_t dir = dir_from_hw();
      enc_latched_dir = dir;
      push_event_isr(dir, 0, c1, 1, ab);

      uint32_t edges = since_z_from_cnt_isr(c1, dir);
      if (edges != 0xFFFF) {
        ab_edges_since_z_isr = edges;
        z_diag_ab_since_isr = edges;
      }
      continue;
    }

    // B channel
    if (sr & TIM_SR_CC2IF) {
      const uint16_t c2 = (uint16_t)TIM1->CCR2;
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC2);
      const uint8_t ab = enc_read_AB() & 0x3u;
      const int8_t dir = dir_from_hw();
      enc_latched_dir = dir;
      push_event_isr(dir, 0, c2, 2, ab);

      uint32_t edges = since_z_from_cnt_isr(c2, dir);
      if (edges != 0xFFFF) {
        ab_edges_since_z_isr = edges;
        z_diag_ab_since_isr = edges;
      }
      continue;
    }
  }
  __DSB();
}
#endif

/* ============================ Public API =============================== */
void EncSampler_Init(void) {
  memset(&enc_state, 0, sizeof(enc_state));
  enc_state.last_update_ms = HAL_GetTick();
  enc_state.baseline_interval = 10.0f;
  enc_state.last_AB_state = enc_read_AB() & 0x3u;

#if ENC_IS_LIVE
  enc_cnt_wrap = (uint32_t)__HAL_TIM_GET_AUTORELOAD(&htim1) + 1u;

  // Enable interrupts
  __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2);
#if HAVE_Z_INDEX && !FORCE_IGNORE_Z
  __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_IDX);
#endif
  __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_UPDATE | TIM_IT_TRIGGER | TIM_IT_COM);

  // Start with Z blocked for 60ms startup period
  enc_block_z = 1;
  // Will be unblocked after first few windows in Process()
#endif

  printf("ENC: X4 mode, Period=%lu, CPR=%u, Z=%s\r\n",
         (unsigned long)enc_cnt_wrap, CPR,
         HAVE_Z_INDEX && !FORCE_IGNORE_Z ? "enabled" : "disabled");
}

#if ENC_IS_LIVE
void EncSampler_Process(void) {
  static uint8_t win_fill = 0;
  static uint32_t last_ms = 0;
  static uint8_t last_src = 0;
  static uint32_t gray_skip2 = 0;
  static uint32_t rule_flags_live = 0;
  static int32_t dir_sum = 0;
  static uint8_t z_latch = 0;
  static uint32_t startup_timer = 0;
  static uint8_t drop_count = 3; // Drop first 3 windows

  // Unblock Z after startup delay
  if (enc_block_z) {
    if (startup_timer == 0) startup_timer = HAL_GetTick();
    if ((HAL_GetTick() - startup_timer) > 60) {
      enc_block_z = 0;
    }
  }

  while (event_read != event_write) {
    encoder_event_t evt = event_buffer[event_read];
    event_read = (event_read + 1u) & EVENT_IDX_MASK;

    // Handle Z events
    if (evt.z_pulse) {
      z_latch = 1;
      z_diag_last_z_ms = evt.timestamp_ms;
      continue;
    }

    // Skip non-AB events
    if (evt.src != 1 && evt.src != 2) continue;

    const uint8_t current_GRAY = evt.ab_state & 0x3u;
    const int8_t dir = (evt.delta > 0) ? +1 : -1;
    const uint8_t src_A = (evt.src == 1);
    const uint8_t src_B = (evt.src == 2);
    const uint8_t is_same_src = (last_src != 0 && evt.src == last_src);

    if (dir > 0) dir_sum++; else dir_sum--;

    // Consume Z latch for this row
    const uint8_t packZ = z_latch;
    z_latch = 0;

    // Timing for speed change rate
    const uint32_t now_ms = evt.timestamp_ms;
    int32_t dms = (int32_t)(now_ms - last_ms);
    if (dms <= 0) dms = 1;
    const float dt_ms = (float)dms;

    if (enc_state.baseline_interval < 1.0f) enc_state.baseline_interval = dt_ms;
    const float ratio = dt_ms / enc_state.baseline_interval;
    enc_state.speed_change_rate = fabsf(ratio - 1.0f);
    enc_state.baseline_interval = 0.9f * enc_state.baseline_interval + 0.1f * dt_ms;
    last_ms = now_ms;

    // Get current ab_since_z
    uint32_t ab_since_z = (ab_edges_since_z_isr == 0xFFFF) ? 0 : ab_edges_since_z_isr;

    // Check adjacency
    const uint8_t prev_gray = enc_state.last_AB_state;
    const uint8_t diff_bits = (prev_gray ^ current_GRAY) & 3u;
    const uint8_t adjacent = (diff_bits == 1u) || (diff_bits == 2u);

    // Pack features
    float *f = feat_win[win_fill];
    f[0] = scale_feat(0, (float)current_GRAY);
    f[1] = scale_feat(1, (float)src_A);
    f[2] = scale_feat(2, (float)src_B);
    f[3] = scale_feat(3, (float)(dir > 0));
    f[4] = scale_feat(4, (float)(dir < 0));
    f[5] = scale_feat(5, enc_state.speed_change_rate);
    f[6] = scale_feat(6, (float)packZ);
    f[7] = scale_feat(7, (float)ab_since_z);
    f[8] = scale_feat(8, (float)is_same_src);
    f[9] = scale_feat(9, (float)adjacent);

    // Update state
    if (is_same_src) gray_skip2++;
    last_src = evt.src;
    enc_state.last_AB_state = current_GRAY;
    enc_state.last_update_ms = now_ms;
    win_fill++;

    // Check for full window
    if (win_fill >= SEQ_LEN) {
      // Drop initial windows during startup
      if (drop_count > 0) {
        drop_count--;
        win_fill = 0;
        gray_skip2 = 0;
        rule_flags_live = 0;
        last_src = 0;
        dir_sum = 0;
        continue;
      }

      // Set rule flags
      uint32_t flags = 0;
      if (gray_skip2 >= 2) flags |= WR_SKIP2;
      if (ab_since_z > Z_MISS_EDGE_LIMIT) flags |= WR_ZMISS;

      // Set window direction
      if (dir_sum > 0) last_window_dir = +1;
      else if (dir_sum < 0) last_window_dir = -1;
      else last_window_dir = enc_latched_dir;

      // Commit to FIFO
      uint8_t w_local = wf_w;
      memcpy(win_fifo[w_local], &feat_win[0][0], sizeof(win_fifo[0]));
      flags_fifo[w_local] = flags;
      enc_rule_flags = flags;

      __disable_irq();
      wf_w = (wf_w + 1u) & (WINFIFO - 1u);
      if (wf_count < WINFIFO) wf_count++;
      else wf_r = (wf_r + 1u) & (WINFIFO - 1u);
      win_ready = wf_count;
      __enable_irq();

      win_total++;

      // Reset for next window
      win_fill = 0;
      gray_skip2 = 0;
      rule_flags_live = 0;
      last_src = 0;
      dir_sum = 0;
    }
  }
}
#endif

int EncSampler_CopyWindowLinear(float *dst, uint32_t *out_flags) {
  uint8_t r_local;
  uint32_t flags;

  __disable_irq();
  if (wf_count == 0) {
    __enable_irq();
    return -1;
  }
  r_local = wf_r;
  flags = flags_fifo[r_local];
  wf_r = (wf_r + 1u) & (WINFIFO - 1u);
  wf_count--;
  win_ready = wf_count;
  __enable_irq();

  memcpy(dst, win_fifo[r_local], sizeof(win_fifo[0]));
  win_rule_flags = flags;
  if (out_flags) *out_flags = flags;

  return 0;
}

void EncSampler_StopHardware(void) {
  if (htim1.Instance) {
    __HAL_TIM_DISABLE(&htim1);
    __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2 | TIM_IT_IDX);
  }
}

void EncSampler_FlushWindows(void) {
  __disable_irq();
  wf_w = wf_r = 0;
  wf_count = 0;
  win_ready = 0;
  win_total = 0;
  event_read = event_write = 0;
  event_drops = 0;

  // Reset Z state but keep hardware blocked initially
  z_last_ms_isr = 0;
  ab_edges_since_z_isr = 0xFFFF;
  last_z_cnt_isr = 0xFFFF;
  z_diag_isr_seen = z_diag_isr_accepted = 0;
  z_diag_ab_since_isr = 0;
  z_diag_last_z_ms = 0;
  enc_block_z = 1;
  __enable_irq();
}

// Accessors
int8_t EncSampler_GetLatchedDir(void) { return enc_latched_dir; }
int8_t EncSampler_GetLastWindowDir(void) { return last_window_dir; }

#if ENABLE_TRACE_WIN
void EncSampler_DebugGetLastTrace(uint8_t *ab, uint8_t *src, uint8_t *z) {
  // Simplified - no trace storage in this version
  if (ab) memset(ab, 0, SEQ_LEN);
  if (src) memset(src, 0, SEQ_LEN);
  if (z) memset(z, 0, SEQ_LEN);
}
#endif
