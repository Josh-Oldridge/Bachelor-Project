// synthetic.c
#include <stdint.h>
#include <stdbool.h>
#include <string.h>
#include <stdio.h>
#include "model_meta.h"
#include "synthetic.h"

/* Forward Gray 0->2->3->1 ; Backward Gray 0->1->3->2 */
static const uint8_t GRAY_FWD[4] = {0, 2, 3, 1};
static const uint8_t GRAY_BWD[4] = {0, 1, 3, 2};

static inline int bitA(uint8_t g) { return (g >> 1) & 1; }  // AB_State=(A<<1)|B
static inline int bitB(uint8_t g) { return g & 1; }

/* Flat, already-scaled window buffer */
static float   g_synth_flat[MODEL_SEQ_LEN * MODEL_FEAT_DIM];
/* Debug traces */
static uint8_t s_ab[MODEL_SEQ_LEN], s_src[MODEL_SEQ_LEN], s_z[MODEL_SEQ_LEN];

const float* EncSynth_GetFlat(void) { return g_synth_flat; }

void EncSynth_DebugPrint(void) {
  char ab_s[MODEL_SEQ_LEN+1], src_s[MODEL_SEQ_LEN+1], z_s[MODEL_SEQ_LEN+1];
  for (int i = 0; i < MODEL_SEQ_LEN; ++i) {
    ab_s[i]  = "0123"[s_ab[i] & 3u];
    src_s[i] = (s_src[i] == 1 ? 'A' : (s_src[i] == 2 ? 'B' : '?'));
    z_s[i]   = s_z[i] ? '^' : '.';
  }
  ab_s[MODEL_SEQ_LEN] = src_s[MODEL_SEQ_LEN] = z_s[MODEL_SEQ_LEN] = '\0';
  printf("WIN AB : %s\r\n", ab_s);
  printf("WIN SRC: %s\r\n", src_s);
  printf("WIN  Z : %s\r\n", z_s);
}

void EncSynth_MakePerfectWindow(int rising_falling, int start_state,
                                int steps0, int forward)
{
  if (start_state < 0) start_state = 0;
  if (start_state > 3) start_state = 3;
  if (steps0 < 0) steps0 = 0;

  const uint8_t *gray = forward ? GRAY_FWD : GRAY_BWD;

  int idx = 0;
  uint8_t g_prev = gray[(start_state - 1) & 3];  // pretend “previous” state
  int ssz = steps0;

  for (int t = 0; t < MODEL_SEQ_LEN; ++t) {
    /* current Gray state */
    uint8_t g = gray[(start_state + t) & 3];

    /* A/B levels from Gray code */
    int a1 = bitA(g_prev), b1 = bitB(g_prev);
    int a2 = bitA(g),      b2 = bitB(g);

    /* Edge flags (what the model expects in Channel_A/B) */
    int chA = (a2 != a1);
    int chB = (b2 != b1);

    /* Rising-only indicator */
    int riseA = (a1 == 0 && a2 == 1);
    int riseB = (b1 == 0 && b2 == 1);

    /* Unscaled features in the exact model order */
    float AB   = (float)g;                       // 0,2,3,1 ...
    float dchg = (t == 0) ? 0.f : ((chA || chB) ? 1.f : 0.f);
    float dirF = forward ? 1.f : 0.f;
    float dirB = forward ? 0.f : 1.f;
    float SCR  = 0.0f;                           // steady speed (OK to be 0)
    float CA   = chA ? 1.f : 0.f;                // edge on A this row
    float CB   = chB ? 1.f : 0.f;                // edge on B this row
    float CZ   = 0.f;                            // no Z hit here
    float ER   = (riseA || riseB) ? 1.f : 0.f;   // rising-only
    if (!rising_falling) ER = 0.f;               // knob to disable rising flag
    float SSZ  = (float)(ssz++);                 // 0,1,2,...

    /* keep debug traces in-sync with semantics */
    s_ab[t]  = g & 3u;
    s_src[t] = (t == 0) ? 0 : (chA ? 1 : (chB ? 2 : 0)); // ? A B
    s_z[t]   = 0;

    const float raw[MODEL_FEAT_DIM] = {
      AB, dchg, dirF, dirB, SCR, CA, CB, CZ, ER, SSZ
    };

    for (int f = 0; f < MODEL_FEAT_DIM; ++f) {
      float y = (raw[f] - MODEL_FEAT_MIN[f]) * MODEL_FEAT_SCALE[f];
      if (y < 0.f) y = 0.f;
      if (y > 1.f) y = 1.f;
      g_synth_flat[idx++] = y;
    }

    g_prev = g;
  }
}
