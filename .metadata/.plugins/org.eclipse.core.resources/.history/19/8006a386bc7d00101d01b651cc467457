/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_LPUART1_UART_Init();
  MX_CACHEAXI_Init();
  MX_TIM1_Init();
  MX_TIM7_Init();
  MX_RAMCFG_Init();
  MX_X_CUBE_AI_Init();
  SystemIsolation_Config();
  /* USER CODE BEGIN 2 */
  EncSampler_Init();

  HAL_TIM_Encoder_Start(&htim1, TIM_CHANNEL_ALL);
  HAL_TIMEx_EnableEncoderIndex(&htim1);
  HAL_TIM_Base_Start_IT(&htim7);

  printf("Init done\r\n");
  uint32_t next_blink_ms  = HAL_GetTick() + 250;
  uint32_t next_report_ms = HAL_GetTick() + 1000;

  uint32_t last_ticks = 0, last_inf = 0, last_win_total = 0;
  /* USER CODE END 2 */

  /* Initialize leds */
  BSP_LED_Init(LED_BLUE);
  BSP_LED_Init(LED_RED);
  BSP_LED_Init(LED_GREEN);
  BSP_LED_On(LED_GREEN);

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */
  EncSampler_Process();
  MX_X_CUBE_AI_Process();
    /* USER CODE BEGIN 3 */
  uint32_t now = HAL_GetTick();

    if ((int32_t)(now - next_blink_ms) >= 0) {
      BSP_LED_Toggle(LED_RED);
      next_blink_ms += 250;
    }

    if ((int32_t)(now - next_report_ms) >= 0) {
      uint32_t dt_ticks = tim7_ticks - last_ticks;
      uint32_t dt_inf   = inf_total  - last_inf;
      uint32_t dt_win   = win_total   - last_win_total;

      /* flags -> text */
      uint32_t rf = enc_rule_flags;
      char ftxt[64];
      snprintf(ftxt, sizeof(ftxt), "%s%s%s%s",
               (rf & RS_A_STUCK)  ? "A_STUCK "  : "",
               (rf & RS_B_STUCK)  ? "B_STUCK "  : "",
               (rf & RS_QUAD_BAD) ? "QUAD_BAD " : "",
               (rf & RS_Z_MISSED) ? "Z_MISSED " : "");

      /* argmax over last_y */
      int best = 0;
      for (int i = 1; i < 4; ++i) {
        if (last_y[i] > last_y[best]) best = i;
      }
      const char* cls[4] = {"jitter","missing_step","normal","z_index"};

      printf("TIM7=%lu/s windows=%lu/s inf=%lu/s flags=[%s] pred=%s "
             "y=[%.5f, %.5f, %.5f, %.5f]\r\n",
             (unsigned long)dt_ticks,
             (unsigned long)dt_win,
             (unsigned long)dt_inf,
             (*ftxt) ? ftxt : "-",
             cls[best],
             (double)last_y[0], (double)last_y[1],
             (double)last_y[2], (double)last_y[3]);

      /* optional: log flag transitions */
      static uint32_t last_flags = 0;
      if (rf != last_flags) {
        printf("RULE FLAGS CHANGED: 0x%08lX -> 0x%08lX (%s)\r\n",
               (unsigned long)last_flags, (unsigned long)rf, (*ftxt) ? ftxt : "-");
        last_flags = rf;
      }

      last_ticks = tim7_ticks;
      last_inf   = inf_total;
      last_win_total  = win_total;
      next_report_ms += 1000;
    }

  }
  /* USER CODE END 3 */
}

