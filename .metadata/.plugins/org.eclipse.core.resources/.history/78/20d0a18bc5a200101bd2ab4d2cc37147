void MX_X_CUBE_AI_Init(void)
{
    __HAL_RCC_AXISRAM2_MEM_CLK_ENABLE();
    __HAL_RCC_AXISRAM3_MEM_CLK_ENABLE();
    __HAL_RCC_AXISRAM4_MEM_CLK_ENABLE();
    __HAL_RCC_AXISRAM5_MEM_CLK_ENABLE();
    __HAL_RCC_AXISRAM6_MEM_CLK_ENABLE();
    RAMCFG_SRAM2_AXI->CR &= ~RAMCFG_CR_SRAMSD;
    RAMCFG_SRAM3_AXI->CR &= ~RAMCFG_CR_SRAMSD;
    RAMCFG_SRAM4_AXI->CR &= ~RAMCFG_CR_SRAMSD;
    RAMCFG_SRAM5_AXI->CR &= ~RAMCFG_CR_SRAMSD;
    RAMCFG_SRAM6_AXI->CR &= ~RAMCFG_CR_SRAMSD;
    /* USER CODE BEGIN 5 */
	ai_log("AI: init\r\n");
	if (ai_boostrap(data_activations0) != 0) {
		ai_log_err(ai_network_get_error(network), "ai_boostrap");
		return;
	}
	const uint32_t in_fmt  = ai_input[0].format;
	const uint32_t out_fmt = ai_output[0].format;

	const uint32_t in_bits  = AI_BUFFER_FMT_GET_BITS(in_fmt);
	const uint32_t out_bits = AI_BUFFER_FMT_GET_BITS(out_fmt);
	const uint32_t in_type  = AI_BUFFER_FMT_GET_TYPE(in_fmt);
	const uint32_t out_type = AI_BUFFER_FMT_GET_TYPE(out_fmt);

	/* INT8 if it's 8-bit and not FLOAT; FLOAT32 if it is FLOAT/32-bit */
	g_io_int8 = (in_bits == 8)  && (out_bits == 8)  &&
	            (in_type != AI_BUFFER_FMT_TYPE_FLOAT) &&
	            (out_type != AI_BUFFER_FMT_TYPE_FLOAT);

	ai_log("AI I/O: in_fmt=0x%08lX out_fmt=0x%08lX  bits(in,out)=(%lu,%lu)  int8_mode=%d\r\n",
	       (unsigned long)in_fmt, (unsigned long)out_fmt,
	       (unsigned long)in_bits, (unsigned long)out_bits, (int)g_io_int8);

	/* No hard assert; we branch at runtime instead. */

	Print_ModelSramFootprint();
    /* USER CODE END 5 */
}

void MX_X_CUBE_AI_Process(void)
{
    /* USER CODE BEGIN 6 */
#ifndef INFER_BUDGET_PER_TICK
#define INFER_BUDGET_PER_TICK 1000000
#endif

	if (!network)
		return;

	/* Always keep sampler moving (builds windows) */
	EncSampler_Process();

	/* Trial active (or capture-only disabled): infer every ready window */
	{
		int budget = INFER_BUDGET_PER_TICK;
		while (budget-- > 0) {
			if (acquire_and_process_data() != 0)
				break;

			if (ai_run_timed() == 0) {
				post_process();
				snapshot_and_print();
			}
		}
	}
    /* USER CODE END 6 */
}
