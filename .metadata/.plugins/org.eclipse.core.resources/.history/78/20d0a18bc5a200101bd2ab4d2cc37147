static inline ai_i8 q_s8(float x, float s, int zp) {
  int32_t qi = (int32_t)lrintf(x / s) + zp;
  if (qi < -128) qi = -128; if (qi > 127) qi = 127;
  return (ai_i8)qi;
}
static void quantize_f32_to_s8(const float* src, ai_i8* dst, int n,
                               float s, int zp) {
  for (int i = 0; i < n; ++i) dst[i] = q_s8(src[i], s, zp);
}
