#define SEQ_LEN   (MODEL_SEQ_LEN)
#define FEAT_DIM  (MODEL_FEAT_DIM)
#if (SEQ_LEN * FEAT_DIM) != AI_NETWORK_IN_1_SIZE
#error "Input size mismatch: regenerate model_meta.h or re-export network"
#endif

/* Feature window buffer (time-major) */
volatile float    feat_win[SEQ_LEN][FEAT_DIM];
volatile uint8_t  win_fill  = 0;
volatile uint32_t win_ready = 0;

/* Telemetry / outputs */
volatile uint32_t tim7_ticks = 0;
volatile uint32_t inf_total  = 0;
volatile float    last_y[AI_NETWORK_OUT_1_SIZE];

/* Encoder / speed / Z tracking */
static uint16_t last_cnt = 0;
static uint32_t steps_since_z = 0;
static uint32_t revolution_cnt = 0;
static float    ema_abs_d = 0.0f;

/* Fast pin readers (work even in AF mode) — use your main.h symbols */
static inline uint8_t read_A(void){ return (ENC_A_GPIO_Port->IDR & ENC_A_Pin) ? 1U : 0U; }
static inline uint8_t read_B(void){ return (ENC_B_GPIO_Port->IDR & ENC_B_Pin) ? 1U : 0U; }
static inline uint8_t read_Z_level(void){ return (ENC_Z_GPIO_Port->IDR & ENC_Z_Pin) ? 1U : 0U; }

/* Encoder period from TIM1.Init.Period+1 (you set Period=1999) */
#define MOD 2000u

/* Scale helper using the exported min/scale arrays */
static inline float scale_feat(int j, float x) {
  float y = (x - MODEL_FEAT_MIN[j]) * MODEL_FEAT_SCALE[j];
  if (y < 0.f) y = 0.f;
  if (y > 1.f) y = 1.f;
  return y;
}

