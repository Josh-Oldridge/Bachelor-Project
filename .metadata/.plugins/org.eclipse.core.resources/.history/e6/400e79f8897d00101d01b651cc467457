void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
  if (htim->Instance != TIM7) return;
  tim7_ticks++;

  /* Delta counts with wrap handling */
  uint16_t cnt = __HAL_TIM_GET_COUNTER(&htim1);
  int16_t d = (int16_t)cnt - (int16_t)last_cnt;
  if (d >  (int16_t)(MOD/2))  d -= MOD;
  if (d < -(int16_t)(MOD/2))  d += MOD;
  last_cnt = cnt;

  /* Z index pulse from TIM1 index flag (flag name differs across HAL versions) */
  uint8_t z_pulse = 0;
#if defined(TIM_FLAG_IDX)
  if (__HAL_TIM_GET_FLAG(&htim1, TIM_FLAG_IDX)) {
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_FLAG_IDX);
    z_pulse = 1;
  }
#elif defined(TIM_FLAG_IDXF)
  if (__HAL_TIM_GET_FLAG(&htim1, TIM_FLAG_IDXF)) {
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_FLAG_IDXF);
    z_pulse = 1;
  }
#endif
  if (z_pulse) { steps_since_z = 0; revolution_cnt++; }
  else         { steps_since_z += (uint32_t)((d>=0)? d : -d); }

  /* Read A/B levels and detect edges */
  uint8_t A = read_A(), B = read_B();
  static uint8_t last_A = 0, last_B = 0;
  uint8_t A_rise = (A && !last_A), A_fall = (!A && last_A);
  uint8_t B_rise = (B && !last_B), B_fall = (!B && last_B);
  last_A = A; last_B = B;

  /* Direction flags */
  int dir_neg = (d < 0);
  int dir_pos = (d > 0);

  /* Speed-ish features (EMA for stability) */
  float ad = (float)((d>=0)? d : -d);
  ema_abs_d = 0.9f*ema_abs_d + 0.1f*ad;
  float interval_ratio    = (ema_abs_d > 1e-6f) ? (ad / ema_abs_d) : 1.0f;
  float speed_change_rate = (interval_ratio > 1.0f) ? (interval_ratio - 1.0f) : (1.0f - interval_ratio);
  uint8_t speed_stable    = (speed_change_rate < 0.1f) ? 1U : 0U;
  uint8_t speed_cat       = (ema_abs_d < 1.0f) ? 0U : (ema_abs_d < 4.0f ? 1U : 2U);

  /* Z expectations relative to 1 rev = MOD counts */
  const uint32_t Z_OVERDUE_MIN = MOD + MOD/2;   /* overdue if ≥1.5 revs without Z */
  uint8_t z_expected = (steps_since_z >= MOD);
  uint8_t z_overdue  = (steps_since_z >= Z_OVERDUE_MIN);

  float   rev_prog   = (float)cnt / (float)MOD; /* 0..1 */
  uint8_t AB         = (uint8_t)((A<<1)|B);     /* 0..3 */
  uint8_t ABnx       = dir_pos ? ((AB+1)&3) : (dir_neg ? ((AB+3)&3) : AB);
  uint8_t phase_lag  = (uint8_t)((ABnx - AB) & 3);

  uint8_t edge_rising  = (A_rise || B_rise) ? 1U : 0U;
  uint8_t edge_falling = (A_fall || B_fall) ? 1U : 0U;
  uint8_t chA = (A_rise || A_fall) ? 1U : 0U;
  uint8_t chB = (B_rise || B_fall) ? 1U : 0U;
  uint8_t chZ = z_pulse; /* keep consistent with training (event, not level) */

  /* Pack one frame in EXACT MODEL_FEATURES order, scaled */
  float f[FEAT_DIM];
  int k = 0;

  #define PACK(val)  do { f[k] = scale_feat(k, (val)); k++; } while(0)

  PACK((float)A);                // A_State
  PACK((float)B);                // B_State
  PACK((float)AB);               // AB_State
  PACK(1.0f);                    // Valid
  PACK((float)revolution_cnt);   // Revolution
  PACK(interval_ratio);          // Interval_Ratio
  PACK((float)speed_stable);     // Speed_Stable
  PACK((float)speed_cat);        // Speed_Category
  PACK(speed_change_rate);       // Speed_Change_Rate
  PACK((float)speed_stable);     // Recent_Stability
  PACK(1.0f);                    // Sequence_Valid
  PACK((float)(d!=0));           // State_Change
  PACK((float)steps_since_z);    // Steps_Since_Z
  PACK((float)z_expected);       // Z_Expected
  PACK((float)z_overdue);        // Z_Overdue
  PACK(rev_prog);                // Revolution_Progress
  PACK(0.0f);                    // Cumulative_Error (placeholder)
  PACK((float)phase_lag);        // Phase_Lag
  PACK((float)chA);              // Channel_A
  PACK((float)chB);              // Channel_B
  PACK((float)chZ);              // Channel_Z
  PACK((float)edge_falling);     // Edge_FALLING
  PACK((float)edge_rising);      // Edge_RISING
  PACK((float)dir_neg);          // Direction_backward
  PACK((float)dir_pos);          // Direction_forward

  #undef PACK


  for (int j=0;j<FEAT_DIM;++j) feat_win[win_fill][j] = f[j];
  win_fill++;
  if (win_fill >= SEQ_LEN) { win_fill = 0; win_ready++; }
}
