/**
 * @brief  The application entry point.
 * @retval int
 */
int main(void) {

	/* USER CODE BEGIN 1 */

	/* USER CODE END 1 */

	/* Enable the CPU Cache */

	/* Enable I-Cache---------------------------------------------------------*/
	SCB_EnableICache();

	/* Enable D-Cache---------------------------------------------------------*/
	SCB_EnableDCache();

	/* MCU Configuration--------------------------------------------------------*/
	HAL_Init();

	/* USER CODE BEGIN Init */

	/* USER CODE END Init */

	/* USER CODE BEGIN SysInit */

	/* USER CODE END SysInit */

	/* Initialize all configured peripherals */
	MX_GPIO_Init();
	MX_LPUART1_UART_Init();
	MX_TIM1_Init();
	MX_RAMCFG_Init();
	MX_CACHEAXI_Init();
	MX_X_CUBE_AI_Init();
	SystemIsolation_Config();
	/* USER CODE BEGIN 2 */
	/**
	 * @brief Early bring-up of diagnostics and encoder sampler.
	 * @details
	 *  - Watermark MSP and print RAM map before interrupts start.
	 *  - Init sampler and timing; publish capacities for health reporting.
	 *  - Flush producer/consumer rings before enabling TIM1 encoder.
	 */
	MemDiag_Init();
	MemDiag_PrintSummary();
	EncSampler_Init();
	DiagTiming_Init();
	Diag_SetEventBufCaps(EVENT_BUFFER_SIZE);
	Diag_SetWinFifoCaps(WINFIFO);
	EncSampler_FlushWindows();

	/** @brief Enable TIM1 in encoder mode with index; events go to ISR drain. */
	HAL_TIM_Encoder_Start(&htim1, TIM_CHANNEL_ALL);
	HAL_TIMEx_EnableEncoderIndex(&htim1);
	__HAL_TIM_ENABLE(&htim1);

	printf("ENC MODE: LIVE (TIM1 enabled)\r\n");
	printf("Init done\r\n");
	printf("SEQ_LEN=%d FEAT_DIM=%d\r\n", (int) MODEL_SEQ_LEN,
			(int) MODEL_FEAT_DIM);

	/** @brief Allow hardware to settle before starting a timed trial. */
	HAL_Delay(WARMUP_MS);

	/**
	 * @brief Arm a fixed-duration trial aligned to the next accepted Z.
	 * @details
	 *   - Diag layer will time the coverage window.
	 *   - Sampler is primed so the first window starts at a canonical edge.
	 */
	Diag_ArmTrialAfterNextZ(TRIAL_MS);
	EncSampler_OnTrialArm();

	/** @brief UI heartbeat timer for LED blink. */
	uint32_t next_blink_ms = HAL_GetTick() + 250;
	HAL_Delay(200);
	/* USER CODE END 2 */

	/* Initialize leds */
	BSP_LED_Init(LED_BLUE);
	BSP_LED_Init(LED_RED);
	BSP_LED_Init(LED_GREEN);

	/* Infinite loop */
	/* USER CODE BEGIN WHILE */
	while (1) {
		/* USER CODE END WHILE */

//  MX_X_CUBE_AI_Process();
		/* USER CODE BEGIN 3 */

		/**
		 * @brief Main loop: event→window→inference pipeline.
		 * @details
		 *   1) EncSampler_Process(): drains ISR events and packs SEQ_LEN×FEAT_DIM windows.
		 *   2) While windows are ready, MX_X_CUBE_AI_Process() consumes exactly one per call.
		 *   3) Optional one-shot trial: stop, hard-drain, print timing/health + stats.
		 *   4) Blink + sleep: low-power wait when idle.
		 */
		EncSampler_Process();

		/* Consume all ready windows; each call runs one inference. */
		while (win_ready) {
			MX_X_CUBE_AI_Process();   // consumes exactly 1 window per call
		}

#if ONE_SHOT_TRIAL
		/** @brief After the trial coverage window ends, freeze, drain, and report once. */
		static uint8_t printed_summary = 0;
		if (!printed_summary && !Diag_IsTrialCovering(HAL_GetTick())) {
			EncSampler_SetABIrqs(0);   // stop new events entering the ring

			/* Hard drain: finish processing everything already captured. */
			while (EncSampler_HasPending() || win_ready) {
				EncSampler_Process();         // events -> windows
				while (win_ready) {
					MX_X_CUBE_AI_Process();   // windows -> model + prints
				}
			}

			/* Timer/health snapshot over the last interval. */
			diag_snapshot_t snap;
			Diag_GetAndResetSnapshot(&snap);
			Diag_PrintSnapshot(&snap);

			/* Optional: per-class inference counts collected by the trial layer. */
			enum {
				C_MISSINGSTEP = 0, C_NORMAL = 1, C_ZINDEX = 2
			};
			const diag_trial_t *tr = Diag_TrialPeek();
			if (tr) {
				uint32_t cnt_missing_step =
						(C_MISSINGSTEP < DIAG_MAX_CLASSES) ?
								tr->class_hist[C_MISSINGSTEP] : 0;
				uint32_t cnt_normal =
						(C_NORMAL < DIAG_MAX_CLASSES) ?
								tr->class_hist[C_NORMAL] : 0;
				uint32_t cnt_zindex =
						(C_ZINDEX < DIAG_MAX_CLASSES) ?
								tr->class_hist[C_ZINDEX] : 0;

				uint32_t cnt_other = 0;
				if (tr->inferences
						> (cnt_missing_step + cnt_normal + cnt_zindex))
					cnt_other = tr->inferences
							- (cnt_missing_step + cnt_normal + cnt_zindex);
				(void) cnt_other; /* available if you want to print it */
			}

			/* Policy totals vs. raw argmax totals (since boot). */
			uint32_t tot_n = 0, tot_ms = 0, tot_z = 0;
			Model_GetTotals(&tot_n, &tot_ms, &tot_z);
			printf(
					"COUNTS(total, policy): normal=%lu  missing_step=%lu  z_index=%lu\r\n",
					(unsigned long) tot_n, (unsigned long) tot_ms,
					(unsigned long) tot_z);

			uint32_t raw_n = 0, raw_ms = 0, raw_z = 0;
			Model_GetTotalsRaw(&raw_n, &raw_ms, &raw_z);
			printf(
					"COUNTS(total, raw)   : normal=%lu  missing_step=%lu  z_index=%lu\r\n",
					(unsigned long) raw_n, (unsigned long) raw_ms,
					(unsigned long) raw_z);

			/* True mechanical speed from Z-to-Z, plus AB-derived rates. */
			float rps_i = 0.f, rps_a = 0.f, rpm_i = 0.f, rpm_a = 0.f;
			TD_Speed_Get(&rps_i, &rps_a, &rpm_i, &rpm_a);
			printf("SPEED(Z): RPS_inst=%.2f  RPS=%.2f  RPM=%.1f\r\n",
					(double) rps_i, (double) rps_a, (double) rpm_a);

			const float ab_khz_inst = (rps_i * (float) DIAG_EDGES_PER_REV)
					/ 1000.0f;
			const float ab_khz_avg = (rps_a * (float) DIAG_EDGES_PER_REV)
					/ 1000.0f;
			printf("SPEED(AB): AB_kHz_inst=%.2f  AB_KHz=%.2f\r\n",
					(double) ab_khz_inst, (double) ab_khz_avg);

			/* Per-channel rising-only rate (A or B individually) — diagnostic. */
			printf("SPEED(CH): A_or_B_kHz≈%.2f\r\n",
					(double) (ab_khz_avg * 0.5f));

			/* x4 step rate: steps/rev = 4*CPR. */
			printf("SPEED(x4): steps_kHz=%.2f\r\n",
					(double) ((rps_a * (4.0f * (float) CPR)) / 1000.0f));

			/* RAM map + free summary at end of trial. */
			MemDiag_PrintSummary();

			/* Stop hardware after the single trial. */
			EncSampler_StopHardware();
			printed_summary = 1;
		}
#endif

		/* Blink heart-beat and idle sleep when no work pending. */
		if (next_blink_ms == 0)
			next_blink_ms = HAL_GetTick() + 250;
		if ((int32_t)(HAL_GetTick() - next_blink_ms) >= 0) {
			BSP_LED_Toggle(LED_RED);
			next_blink_ms += 250;
		}
		if ((win_ready == 0) && !EncSampler_HasPending()) {
			__DSB();
			__WFI();
			__ISB();
		}
	}
	/* USER CODE END 3 */
}

