/**
 * @def CPR
 * @brief Encoder counts per mechanical revolution.
 * @note Used to derive x4 step rate and AB edges per revolution.
 */
#ifndef CPR
#define CPR 500u
#endif

/**
 * @brief When 1, run a single timed capture ("trial") and then print a summary.
 * @details Set to 0 to stream continuously (no auto-stop/summary).
 */
#define ONE_SHOT_TRIAL  1

/** @brief Warm-up delay before arming the trial (ms). */
#define WARMUP_MS       1000u

/** @brief Trial duration passed to Diag_ArmTrialAfterNextZ() (ms). */
#define TRIAL_MS        1000u

/**
 * @def DIAG_EDGES_PER_REV
 * @brief Number of AB edges per mechanical revolution (quadrature ×4).
 */
#ifndef DIAG_EDGES_PER_REV
# define DIAG_EDGES_PER_REV (4u * CPR)
#endif

