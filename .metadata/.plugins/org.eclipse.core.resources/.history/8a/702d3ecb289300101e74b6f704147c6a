/* ============================ Public API =============================== */

void EncSampler_Init(void) {
  memset(&enc_state, 0, sizeof(enc_state));
  enc_state.baseline_interval = 10.0f;

  enc_state.last_AB_state = (enc_read_AB() & 0x3u);
  synth_ring_idx = gray_to_ring_idx(enc_state.last_AB_state);
  synth_gray = enc_state.last_AB_state;

  WinStamp_InitAll();

  __disable_irq();
  wf_w = wf_r = 0; wf_count = 0; win_row = 0;
  win_ready = 0; win_total = 0;
  __enable_irq();

  z_epoch_seen_main = z_epoch_isr;

  __disable_irq();
  /* capture state */
  cap_armed = cap_active = cap_done = 0u;
  cap_w = cap_r = cap_count = cap_drops = 0u;
  cap_start_ms = cap_end_ms = cap_duration_ms = 0u;

  z_last_gap_edges_isr = 0u;
  __enable_irq();

  /* Seed/ECC-init the NOLOAD buffers once */
  memset((void*)win_ring, 0, sizeof(win_ring));
  memset((void*)flags_ring, 0, sizeof(flags_ring));
  memset((void*)event_buffer, 0, sizeof(event_buffer));
  memset((void*)cap_buf, 0, sizeof(cap_buf));

  EncSampler_ConfigIRQs();
  __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_TIF | TIM_SR_COMIF);
}

void EncSampler_Process(void) {
  /* LIVE processing only (no replay pump) */

  static uint32_t last_ms = 0;
  static uint32_t gray_skip2 = 0;
  static uint8_t last_src = 0;
  static int32_t dir_sum = 0;
  static uint32_t rule_flags_live = 0;
  static uint8_t had_z_in_win = 0;

  /* adjacency computed on the same gray the model sees */
  static uint8_t last_model_gray = 0;
  static uint8_t have_last_model_gray = 0;

  if (cap_active) {
    uint32_t now = HAL_GetTick();
    if ((int32_t)(now - cap_end_ms) >= 0) {
      __disable_irq();
      cap_active = 0u;
      cap_done = 1u;
      __enable_irq();
    }
  }

  while (event_read != event_write) {
    encoder_event_t evt = event_buffer[event_read];
    event_read = (event_read + 1u) & EVENT_IDX_MASK;

    /* keep public Z time fresh for UI (coarse) */
    z_diag_last_z_ms = z_last_ms_isr;

#if ENABLE_TRACE_WIN
    if (win_row == 0) memset(trace_z, 0, SEQ_LEN);
#endif
    if (win_row == 0) {
      had_z_in_win = 0;
      DiagTiming_Start(DIAG_T_E2E_WINDOW);
      WinStamp_BeginWindow(wf_w);
    }

    uint8_t packZ = 0u;
    uint32_t gap_before = 0u;

    if (evt.src == 0u) { /* Handle queued Z event */
      z_epoch_seen_main = z_epoch_isr; /* Sync epoch for diagnostics */
      had_z_in_win = 1u;
      gap_before = z_last_gap_edges_isr;

      /* Increment main-side Z sequence counter */
      z_seq_main++;

      /* phase-lock synthetic gray to Z */
      synth_ring_idx = gray_to_ring_idx(evt.ab_state & 3u);
      synth_gray = GRAY_RING[synth_ring_idx];
      have_last_model_gray = 0;

      /* Stamp Z at THIS row and reset counter */
      WinStamp_OnZStampedInStream((uint8_t)win_row, z_seq_main);

      /* Flags for double/miss */
      if (gap_before < Z_MIN_GAP_EDGES) rule_flags_live |= WR_ZDOUBLE;
      if (g_ws.ab_since_z_soft > Z_MISS_EDGE_LIMIT) rule_flags_live |= WR_ZMISS;

      /* Set packZ for this row’s feature */
      packZ = 1u;

#if ENC_ZSTAMP_DEBUG
      ENC_DEBUG_PRINTF("Z processed @row=%u, seq=%lu, t=%lu ms, gap=%lu\n",
                       win_row, (unsigned long)z_seq_main, evt.timestamp_ms,
                       (unsigned long)gap_before);
#endif
    }

    /* Pack features for Z or A/B events */
    DiagTiming_Start(DIAG_T_PACK_AB);

    float *f = &win_ring[wf_w][((uint32_t)win_row * FEAT_DIM)];

    const uint8_t src_A = (evt.src == 1u);
    const uint8_t src_B = (evt.src == 2u);
    const uint8_t is_same_src = (last_src && (evt.src == last_src && evt.src != 0u)) ? 1u : 0u;

    const uint8_t current_gray = (evt.ab_state & 0x3u);
    const uint8_t model_gray = (synth_gray & 0x3u);

    uint8_t adjacent = 1u;
    if (have_last_model_gray) {
      const uint8_t diff_bits = (last_model_gray ^ model_gray) & 3u;
      adjacent = (diff_bits == 1u) || (diff_bits == 2u);
    } else {
      have_last_model_gray = 1u;
    }
    last_model_gray = model_gray;

    const uint32_t ab_for_model = WinStamp_GetAbForModel();

    f[0] = scale_feat(0, (float)model_gray);
    f[1] = scale_feat(1, (float)src_A);
    f[2] = scale_feat(2, (float)src_B);
    f[3] = scale_feat(3, (float)(evt.dir > 0));
    f[4] = scale_feat(4, (float)(evt.dir < 0));
    f[5] = scale_feat(5, enc_state.speed_change_rate);
    f[6] = scale_feat(6, (float)packZ);
    f[7] = scale_feat(7, (float)ab_for_model);
    f[8] = scale_feat(8, (float)is_same_src);
    f[9] = scale_feat(9, (float)adjacent);

    DiagTiming_Stop(DIAG_T_PACK_AB);

#if ENABLE_TRACE_WIN
    trace_ab[win_row] = model_gray;
    trace_src[win_row] = evt.src;
    trace_z[win_row] = packZ;
#endif

    if (is_same_src) gray_skip2++;
    last_src = evt.src;

    enc_state.last_AB_state = current_gray;

    /* Advance synthetic gray and counters for A/B events only */
    if (evt.src != 0u) {
      const uint8_t expect_src = (evt.dir > 0)
                                 ? ((synth_ring_idx & 1u) ? 1u : 2u)
                                 : ((synth_ring_idx & 1u) ? 2u : 1u);
      if (evt.src != expect_src) {
        synth_ring_idx = gray_to_ring_idx(current_gray);
      }
      if (evt.dir > 0) synth_ring_idx = (synth_ring_idx + 1) & 3u;
      else synth_ring_idx = (synth_ring_idx + 3) & 3u;

      WinStamp_OnEdge();
      win_row++;
    }

    /* Publish window if full */
    if (win_row >= SEQ_LEN) {
      uint32_t flags = rule_flags_live;
      if (gray_skip2 >= 2) flags |= WR_SKIP2;
      if (had_z_in_win) flags |= WR_ZINWIN;
      enc_rule_flags = flags;

      if (dir_sum > 0) last_window_dir = +1;
      else if (dir_sum < 0) last_window_dir = -1;
      else last_window_dir = enc_latched_dir;
      dir_sum = 0;

      DiagTiming_End(DIAG_T_E2E_WINDOW);
      DiagTiming_Start(DIAG_T_WIN_PUBLISH);

      WinStamp_PublishWindow(wf_w);

      flags_ring[wf_w] = flags;

      __disable_irq();
      wf_w = (uint16_t)((wf_w + 1u) & WINMASK);
      if (wf_count < WINFIFO) {
        wf_count++;
      } else {
        wf_r = (uint16_t)((wf_r + 1u) & WINMASK);
      }
      win_ready = wf_count;
#if ENABLE_TRACE_WIN
      memcpy(last_trace_ab, trace_ab, SEQ_LEN);
      memcpy(last_trace_src, trace_src, SEQ_LEN);
      memcpy(last_trace_z, trace_z, SEQ_LEN);
      memset(trace_z, 0, SEQ_LEN);
#endif
      __enable_irq();

      Diag_ObserveWinFifoLevel(wf_count);
      win_total++;

      DiagTiming_End(DIAG_T_WIN_PUBLISH);
      Diag_NotifyWindowPublished();

      /* reset window accumulators */
      win_row = 0;
      gray_skip2 = 0;
      rule_flags_live = 0;
      last_src = 0;
      had_z_in_win = 0;
      /* keep last_model_gray & have_last_model_gray across windows */
    }
  }
}

/* =============================== Copy ================================== */

int EncSampler_CopyWindowLinear(float *dst, uint32_t *out_flags) {
  uint16_t r;
  uint32_t flags;

  __disable_irq();
  if (wf_count == 0) { __enable_irq(); return -1; }
  r = wf_r;
  flags = flags_ring[r];
  wf_r = (uint16_t)((wf_r + 1u) & WINMASK);
  wf_count--;
  win_ready = wf_count;
  __enable_irq();

  memcpy(dst, win_ring[r], sizeof(win_ring[0]));
  win_rule_flags = flags;
  if (out_flags) *out_flags = flags;

  /* >>> hand off the stamps for this window <<< */
  WinStamp_CopyOut(r);

  return 0;
}

/* =============================== Stop / Flush =========================== */

void EncSampler_StopHardware(void) {
  __disable_irq();

  if (htim1.Instance) {
    __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2 | TIM_IT_UPDATE | TIM_IT_TRIGGER | TIM_IT_COM);
#ifdef TIM_IT_IDX
    __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_IDX);
#endif
    __HAL_TIM_DISABLE(&htim1);

    __HAL_TIM_CLEAR_FLAG(&htim1,
      TIM_SR_CC1IF | TIM_SR_CC1OF |
      TIM_SR_CC2IF | TIM_SR_CC2OF |
      TIM_SR_UIF | TIM_SR_TIF | TIM_SR_COMIF);
#ifdef TIM_SR_IDXF
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
#endif
  }

#ifdef TIM1_CC_IRQn
  NVIC_DisableIRQ(TIM1_CC_IRQn);
#endif
#if defined(TIM1_TRG_CCU_IRQn)
  NVIC_DisableIRQ(TIM1_TRG_CCU_IRQn);
#elif defined(TIM1_TRG_COM_IRQn)
  NVIC_DisableIRQ(TIM1_TRG_COM_IRQn);
#endif

  ab_irqs_on = 0;
  __enable_irq();
}

void EncSampler_FlushWindows(void) {
  __disable_irq();

  wf_w = wf_r = 0; wf_count = 0;
  win_ready = 0; win_total = 0;
  win_row = 0;

  event_read = event_write = 0; event_drops = 0;

  z_last_ms_isr = 0;
  ab_edges_since_z_isr = 0;
  z_last_gap_edges_isr = 0;
  z_diag_isr_seen = 0;
  z_diag_isr_accepted = 0;
  z_diag_ab_since_isr = 0;
  z_diag_steps_x4 = 0;
  z_diag_last_z_ms = 0;

  z_epoch_isr = 0;
  z_epoch_seen_main = 0;

  cap_armed = cap_active = cap_done = 0u;
  cap_w = cap_r = cap_count = cap_drops = 0u;
  cap_start_ms = cap_end_ms = cap_duration_ms = 0u;

  WinStamp_InitAll();

  __enable_irq();
}

/* ============================ Capture API ============================== */

void EncSampler_CaptureArmOnNextZ(uint32_t duration_ms)
{
  __disable_irq();
  cap_duration_ms = duration_ms ? duration_ms : 1000u;
  cap_armed = 1u;
  cap_active = 0u;
  cap_done = 0u;
  cap_reset_locked();
  __enable_irq();
}

void EncSampler_CaptureCancel(void)
{
  __disable_irq();
  cap_armed = 0u;
  cap_active = 0u;
  __enable_irq();
}

bool EncSampler_CaptureActive(void) { return cap_active != 0u; }
bool EncSampler_CaptureDone(void) { return cap_done != 0u; }
uint32_t EncSampler_CaptureCount(void) { return cap_count; }
uint32_t EncSampler_CaptureDrops(void) { return cap_drops; }

uint32_t EncSampler_CaptureRead(enc_capture_evt_t *dst, uint32_t max)
{
  if (!dst || !max) return 0u;
  uint32_t copied = 0;
  __disable_irq();
  while ((copied < max) && (cap_r != cap_w)) {
    dst[copied++] = cap_buf[cap_r];
    cap_r = (cap_r + 1u);
    if (cap_r >= CAPTURE_MAX_EVENTS) cap_r = 0u;
  }
  __enable_irq();
  return copied;
}

void EncSampler_GetLastCaptureStats(uint32_t* edges, uint32_t* dur_ms,
                                    uint32_t* first_ms, uint32_t* last_ms,
                                    uint32_t* z_marks)
{
  uint32_t e=0, f=0, l=0, z=0;

  __disable_irq();
  /* You can accumulate edges/marks inline where you need them if desired. */
  /* For now these are not auto-maintained; compute later from cap_buf if needed. */
  __enable_irq();

  if (edges) *edges = e;
  if (dur_ms) *dur_ms = (f && l && l >= f) ? (l - f) : 0u;
  if (first_ms) *first_ms = f;
  if (last_ms) *last_ms = l;
  if (z_marks) *z_marks = z;
}

void EncSampler_CaptureForceStopFromISR(void)
{
  if (cap_active) {
    __disable_irq();
    EncSampler_StopHardware();
    printf("Capture stopped at %lu ms\n", HAL_GetTick());
    cap_active = 0u;
    cap_done = 1u;
    __enable_irq();
  }
}

uint8_t EncSampler_HasPending(void)
{
  uint8_t p;
  __disable_irq();
  p = ((event_write != event_read) || ((win_row != 0) && ab_irqs_on)) ? 1u : 0u;
  __enable_irq();
  return p;
}

/* ============================== Trace API ============================== */
#if ENABLE_TRACE_WIN
void EncSampler_DebugGetLastTrace(uint8_t *ab, uint8_t *src, uint8_t *z) {
  if (ab) memcpy(ab, last_trace_ab, SEQ_LEN);
  if (src) memcpy(src, last_trace_src, SEQ_LEN);
  if (z) memcpy(z, last_trace_z, SEQ_LEN);
}
#else
void EncSampler_DebugGetLastTrace(uint8_t *ab, uint8_t *src, uint8_t *z) {
  if (ab) memset(ab, 0, SEQ_LEN);
  if (src) memset(src, 0, SEQ_LEN);
  if (z) memset(z, 0, SEQ_LEN);
}
#endif
