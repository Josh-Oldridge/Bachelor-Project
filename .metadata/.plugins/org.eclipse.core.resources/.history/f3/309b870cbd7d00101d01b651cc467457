#include "enc_sampler.h"
#include "model_meta.h"
#include <string.h>

/* -------- Fast pin readers from main.h symbols -------- */
static inline uint8_t read_A(void) { return (ENC_A_GPIO_Port->IDR & ENC_A_Pin) ? 1U : 0U; }
static inline uint8_t read_B(void) { return (ENC_B_GPIO_Port->IDR & ENC_B_Pin) ? 1U : 0U; }

/* -------- Rule flags (live + per-window snapshot) -------- */
volatile uint32_t enc_rule_flags = 0;   /* live: for UI/telemetry */
volatile uint32_t win_rule_flags = 0;   /* snapshot for the NN guardrails */

/* -------- Per-window accumulators -------- */
static uint16_t edges_A = 0, edges_B = 0, quad_bad = 0;
static uint8_t  last_AB = 0;
static uint8_t  z_seen_in_window = 0;
static uint8_t  win_fill = 0;

/* -------- Exposed state -------- */
volatile uint32_t tim7_ticks = 0;
volatile uint32_t win_ready  = 0;   /* queue depth of windows available to consume */
volatile uint32_t win_total  = 0;   /* cumulative windows produced (for sane /s rate) */
volatile float    feat_win[SEQ_LEN][FEAT_DIM];

/* -------- Private encoder/ring state -------- */
typedef struct {
  int16_t  d;        /* signed delta TIM1 between samples (with wrap fix) */
  uint8_t  z_pulse;  /* index pulse seen in this tick */
  uint8_t  A, B;     /* raw GPIO samples */
  uint16_t cnt;      /* raw TIM1 count (0..MOD-1) */
} raw_t;

#define RB_LOG2 9                     /* 512 samples ring (bigger = safer) */
#define RB_SIZE (1u << RB_LOG2)
#define RB_MASK (RB_SIZE - 1)

static volatile raw_t    rb[RB_SIZE];
static volatile uint16_t rb_w = 0, rb_r = 0;

#define MOD 2000u                     /* TIM1 period+1 (1999+1) */
static uint16_t last_cnt = 0;

/* These live in main-context only (never touched in ISR) */
static uint32_t steps_since_z = 0;
static uint32_t revolution_cnt = 0;
static float    ema_abs_d = 0.0f;

/* Scale helper using exported arrays (0..1 clamp) */
static inline float scale_feat(int j, float x) {
  float y = (x - MODEL_FEAT_MIN[j]) * MODEL_FEAT_SCALE[j];
  if (y < 0.f) y = 0.f;
  if (y > 1.f) y = 1.f;
  return y;
}

/* -------- Public API -------- */
void EncSampler_Init(void) { /* TIMs are CubeMX-inited in main.c */ }
void EncSampler_Start(void) { /* start happens in main.c */ }

/* -------- ISR hook: push one compact sample to ring -------- */
void EncSampler_TIM7_Callback(void)
{
  tim7_ticks++;

  uint16_t cnt = __HAL_TIM_GET_COUNTER(&htim1);
  int16_t d = (int16_t)cnt - (int16_t)last_cnt;
  if (d >  (int16_t)(MOD/2))  d -= MOD;
  if (d < -(int16_t)(MOD/2))  d += MOD;
  last_cnt = cnt;

  uint8_t z_pulse = 0;
#if defined(TIM_FLAG_IDX)
  if (__HAL_TIM_GET_FLAG(&htim1, TIM_FLAG_IDX)) {
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_FLAG_IDX);
    z_pulse = 1;
  }
#elif defined(TIM_FLAG_IDXF)
  if (__HAL_TIM_GET_FLAG(&htim1, TIM_FLAG_IDXF)) {
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_FLAG_IDXF);
    z_pulse = 1;
  }
#endif

  uint8_t A = read_A();
  uint8_t B = read_B();

  uint16_t w = rb_w;
  uint16_t n = (w + 1) & RB_MASK;
  if (n == rb_r) {                    /* overflow: drop oldest */
    rb_r = (rb_r + 1) & RB_MASK;
  }
  rb[w].d = d; rb[w].z_pulse = z_pulse; rb[w].A = A; rb[w].B = B; rb[w].cnt = cnt;
  rb_w = n;
}

/* -------- Main-context feature builder: drains ring, fills feat_win -------- */
void EncSampler_Process(void)
{
  static uint8_t last_A = 0, last_B = 0;

  while (rb_r != rb_w) {
    raw_t s = rb[rb_r];
    rb_r = (rb_r + 1) & RB_MASK;

    int16_t  d       = s.d;
    uint8_t  A       = s.A;
    uint8_t  B       = s.B;
    uint8_t  z_pulse = s.z_pulse;
    uint16_t cnt     = s.cnt;

    /* Track Z progress */
    if (z_pulse) { steps_since_z = 0; revolution_cnt++; }
    else { steps_since_z += (uint32_t)((d >= 0) ? d : -d); }

    /* Edge detection on raw GPIO sample */
    uint8_t A_rise = (A && !last_A), A_fall = (!A && last_A);
    uint8_t B_rise = (B && !last_B), B_fall = (!B && last_B);
    uint8_t chAchg = (uint8_t)(A_rise | A_fall);
    uint8_t chBchg = (uint8_t)(B_rise | B_fall);

    /* Current AB and previous AB */
    uint8_t AB = (uint8_t)(((uint8_t)A << 1) | (uint8_t)B) & 3;
    uint8_t AB_prev = last_AB;

    /* At start of a window, sync AB so the first compare isn’t stale */
    if (win_fill == 0) {
      AB_prev = AB;
      last_AB = AB;
    }

    /* Count edges (for stuck detection) */
    if (chAchg) edges_A++;
    if (chBchg) edges_B++;

    /* Quadrature sanity: check ONLY when exactly one channel toggled.
       Valid Gray code sequence is a neighbor: 00->01->11->10->00 or reverse. */
    if (chAchg ^ chBchg) {
      /* Map Gray code (AB) to sequential index: 00,01,11,10 -> 0,1,2,3 */
      static const uint8_t gray2idx[4] = {0, 1, 3, 2};
      uint8_t idx_prev = gray2idx[AB_prev];
      uint8_t idx_curr = gray2idx[AB];
      uint8_t diff     = (uint8_t)((idx_curr - idx_prev) & 3);
      /* Valid neighbor moves are +1 or -1 (1 or 3 mod 4). Anything else is bad. */
      if (diff != 1 && diff != 3) {
        quad_bad++;
      }
    }
    /* If both channels changed in the same sample, skip: ambiguous at this rate. */

    if (z_pulse) z_seen_in_window = 1;

    last_AB = AB;
    last_A  = A;
    last_B  = B;

    /* Lightweight speed features */
    int   dir_neg = (d < 0), dir_pos = (d > 0);
    float ad = (float)((d >= 0) ? d : -d);
    ema_abs_d = 0.9f * ema_abs_d + 0.1f * ad;
    float interval_ratio    = (ema_abs_d > 1e-6f) ? (ad / ema_abs_d) : 1.0f;
    float speed_change_rate = (interval_ratio > 1.0f) ? (interval_ratio - 1.0f) : (1.0f - interval_ratio);
    uint8_t speed_stable    = (speed_change_rate < 0.1f) ? 1U : 0U;
    uint8_t speed_cat       = (ema_abs_d < 1.0f) ? 0U : (ema_abs_d < 4.0f ? 1U : 2U);

    /* Z expectations (one per rev @ MOD counts) */
    const uint32_t Z_OVERDUE_MIN = MOD + MOD/2;   /* ~1.5 revs */
    uint8_t z_expected = (steps_since_z >= MOD);
    uint8_t z_overdue  = (steps_since_z >= Z_OVERDUE_MIN);

    /* Phase/edge features */
    float   rev_prog   = (float)cnt / (float)MOD;
    uint8_t ABnx       = dir_pos ? ((AB + 1) & 3) : (dir_neg ? ((AB + 3) & 3) : AB);
    uint8_t phase_lag  = (uint8_t)((ABnx - AB) & 3);

    uint8_t edge_rising  = (uint8_t)((A_rise || B_rise) ? 1U : 0U);
    uint8_t edge_falling = (uint8_t)((A_fall || B_fall) ? 1U : 0U);
    uint8_t chA          = (uint8_t)((A_rise || A_fall) ? 1U : 0U);
    uint8_t chB          = (uint8_t)((B_rise || B_fall) ? 1U : 0U);
    uint8_t chZ          = z_pulse;

    /* Pack features into the sliding window row */
    volatile float *f = feat_win[win_fill];
    int k = 0;
#define PACK(val) do { f[k] = scale_feat(k, (val)); k++; } while(0)
    PACK((float)A);
    PACK((float)B);
    PACK((float)AB);
    PACK(1.0f);
    PACK((float)revolution_cnt);
    PACK(interval_ratio);
    PACK((float)speed_stable);
    PACK((float)speed_cat);
    PACK(speed_change_rate);
    PACK((float)speed_stable);
    PACK(1.0f);
    PACK((float)(d != 0));
    PACK((float)steps_since_z);
    PACK((float)z_expected);
    PACK((float)z_overdue);
    PACK(rev_prog);
    PACK(0.0f);
    PACK((float)phase_lag);
    PACK((float)chA);
    PACK((float)chB);
    PACK((float)chZ);
    PACK((float)edge_falling);
    PACK((float)edge_rising);
    PACK((float)dir_neg);
    PACK((float)dir_pos);
#undef PACK

    /* Advance within the window; if full, publish flags & rotate */
    win_fill++;
    if (win_fill >= SEQ_LEN) {
      const uint16_t MIN_MOVING_EDGES = 4;
      uint32_t flags = 0;

      /* Stuck channel detection */
      if (edges_B >= MIN_MOVING_EDGES && edges_A == 0) flags |= RS_A_STUCK;
      if (edges_A >= MIN_MOVING_EDGES && edges_B == 0) flags |= RS_B_STUCK;

      /* Bad quadrature sequencing inside the window */
      #define QUAD_BAD_MIN 3
      if ((edges_A + edges_B) >= MIN_MOVING_EDGES && quad_bad >= QUAD_BAD_MIN)
        flags |= RS_QUAD_BAD;

      /* Missed Z only if: we were moving, no Z seen this window, and overdue */
      if ((edges_A + edges_B) >= MIN_MOVING_EDGES &&
          !z_seen_in_window &&
          steps_since_z >= Z_OVERDUE_MIN) {
        flags |= RS_Z_MISSED;
      }

      /* Publish flags: snapshot for NN, live for UI */
      win_rule_flags = flags;
      enc_rule_flags = flags;

      /* reset per-window accumulators */
      edges_A = edges_B = quad_bad = 0;
      z_seen_in_window = 0;

      /* rotate window & notify */
      win_fill = 0;
      win_ready++;    /* queue depth for consumer */
      win_total++;    /* cumulative windows produced */
    }
  }
}

/* -------- Copy the current window into a linear buffer -------- */
int EncSampler_CopyWindowLinear(float* dst)
{
  if (win_ready == 0) return -1;

  __disable_irq();
  /* Oldest element starts at win_fill (next write index). */
  uint8_t start = win_fill;
  int idx = 0;
  for (int t = 0; t < SEQ_LEN; ++t) {
    uint8_t i = (uint8_t)(start + t);
    if (i >= SEQ_LEN) i -= SEQ_LEN;
    volatile float* src = feat_win[i];
    for (int f = 0; f < FEAT_DIM; ++f) dst[idx++] = src[f];
  }
  win_ready--;  /* consumed one */
  __enable_irq();
  return 0;
}
