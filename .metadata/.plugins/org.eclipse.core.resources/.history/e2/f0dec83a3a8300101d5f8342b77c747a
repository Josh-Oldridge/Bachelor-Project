extern TIM_HandleTypeDef htim1;

#ifndef ENABLE_RAW_LOG
#define ENABLE_RAW_LOG 1
#endif

/* --- Public/live flags --- */
volatile uint32_t enc_rule_flags = 0;
volatile uint32_t win_rule_flags = 0;

/* --- Exposed state --- */
volatile uint32_t tim7_ticks = 0; // Keep for compatibility
volatile uint32_t win_ready = 0;
volatile uint32_t win_total = 0;
volatile float feat_win[SEQ_LEN][FEAT_DIM];

/* --- Encoder state tracking --- */
typedef struct {
    int32_t last_position;
    int32_t current_position;
    uint8_t last_AB_state;
    uint32_t steps_since_z;
    uint32_t z_count;
    float speed_change_rate;
    uint32_t last_update_ms;
    float baseline_interval; // Added this missing field
} encoder_state_t;

static encoder_state_t enc_state = {0};

/* --- Window FIFO --- */
#define WINFIFO_LOG2 2
#define WINFIFO (1u << WINFIFO_LOG2)
static float win_fifo[WINFIFO][SEQ_LEN * FEAT_DIM];
static uint32_t flags_fifo[WINFIFO];
static uint8_t wf_w = 0, wf_r = 0, wf_count = 0;

/* --- Gray code helpers --- */
static inline uint8_t position_to_AB_state(int32_t pos) {
    uint8_t phase = (uint8_t)(pos & 3);
    const uint8_t gray_lut[4] = {0, 1, 3, 2}; // 00, 01, 11, 10
    return gray_lut[phase];
}

/* --- Scaling helper --- */
static inline float scale_feat(int j, float x) {
    float y = (x - MODEL_FEAT_MIN[j]) * MODEL_FEAT_SCALE[j];
    if (y < 0.f) y = 0.f;
    if (y > 1.f) y = 1.f;
    return y;
}

// Circular buffer for encoder events
typedef struct {
    int32_t delta; // ±1 per edge, or 0 for Z-only
    uint32_t timestamp_ms;
    uint8_t z_pulse;
} encoder_event_t;

#define EVENT_BUFFER_SIZE 512 // Adjust for max edge rate (e.g., if high speed, increase to 512)
static encoder_event_t event_buffer[EVENT_BUFFER_SIZE];
static volatile uint32_t event_write = 0;
static volatile uint32_t event_read = 0;
volatile uint32_t event_drops = 0; // Diagnostic for buffer overflows (made non-volatile for extern)

volatile uint32_t last_sr = 0; // For debug

// ISR callback - keep fast, just buffer the event
void EncSampler_EncoderChangeCallback(void) {
    uint32_t next_write = (event_write + 1) % EVENT_BUFFER_SIZE;
    if (next_write == event_read) {
        event_drops++;
        return;
    }

    encoder_event_t *evt = &event_buffer[event_write];
    evt->timestamp_ms = HAL_GetTick();
    evt->z_pulse = 0;
    evt->delta = 0;

    uint32_t sr = htim1.Instance->SR;
    last_sr = sr;

    // For encoder mode, use UPDATE interrupt for position changes
    if (sr & TIM_SR_UIF) {
        int32_t current_pos = (int32_t)__HAL_TIM_GET_COUNTER(&htim1);
        static int32_t last_pos = 0;
        evt->delta = current_pos - last_pos;
        last_pos = current_pos;
        __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_UPDATE);
    }

    if (sr & TIM_SR_IDXF) {
        evt->z_pulse = 1;
        __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_IDX);
    }

    // Clear error flags
    if (sr & (TIM_SR_TERRF | TIM_SR_IERRF)) {
        __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_TERRF | TIM_SR_IERRF);
    }

    event_write = next_write;
}

/* --- Public API --- */
void EncSampler_Init(void) {
    memset(&enc_state, 0, sizeof(enc_state));
    enc_state.last_update_ms = HAL_GetTick();
    enc_state.baseline_interval = 10.0f; // Initialize baseline

    // Disable unwanted interrupts to avoid firing on them
    __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_UPDATE | TIM_IT_CC3 | TIM_IT_CC4 | TIM_IT_TRIGGER | TIM_IT_COM | TIM_IT_BREAK);
}

/* --- Compatibility stub --- */
void EncSampler_TIM7_Callback(void) {
    tim7_ticks++; // Just for compatibility with rate reporting
}

/* --- Event-driven processing --- */
void EncSampler_Process(void) {
    static uint8_t win_fill = 0;

    // Print last SR from ISR for debug (only if non-zero or changed)
    static uint32_t prev_sr = 0;
//    if (last_sr != prev_sr && last_sr != 0) {
//        printf("Last SR from ISR: 0x%lx\n", (unsigned long)last_sr);
//        prev_sr = last_sr;
//    }

    while (event_read != event_write) {
        encoder_event_t evt = event_buffer[event_read];
        event_read = (event_read + 1) % EVENT_BUFFER_SIZE;

        // Update position and steps
        enc_state.current_position += evt.delta;
        enc_state.last_position = enc_state.current_position; // For any future use

        // Handle Z pulse
        if (evt.z_pulse) {
            enc_state.z_count++;
            enc_state.steps_since_z = 0;
        } else if (evt.delta != 0) {
            enc_state.steps_since_z += abs(evt.delta);
        }

        // Compute AB state
        uint8_t current_AB = position_to_AB_state(enc_state.current_position);

        // Only process if state change or Z (as in your old logic)
        if (current_AB != enc_state.last_AB_state || evt.z_pulse) {

            // Calculate features
            uint8_t state_change = (current_AB != enc_state.last_AB_state) ? 1 : 0;
            uint8_t dir_fwd = (evt.delta > 0) ? 1 : 0;
            uint8_t dir_bwd = (evt.delta < 0) ? 1 : 0;
            uint8_t A = (current_AB >> 1) & 1;
            uint8_t B = current_AB & 1;

            // Edge detection
            uint8_t last_A = (enc_state.last_AB_state >> 1) & 1;
            uint8_t last_B = enc_state.last_AB_state & 1;
            uint8_t edge_rising = ((A && !last_A) || (B && !last_B) || evt.z_pulse) ? 1 : 0;

            // Speed change rate
            uint32_t time_delta = evt.timestamp_ms - enc_state.last_update_ms;
            if (time_delta > 0 && state_change && evt.delta != 0) {
                float interval_ratio = (float)time_delta / enc_state.baseline_interval;
                enc_state.speed_change_rate = fabsf(interval_ratio - 1.0f);
                enc_state.baseline_interval = 0.9f * enc_state.baseline_interval + 0.1f * (float)time_delta;
            }

            // Pack features
            volatile float *f = feat_win[win_fill];
            f[0] = scale_feat(0, (float)current_AB);
            f[1] = scale_feat(1, (float)state_change);
            f[2] = scale_feat(2, (float)dir_fwd);
            f[3] = scale_feat(3, (float)dir_bwd);
            f[4] = scale_feat(4, enc_state.speed_change_rate);
            f[5] = scale_feat(5, (float)A);
            f[6] = scale_feat(6, (float)B);
            f[7] = scale_feat(7, (float)evt.z_pulse);
            f[8] = scale_feat(8, (float)edge_rising);
            f[9] = scale_feat(9, (float)enc_state.steps_since_z);

            win_fill++;
            if (win_fill >= SEQ_LEN) {
                // Complete window
                int idx = 0;
                for (int t = 0; t < SEQ_LEN; ++t) {
                    volatile float* src = feat_win[t];
                    for (int f = 0; f < FEAT_DIM; ++f) win_fifo[wf_w][idx++] = src[f];
                }

                flags_fifo[wf_w] = 0;
                wf_w = (wf_w + 1) & (WINFIFO - 1);
                if (wf_count < WINFIFO) { wf_count++; }
                else { wf_r = (wf_r + 1) & (WINFIFO - 1); }

                win_ready = wf_count;
                win_total++;
                win_fill = 0;

#if ENABLE_RAW_LOG
                printf("CLEAN_SIGNALS [WIN #%lu]: delta=%ld AB=%u z=%lu steps=%lu\r\n",
                       (unsigned long)win_total, (long)evt.delta, current_AB,
                       (unsigned long)enc_state.z_count, (unsigned long)enc_state.steps_since_z);
#endif
            }

            // Update state
            enc_state.last_AB_state = current_AB;
            enc_state.last_update_ms = evt.timestamp_ms;
        }
    }
}

int EncSampler_CopyWindowLinear(float* dst, uint32_t* out_flags) {
    EncSampler_Process();

    __disable_irq();
    if (wf_count == 0) { __enable_irq(); return -1; }

    uint8_t r = wf_r;
    wf_r = (wf_r + 1) & (WINFIFO - 1);
    wf_count--;
    win_ready = wf_count;
    uint32_t flags = flags_fifo[r];
    __enable_irq();

    for (int i = 0; i < SEQ_LEN*FEAT_DIM; ++i) dst[i] = win_fifo[r][i];

    win_rule_flags = flags;
    if (out_flags) *out_flags = flags;
    return 0;
}
