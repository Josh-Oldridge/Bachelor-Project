/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_LPUART1_UART_Init();
  MX_CACHEAXI_Init();
  MX_TIM1_Init();
  MX_TIM7_Init();
  MX_RAMCFG_Init();
  MX_X_CUBE_AI_Init();
  SystemIsolation_Config();
  /* USER CODE BEGIN 2 */
  HAL_TIM_Encoder_Start(&htim1, TIM_CHANNEL_ALL);
    HAL_TIMEx_EnableEncoderIndex(&htim1);

    /* Start the periodic sampler (TIM7 @ 10 kHz) */
    HAL_TIM_Base_Start_IT(&htim7);

    printf("Init done\r\n");

    uint32_t next_blink_ms = HAL_GetTick() + 250; // 4 Hz heartbeat
    uint32_t next_report_ms = HAL_GetTick() + 200; // 5 Hz stats

    uint32_t last_ticks = 0, last_inf = 0, last_win = 0;
  /* USER CODE END 2 */

  /* Initialize leds */
  BSP_LED_Init(LED_BLUE);
  BSP_LED_Init(LED_RED);
  BSP_LED_Init(LED_GREEN);
  BSP_LED_On(LED_GREEN);

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

  MX_X_CUBE_AI_Process();
    /* USER CODE BEGIN 3 */
  uint32_t now = HAL_GetTick();
      if ((int32_t)(now - next_blink_ms) >= 0) {
        BSP_LED_Toggle(LED_RED);
        next_blink_ms += 250;
      }

      /* 1 Hz stats: shows timer rate, windows, infer rate, last output */
      if ((int32_t)(now - next_report_ms) >= 0) {
        uint32_t dt_ticks = tim7_ticks - last_ticks;
        uint32_t dt_inf = inf_total - last_inf;
        uint32_t dt_win = win_ready - last_win;

        printf("TIM7=%lu/s windows=%lu/s inf=%lu/s y=[%.5f, %.5f, %.5f, %.5f]\r\n",
               (unsigned long)dt_ticks,
               (unsigned long)dt_win,
               (unsigned long)dt_inf,
               (double)last_y[0], (double)last_y[1], (double)last_y[2], (double)last_y[3]);

        last_ticks = tim7_ticks;
        last_inf = inf_total;
        last_win = win_ready;
        next_report_ms += 200;
      }

  }
  /* USER CODE END 3 */
}

