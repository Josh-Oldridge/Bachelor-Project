void read_encoder_pins(void) {
    enc_state.A_prev = enc_state.A_current;
    enc_state.B_prev = enc_state.B_current;
    enc_state.Z_prev = enc_state.Z_current;

    // Read actual GPIO pins - adjust pin numbers for your setup
    enc_state.A_current = HAL_GPIO_ReadPin(GPIOE, GPIO_PIN_5);  // TIM1_CH1
    enc_state.B_current = HAL_GPIO_ReadPin(GPIOE, GPIO_PIN_6);  // TIM1_CH2
    enc_state.Z_current = HAL_GPIO_ReadPin(GPIOE, GPIO_PIN_7);  // TIM1_CH3 (Z)
}

// Calculate all 23 features that match training data
void calculate_features(float features[NUM_FEATURES]) {
    uint32_t current_time = tim7_ticks;

    // Read encoder pins first
    read_encoder_pins();

    // Detect edges and direction
    uint8_t a_edge = (enc_state.A_current != enc_state.A_prev);
    uint8_t b_edge = (enc_state.B_current != enc_state.B_prev);

    if (a_edge || b_edge) {
        // Update timing
        enc_state.current_interval = current_time - enc_state.last_edge_time;
        enc_state.last_edge_time = current_time;

        // Determine direction from quadrature sequence
        if (a_edge) {
            if (enc_state.A_current) { // Rising edge A
                enc_state.direction = enc_state.B_current ? -1 : 1;
                enc_state.edge_type = 0; // RISING
            } else { // Falling edge A
                enc_state.direction = enc_state.B_current ? 1 : -1;
                enc_state.edge_type = 1; // FALLING
            }
        }

        // Update encoder count
        enc_state.prev_encoder_count = enc_state.encoder_count;
        enc_state.encoder_count += enc_state.direction;

        // Check Z pulse
        if (enc_state.Z_current && !enc_state.Z_prev) {
            enc_state.revolution_count++;
            enc_state.steps_since_z = 0;
        } else {
            enc_state.steps_since_z++;
        }

        // Update speed history for stability calculation
        if (enc_state.prev_interval > 0) {
            float speed_ratio = (float)enc_state.current_interval / enc_state.prev_interval;
            enc_state.speed_history[enc_state.speed_idx] = speed_ratio;
            enc_state.speed_idx = (enc_state.speed_idx + 1) % 5;
        }
        enc_state.prev_interval = enc_state.current_interval;
    }

    // Calculate expected interval (running average)
    if (enc_state.prev_interval > 0) {
        enc_state.expected_interval = enc_state.expected_interval * 0.9f + enc_state.prev_interval * 0.1f;
    }

    // **FEATURE CALCULATION - MUST MATCH TRAINING EXACTLY**

    // 1. A_State, B_State, AB_State (core encoder states)
    features[0] = (float)enc_state.A_current;
    features[1] = (float)enc_state.B_current;
    features[2] = (float)(enc_state.A_current * 2 + enc_state.B_current); // AB_State

    // 2. Interval_Ratio (most critical feature)
    features[3] = (enc_state.expected_interval > 0) ?
                  (enc_state.current_interval / enc_state.expected_interval) : 1.0f;

    // 3. Speed analysis features
    float speed_change = fabsf(features[3] - 1.0f);
    features[4] = speed_change; // Speed_Change_Rate
    features[5] = (speed_change < 0.01f) ? 1.0f : 0.0f; // Speed_Stable

    // Speed category (0=slow, 1=medium, 2=fast)
    features[6] = (enc_state.current_interval < 100) ? 2.0f :
                  (enc_state.current_interval < 500) ? 1.0f : 0.0f; // Speed_Category

    // Recent stability (check last 5 speed measurements)
    float stability_sum = 0;
    for (int i = 0; i < 5; i++) {
        stability_sum += fabsf(enc_state.speed_history[i] - 1.0f);
    }
    features[7] = (stability_sum / 5.0f < 0.05f) ? 1.0f : 0.0f; // Recent_Stability

    // 4. Sequence validation features
    uint8_t valid_sequence = 1;
    // Check if A/B transitions follow proper quadrature sequence
    if (a_edge || b_edge) {
        uint8_t ab_state = enc_state.A_current * 2 + enc_state.B_current;
        uint8_t prev_ab_state = enc_state.A_prev * 2 + enc_state.B_prev;

        // Valid transitions: 0→1→3→2→0 (forward) or reverse
        uint8_t valid_transitions[4] = {1, 3, 2, 0}; // Next state for each current state
        uint8_t expected_next = valid_transitions[prev_ab_state];
        uint8_t expected_prev = valid_transitions[(ab_state + 2) % 4];

        if (ab_state != expected_next && prev_ab_state != expected_prev) {
            valid_sequence = 0;
        }
    }

    features[8] = (float)valid_sequence; // Sequence_Valid
    features[9] = (a_edge || b_edge) ? 1.0f : 0.0f; // State_Change

    // Phase lag calculation (simplified)
    int8_t phase_diff = enc_state.A_current - enc_state.B_current;
    features[10] = (float)phase_diff; // Phase_Lag

    // 5. Z-pulse tracking features
    features[11] = (float)enc_state.steps_since_z; // Steps_Since_Z
    features[12] = (enc_state.steps_since_z > 1800) ? 1.0f : 0.0f; // Z_Expected (near 2000 steps)
    features[13] = (enc_state.steps_since_z > 2200) ? 1.0f : 0.0f; // Z_Overdue

    // Revolution progress (0.0 to 1.0)
    features[14] = fminf((float)enc_state.steps_since_z / 2000.0f, 1.0f); // Revolution_Progress

    // 6. Error context features
    features[15] = 0.0f; // Cumulative_Error (simplified for now)

    // 7. Basic validation and metadata
    features[16] = (float)valid_sequence; // Valid
    features[17] = (float)enc_state.revolution_count; // Revolution
    features[18] = 0.0f; // Error_Type (always 0 during inference)

    // 8. Categorical features (one-hot encoded)
    // Channel (A=1,0,0 B=0,1,0 Z=0,0,1) - simplified as single value
    features[19] = (a_edge) ? 0.0f : (b_edge) ? 1.0f : 2.0f; // Channel

    // Edge type (RISING=0, FALLING=1)
    features[20] = (float)enc_state.edge_type; // Edge

    // Direction (forward=1, backward=0)
    features[21] = (enc_state.direction > 0) ? 1.0f : 0.0f; // Direction

    // Additional features to reach 25 (padding/derived)
    features[22] = features[3] * features[4]; // Interaction term
    features[23] = (float)(current_time % 1000) / 1000.0f; // Time feature
    features[24] = (features[8] && features[5]) ? 1.0f : 0.0f; // Combined health
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM7)
    {
        tim7_ticks++;

        // Calculate all features for this timestep
        calculate_features(feature_buffer[feature_fill]);

        feature_fill++;
        if (feature_fill >= WIN) {
            feature_fill = 0;
            run_infer = 1;
        }
    }
}
