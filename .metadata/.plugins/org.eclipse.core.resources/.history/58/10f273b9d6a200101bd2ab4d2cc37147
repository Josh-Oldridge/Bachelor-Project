/* GPIO pulse + timing around ai_network_run (same as float32) */
static int ai_run_timed(void) {
  ai_i32 batch;

#ifdef MODEL_PIN_GPIO_Port
  HAL_GPIO_WritePin(MODEL_PIN_GPIO_Port, MODEL_PIN_Pin, GPIO_PIN_SET);
#endif
  DiagTiming_Start(DIAG_T_MODEL);

  batch = ai_network_run(network, ai_input, ai_output);

  DiagTiming_Stop(DIAG_T_MODEL);
#ifdef MODEL_PIN_GPIO_Port
  HAL_GPIO_WritePin(MODEL_PIN_GPIO_Port, MODEL_PIN_Pin, GPIO_PIN_RESET);
#endif

  if (batch != 1) {
    ai_log_err(ai_network_get_error(network), "ai_network_run");
    return -1;
  }

  Diag_IncInferenceCount();
  return 0;
}

/* Quantize float -> int8 using per-tensor (scale, zp) */
static inline int8_t q_i8_from_f32(float x, float scale, int zp) {
  const int v = (int)lrintf(x / scale) + zp;
  return (int8_t)CLAMP_I8(v);
}

/* Acquire oldest ready window as float (like FP32), then quantize into NN input */
int acquire_and_process_data(ai_i8* data[])
{
  if (EncSampler_CopyWindowLinear(g_xwin_float, &rf_snapshot) != 0)
    return -1;  /* no ready window */

  ai_i8 *dst = data[0];  /* single input tensor */
  const int N = SEQ_LEN * FEAT_DIM;
  for (int i = 0; i < N; ++i) {
    dst[i] = (ai_i8)q_i8_from_f32(g_xwin_float[i], IN_SCALE, IN_ZP);
  }
  return 0;
}

/* RAW+POLICY totals already declared below; we keep the simple “policy == raw” for now */
static uint32_t s_tot_raw_ms = 0, s_tot_raw_n = 0, s_tot_raw_z = 0;
static uint32_t s_tot_pol_ms = 0, s_tot_pol_n = 0, s_tot_pol_z = 0;

/* Dequantize output to floats (for logging/policy) & update totals */
int post_process(ai_i8* data[])
{
  const ai_i8 *src = data[0];
  for (int i = 0; i < AI_NETWORK_OUT_1_SIZE; ++i)
    last_y_raw[i] = (float)((int)src[i] - OUT_ZP) * OUT_SCALE;

  int best_raw = 0;
  for (int i = 1; i < AI_NETWORK_OUT_1_SIZE; ++i)
    if (last_y_raw[i] > last_y_raw[best_raw]) best_raw = i;

  if      (best_raw == C_MISSINGSTEP) s_tot_raw_ms++;
  else if (best_raw == C_ZINDEX)      s_tot_raw_z++;
  else                                s_tot_raw_n++;

  /* policy == raw for now (plug your DecideWithPolicy later if you want) */
  int best_pol = best_raw;
  if      (best_pol == C_MISSINGSTEP) s_tot_pol_ms++;
  else if (best_pol == C_ZINDEX)      s_tot_pol_z++;
  else                                s_tot_pol_n++;

  /* quick one-line INF log (keeps your telemetry flowing) */
  inf_seq++;
  printf("INF#%lu P=[MS:%.3f N:%.3f Z:%.3f] flags(win)=0x%08lX flags(live)=0x%08lX\r\n",
         (unsigned long)inf_seq,
         (double)last_y_raw[C_MISSINGSTEP],
         (double)last_y_raw[C_NORMAL],
         (double)last_y_raw[C_ZINDEX],
         (unsigned long)win_rule_flags,
         (unsigned long)enc_rule_flags);
  return 0;
}

/* getters used by main.c */
void Model_GetTotals(uint32_t *normal, uint32_t *missing, uint32_t *zindex)
{
  if (normal)  *normal  = s_tot_pol_n;
  if (missing) *missing = s_tot_pol_ms;
  if (zindex)  *zindex  = s_tot_pol_z;
}

void Model_GetTotalsRaw(uint32_t *normal, uint32_t *missing, uint32_t *zindex)
{
  if (normal)  *normal  = s_tot_raw_n;
  if (missing) *missing = s_tot_raw_ms;
  if (zindex)  *zindex  = s_tot_raw_z;
}

