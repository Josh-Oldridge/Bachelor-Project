/* === INT8 quant params learned at conversion ===
 *  Input : scale = 1/255.0f , zero_point = -128
 *  Output: scale = 1/256.0f , zero_point = -128
 *  (You printed: in (0.00392156886, -128), out (0.00390625, -128))
 */
#define IN_SCALE   (1.0f/255.0f)
#define IN_ZP      (-128)
#define OUT_SCALE  (1.0f/256.0f)
#define OUT_ZP     (-128)

/* Handy macros */
#define CLAMP_I8(v)   ((v) < -128 ? -128 : ((v) > 127 ? 127 : (v)))

