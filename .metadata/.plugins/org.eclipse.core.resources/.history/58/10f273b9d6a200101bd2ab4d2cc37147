  printf("\r\nTEMPLATE - initialization\r\n");

  ai_boostrap(data_activations0);

  /* --- Assert INT8 I/O (full-integer path) --- */
  const uint32_t in_type  = AI_BUFFER_FMT_GET_TYPE(ai_input[0].format);
  const uint32_t out_type = AI_BUFFER_FMT_GET_TYPE(ai_output[0].format);
  const uint32_t in_bits  = AI_BUFFER_FMT_GET_BITS(ai_input[0].format);
  const uint32_t out_bits = AI_BUFFER_FMT_GET_BITS(ai_output[0].format);

  if (!((in_type == AI_BUFFER_FMT_TYPE_Q) && (in_bits == 8) &&
        (out_type == AI_BUFFER_FMT_TYPE_Q) && (out_bits == 8))) {
    ai_log_err((ai_error){AI_ERROR_INVALID_PARAM, AI_ERROR_CODE_INVALID_SIZE},
               "Model I/O not INT8");
  }

  printf("AI: INT8 I/O OK (in:%lu bits, out:%lu bits)  "
         "Qparams: IN(scale=%.8f,zp=%d) OUT(scale=%.8f,zp=%d)\r\n",
         (unsigned long)in_bits, (unsigned long)out_bits,
         (double)IN_SCALE, (int)IN_ZP, (double)OUT_SCALE, (int)OUT_ZP);

  /* USER CODE END 5 */
}

void MX_X_CUBE_AI_Process(void)
{
    /* USER CODE BEGIN 6 */
  int res = -1;

  printf("TEMPLATE - run - main loop\r\n");

  if (network) {

    do {
      /* 1 - acquire and pre-process input data (now quantizes into INT8) */
      res = acquire_and_process_data(data_ins);
      /* 2 - process the data - call inference engine */
      if (res == 0)
        res = ai_run();
      /* 3- post-process the predictions (now dequantizes to float) */
      if (res == 0)
        res = post_process(data_outs);
    } while (res==0);
  }

  if (res) {
    ai_error err = {AI_ERROR_INVALID_STATE, AI_ERROR_CODE_NETWORK};
    ai_log_err(err, "Process has FAILED");
  }
    /* USER CODE END 6 */
}
