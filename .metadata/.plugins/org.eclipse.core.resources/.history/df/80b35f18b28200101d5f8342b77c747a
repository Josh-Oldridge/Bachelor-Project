extern TIM_HandleTypeDef htim1;

#ifndef ENABLE_DIAGNOSTICS
#define ENABLE_DIAGNOSTICS 0
#endif

#ifndef ENABLE_RAW_LOG
#define ENABLE_RAW_LOG 0
#endif

/* --- Public/live flags --- */
volatile uint32_t enc_rule_flags = 0;
volatile uint32_t win_rule_flags = 0;

/* --- Exposed state --- */
// volatile uint32_t tim7_ticks = 0;  // Removed, no TIM7
volatile uint32_t win_ready = 0;
volatile uint32_t win_total = 0;
volatile float feat_win[SEQ_LEN][FEAT_DIM];

/* --- Window FIFO --- */
#define WINFIFO_LOG2 2
#define WINFIFO (1u << WINFIFO_LOG2)
static float win_fifo[WINFIFO][SEQ_LEN*FEAT_DIM];
static uint32_t flags_fifo[WINFIFO];
static uint8_t wf_w = 0, wf_r = 0, wf_count = 0;

/* --- State tracking --- */
#define TIM1_PERIOD 2000u
static uint16_t last_cnt = 0;
static uint8_t last_AB = 0;
static uint8_t last_A = 0;
static uint8_t last_B = 0;
static uint32_t steps_since_z_encoder = 0;
static uint32_t last_change_tick_ms = 0;
static uint32_t last_edge_tick = 0;
static float baseline_interval_ms = 50.0f;
static float current_speed_change_rate = 0.0f;

/* --- Gray code helpers --- */
static const uint8_t gray2idx[4] = {0,1,3,2};
static inline uint8_t idx2gray(uint8_t idx) {
  static const uint8_t lut[4] = {0,1,3,2};
  return lut[idx & 3];
}

/* --- Scaling helper --- */
static inline float scale_feat(int j, float x) {
  float y = (x - MODEL_FEAT_MIN[j]) * MODEL_FEAT_SCALE[j];
  if (y < 0.f) y = 0.f;
  if (y > 1.f) y = 1.f;
  return y;
}

/* --- Public API --- */
void EncSampler_Init(void) {
  last_change_tick_ms = HAL_GetTick();
  last_edge_tick = HAL_GetTick();
}

void EncSampler_Start(void) {}

/* --- No ISR callback anymore - polling in Process --- */

/* --- Process function: Poll DMA for new edges --- */
void EncSampler_Process(void)
{
  static uint32_t last_A_pos = 0, last_B_pos = 0;
  static uint8_t win_fill = 0;
  uint32_t tick_ms = HAL_GetTick();

  // Poll for new A edges
  uint32_t A_pos = IC_BUF_LEN - htim1.hdma[TIM_DMA_ID_CC1]->Instance->NDTR;
  while (last_A_pos != A_pos) {
    uint16_t cnt = ic_buf_A[last_A_pos % IC_BUF_LEN];
    int16_t d = (int16_t)cnt - (int16_t)last_cnt;
    if (d > (int16_t)(TIM1_PERIOD/2)) d -= TIM1_PERIOD;
    if (d < -(int16_t)(TIM1_PERIOD/2)) d += TIM1_PERIOD;
    last_cnt = cnt;

    // Flip A (edge on A)
    uint8_t A = !last_A;
    uint8_t B = last_B;
    uint8_t AB = (A << 1) | B;

    // State change
    uint8_t state_change = (AB != last_AB);

    // Direction from step
    uint8_t idx_prev = gray2idx[last_AB];
    uint8_t idx_curr = gray2idx[AB];
    uint8_t step = (uint8_t)((idx_curr - idx_prev + 4) % 4);  // Wrap-safe
    uint8_t dir_fwd = (step == 1);
    uint8_t dir_bwd = (step == 3);

    // Edges
    uint8_t A_rise = (A && !last_A);
    uint8_t B_rise = 0;  // No B change
    uint8_t edge_rising = (A_rise || B_rise);  // Z added later

    // SCR if change
    if (state_change) {
      uint32_t interval_ms = tick_ms - last_change_tick_ms;
      if (interval_ms == 0) interval_ms = 1;
      if (baseline_interval_ms <= 0.0f) baseline_interval_ms = (float)interval_ms;
      float ratio = (float)interval_ms / baseline_interval_ms;
      current_speed_change_rate = fabsf(ratio - 1.0f);
      baseline_interval_ms = 0.9f * baseline_interval_ms + 0.1f * (float)interval_ms;
      last_change_tick_ms = tick_ms;
    }

    // Steps
    uint32_t ad = (uint32_t)((d >= 0) ? d : -d);
    steps_since_z_encoder += ad;

    // Z check (periodic, not per edge)
    uint8_t z_pulse = 0;
    #if defined(TIM_FLAG_IDXF)
    if (__HAL_TIM_GET_FLAG(&htim1, TIM_FLAG_IDXF)) {
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_FLAG_IDXF);
      z_pulse = 1;
      steps_since_z_encoder = 0;
    }
    #else
    if (__HAL_TIM_GET_FLAG(&htim1, TIM_FLAG_IDX)) {
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_FLAG_IDX);
      z_pulse = 1;
      steps_since_z_encoder = 0;
    }
    #endif
    edge_rising |= z_pulse;

    // Update state
    last_AB = AB;
    last_A = A;
    last_edge_tick = tick_ms;

    // Pack to feat_win (direct, no processed buffer for simplicity)
    volatile float *f = feat_win[win_fill];
    f[0] = scale_feat(0, (float)AB);
    f[1] = scale_feat(1, (float)state_change);
    f[2] = scale_feat(2, (float)dir_fwd);
    f[3] = scale_feat(3, (float)dir_bwd);
    f[4] = scale_feat(4, current_speed_change_rate);
    f[5] = scale_feat(5, (float)A);
    f[6] = scale_feat(6, (float)B);
    f[7] = scale_feat(7, (float)z_pulse);
    f[8] = scale_feat(8, (float)edge_rising);
    f[9] = scale_feat(9, (float)steps_since_z_encoder);

    win_fill++;
    if (win_fill >= SEQ_LEN) {
      // Store window to FIFO
      int idx = 0;
      for (int t = 0; t < SEQ_LEN; ++t) {
        volatile float* src = feat_win[t];
        for (int f = 0; f < FEAT_DIM; ++f) win_fifo[wf_w][idx++] = src[f];
      }

      flags_fifo[wf_w] = 0; // No rules yet
      wf_w = (wf_w + 1) & (WINFIFO - 1);
      if (wf_count < WINFIFO) wf_count++;
      else wf_r = (wf_r + 1) & (WINFIFO - 1);

      win_ready = wf_count;
      win_total++;
      win_fill = 0;

#if ENABLE_RAW_LOG
      printf("CONSECUTIVE_SIGNALS [WIN #%lu]: ", (unsigned long)win_total);
      for (int i = 0; i < SEQ_LEN; i++) {
        float ab_scaled = feat_win[i][0];
        float z_scaled = feat_win[i][7];
        uint8_t ab = (uint8_t)roundf(ab_scaled / MODEL_FEAT_SCALE[0] + MODEL_FEAT_MIN[0]);
        uint8_t z = (uint8_t)roundf(z_scaled / MODEL_FEAT_SCALE[7] + MODEL_FEAT_MIN[7]);
        printf("%u,%u ", ab, z);
      }
      printf("\r\n");
#endif
    }

    last_A_pos = (last_A_pos + 1) % IC_BUF_LEN;
  }

  // Process B edges similarly
  while (last_B_pos != B_pos) {
    uint16_t cnt = ic_buf_B[last_B_pos % IC_BUF_LEN];
    int16_t d = (int16_t)cnt - (int16_t)last_cnt;
    // Wrap fix
    last_cnt = cnt;

    uint8_t A = last_A;
    uint8_t B = !last_B;
    uint8_t AB = (A << 1) | B;

    // State change, dir, edges (B_rise = B && !last_B), etc. same as above
    // Update last_B = B
    // Pack to feat_win as above
    last_edge_tick = tick_ms;

    last_B_pos = (last_B_pos + 1) % IC_BUF_LEN;
  }

  // Idle timeout: Push idle sample if no edges for 50ms
  if (tick_ms - last_edge_tick > 50 && win_fill < SEQ_LEN) {
    // d=0, change=0, dir=0, SCR=0, A/B same, z=0, edge=0, ssz++
    steps_since_z_encoder++;  // Optional, if idle counts as "step" for overdue

    volatile float *f = feat_win[win_fill];
    f[0] = scale_feat(0, (float)last_AB);
    f[1] = scale_feat(1, 0.f);
    f[2] = scale_feat(2, 0.f);
    f[3] = scale_feat(3, 0.f);
    f[4] = scale_feat(4, 0.f);
    f[5] = scale_feat(5, (float)last_A);
    f[6] = scale_feat(6, (float)last_B);
    f[7] = scale_feat(7, 0.f);
    f[8] = scale_feat(8, 0.f);
    f[9] = scale_feat(9, (float)steps_since_z_encoder);

    win_fill++;
    last_edge_tick = tick_ms;  // Reset to avoid flood
    if (win_fill >= SEQ_LEN) {
      // Publish as above
    }
  }
}

