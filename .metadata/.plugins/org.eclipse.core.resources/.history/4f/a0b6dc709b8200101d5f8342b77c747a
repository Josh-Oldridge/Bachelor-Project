#include "enc_sampler.h"
#include <string.h>
#include <math.h>
#include <stdio.h>
#include "model_meta.h"

extern TIM_HandleTypeDef htim1;

#ifndef ENABLE_DIAGNOSTICS
#define ENABLE_DIAGNOSTICS 0
#endif

#ifndef ENABLE_RAW_LOG
#define ENABLE_RAW_LOG 1
#endif

/* --- Public/live flags --- */
volatile uint32_t enc_rule_flags = 0;
volatile uint32_t win_rule_flags = 0;

/* --- Exposed state --- */
volatile uint32_t tim7_ticks = 0;
volatile uint32_t win_ready = 0;
volatile uint32_t win_total = 0;
volatile float feat_win[SEQ_LEN][FEAT_DIM];

/* --- MINIMAL raw capture buffer --- */
typedef struct {
  uint16_t cnt;     /* TIM1 count only */
  uint8_t z_pulse;  /* Z flag only */
} minimal_raw_t;

#define RAW_BUF_SIZE 4096
static volatile minimal_raw_t raw_buffer[RAW_BUF_SIZE];
static volatile uint16_t raw_write = 0, raw_read = 0;

/* --- Processed sample buffer --- */
typedef struct {
  uint8_t AB_state;
  uint8_t z_pulse;
  uint8_t state_change;
  uint8_t dir_fwd, dir_bwd;
  uint8_t A, B;
  uint8_t edge_rising;
  float speed_change_rate;
  uint32_t steps_since_z;
} processed_sample_t;

static processed_sample_t processed_samples[SEQ_LEN * 4]; // Buffer for processing
static uint16_t proc_write = 0, proc_read = 0;

/* --- Window FIFO --- */
#define WINFIFO_LOG2 2
#define WINFIFO (1u << WINFIFO_LOG2)
static float win_fifo[WINFIFO][SEQ_LEN*FEAT_DIM];
static uint32_t flags_fifo[WINFIFO];
static uint8_t wf_w = 0, wf_r = 0, wf_count = 0;

/* --- State tracking --- */
#define TIM1_PERIOD 2000u
static uint16_t last_cnt = 0;
static uint8_t last_AB = 0;
static uint32_t steps_since_z_encoder = 0;
static uint32_t last_change_tick_ms = 0;
static float baseline_interval_ms = 50.0f;
static float current_speed_change_rate = 0.0f;

/* --- Gray code helpers --- */
static const uint8_t gray2idx[4] = {0,1,3,2};
static inline uint8_t idx2gray(uint8_t idx) {
  static const uint8_t lut[4] = {0,1,3,2};
  return lut[idx & 3];
}

/* --- Scaling helper --- */
static inline float scale_feat(int j, float x) {
  float y = (x - MODEL_FEAT_MIN[j]) * MODEL_FEAT_SCALE[j];
  if (y < 0.f) y = 0.f;
  if (y > 1.f) y = 1.f;
  return y;
}

/* --- Public API --- */
void EncSampler_Init(void) {
  last_change_tick_ms = HAL_GetTick();
}

void EncSampler_Start(void) {}

/* --- ULTRA-MINIMAL ISR: Only capture, no processing --- */
void EncSampler_TIM7_Callback(void)
{
  tim7_ticks++;

  /* Capture only essential data - NO processing */
  uint16_t cnt = __HAL_TIM_GET_COUNTER(&htim1);
  uint8_t z_pulse = 0;

  #if defined(TIM_FLAG_IDXF)
  if (__HAL_TIM_GET_FLAG(&htim1, TIM_FLAG_IDXF)) {
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_FLAG_IDXF);
    z_pulse = 1;
  }
  #else
  if (__HAL_TIM_GET_FLAG(&htim1, TIM_FLAG_IDX)) {
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_FLAG_IDX);
    z_pulse = 1;
  }
  #endif

  /* Store in minimal buffer - wrap on overflow */
  uint16_t next_write = (raw_write + 1) % RAW_BUF_SIZE;
  if (next_write != raw_read) { // Only store if buffer not full
    raw_buffer[raw_write].cnt = cnt;
    raw_buffer[raw_write].z_pulse = z_pulse;
    raw_write = next_write;
  }

  /* NO other processing in ISR */
}

/* --- Batch process accumulated raw samples --- */
void EncSampler_Process(void)
{
  /* Process all accumulated raw samples */
  while (raw_read != raw_write) {
    minimal_raw_t raw = raw_buffer[raw_read];
    raw_read = (raw_read + 1) % RAW_BUF_SIZE;

    /* Calculate delta like before */
    int16_t d = (int16_t)raw.cnt - (int16_t)last_cnt;
    if (d > (int16_t)(TIM1_PERIOD/2)) d -= TIM1_PERIOD;
    if (d < -(int16_t)(TIM1_PERIOD/2)) d += TIM1_PERIOD;
    last_cnt = raw.cnt;

    /* Skip samples with no movement */
    if (d == 0 && !raw.z_pulse) continue;

    /* Process this sample into features */
    uint32_t tick_ms = HAL_GetTick(); // Get time during processing, not ISR

    const uint32_t ad = (uint32_t)((d >= 0) ? d : -d);

    if (raw.z_pulse) {
      steps_since_z_encoder = 0;
    } else {
      steps_since_z_encoder += ad;
    }

    /* Synthesize AB from encoder phase */
    const uint8_t idx_curr = (uint8_t)(raw.cnt & 3);
    const uint8_t AB = idx2gray(idx_curr);
    uint8_t A = (AB >> 1) & 1U;
    uint8_t B = AB & 1U;

    /* State change detection */
    uint8_t AB_prev = last_AB;
    const uint8_t state_change = (AB != AB_prev);

    /* Direction */
    const uint8_t idx_prev = gray2idx[AB_prev];
    const uint8_t step = (uint8_t)((gray2idx[AB] - idx_prev) & 3);
    const uint8_t dir_fwd = (step == 1);
    const uint8_t dir_bwd = (step == 3);

    /* Edges */
    const uint8_t last_A = (last_AB >> 1) & 1U;
    const uint8_t last_B = last_AB & 1U;
    const uint8_t A_rise = (A && !last_A);
    const uint8_t B_rise = (B && !last_B);
    const uint8_t edge_rising = (A_rise || B_rise || raw.z_pulse) ? 1U : 0U;

    /* Speed change rate */
    if (state_change) {
      uint32_t interval_ms = tick_ms - last_change_tick_ms;
      if (interval_ms == 0) interval_ms = 1;

      if (baseline_interval_ms <= 0.0f) {
        baseline_interval_ms = (float)interval_ms;
      }

      float ratio = ((float)interval_ms) / baseline_interval_ms;
      current_speed_change_rate = fabsf(ratio - 1.0f);
      baseline_interval_ms = 0.9f * baseline_interval_ms + 0.1f * (float)interval_ms;
      last_change_tick_ms = tick_ms;
    }

    last_AB = AB;

    /* Store processed sample */
    processed_samples[proc_write].AB_state = AB;
    processed_samples[proc_write].z_pulse = raw.z_pulse;
    processed_samples[proc_write].state_change = state_change;
    processed_samples[proc_write].dir_fwd = dir_fwd;
    processed_samples[proc_write].dir_bwd = dir_bwd;
    processed_samples[proc_write].A = A;
    processed_samples[proc_write].B = B;
    processed_samples[proc_write].edge_rising = edge_rising;
    processed_samples[proc_write].speed_change_rate = current_speed_change_rate;
    processed_samples[proc_write].steps_since_z = steps_since_z_encoder;

    proc_write = (proc_write + 1) % (SEQ_LEN * 4);

    /* Build windows */
    static uint8_t win_fill = 0;

    if (proc_write != proc_read) {
      processed_sample_t *p = &processed_samples[proc_read];
      proc_read = (proc_read + 1) % (SEQ_LEN * 4);

      /* Pack features */
      volatile float *f = feat_win[win_fill];
      f[0] = scale_feat(0, (float)p->AB_state);
      f[1] = scale_feat(1, (float)p->state_change);
      f[2] = scale_feat(2, (float)p->dir_fwd);
      f[3] = scale_feat(3, (float)p->dir_bwd);
      f[4] = scale_feat(4, p->speed_change_rate);
      f[5] = scale_feat(5, (float)p->A);
      f[6] = scale_feat(6, (float)p->B);
      f[7] = scale_feat(7, (float)p->z_pulse);
      f[8] = scale_feat(8, (float)p->edge_rising);
      f[9] = scale_feat(9, (float)p->steps_since_z);

      win_fill++;
      if (win_fill >= SEQ_LEN) {
        /* Complete window - store in FIFO */
        int idx = 0;
        for (int t = 0; t < SEQ_LEN; ++t) {
          volatile float* src = feat_win[t];
          for (int f = 0; f < FEAT_DIM; ++f) win_fifo[wf_w][idx++] = src[f];
        }

        flags_fifo[wf_w] = 0; // No rule flags for now
        wf_w = (wf_w + 1) & (WINFIFO - 1);
        if (wf_count < WINFIFO) { wf_count++; }
        else { wf_r = (wf_r + 1) & (WINFIFO - 1); }

        win_ready = wf_count;
        win_total++;
        win_fill = 0;

#if ENABLE_RAW_LOG
        printf("CONSECUTIVE_SIGNALS [WIN #%lu]: ", (unsigned long)win_total);
        for (int i = 0; i < SEQ_LEN; i++) {
          processed_sample_t *ps = &processed_samples[(proc_read - SEQ_LEN + i + SEQ_LEN*4) % (SEQ_LEN*4)];
          printf("%u,%u ", ps->AB_state, ps->z_pulse);
        }
        printf("\r\n");
#endif
      }
    }
  }
}

/* Keep existing CopyWindowLinear */
int EncSampler_CopyWindowLinear(float* dst, uint32_t* out_flags)
{
  EncSampler_Process();

  __disable_irq();
  if (wf_count == 0) { __enable_irq(); return -1; }

  uint8_t r = wf_r;
  wf_r = (wf_r + 1) & (WINFIFO - 1);
  wf_count--;
  win_ready = wf_count;
  uint32_t flags = flags_fifo[r];
  __enable_irq();

  for (int i = 0; i < SEQ_LEN*FEAT_DIM; ++i) dst[i] = win_fifo[r][i];

  win_rule_flags = flags;
  if (out_flags) *out_flags = flags;
  return 0;
}
