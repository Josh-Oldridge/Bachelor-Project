extern volatile uint32_t win_ready;
extern volatile uint32_t win_rule_flags;
extern volatile uint32_t enc_rule_flags;
volatile float last_y_raw[AI_NETWORK_OUT_1_SIZE];

extern volatile uint32_t z_diag_isr_seen, z_diag_isr_accepted;
extern volatile uint32_t z_diag_ab_since_isr, z_diag_steps_x4, z_diag_last_z_ms;

static uint32_t rf_snapshot = 0;
static uint32_t inf_seq = 0;

static int acquire_and_process_data(void) {
  return EncSampler_CopyWindowLinear((float*)ai_input[0].data, &rf_snapshot);
}

static int post_process(void) {
  const float *out = (const float*) ai_output[0].data;
  for (int i = 0; i < AI_NETWORK_OUT_1_SIZE; ++i) last_y_raw[i] = out[i];
  return 0;
}

static void print_dir_win_zdiag(void) {
  {
    int8_t latched = EncSampler_GetLatchedDir();
    int8_t wdir    = EncSampler_GetLastWindowDir();
    ai_log("DIR: latched=%s  window=%s\r\n",
           (latched > 0 ? "FWD" : "BWD"),
           (wdir    > 0 ? "FWD" : "BWD"));
  }

  {
    uint8_t ab[SEQ_LEN], src[SEQ_LEN], z[SEQ_LEN];
    EncSampler_DebugGetLastTrace(ab, src, z);
    char lineAB[SEQ_LEN + 1], lineSRC[SEQ_LEN + 1], lineZ[SEQ_LEN + 1];
    for (int i = 0; i < SEQ_LEN; ++i) {
      switch (ab[i] & 3u) { case 0: lineAB[i]='0'; break; case 1: lineAB[i]='1'; break; case 2: lineAB[i]='2'; break; default: lineAB[i]='3'; break; }
      lineSRC[i] = (src[i] == 1 ? 'A' : (src[i] == 2 ? 'B' : '?'));
      lineZ[i]   = z[i] ? '^' : '.';
    }
    lineAB[SEQ_LEN]  = '\0';
    lineSRC[SEQ_LEN] = '\0';
    lineZ[SEQ_LEN]   = '\0';
    ai_log("WIN AB : %s\r\n", lineAB);
    ai_log("WIN SRC: %s\r\n", lineSRC);
    ai_log("WIN  Z : %s\r\n", lineZ);
  }

  ai_log("Z_DIAG: seen=%lu acc=%lu ab_since=%lu steps_x4=%lu lastZ_ms=%lu\r\n",
         (unsigned long)z_diag_isr_seen,
         (unsigned long)z_diag_isr_accepted,
         (unsigned long)z_diag_ab_since_isr,
         (unsigned long)z_diag_steps_x4,
         (unsigned long)z_diag_last_z_ms);
}

static void snapshot_and_print(void) {
  inf_seq++;
  int best = 0;
  for (int i = 1; i < AI_NETWORK_OUT_1_SIZE; ++i)
    if (last_y_raw[i] > last_y_raw[best]) best = i;

  Diag_NotifyInferenceTop((uint32_t)best);

  float p_ms = last_y_raw[C_MISSINGSTEP];
  float p_n  = last_y_raw[C_NORMAL];
  float p_z  = last_y_raw[C_ZINDEX];

  uint32_t tms = ms_now();
  ai_log("INF#%lu t=%lums TOP=%s P=[MS:%.3f, N:%.3f, Z:%.3f] flags(win)=0x%08lX flags(live)=0x%08lX\r\n",
         (unsigned long)inf_seq, (unsigned long)tms, MODEL_CLASSES[best],
         p_ms, p_n, p_z, (unsigned long)win_rule_flags, (unsigned long)enc_rule_flags);

  print_dir_win_zdiag();
}

/* ---- 1 Hz diagnostics ---- */
static void print_1s_snapshot(void)
{
  diag_snapshot_t s;
  Diag_GetAndResetSnapshot(&s);

  /* Names must match your diag_timer_id_t order */
  static const char* timer_names[] = {
    "isr_total", "pack_ab", "e2e_window", "win_publish", "ai_run"
  };
  const uint32_t tn = (uint32_t)(sizeof(timer_names)/sizeof(timer_names[0]));
  const uint32_t n  = (DIAG_T__COUNT < tn) ? DIAG_T__COUNT : tn;

  ai_log("DIAG 1s: inferences=%lu  evbuf:%lu/%lu drops:%lu  winfifo:%lu/%lu\r\n",
         (unsigned long)s.inferences,
         (unsigned long)s.event_buf_hwm, (unsigned long)s.event_buf_cap,
         (unsigned long)s.event_drops,
         (unsigned long)s.winfifo_hwm,   (unsigned long)s.winfifo_cap);

  for (uint32_t i = 0; i < n; ++i) {
    const diag_timer_stat_t *st = &s.timers[i];
    if (st->count == 0) { ai_log("  %s: count=0\r\n", timer_names[i]); continue; }
    uint64_t avg = (st->sum_cycles / (st->count ? st->count : 1));
    ai_log("  %s: n=%lu min=%lu cyc (%lu us)  avg=%llu cyc (%llu us)  max=%lu cyc (%lu us)\r\n",
           timer_names[i],
           (unsigned long)st->count,
           (unsigned long)st->min_cycles, (unsigned long)cycles_to_us(st->min_cycles),
           (unsigned long long)avg,        (unsigned long long)cycles_to_us(avg),
           (unsigned long)st->max_cycles,  (unsigned long)cycles_to_us(st->max_cycles));
  }
}

/* ---- Warm-up & 1s trial control ---- */
#ifndef DIAG_WARMUP_MS
#define DIAG_WARMUP_MS 5000u
#endif
#ifndef DIAG_TRIAL_MS
#define DIAG_TRIAL_MS  1000u
#endif

static uint32_t g_warmup_end_ms = 0;
static uint8_t  g_trial_armed   = 0;
static uint32_t g_next_print_ms = 0;

static void maybe_arm_trial_after_warmup(void)
{
  if (!g_trial_armed && (int32_t)(ms_now() - g_warmup_end_ms) >= 0) {
    Diag_ArmTrialAfterNextZ(DIAG_TRIAL_MS);
    g_trial_armed = 1;
    ai_log("TRIAL: armed after next Z for %u ms\r\n", (unsigned)DIAG_TRIAL_MS);
  }
}

static void maybe_print_trial_result(void)
{
  const diag_trial_t* t = Diag_TrialPeek();
  if (t->done) {
    ai_log("TRIAL RESULT: ab_edges=%lu windows=%lu inferences=%lu | hist[",
           (unsigned long)t->ab_edges,
           (unsigned long)t->windows,
           (unsigned long)t->inferences);
    for (uint32_t i = 0; i < (uint32_t)DIAG_MAX_CLASSES; ++i) {
      ai_log("%lu%s", (unsigned long)t->class_hist[i], (i+1<DIAG_MAX_CLASSES)?",":"");
    }
    ai_log("]\r\n");
    Diag_TrialReset();
  }
}
