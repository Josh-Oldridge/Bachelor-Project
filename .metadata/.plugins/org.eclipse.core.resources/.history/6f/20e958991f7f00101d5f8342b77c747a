#include "enc_sampler.h"
#include <string.h>
#include <math.h>
#include <stdio.h>   // optional debug prints
#include "model_meta.h"  // for MODEL_FEAT_* scales

/* ---------- A/B mapping toggles (set to 1 to try) ---------- */
#ifndef ENC_INVERT_A
#define ENC_INVERT_A 0
#endif
#ifndef ENC_INVERT_B
#define ENC_INVERT_B 0
#endif
#ifndef ENC_SWAP_AB
#define ENC_SWAP_AB  0
#endif

/* --- Fast pin reads from main.h symbols --- */
static inline uint8_t read_A_hw(void) { return (ENC_A_GPIO_Port->IDR & ENC_A_Pin) ? 1U : 0U; }
static inline uint8_t read_B_hw(void) { return (ENC_B_GPIO_Port->IDR & ENC_B_Pin) ? 1U : 0U; }

static inline void read_AB(uint8_t* A, uint8_t* B) {
  uint8_t a = read_A_hw();
  uint8_t b = read_B_hw();
#if ENC_INVERT_A
  a ^= 1U;
#endif
#if ENC_INVERT_B
  b ^= 1U;
#endif
#if ENC_SWAP_AB
  uint8_t t = a; a = b; b = t;
#endif
  *A = a; *B = b;
}

/* --- Public/live flags --- */
volatile uint32_t enc_rule_flags = 0;   // live telemetry (most recent computed)
volatile uint32_t win_rule_flags = 0;   // flags aligned to the last window given to NN

/* --- Per-window accumulators (for rule checks) --- */
static uint16_t edges_A = 0, edges_B = 0, quad_bad = 0;
static uint8_t  z_seen_in_window = 0;
static uint8_t  win_fill = 0;
static uint32_t ad_sum_win = 0;

/* --- Exposed state --- */
volatile uint32_t tim7_ticks = 0;
volatile uint32_t win_ready  = 0;
volatile uint32_t win_total  = 0;
volatile float    feat_win[SEQ_LEN][FEAT_DIM];

/* --- Ring buffer fed by TIM7 ISR --- */
typedef struct {
  int16_t  d;        /* signed delta TIM1 between samples (wrap-fixed) */
  uint8_t  z_pulse;  /* index pulse seen this tick */
  uint8_t  A, B;     /* raw GPIO samples (post mapping toggles) */
  uint16_t cnt;      /* raw TIM1 count (0..MOD-1) */
} raw_t;

#define RB_LOG2 11
#define RB_SIZE (1u << RB_LOG2)
#define RB_MASK (RB_SIZE - 1)

static volatile raw_t    rb[RB_SIZE];
static volatile uint16_t rb_w = 0, rb_r = 0;

/* --- Flags queue so the flags match the window we hand to the NN --- */
#define WQ_SIZE 8  /* power of two */
static uint32_t flags_q[WQ_SIZE];
static uint8_t  flags_q_w = 0, flags_q_r = 0;

#define MOD 2000u
static uint16_t last_cnt = 0;

/* --- main-context only --- */
static uint8_t  last_A = 0, last_B = 0;
static uint8_t  last_AB = 0;
static uint32_t steps_since_z = 0;

/* interval-based SCR state (matches "Interval_Ratio" training path) */
static uint32_t samps_since_ab_change = 0;  /* samples since last AB state change */
static float    ema_interval          = 0.0f; /* EMA of interval (samples) */
static float    scr_hold              = 0.0f; /* last computed SCR, held until next change */




/* --- scaling helper (0..1 clamp) --- */
static inline float scale_feat(int j, float x) {
  float y = (x - MODEL_FEAT_MIN[j]) * MODEL_FEAT_SCALE[j];
  if (y < 0.f) y = 0.f;
  if (y > 1.f) y = 1.f;
  return y;
}

/* ------- Snapshotted windows FIFO ------- */
#define WINFIFO_LOG2 2              /* 4 entries */
#define WINFIFO      (1u << WINFIFO_LOG2)
static float    win_fifo[WINFIFO][SEQ_LEN*FEAT_DIM];
static uint32_t flags_fifo[WINFIFO];
static uint8_t  wf_w = 0, wf_r = 0, wf_count = 0;


/* --- Public API --- */
void EncSampler_Init(void) {}
void EncSampler_Start(void) {}

/* --- ISR: sample encoder quickly, push into ring --- */
void EncSampler_TIM7_Callback(void)
{
  tim7_ticks++;

  uint16_t cnt = __HAL_TIM_GET_COUNTER(&htim1);
  int16_t d = (int16_t)cnt - (int16_t)last_cnt;
  if (d >  (int16_t)(MOD/2))  d -= MOD;
  if (d < -(int16_t)(MOD/2))  d += MOD;
  last_cnt = cnt;

  uint8_t z_pulse = 0;
#if defined(TIM_FLAG_IDX)
  if (__HAL_TIM_GET_FLAG(&htim1, TIM_FLAG_IDX)) {
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_FLAG_IDX);
    z_pulse = 1;
  }
#elif defined(TIM_FLAG_IDXF)
  if (__HAL_TIM_GET_FLAG(&htim1, TIM_FLAG_IDXF)) {
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_FLAG_IDXF);
    z_pulse = 1;
  }
#endif

  uint8_t A, B;
  read_AB(&A, &B);

  uint16_t w = rb_w;
  uint16_t n = (w + 1) & RB_MASK;
  if (n == rb_r) rb_r = (rb_r + 1) & RB_MASK;  // drop oldest on overflow
  rb[w].d = d; rb[w].z_pulse = z_pulse; rb[w].A = A; rb[w].B = B; rb[w].cnt = cnt;
  rb_w = n;
}

/*
MODEL_FEATURES order (must match model_meta.h):
  0 AB_State
  1 State_Change
  2 Direction_forward
  3 Direction_backward
  4 Speed_Change_Rate           <-- |State_Change - EMA(State_Change)|
  5 Channel_A
  6 Channel_B
  7 Channel_Z
  8 Edge_RISING
  9 Steps_Since_Z               <-- increments per tick since last Z
*/
void EncSampler_Process(void)
{
  while (rb_r != rb_w) {
    raw_t s = rb[rb_r];
    rb_r = (rb_r + 1) & RB_MASK;

    const int16_t d       = s.d;
    const uint8_t A       = s.A;
    const uint8_t B       = s.B;
    const uint8_t z_pulse = s.z_pulse;
    const uint16_t cnt    = s.cnt; (void)cnt;

    /* absolute movement this tick (still used for rule guards only) */
    const uint32_t ad = (uint32_t)((d >= 0) ? d : -d);
    ad_sum_win += ad;

    /* Steps_Since_Z must match training: +1 per sample, NOT +ad */
    if (z_pulse) { steps_since_z = 0; }
    else         { steps_since_z += 1; }

    /* Edges */
    const uint8_t A_rise = (A && !last_A), A_fall = (!A && last_A);
    const uint8_t B_rise = (B && !last_B), B_fall = (!B && last_B);
    const uint8_t chAchg = (uint8_t)(A_rise | A_fall);
    const uint8_t chBchg = (uint8_t)(B_rise | B_fall);

    /* AB state + prev */
    const uint8_t AB = (uint8_t)((A << 1) | B) & 3;
    uint8_t AB_prev  = last_AB;

    if (win_fill == 0) { AB_prev = AB; last_AB = AB; }   // avoid stale first compare

    if (chAchg) edges_A++;
    if (chBchg) edges_B++;

    /* Direction from Gray-code step (matches training inference) */
    static const uint8_t gray2idx[4] = {0,1,3,2};
    uint8_t idx_prev = gray2idx[AB_prev];
    uint8_t idx_curr = gray2idx[AB];
    uint8_t step     = (uint8_t)((idx_curr - idx_prev) & 3);
    const uint8_t dir_fwd = (step == 1);
    const uint8_t dir_bwd = (step == 3);

    /* Quadrature sanity: only when exactly one channel changed and ad<=1 */
    if ((chAchg ^ chBchg) && ad <= 1) {
      if (step != 1 && step != 3) quad_bad++;
    }

    /* Edge_RISING includes Z too (as in training) */
    const uint8_t edge_rising = (A_rise || B_rise || z_pulse) ? 1U : 0U;

    /* State_Change bit */
    const uint8_t state_change = (AB != AB_prev);

    /* -------- Speed_Change_Rate = |interval/EMA(interval) - 1| --------
       - interval is the number of TIM7 samples between AB state changes
       - update only when a state change happens; hold value otherwise
       - no explicit clamp here; model_meta scale & clamp handles it
    */
    samps_since_ab_change += 1;
    if (state_change) {
      uint32_t interval = samps_since_ab_change;          /* samples since last change */
      if (interval == 0) interval = 1;
      if (ema_interval <= 0.0f) ema_interval = (float)interval;
      float ratio = ((float)interval) / ema_interval;     /* can exceed 1.0 */
      float scr   = ratio - 1.0f; if (scr < 0.f) scr = -scr;
      scr_hold    = scr;                                   /* hold until next change */
      /* slow EMA to mimic ‘Interval_Ratio’ baseline adaptation */
      ema_interval = 0.9f * ema_interval + 0.1f * (float)interval;
      samps_since_ab_change = 0;
    }
    const float scr_out = scr_hold;   /* value to emit this sample */

    if (z_pulse) z_seen_in_window = 1;

    last_AB = AB;
    last_A  = A;
    last_B  = B;

    /* --- pack the 10 trained features in the exact order --- */
    volatile float *f = feat_win[win_fill];
    int k = 0;
#define PACK(v) do { f[k] = scale_feat(k, (v)); k++; } while(0)
    PACK((float)AB);                         // 0 AB_State (0..3)
    PACK((float)state_change);               // 1 State_Change
    PACK((float)dir_fwd);                    // 2 Direction_forward (Gray +1)
    PACK((float)dir_bwd);                    // 3 Direction_backward (Gray -1)
    PACK(scr_out);                           // 4 Speed_Change_Rate (interval ratio dev)
    PACK((float)A);                          // 5 Channel_A
    PACK((float)B);                          // 6 Channel_B
    PACK((float)z_pulse);                    // 7 Channel_Z
    PACK((float)edge_rising);                // 8 Edge_RISING (A|B|Z)
    PACK((float)steps_since_z);              // 9 Steps_Since_Z  (+1 per tick)
#undef PACK

    /* advance; when full, publish flags, reset accumulators */
    win_fill++;
    if (win_fill >= SEQ_LEN) {
      uint32_t flags = 0;

      const uint16_t MIN_MOVING_EDGES  = 1;
      const uint32_t MIN_MOVING_COUNTS = 2;
      const uint32_t Z_OVERDUE_MIN     = MOD + (MOD/2);   // ~1.5 revs

      if (ad_sum_win >= MIN_MOVING_COUNTS) {
        if (edges_B >= MIN_MOVING_EDGES && edges_A == 0) flags |= RS_A_STUCK;
        if (edges_A >= MIN_MOVING_EDGES && edges_B == 0) flags |= RS_B_STUCK;
        if ((edges_A + edges_B) >= 6 && quad_bad >= 2)   flags |= RS_QUAD_BAD;
        if (!z_seen_in_window && steps_since_z >= Z_OVERDUE_MIN) flags |= RS_Z_MISSED;
      }

      enc_rule_flags = flags;               /* live telemetry */
      win_rule_flags = flags;               /* last-window live copy */

      /* ---- snapshot the completed window into a FIFO ---- */
      int idx = 0;
      for (int t = 0; t < SEQ_LEN; ++t) {
        volatile float* src = feat_win[t];  /* the finished window occupies [0..SEQ_LEN-1] */
        for (int f = 0; f < FEAT_DIM; ++f) win_fifo[wf_w][idx++] = src[f];
      }
      flags_fifo[wf_w] = flags;
      wf_w = (wf_w + 1) & (WINFIFO - 1);
      if (wf_count < WINFIFO) { wf_count++; }
      else { wf_r = (wf_r + 1) & (WINFIFO - 1); }   /* overwrite oldest if full */

      /* reset per-window */
      edges_A = edges_B = quad_bad = 0;
      z_seen_in_window = 0;
      ad_sum_win = 0;
      win_fill = 0;

      win_ready = wf_count;    /* keep external counter in sync */
      win_total++;

    }
  }
}


/* --- Copy current circular window into linear buffer and return its flags --- */
int EncSampler_CopyWindowLinear(float* dst, uint32_t* out_flags)
{
  if (win_ready == 0) return -1;

  __disable_irq();
  uint8_t start = win_fill;               // oldest element
  int idx = 0;
  for (int t = 0; t < SEQ_LEN; ++t) {
    uint8_t i = (uint8_t)(start + t);
    if (i >= SEQ_LEN) i -= SEQ_LEN;
    volatile float* src = feat_win[i];
    for (int f = 0; f < FEAT_DIM; ++f) dst[idx++] = src[f];
  }
  win_ready--;

  /* pop the flags snapshot that belongs to this window */
  uint32_t flags = flags_q[flags_q_r];
  flags_q_r = (flags_q_r + 1) & (WQ_SIZE - 1);

  /* publish aligned flags for telemetry too (optional convenience) */
  win_rule_flags = flags;

  __enable_irq();

  if (out_flags) *out_flags = flags;
  return 0;
}

