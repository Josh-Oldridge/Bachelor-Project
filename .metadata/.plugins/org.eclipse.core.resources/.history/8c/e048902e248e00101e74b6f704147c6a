extern volatile uint32_t win_ready; /* from enc_sampler.c */
extern volatile uint32_t win_rule_flags; /* sampler flags aligned to window */
extern volatile uint32_t enc_rule_flags; /* rolling/live flags */
volatile float last_y_raw[AI_NETWORK_OUT_1_SIZE]; /* exported for others */
extern volatile uint32_t z_diag_isr_seen, z_diag_isr_accepted;
extern volatile uint32_t z_diag_ab_since_isr, z_diag_steps_since_main;
extern volatile uint32_t z_diag_last_z_ms;
static uint32_t rf_snapshot = 0;
static uint32_t inf_seq = 0;

/* Acquire oldest ready window directly into NN input (live only) */
static int acquire_and_process_data(void) {
	return EncSampler_CopyWindowLinear((float*) ai_input[0].data, &rf_snapshot);
}

/* Post-process: just mirror raw output (model already softmax) */
static int post_process(void) {
	const float *out = (const float*) ai_output[0].data;
	for (int i = 0; i < AI_NETWORK_OUT_1_SIZE; ++i)
		last_y_raw[i] = out[i];
	return 0;
}

static void print_dir_win_zdiag(void) {
	/* Directions (latched edge DIR and summarized window DIR) */
	{
		int8_t latched = EncSampler_GetLatchedDir();
		int8_t wdir = EncSampler_GetLastWindowDir();
		ai_log("DIR: latched=%s  window=%s\r\n", (latched > 0 ? "FWD" : "BWD"),
				(wdir > 0 ? "FWD" : "BWD"));
	}

	/* Window traces (requires ENABLE_TRACE_WIN=1 in enc_sampler.h) */
	{
		uint8_t ab[SEQ_LEN], src[SEQ_LEN], z[SEQ_LEN];
		EncSampler_DebugGetLastTrace(ab, src, z);

		char lineAB[SEQ_LEN + 1], lineSRC[SEQ_LEN + 1], lineZ[SEQ_LEN + 1];
		for (int i = 0; i < SEQ_LEN; ++i) {
			switch (ab[i] & 3u) {
			case 0:
				lineAB[i] = '0';
				break;
			case 1:
				lineAB[i] = '1';
				break;
			case 2:
				lineAB[i] = '2';
				break;
			default:
				lineAB[i] = '3';
				break;
			}
			lineSRC[i] = (src[i] == 1 ? 'A' : (src[i] == 2 ? 'B' : '?'));
			lineZ[i] = z[i] ? '^' : '.';
		}
		lineAB[SEQ_LEN] = '\0';
		lineSRC[SEQ_LEN] = '\0';
		lineZ[SEQ_LEN] = '\0';

		ai_log("WIN AB : %s\r\n", lineAB);
		ai_log("WIN SRC: %s\r\n", lineSRC);
		ai_log("WIN  Z : %s\r\n", lineZ);
	}

	/* Z-path diagnostics snapshot (same format you’ve been using) */
	ai_log(
			"Z_DIAG: seen=%lu acc=%lu ab_since=%lu steps_since=%lu lastZ_ms=%lu\r\n",
			(unsigned long) z_diag_isr_seen,
			(unsigned long) z_diag_isr_accepted,
			(unsigned long) z_diag_ab_since_isr,
			(unsigned long) z_diag_steps_since_main,
			(unsigned long) z_diag_last_z_ms);
}

/* Compact INF line + window/diag dump using the fast logger */
static void snapshot_and_print(void) {
	inf_seq++;

	/* Find top class */
	int best = 0;
	for (int i = 1; i < AI_NETWORK_OUT_1_SIZE; ++i)
	  if (last_y_raw[i] > last_y_raw[best]) best = i;

	/* Nice % readout */
	float q0 = last_y_raw[0] * 100.0f;
	float q1 = last_y_raw[1] * 100.0f;
	float q2 = last_y_raw[2] * 100.0f;

	uint32_t tms = HAL_GetTick();
	ai_log(
			"INF#%lu t=%lums TOP=%s raw_pm=[%d,%d,%d] flags(win)=0x%08lX flags(live)=0x%08lX\r\n",
			(unsigned long) inf_seq, (unsigned long) tms, MODEL_CLASSES[best],
			p0, p1, p2, (unsigned long) win_rule_flags,
			(unsigned long) enc_rule_flags);

	/* Your familiar DIR + WIN AB/SRC/Z + Z_DIAG lines */
	print_dir_win_zdiag();
}

