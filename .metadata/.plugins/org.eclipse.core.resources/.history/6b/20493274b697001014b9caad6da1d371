/* ---- window-stamp helpers ---- */
static inline void WinStamp_InitAll(void) {
  memset(win_ab_start_x4, 0, sizeof(win_ab_start_x4));
  memset(win_ab_end_x4,   0, sizeof(win_ab_end_x4));
  for (uint32_t i=0; i<WINFIFO; ++i) win_z_row[i] = 0xFFFFu;
  memset(win_z_epoch,     0, sizeof(win_z_epoch));

  win_stamp_ab_start_x4 = 0;
  win_stamp_ab_end_x4   = 0;
  win_stamp_ab_delta_x4 = 0;
  win_stamp_z_epoch     = 0;
  win_stamp_z_row       = -1;

  g_ws.ab_since_z_soft  = 0;
  g_ws.z_row_this_window= 0xFFFFu;
  g_ws.z_epoch_this_window = 0;

  /* main-side serialized Z state */
  z_seq_main = 0;
}

static inline void WinStamp_BeginWindow(uint16_t wf_w_local) {
  /* Continuity: start_x4 for this window == end_x4 of the previous window */
  uint16_t prev = (uint16_t)((wf_w_local - 1u) & WINMASK);

  if (wf_w_local == 0 && wf_count == 0) {
    /* first-ever window after init/flush: compute from counter once */
    uint32_t since_x4 = g_ws.ab_since_z_soft * STEPS_PER_AB_EVENT;

    win_ab_start_x4[wf_w_local] = since_x4;
  } else {
    win_ab_start_x4[wf_w_local] = win_ab_end_x4[prev];
  }

  g_ws.z_row_this_window   = 0xFFFFu;
  g_ws.z_epoch_this_window = 0;
}


/* PRE-Z: record which row carries Z and the epoch, do NOT reset counter here */
static inline void WinStamp_OnZStampedInStream(uint8_t row, uint32_t epoch_seq) {
  if (g_ws.z_row_this_window == 0xFFFFu) {
    g_ws.z_row_this_window = row;
    g_ws.z_epoch_this_window = epoch_seq;
  }
}

/* bump stream-aligned AB counter by one edge (x2 domain) */
static inline void WinStamp_OnEdge(void) {
  g_ws.ab_since_z_soft++;
}

static inline void WinStamp_PublishWindow(uint16_t wf_w_local) {
  uint32_t since_x4 = g_ws.ab_since_z_soft * STEPS_PER_AB_EVENT;

  win_ab_end_x4[wf_w_local]  = since_x4;
  win_z_row[wf_w_local]      = g_ws.z_row_this_window;
  win_z_epoch[wf_w_local]    = g_ws.z_epoch_this_window;
  win_z_seq_end[wf_w_local]  = z_seq_main;
}

/* called from CopyWindowLinear to expose stamps for the window you just dequeued */
static inline void WinStamp_CopyOut(uint16_t r) {
  win_stamp_ab_start_x4 = win_ab_start_x4[r];
  win_stamp_ab_end_x4   = win_ab_end_x4[r];

  /* NEW: provide the delta for the app */
  win_stamp_ab_delta_x4 = (win_stamp_ab_end_x4 - win_stamp_ab_start_x4);

  win_stamp_z_epoch     = win_z_epoch[r];
  win_stamp_z_row       = (win_z_row[r] == 0xFFFFu) ? -1 : (int16_t)win_z_row[r];
  win_stamp_z_seq_end   = win_z_seq_end[r];
}

/* during capture we also write into cap_buf, but still feed live FIFO */
static inline void cap_push_isr(uint8_t src, int8_t dir, uint16_t ccr,
                                uint8_t ab, uint32_t t_ms, uint8_t flags)
{
  uint32_t next = cap_w + 1u;
  if (next >= CAPTURE_MAX_EVENTS) next = 0;
  if (next == cap_r) { cap_drops++; return; }  /* drop if full */

  enc_capture_evt_t *e = &cap_buf[cap_w];
  e->t_ms     = t_ms;
  e->ccr      = ccr;
  e->src      = src;          /* 0 = Z, 1 = A(CC1), 2 = B(CC2) */
  e->dir      = dir;
  e->ab_state = ab;
  e->flags    = flags;

  cap_w = next;
  cap_count++;
}

/* ======================== IRQ Drain (encoder) ========================== */

static inline void push_event_isr(uint8_t src, int8_t dir, uint16_t ccr_sample,
                                  uint8_t ab_state)
{
  const uint32_t next = (event_write + 1u) & EVENT_IDX_MASK;
  if (next == event_read) { event_drops++; Diag_AddEventDrops(1); return; }
  encoder_event_t *e = &event_buffer[event_write];
  e->timestamp_ms = HAL_GetTick();
  e->ccr          = ccr_sample;
  e->src          = src;   /* 0=Z, 1=A, 2=B */
  e->dir          = dir;
  e->ab_state     = ab_state;
  event_write = next;
}

/* Gate helpers: only queue live events during the active slice */
static void Gate_OnAcceptedZ(uint32_t now_ms, uint8_t ab_post, int8_t dir)
{
  /* If we were armed, this Z STARTS the slice */
  if (cap_armed && !cap_active) {
    cap_active   = 1u;
    cap_armed    = 0u;
    cap_done     = 0u;
    cap_start_ms = now_ms;
    cap_end_ms   = now_ms + cap_duration_ms;   /* typically 1000 ms */
  }

  /* Always update trial/speed */
  Diag_NotifyZAccepted(now_ms);

  /* Live FIFO only inside the slice */
  if (cap_active) {
    push_event_isr(0u, dir, 0u, ab_post);
  }

  /* Raw capture buffer mirrors hardware during slice */
  if (cap_active) {
    cap_push_isr(0u, dir, 0u, ab_post, now_ms, CAP_F_Z);
  }
}

static void Gate_PushAB(uint8_t src_code /*1=A,2=B*/, int8_t dir, uint16_t ccr,
                        uint8_t ab_post, uint32_t tms)
{
  if (cap_active) {
    /* raw capture */
    cap_push_isr(src_code, dir, ccr, ab_post, tms, 0u);
    /* live FIFO (drives windows) */
    push_event_isr(src_code, dir, ccr, ab_post);
    /* trial AB edge count */
    Diag_NotifyABEdgeAt(tms);
  }

  /* Hard cutoff right at end timestamp */
  if (cap_active && (int32_t)(tms - cap_end_ms) >= 0) {
    cap_active = 0u;
    cap_done   = 1u;
    /* Optional: stop new IRQs immediately for strictness */
    __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2 | TIM_IT_IDX);
  }
}



/* ============================ Helpers ================================== */

static inline float scale_feat(int j, float x) {
  float y = (x - MODEL_FEAT_MIN[j]) * MODEL_FEAT_SCALE[j];
  if (y < 0.f) y = 0.f;
  if (y > 1.f) y = 1.f;
  return y;
}

static inline uint8_t enc_read_AB(void) {
  const uint32_t idr = GPIOE->IDR;              /* A=PE9, B=PE11 */
  const uint8_t a = (idr & ENC_A_Pin) ? 1u : 0u;
  const uint8_t b = (idr & ENC_B_Pin) ? 1u : 0u;
  return (uint8_t)((a << 1) | b);
}

/* Hardware DIR at capture time */
static inline int8_t dir_from_hw(void) {
  return ((TIM1->CR1 & TIM_CR1_DIR) == 0) ? +1 : -1; /* DIR=0 => up */
}

static inline void gray_step_to_src(uint8_t prev_gray, uint8_t curr_gray,
                                    uint8_t *srcA, uint8_t *srcB)
{
  const uint8_t toggled = (prev_gray ^ curr_gray) & 0x3u;  /* bit(s) that flipped */
  *srcA = (toggled & 0x2u) ? 1u : 0u;  /* A bit changed */
  *srcB = (toggled & 0x1u) ? 1u : 0u;  /* B bit changed */
}
/* ======================= IRQ enable helpers ============================ */

static volatile uint8_t ab_irqs_on = 1;  /* mirror state for AB (CC1/CC2) */

static inline void EncSampler_ConfigIRQs(void) {
  /* Enable AB capture IRQs */
  __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2);

#if HAVE_Z_INDEX && !FORCE_IGNORE_Z
  /* Enable index IRQ and proactively clear any latched IDXF */
  __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_IDX);
# ifdef TIM_SR_IDXF
  __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
# endif
#endif

  /* Disable unused timer IRQs, clear their flags */
  __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_UPDATE | TIM_IT_TRIGGER | TIM_IT_COM);
  __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_UIF | TIM_SR_TIF | TIM_SR_COMIF);
}

void EncSampler_SetABIrqs(uint8_t on)
{
  __disable_irq();
  if (on) {
    __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2);
#if HAVE_Z_INDEX && !FORCE_IGNORE_Z
    __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_IDX);
# ifdef TIM_SR_IDXF
    /* Clear any pending/latching index flag at (re)enable time */
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
# endif
#endif
  } else {
    __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2 | TIM_IT_IDX);
    __HAL_TIM_CLEAR_FLAG(&htim1,
                         TIM_SR_CC1IF | TIM_SR_CC1OF |
                         TIM_SR_CC2IF | TIM_SR_CC2OF);
#   ifdef TIM_SR_IDXF
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
#   endif
  }
  ab_irqs_on = on ? 1u : 0u;
  __enable_irq();
}



void EncSampler_EncoderIRQ_Drain(void) {
  HAL_GPIO_WritePin(INT_PIN_GPIO_Port, INT_PIN_Pin, GPIO_PIN_SET);
  DiagTiming_Start(DIAG_T_ISR_TOTAL);

  for (int guard = 0; guard < 256; ++guard) {
    uint32_t sr = TIM1->SR;
    uint32_t pending = sr & (TIM_SR_CC1IF | TIM_SR_CC2IF | TIM_SR_CC1OF | TIM_SR_CC2OF);
#if HAVE_Z_INDEX && !FORCE_IGNORE_Z && defined(TIM_SR_IDXF)
    pending |= (sr & TIM_SR_IDXF);
#endif
    if (!pending) break;

    /* overflow handling */
    if (sr & TIM_SR_CC1OF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC1OF); event_drops++; Diag_AddEventDrops(1); }
    if (sr & TIM_SR_CC2OF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC2OF); event_drops++; Diag_AddEventDrops(1); }

#if HAVE_Z_INDEX && !FORCE_IGNORE_Z && defined(TIM_SR_IDXF)
    /* ----- Index (Z) flag ----- */
    if (sr & TIM_SR_IDXF) {
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_IDX);
# ifdef TIM_SR_IDXF
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
# endif
      z_diag_isr_seen++;

      /* Ignore Z entirely unless we're armed/active for the slice */
      if (!(cap_active || cap_armed)) {
        continue;
      }

      /* Require Z pin to go low once after arming */
      if ((cap_armed || cap_active) && z_need_low_since_arm) {
        continue;
      }

      const uint32_t now_ms = HAL_GetTick();
      const int32_t  dt_ms  = (int32_t)(now_ms - z_last_ms_isr);
      const uint8_t  ab_now = enc_read_AB() & 0x3u;

      if ((dt_ms >= (int32_t)Z_SOFT_DEBOUNCE_MS) &&
          (ab_edges_since_z_isr >= Z_MIN_AB_EDGES)) {

        if (ab_now != 0u) {
          /* Defer Z until pins pass through 00; will be stamped in CC1/CC2 */
          z_align_pending_isr = 1u;
        } else {
          /* Accept Z immediately (already at AB=00) */
          z_align_pending_isr = 0u;

          /* latch gap BEFORE reset (diagnostics) */
          z_last_gap_edges_isr = ab_edges_since_z_isr;

          /* canonical resets */
          ab_edges_since_z_isr = 0u;
          z_diag_ab_since_isr  = 0u;
          z_diag_steps_x4      = 0u;

          z_last_ms_isr    = now_ms;
          z_diag_last_z_ms = now_ms;
          z_diag_isr_accepted++;
          z_epoch_isr++;

          /* Gate: start/continue the slice and only then queue live/capture */
          Gate_OnAcceptedZ(now_ms, ab_now, dir_from_hw());
        }

#if ENC_ZSTAMP_DEBUG
        ENC_DEBUG_PRINTF("Z_ISR accept @%lu ms, epoch=%lu, gap=%lu\n",
                         (unsigned long)now_ms, (unsigned long)z_epoch_isr,
                         (unsigned long)z_last_gap_edges_isr);
#endif
      }
      /* continue to re-read SR and drain other flags */
    }
#endif

    sr = TIM1->SR;

    /* ----- CC1 (A) ----- */
    if (sr & TIM_SR_CC1IF) {
      const uint16_t c1 = (uint16_t)TIM1->CCR1;
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC1);
      const uint8_t ab  = enc_read_AB() & 0x3u;
      const int8_t  dir = dir_from_hw();
      enc_latched_dir   = dir;
      const uint32_t tms = HAL_GetTick();

      /* Clear the “need-low” guard when Z=0 observed */
      if (z_need_low_since_arm && (z_pin_now() == 0u)) {
        z_need_low_since_arm = 0u;
      }

      /* If Z alignment was pending and pins are 00 now, stamp Z FIRST */
      if (z_align_pending_isr) {
        const uint32_t now_ms2 = tms;

        /* latch gap then reset canonical counters */
        z_last_gap_edges_isr = ab_edges_since_z_isr;
        ab_edges_since_z_isr = 0u;
        z_diag_ab_since_isr  = 0u;
        z_diag_steps_x4      = 0u;

        z_last_ms_isr    = now_ms2;
        z_diag_last_z_ms = now_ms2;
        z_diag_isr_accepted++;
        z_epoch_isr++;

        /* Gate the accepted Z into live/capture (and start slice if armed) */
        Gate_OnAcceptedZ(now_ms2, ab, dir);

        z_align_pending_isr = 0u;
      }

      /* Gate AB events (only pass through during active slice) */
      Gate_PushAB(1u, dir, c1, ab, tms);

      /* canonical counters for diagnostics */
      ab_edges_since_z_isr++;
      z_diag_ab_since_isr = ab_edges_since_z_isr;
      z_diag_steps_x4     = ab_edges_since_z_isr * STEPS_PER_AB_EVENT;
      continue;
    }

    /* ----- CC2 (B) ----- */
    if (sr & TIM_SR_CC2IF) {
      const uint16_t c2 = (uint16_t)TIM1->CCR2;
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC2);
      const uint8_t ab  = enc_read_AB() & 0x3u;
      const int8_t  dir = dir_from_hw();
      enc_latched_dir   = dir;
      const uint32_t tms = HAL_GetTick();

      if (z_need_low_since_arm && (z_pin_now() == 0u)) {
        z_need_low_since_arm = 0u;
      }

      if (z_align_pending_isr) {
        const uint32_t now_ms2 = tms;

        /* latch gap then reset canonical counters */
        z_last_gap_edges_isr = ab_edges_since_z_isr;
        ab_edges_since_z_isr = 0u;
        z_diag_ab_since_isr  = 0u;
        z_diag_steps_x4      = 0u;

        z_last_ms_isr    = now_ms2;
        z_diag_last_z_ms = now_ms2;
        z_diag_isr_accepted++;
        z_epoch_isr++;

        /* Gate the accepted Z into live/capture (and start slice if armed) */
        Gate_OnAcceptedZ(now_ms2, ab, dir);

        z_align_pending_isr = 0u;
      }

      /* Gate AB events (only pass through during active slice) */
      Gate_PushAB(2u, dir, c2, ab, tms);

      /* canonical counters for diagnostics */
      ab_edges_since_z_isr++;
      z_diag_ab_since_isr = ab_edges_since_z_isr;
      z_diag_steps_x4     = ab_edges_since_z_isr * STEPS_PER_AB_EVENT;
      continue;
    }

#ifdef TIM_SR_TERRF
    if (sr & TIM_SR_TERRF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_TERRF); }
#endif
#ifdef TIM_SR_IERRF
    if (sr & TIM_SR_IERRF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IERRF); }
#endif
  }

  /* health */
  {
    const uint32_t level = (event_write - event_read) & EVENT_IDX_MASK;
    Diag_ObserveEventBufLevel(level);
  }

  DiagTiming_Stop(DIAG_T_ISR_TOTAL);
  HAL_GPIO_WritePin(INT_PIN_GPIO_Port, INT_PIN_Pin, GPIO_PIN_RESET);
  __DSB();
}



/* ============================ (Replay removed) ========================= */
/* If main still references these, keep tiny stubs temporarily. */
static inline void EncSampler_ReplayStart(void) {}
static inline int  EncSampler_ReplayStep(uint32_t max_events) { (void)max_events; return 0; }
uint8_t EncSampler_ReplayActive(void) { return 0u; }

/* ============================ Public API =============================== */

void EncSampler_Init(void) {
  memset(&enc_state, 0, sizeof(enc_state));
  enc_state.baseline_interval = 10.0f;

  enc_state.last_AB_state = (enc_read_AB() & 0x3u);
  synth_ring_idx = gray_to_ring_idx(enc_state.last_AB_state);
  synth_gray     = enc_state.last_AB_state;

  WinStamp_InitAll();

  __disable_irq();
  wf_w = wf_r = 0; wf_count = 0; win_row = 0;
  win_ready = 0; win_total = 0;
  __enable_irq();
  z_align_pending_isr = 0u;

  z_epoch_seen_main = z_epoch_isr;

  __disable_irq();
  /* capture state */
  cap_armed = cap_active = cap_done = 0u;
  cap_w = cap_r = cap_count = cap_drops = 0u;
  cap_start_ms = cap_end_ms = cap_duration_ms = 0u;

  z_last_gap_edges_isr = 0u;
  __enable_irq();

  /* Seed/ECC-init the NOLOAD buffers once */
  memset((void*)win_ring,     0, sizeof(win_ring));
  memset((void*)flags_ring,   0, sizeof(flags_ring));
  memset((void*)event_buffer, 0, sizeof(event_buffer));
  memset((void*)cap_buf,      0, sizeof(cap_buf));

  EncSampler_ConfigIRQs();
  suppress_until_first_Z = 1u;
  __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_TIF | TIM_SR_COMIF);
}

void EncSampler_Process(void) {
  /* LIVE processing with PRE-Z semantics */

  static uint32_t last_ms = 0;
  static uint32_t gray_skip2   = 0;
  static uint8_t  last_src     = 0;
  static int32_t  dir_sum      = 0;
  static uint32_t rule_flags_live = 0;
  static uint8_t  had_z_in_win = 0;

  /* adjacency computed on the same gray the model sees */
  static uint8_t  last_model_gray = 0;
  static uint8_t  have_last_model_gray = 0;

  if (cap_active) {
    uint32_t now = HAL_GetTick();
    if ((int32_t)(now - cap_end_ms) >= 0) {
      __disable_irq();
      cap_active = 0u;
      cap_done   = 1u;
      __enable_irq();
    }
  }

  while (event_read != event_write) {
    encoder_event_t evt = event_buffer[event_read];
    event_read = (event_read + 1u) & EVENT_IDX_MASK;

    /* === Handle queued Z (src==0) BEFORE any A/B work — PRE-Z stamping === */
    if (evt.src == 0u) {
      z_diag_last_z_ms = z_last_ms_isr;

#if ENABLE_TRACE_WIN
      if (win_row == 0) memset(trace_z, 0, SEQ_LEN);
#endif

      /* ---- Special case: the FIRST Z since init/arm.
         Drop any partial window and start clean AFTER this Z. ---- */
      if (suppress_until_first_Z) {
        /* Mirror ISR epoch (diagnostics) & bump main-side sequence */
        z_epoch_seen_main = z_epoch_isr;
        z_seq_main++;

        /* Ensure the next AB row sees SSZ=1 */
        g_ws.ab_since_z_soft = 0u;

        /* Throw away partially-packed content so first window starts right after Z */
        win_row = 0;
        gray_skip2 = 0;
        rule_flags_live = 0;
        last_src = 0;
        had_z_in_win = 0;

        /* Reset modeled-gray continuity for a clean first row */
        have_last_model_gray = 0;
        /* (Keep enc_state.* timing EWMA as-is) */

        /* Done with the special-case */
        suppress_until_first_Z = 0u;

        /* Do NOT stamp any row/window for this Z; begin on next AB edge */
        continue;
      }

      /* Mirror ISR epoch (diagnostics) & bump main-side sequence */
      z_epoch_seen_main = z_epoch_isr;
      z_seq_main++;

      /* Optional double/miss flags */
      if (z_last_gap_edges_isr < Z_MIN_GAP_EDGES)   rule_flags_live |= WR_ZDOUBLE;
      if (g_ws.ab_since_z_soft > Z_MISS_EDGE_LIMIT) rule_flags_live |= WR_ZMISS;

      if (win_row > 0) {
        /* ---------- normal in-window PRE-Z ---------- */
        const uint8_t zrow = (uint8_t)(win_row - 1u);

        /* Set Z=1 directly on the already-written previous row */
        win_ring[wf_w][((uint32_t)zrow * FEAT_DIM) + 6u] = scale_feat(6, 1.0f);

#if ENABLE_TRACE_WIN
        trace_z[zrow] = 1u;
#endif
        WinStamp_OnZStampedInStream(zrow, z_seq_main);
        had_z_in_win = 1u;

        /* PRE-Z semantics: Z occurs AFTER that row -> next AB row must see SSZ=1 */
        g_ws.ab_since_z_soft = 0u;

      } else {
        /* ---------- cross-window PRE-Z (previous window’s last row) ---------- */
        if (win_total == 0) {
          /* No previous window exists yet. Just reset SSZ; first AB row will see SSZ=1. */
          g_ws.ab_since_z_soft = 0u;
          had_z_in_win = 0u;
        } else {
          uint16_t pw = (uint16_t)((wf_w - 1u) & WINMASK);

          win_ring[pw][((uint32_t)(SEQ_LEN - 1u) * FEAT_DIM) + 6u] = scale_feat(6, 1.0f);
          win_z_row[pw]      = (uint16_t)(SEQ_LEN - 1u);
          win_z_epoch[pw]    = z_seq_main;
          win_z_seq_end[pw]  = z_seq_main;
          flags_ring[pw]    |= WR_ZINWIN;

          g_ws.ab_since_z_soft = 0u;
          had_z_in_win = 0u;
        }

        /* consume Z and continue */
        continue;
      }
    }

    /* keep public Z time fresh for UI (coarse) */
    z_diag_last_z_ms = z_last_ms_isr;

#if ENABLE_TRACE_WIN
    if (win_row == 0) memset(trace_z, 0, SEQ_LEN);
#endif
    if (win_row == 0) {
      /* ---- begin metadata for this window (stream-aligned) ----
         IMPORTANT: We begin the window ONLY here (first non-Z AB),
         AFTER any cross-window Z reset above, so start_x4 is correct. */
      had_z_in_win = 0;
      DiagTiming_Start(DIAG_T_E2E_WINDOW);
      WinStamp_BeginWindow(wf_w);
    }

    const uint8_t current_gray = (evt.ab_state & 0x3u);
    const int8_t  dir = evt.dir;
    const uint8_t dir_fwd = (dir > 0);
    const uint8_t dir_bwd = (dir < 0);
    if (dir_fwd) dir_sum++; else if (dir_bwd) dir_sum--;

    /* --- timing features (EWMA) --- */
    const uint32_t now_ms = evt.timestamp_ms;
    int32_t dms = (int32_t)(now_ms - last_ms);
    if (dms <= 0) dms = 1;
    const float dt_ms = (float)dms;
    if (enc_state.baseline_interval < 1.0f) enc_state.baseline_interval = dt_ms;
    const float ratio = dt_ms / enc_state.baseline_interval;
    enc_state.speed_change_rate = fabsf(ratio - 1.0f);
    enc_state.baseline_interval = 0.9f * enc_state.baseline_interval + 0.1f * dt_ms;
    last_ms = now_ms;

    /* === advance synthetic gray one step PER EDGE (fills falling edges visually) === */
    {
      const uint8_t post_gray = (evt.ab_state & 0x3u);   /* pins at this rising edge */
      const uint8_t pin_idx   = gray_to_ring_idx(post_gray);

      /* From the synth PRE index, which channel should be rising now?
       * FWD: 0->1 (B↑), 1->3 (A↑), 3->2 (B↓), 2->0 (A↓)
       * BWD: 0->2 (A↑), 2->3 (B↑), 3->1 (A↓), 1->0 (B↓) */
      uint8_t expect_src;
      if (evt.dir > 0) {
        expect_src = (synth_ring_idx & 1u) ? 1u /*A*/ : 2u /*B*/;
      } else {
        expect_src = (synth_ring_idx & 1u) ? 2u /*B*/ : 1u /*A*/;
      }

      /* Only snap if the observed rising channel disagrees with our PRE parity */
      if (evt.src != expect_src) {
        synth_ring_idx = pin_idx;        /* resync to real POST state */
      }

      /* Emit the synth state (interleaves the missing falling steps visually): 1,3,2,0… */
      synth_gray = GRAY_RING[synth_ring_idx];

      /* Step one quarter for the NEXT row so we alternate POST/falling properly */
      if (evt.dir > 0) {
        synth_ring_idx = (uint8_t)((synth_ring_idx + 1u) & 3u);
      } else {
        synth_ring_idx = (uint8_t)((synth_ring_idx + 3u) & 3u);
      }
    }

    /* PRE-Z: set Z on the row selected by the Z handler */
    const uint8_t packZ = 0u;

    /* === pack features (use FILLED gray, stream-aligned counters) === */
    DiagTiming_Start(DIAG_T_PACK_AB);

    float *f = &win_ring[wf_w][((uint32_t)win_row * FEAT_DIM)];

    /* Modeled Gray (filled: alternates rise/fall 1,3,2,0 …) */
    const uint8_t model_gray = (synth_gray & 0x3u);

    /* Derive source from modeled gray transition (prev -> curr):
       FWD: 00→01 (1)=B↑, 01→11 (3)=A↑, 11→10=B↓, 10→00=A↓  */
    uint8_t src_A_model = 0, src_B_model = 0;
    if (have_last_model_gray) {
      gray_step_to_src(last_model_gray, model_gray, &src_A_model, &src_B_model);
    } else {
      /* first row fallback: use this rising edge once */
      src_A_model = (evt.src == 1u);
      src_B_model = (evt.src == 2u);
      have_last_model_gray = 1u;
    }

    /* adjacency based on modeled gray (matches what model sees) */
    uint8_t adjacent = 1u;
    if (have_last_model_gray) {
      const uint8_t diff_bits = (last_model_gray ^ model_gray) & 3u;
      adjacent = (diff_bits == 1u) || (diff_bits == 2u);
    }
    last_model_gray = model_gray;

    /* 1-based SSZ for the model (AB×2 domain by default) */
    #if MODEL_FEEDS_X4
      uint32_t ab_for_model = g_ws.ab_since_z_soft * STEPS_PER_AB_EVENT + 1u;  /* 1,3,5,… */
    #else
      uint32_t ab_for_model = g_ws.ab_since_z_soft + 1u;                        /* 1..2000.. */
    #endif

    /* Build same_src from the modeled source code (1=A, 2=B) */
    const uint8_t src_code_model = src_A_model ? 1u : (src_B_model ? 2u : 0u);
    const uint8_t is_same_src = (last_src && (src_code_model == last_src)) ? 1u : 0u;

    /* Write features */
    f[0] = scale_feat(0, (float)model_gray);      /* modeled AB state (0,1,3,2) */
    f[1] = scale_feat(1, (float)src_A_model);     /* SRC_A (modeled) */
    f[2] = scale_feat(2, (float)src_B_model);     /* SRC_B (modeled) */
    f[3] = scale_feat(3, (float)dir_fwd);
    f[4] = scale_feat(4, (float)dir_bwd);
    f[5] = scale_feat(5, enc_state.speed_change_rate);
    f[6] = scale_feat(6, (float)packZ);           /* PRE-Z on this row if selected */
    f[7] = scale_feat(7, (float)ab_for_model);    /* SSZ (1-based) */
    f[8] = scale_feat(8, (float)is_same_src);     /* same_src (modeled) */
    f[9] = scale_feat(9, (float)adjacent);        /* adjacency (modeled) */

#if ENABLE_TRACE_WIN
    trace_ab[win_row]  = model_gray;
    /* log modeled source so the trace matches the shown gray step */
    trace_src[win_row] = src_code_model ? src_code_model : evt.src;
    trace_z[win_row]   = packZ;
#endif

    if (is_same_src) gray_skip2++;
    last_src = src_code_model ? src_code_model : evt.src;

    DiagTiming_Stop(DIAG_T_PACK_AB);

    enc_state.last_AB_state = current_gray;

    WinStamp_OnEdge();

    /* advance row, publish window if full */
    win_row++;

    if (win_row >= SEQ_LEN) {
      uint32_t flags = rule_flags_live;
      if (gray_skip2 >= 2) flags |= WR_SKIP2;
      if (had_z_in_win)    flags |= WR_ZINWIN;
      enc_rule_flags = flags;

      if (dir_sum > 0)      last_window_dir = +1;
      else if (dir_sum < 0) last_window_dir = -1;
      else                  last_window_dir = enc_latched_dir;
      dir_sum = 0;

      DiagTiming_Stop(DIAG_T_E2E_WINDOW);
      DiagTiming_Start(DIAG_T_WIN_PUBLISH);

      if (suppress_until_first_Z && (z_seq_main == 0u)) {
        /* Do NOT publish this window. Reset per-window accumulators and continue. */
        win_row = 0;
        gray_skip2 = 0;
        rule_flags_live = 0;
        last_src = 0;
        had_z_in_win = 0;
        /* keep last_model_gray/have_last_model_gray for continuity */
        DiagTiming_Stop(DIAG_T_WIN_PUBLISH);
        /* Skip rotating wf_w etc. */
        continue;
      }
      /* Once we’ve seen any Z, stop suppressing (kept for safety). */
      if (suppress_until_first_Z && (z_seq_main > 0u)) {
        suppress_until_first_Z = 0u;
      }

      /* publish stamped metadata for this window BEFORE rotating wf_w */
      WinStamp_PublishWindow(wf_w);

      flags_ring[wf_w] = flags;

      __disable_irq();
      wf_w = (uint16_t)((wf_w + 1u) & WINMASK);
      if (wf_count < WINFIFO) {
        wf_count++;
      } else {
        wf_r = (uint16_t)((wf_r + 1u) & WINMASK);
      }
      win_ready = wf_count;
#if ENABLE_TRACE_WIN
      memcpy(last_trace_ab,  trace_ab,  SEQ_LEN);
      memcpy(last_trace_src, trace_src, SEQ_LEN);
      memcpy(last_trace_z,   trace_z,   SEQ_LEN);
      memset(trace_z, 0, SEQ_LEN);
#endif
      __enable_irq();

      Diag_ObserveWinFifoLevel(wf_count);
      win_total++;

      DiagTiming_Stop(DIAG_T_WIN_PUBLISH);
      Diag_NotifyWindowPublished();

      /* reset window accumulators */
      win_row = 0;
      gray_skip2 = 0;
      rule_flags_live = 0;
      last_src = 0;
      had_z_in_win = 0;
      /* keep last_model_gray & have_last_model_gray across windows */
    }
  }
}


/* =============================== Copy ================================== */

int EncSampler_CopyWindowLinear(float *dst, uint32_t *out_flags) {
  uint16_t r;
  uint32_t flags;

  __disable_irq();
  if (wf_count == 0) { __enable_irq(); return -1; }
  r     = wf_r;
  flags = flags_ring[r];
  wf_r  = (uint16_t)((wf_r + 1u) & WINMASK);
  wf_count--;
  win_ready = wf_count;
  __enable_irq();

  memcpy(dst, win_ring[r], sizeof(win_ring[0]));
  win_rule_flags = flags;
  if (out_flags) *out_flags = flags;

  /* hand off the stamps for this window */
  WinStamp_CopyOut(r);

  return 0;
}

/* =============================== Stop / Flush =========================== */

void EncSampler_StopHardware(void) {
  __disable_irq();

  if (htim1.Instance) {
    __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2 | TIM_IT_UPDATE | TIM_IT_TRIGGER | TIM_IT_COM);
#ifdef TIM_IT_IDX
    __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_IDX);
#endif
    __HAL_TIM_DISABLE(&htim1);

    __HAL_TIM_CLEAR_FLAG(&htim1,
      TIM_SR_CC1IF | TIM_SR_CC1OF |
      TIM_SR_CC2IF | TIM_SR_CC2OF |
      TIM_SR_UIF   | TIM_SR_TIF   | TIM_SR_COMIF);
#ifdef TIM_SR_IDXF
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
#endif
  }

#ifdef TIM1_CC_IRQn
  NVIC_DisableIRQ(TIM1_CC_IRQn);
#endif
#if defined(TIM1_TRG_CCU_IRQn)
  NVIC_DisableIRQ(TIM1_TRG_CCU_IRQn);
#elif defined(TIM1_TRG_COM_IRQn)
  NVIC_DisableIRQ(TIM1_TRG_COM_IRQn);
#endif

  ab_irqs_on = 0;
  __enable_irq();
}

void EncSampler_FlushWindows(void) {
  __disable_irq();

  wf_w = wf_r = 0; wf_count = 0;
  win_ready = 0; win_total = 0;
  win_row = 0;

  event_read = event_write = 0; event_drops = 0;

  z_last_ms_isr = 0;
  ab_edges_since_z_isr = 0;
  z_last_gap_edges_isr = 0;
  z_diag_isr_seen = 0;
  z_diag_isr_accepted = 0;
  z_diag_ab_since_isr = 0;
  z_diag_steps_x4 = 0;
  z_diag_last_z_ms = 0;
  z_align_pending_isr = 0u;


  z_epoch_isr = 0;
  z_epoch_seen_main = 0;

  cap_armed = 0u; cap_active = 0u; cap_done = 0u;
  cap_w = cap_r = cap_count = cap_drops = 0u;
  cap_start_ms = cap_end_ms = cap_duration_ms = 0u;
  suppress_until_first_Z = 1u;
  WinStamp_InitAll();


  __enable_irq();
}

/* ============================ Capture API ============================== */

void EncSampler_CaptureArmOnNextZ(uint32_t duration_ms)
{
  __disable_irq();
  cap_duration_ms = duration_ms ? duration_ms : 1000u;
  cap_armed  = 1u;
  cap_active = 0u;
  cap_done   = 0u;
  cap_w = cap_r = cap_count = cap_drops = 0u;

  /* NEW: if Z is currently high at arm time, force a low first */
  z_need_low_since_arm = z_pin_now();  // 1 if high, 0 if already low
  suppress_until_first_Z = 1u;
  __enable_irq();
}

void EncSampler_CaptureCancel(void)
{
  __disable_irq();
  cap_armed  = 0u;
  cap_active = 0u;
  __enable_irq();
}

bool     EncSampler_CaptureActive(void) { return cap_active != 0u; }
bool     EncSampler_CaptureDone(void)   { return cap_done   != 0u; }
uint32_t EncSampler_CaptureCount(void)  { return cap_count; }
uint32_t EncSampler_CaptureDrops(void)  { return cap_drops; }

uint32_t EncSampler_CaptureRead(enc_capture_evt_t *dst, uint32_t max)
{
  if (!dst || !max) return 0u;
  uint32_t copied = 0;
  __disable_irq();
  while ((copied < max) && (cap_r != cap_w)) {
    dst[copied++] = cap_buf[cap_r];
    cap_r = (cap_r + 1u);
    if (cap_r >= CAPTURE_MAX_EVENTS) cap_r = 0u;
  }
  __enable_irq();
  return copied;
}

void EncSampler_GetLastCaptureStats(uint32_t* edges, uint32_t* dur_ms,
                                    uint32_t* first_ms, uint32_t* last_ms,
                                    uint32_t* z_marks)
{
  uint32_t e=0, f=0, l=0, z=0;

  __disable_irq();
  uint32_t r = cap_r;
  uint32_t w = cap_w;
  /* Snapshot indices to iterate without holding IRQs too long */
  __enable_irq();

  if (r == w) {
    /* empty */
    if (edges)    *edges    = 0u;
    if (dur_ms)   *dur_ms   = 0u;
    if (first_ms) *first_ms = 0u;
    if (last_ms)  *last_ms  = 0u;
    if (z_marks)  *z_marks  = 0u;
    return;
  }

  /* Iterate from r to w (wrapping) */
  uint8_t started = 0u;
  while (r != w) {
    const enc_capture_evt_t *ev = &cap_buf[r];
    if (!started) { f = ev->t_ms; started = 1u; }
    l = ev->t_ms;
    e++;
    if (ev->src == 0u) z++;          /* our convention: 0 == Z */
    r = r + 1u;
    if (r >= CAPTURE_MAX_EVENTS) r = 0u;
  }

  if (edges)    *edges    = e;
  if (dur_ms)   *dur_ms   = (l >= f) ? (l - f) : 0u;
  if (first_ms) *first_ms = f;
  if (last_ms)  *last_ms  = l;
  if (z_marks)  *z_marks  = z;
}


void EncSampler_CaptureForceStopFromISR(void)
{
  if (cap_active) {
    __disable_irq();
    EncSampler_StopHardware();
    printf("Capture stopped at %lu ms\n", HAL_GetTick());
    cap_active = 0u;
    cap_done = 1u;
    __enable_irq();
  }
}

uint8_t EncSampler_HasPending(void)
{
  uint8_t p;
  __disable_irq();
  p = ((event_write != event_read) || ((win_row != 0) && ab_irqs_on)) ? 1u : 0u;
  __enable_irq();
  return p;
}

/* ============================== Trace API ============================== */
#if ENABLE_TRACE_WIN
void EncSampler_DebugGetLastTrace(uint8_t *ab, uint8_t *src, uint8_t *z) {
  if (ab) memcpy(ab, last_trace_ab, SEQ_LEN);
  if (src) memcpy(src, last_trace_src, SEQ_LEN);
  if (z) memcpy(z, last_trace_z, SEQ_LEN);
}
