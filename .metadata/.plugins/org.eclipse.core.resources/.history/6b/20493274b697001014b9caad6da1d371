  uint16_t z_row_this_window;     /* first row within current window where Z stamped, or 0xFFFF */
  uint32_t z_epoch_this_window;   /* sequence value for that Z (0 if none) */
} winstamp_t;

static winstamp_t g_ws = { 0, 0xFFFFu, 0 };

