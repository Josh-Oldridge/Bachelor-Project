void MX_X_CUBE_AI_Process(void)
{
    /* USER CODE BEGIN 6 */
	if (!network) return;

	/* Run one inference iff a full window is ready */
	if (acquire_and_process_data((ai_float**)data_ins) == 0) {
	  if (ai_run() == 0) {
	    post_process((ai_float**)data_outs);
	  }
	}
    /* USER CODE END 6 */
}
