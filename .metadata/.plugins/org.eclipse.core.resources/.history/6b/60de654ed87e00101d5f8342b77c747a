extern volatile uint32_t win_ready;                    // from enc_sampler.c
volatile uint32_t       inf_total = 0;                 // owned here
volatile float          last_y[AI_NETWORK_OUT_1_SIZE]; // owned here

/* Class indices (model_meta.h order) */
#define C_BOUNCE       0   // "bounce"
#define C_MISSINGSTEP  1   // "missing_step"
#define C_NORMAL       2   // "normal"
#define C_ZINDEX       3   // "z_index"

/* Acquire input: copy the oldest complete window straight into the NN input */
static int acquire_and_process_data(void)
{
  /* Returns 0 on success, -1 if no window ready */
  return EncSampler_CopyWindowLinear((float*)ai_input[0].data);
}

/* Force a 2-class decision vs NORMAL (for rule guardrails) */
static inline void force_vs_normal(int cls, float p)
{
  for (int k = 0; k < AI_NETWORK_OUT_1_SIZE; ++k) last_y[k] = 0.0f;
  if (p < 0.0f) p = 0.0f; if (p > 0.999f) p = 0.999f;
  last_y[cls]      = p;
  last_y[C_NORMAL] = 1.0f - p;
}

/* Optional: apply per-class operating thresholds from model_meta.h */
static void apply_thresholds(void)
{
#if MODEL_HAS_THRESHOLDS
  float sum = 0.0f, tmp[AI_NETWORK_OUT_1_SIZE];
  for (int i = 0; i < AI_NETWORK_OUT_1_SIZE; ++i) {
    float v = last_y[i];
    if (i != C_NORMAL && v < OP_THRESH[i]) v = 0.0f;   // gate low-confidence errors
    tmp[i] = v; sum += v;
  }
  if (sum > 1e-6f) {
    for (int i = 0; i < AI_NETWORK_OUT_1_SIZE; ++i) last_y[i] = tmp[i] / sum;
  }
#endif
}

/* Handle post-inference: copy outputs, apply thresholds, then rule guardrails */
static int post_process(void)
{
  const float* out = (const float*)ai_output[0].data;

  /* snapshot raw network output */
  for (int i = 0; i < AI_NETWORK_OUT_1_SIZE; ++i) last_y[i] = out[i];

  /* nudge with operating thresholds (if provided) */
  apply_thresholds();

  /* ultra-light guardrails based on encoder rules (from sampler) */
  const uint32_t rf = enc_rule_flags;   // live flags are fine here
  if (rf & RS_A_STUCK) {
    force_vs_normal(C_MISSINGSTEP, 0.999f);
  } else if (rf & RS_B_STUCK) {
    force_vs_normal(C_MISSINGSTEP, 0.999f);
  } else if (rf & RS_QUAD_BAD) {
    float p = last_y[C_BOUNCE]; if (p < 0.95f) p = 0.95f;
    force_vs_normal(C_BOUNCE, p);
  } else if (rf & RS_Z_MISSED) {
    float p = last_y[C_ZINDEX]; if (p < 0.95f) p = 0.95f;
    force_vs_normal(C_ZINDEX, p);
  }

  inf_total++;
  return 0;
}






