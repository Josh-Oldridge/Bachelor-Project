// enc_sampler.c — robust quadrature (STM32 TIM encoder) with CNT-delta direction
// Key fixes:
//  - Use CCR delta (CNT step) to infer direction (mapping-safe, robust).
//  - Big event buffer + "drop-oldest" on overflow (keeps ISR state coherent).
//  - Optional A-rising-only drain to cap ISR load by 4×.
//  - Keeps your feature layout / prints.

#include "enc_sampler.h"
#include <string.h>
#include <math.h>
#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include "model_meta.h"
#include "main.h"
#include "stm32n6xx_hal.h"

/* ============================= Config ================================== */

// Encoder lines per rev (mechanical)
#ifndef CPR
#define CPR 500u
#endif

// Z index availability
#ifndef HAVE_Z_INDEX
#define HAVE_Z_INDEX 1
#endif
#if !defined(TIM_SR_IDXF) || !defined(TIM_IT_IDX)
#  undef  HAVE_Z_INDEX
#  define HAVE_Z_INDEX 0
#endif

// Ignore Z in firmware even if wired
#ifndef FORCE_IGNORE_Z
#define FORCE_IGNORE_Z 0
#endif

// Input capture digital filter (0..15). 0b1011 => fDTS/32, N=8
#ifndef ENC_IC_FILTER
#define ENC_IC_FILTER 0b1011
#endif

// Mute TRG/COM/UPD noise
#ifndef ENC_SUPPRESS_TRG_COM
#define ENC_SUPPRESS_TRG_COM 1
#endif

// Flip logical direction
#ifndef ENC_DIR_REVERSED
#define ENC_DIR_REVERSED 0
#endif

// Process only A rising edges (still x4 hardware count; 4× fewer events)
#ifndef ENC_IRQ_ONLY_A_RISING
#define ENC_IRQ_ONLY_A_RISING 0
#endif

// Event buffer size (power of 2): 15 => 32768 events
#ifndef EVENT_BUF_BITS
#define EVENT_BUF_BITS 15
#endif

// On overflow, drop the oldest (keeps ISR state/data recent & coherent)
#ifndef EVENT_OVERWRITE_OLDEST
#define EVENT_OVERWRITE_OLDEST 1
#endif

#define QUAD_EDGES_PER_REV (4u * CPR)

/* Z hygiene */
#ifndef Z_SOFT_DEBOUNCE_MS
#define Z_SOFT_DEBOUNCE_MS  0u
#endif
#ifndef Z_MIN_AB_EDGES
#define Z_MIN_AB_EDGES      0u
#endif
#ifndef Z_MIN_GAP_EDGES
#define Z_MIN_GAP_EDGES     20u
#endif
#ifndef Z_MISS_EDGE_LIMIT
#define Z_MISS_EDGE_LIMIT   (QUAD_EDGES_PER_REV + QUAD_EDGES_PER_REV/8u)
#endif
#ifndef Z_MISS_MS_LIMIT
#define Z_MISS_MS_LIMIT 0u
#endif

/* ---------- Drop-in robustness switches ---------- */

// Kill digital filter to avoid unequal A/B delay (phase skew at speed)
#undef  ENC_IC_FILTER
#define ENC_IC_FILTER 0

// Tell the ISR which physical channel is "A" in your UI/traces
// If CC1 is actually B (and CC2 is A), set to 0.
#ifndef ENC_CC1_IS_A
#define ENC_CC1_IS_A 1
#endif

// Prefer direction from captured CNT delta (robust to pin mapping)
#ifndef ENC_DIR_FROM_CNT
#define ENC_DIR_FROM_CNT 1
#endif

/* ======================== Globals / Exposed state ====================== */

extern TIM_HandleTypeDef htim1;

enum {
  WR_SKIP2     = 1u<<0,
  WR_ZMISS     = 1u<<1,
  WR_ZDOUBLE   = 1u<<2,
  WR_ZMISALIGN = 1u<<3,
};

volatile uint32_t enc_rule_flags = 0;
volatile uint32_t win_rule_flags = 0;

volatile uint32_t win_ready = 0;
volatile uint32_t win_total = 0;

volatile uint32_t event_drops = 0;

#define SEQ_LEN  (MODEL_SEQ_LEN)
#define FEAT_DIM (MODEL_FEAT_DIM)
static float feat_win[SEQ_LEN][FEAT_DIM];

#if ENABLE_TRACE_WIN
static uint8_t trace_ab[SEQ_LEN];
static uint8_t trace_src[SEQ_LEN];
static uint8_t trace_z[SEQ_LEN];

static uint8_t last_trace_ab[SEQ_LEN];
static uint8_t last_trace_src[SEQ_LEN];
static uint8_t last_trace_z[SEQ_LEN];
#endif

typedef struct {
  uint8_t  last_AB_state;      // Gray digit: 0,1,3,2 (bit1=A, bit0=B)
  float    speed_change_rate;
  uint32_t last_update_ms;
  float    baseline_interval;
} encoder_state_t;

static encoder_state_t enc_state = {0};

static volatile int8_t  enc_latched_dir = +1;
int8_t EncSampler_GetLatchedDir(void) { return enc_latched_dir; }

static volatile int8_t last_window_dir = +1;
int8_t EncSampler_GetLastWindowDir(void) { return last_window_dir; }

static volatile uint16_t enc_cnt_wrap = 0;
static volatile uint16_t last_cnt_isr = 0;

/* ============================ Window FIFO ============================== */

#define WINFIFO_LOG2 5
#define WINFIFO      (1u << WINFIFO_LOG2)
static float    win_fifo[WINFIFO][SEQ_LEN * FEAT_DIM];
static uint32_t flags_fifo[WINFIFO];
static uint8_t  wf_w = 0, wf_r = 0, wf_count = 0;

/* ============================ Event ring =============================== */

typedef struct {
  int8_t   delta;           // +1 / -1 per AB edge, 0 for Z-only
  uint8_t  z_pulse;         // 1 if Z accepted
  uint8_t  src;             // 1=CC1(A), 2=CC2(B), 3=IDX
  uint8_t  ab_state;        // Gray at event (bit1=A, bit0=B)
  uint32_t timestamp_ms;    // coarse tick
  uint16_t ccr;             // CNT snapshot
} encoder_event_t;

#define EVENT_BUFFER_SIZE  (1u << EVENT_BUF_BITS)
#define EVENT_IDX_MASK     (EVENT_BUFFER_SIZE - 1u)

static encoder_event_t event_buffer[EVENT_BUFFER_SIZE];
static volatile uint32_t event_write = 0;
static volatile uint32_t event_read  = 0;

/* Z diag mirrors */
static volatile uint32_t z_last_ms_isr        = 0;
static volatile uint32_t ab_edges_since_z_isr = 0;
volatile uint32_t z_diag_isr_seen        = 0;
volatile uint32_t z_diag_isr_accepted    = 0;
volatile uint32_t z_diag_ab_since_isr    = 0;
volatile uint32_t z_diag_steps_since_main= 0;
volatile uint32_t z_diag_last_z_ms       = 0;

/* ============================ Helpers ================================== */

#ifndef TIM_CCMR1_IC1F_Pos
#define TIM_CCMR1_IC1F_Pos 4U
#endif
#ifndef TIM_CCMR1_IC2F_Pos
#define TIM_CCMR1_IC2F_Pos 12U
#endif

static inline int16_t mod_diff_u16(uint16_t now, uint16_t prev, uint16_t wrap) {
  int32_t d = (int32_t)now - (int32_t)prev;
  if (d >  (int32_t)wrap/2) d -= wrap;
  if (d < -(int32_t)wrap/2) d += wrap;
  return (int16_t)d;
}

/* Read present Gray from pins (A on bit1, B on bit0) */
static inline uint8_t enc_read_AB(void) {
  const uint8_t a = (HAL_GPIO_ReadPin(ENC_A_GPIO_Port, ENC_A_Pin) != GPIO_PIN_RESET);
  const uint8_t b = (HAL_GPIO_ReadPin(ENC_B_GPIO_Port, ENC_B_Pin) != GPIO_PIN_RESET);
  return (uint8_t)((a << 1) | b);
}

/* ---- Direction LUT on Gray ring (0→1→3→2→0 is +1) ----
 * index = (prev<<2) | curr
 * invalid (two-bit) transitions map to 0.
 */
static inline int8_t dir_from_prev_curr(uint8_t prev, uint8_t curr) {
  static const int8_t lut[16] = {
    // curr: 0, 1, 2, 3    (prev=0..3 rows)
    /* prev=0 */  0, +1, -1,  0,
    /* prev=1 */ -1,  0,  0, +1,
    /* prev=2 */ +1,  0,  0, -1,
    /* prev=3 */  0, -1, +1,  0
  };
  int8_t d = lut[((prev & 3u) << 2) | (curr & 3u)];
#if ENC_DIR_REVERSED
  d = (int8_t)-d;
#endif
  return d;
}

static inline void EncSampler_ApplyTIM1ICFilter(void) {
  const uint32_t save_ccer = TIM1->CCER;
  TIM1->CCER &= ~(TIM_CCER_CC1E | TIM_CCER_CC2E);
  uint32_t ccmr1 = TIM1->CCMR1;
  ccmr1 &= ~(TIM_CCMR1_IC1F | TIM_CCMR1_IC2F);
  ccmr1 |= ((ENC_IC_FILTER & 0xF) << TIM_CCMR1_IC1F_Pos) |
           ((ENC_IC_FILTER & 0xF) << TIM_CCMR1_IC2F_Pos);
  TIM1->CCMR1 = ccmr1;
  TIM1->CCER  = save_ccer;
}

static inline void EncSampler_ConfigIRQs(void) {
#if ENC_IRQ_ONLY_A_RISING
  __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_CC1);
  __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_CC2);
#else
  __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2);
#endif
#if HAVE_Z_INDEX && !FORCE_IGNORE_Z
  __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_IDX);
#endif
#if ENC_SUPPRESS_TRG_COM
  __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_TRIGGER | TIM_IT_COM | TIM_IT_UPDATE);
  __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_TIF | TIM_SR_COMIF | TIM_SR_UIF);
#endif
}

/* ======================== IRQ Drain (encoder) ========================== */

#if ENC_IS_LIVE
static volatile uint8_t last_ab_isr = 0;

static inline void push_event_isr(int delta, int z, uint16_t ccr_sample,
                                  uint8_t src, uint8_t ab_state) {
  uint32_t next = (event_write + 1u) & EVENT_IDX_MASK;
  if (next == event_read) {
#if EVENT_OVERWRITE_OLDEST
    // Drop oldest to keep recent motion and ISR state coherent
    event_read = (event_read + 1u) & EVENT_IDX_MASK;
#else
    event_drops++;
    return;
#endif
  }
  encoder_event_t *e = &event_buffer[event_write];
  e->timestamp_ms = HAL_GetTick();
  e->ccr          = ccr_sample;
  e->delta        = (int8_t)delta;
  e->z_pulse      = (uint8_t)z;
  e->src          = src;
  e->ab_state     = ab_state;
  event_write = next;
}

void EncSampler_EncoderIRQ_Drain(void) {
  for (int guard = 0; guard < 256; ++guard) {
    uint32_t sr = TIM1->SR;
    uint32_t pend = sr & (TIM_SR_CC1IF | TIM_SR_CC2IF | TIM_SR_CC1OF | TIM_SR_CC2OF);
#if HAVE_Z_INDEX && !FORCE_IGNORE_Z && defined(TIM_SR_IDXF)
    pend |= (sr & TIM_SR_IDXF);
#endif
    if (!pend) break;

    if (sr & TIM_SR_CC1OF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC1OF); }
    if (sr & TIM_SR_CC2OF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC2OF); }

#if HAVE_Z_INDEX && defined(TIM_SR_IDXF)
    if (sr & TIM_SR_IDXF) {
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_IDX);
# ifdef TIM_SR_IDXF
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
# endif
      z_diag_isr_seen++;
# if !FORCE_IGNORE_Z
      const uint32_t now_ms = HAL_GetTick();
      const int32_t  dt_ms  = (int32_t)(now_ms - z_last_ms_isr);
      if ((dt_ms >= (int32_t)Z_SOFT_DEBOUNCE_MS) && (ab_edges_since_z_isr >= Z_MIN_AB_EDGES)) {
        const uint16_t ccrz = (uint16_t)TIM1->CNT;
        const uint8_t  abz  = last_ab_isr;   // keep with last latched AB
        push_event_isr(0, 1, ccrz, 3, abz);
        z_last_ms_isr = now_ms;
        ab_edges_since_z_isr = 0;
        z_diag_isr_accepted++;
        z_diag_ab_since_isr = 0;
      }
# endif
    }
#endif
    sr = TIM1->SR;

#if ENC_IRQ_ONLY_A_RISING

    // ---- Only CC1 (A rising accepted) ----
    if (sr & TIM_SR_CC1IF) {
      const uint16_t c1 = (uint16_t)TIM1->CCR1;
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC1);
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC1OF);

      const uint8_t ab_now = (enc_read_AB() & 0x3u);
      const uint8_t a_prev = (last_ab_isr >> 1) & 1u;
      const uint8_t a_now  = (ab_now     >> 1) & 1u;

      if (!a_prev && a_now) { // strictly rising A
        const uint8_t prev = last_ab_isr;
        const uint8_t curr = ab_now;
#if ENC_DIR_FROM_CNT
        int16_t step = mod_diff_u16(c1, last_cnt_isr, enc_cnt_wrap);
        int8_t dir = (step > 0) ? +1 : (step < 0) ? -1 : enc_latched_dir;
#else
        int8_t dir = dir_from_prev_curr(prev, curr);
        if (dir == 0) dir = enc_latched_dir;
#endif
        last_cnt_isr = c1;
        last_ab_isr  = curr;
        enc_latched_dir = dir;
        push_event_isr(dir, 0, c1, 1, curr);
        ab_edges_since_z_isr++; z_diag_ab_since_isr = ab_edges_since_z_isr;
      }
    }
    if (sr & TIM_SR_CC2IF) { // keep CC2 clean
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC2);
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC2OF);
    }

#else   // =================== BOTHEDGE path ===================

    // ---- BOTHEDGE: CC1 and/or CC2 may be pending ----
    if ((sr & (TIM_SR_CC1IF | TIM_SR_CC2IF)) == (TIM_SR_CC1IF | TIM_SR_CC2IF)) {
      // Both flagged: choose earlier by proximity to previous CNT
      const uint16_t prev = last_cnt_isr;
      const uint16_t c1   = (uint16_t)TIM1->CCR1;
      const uint16_t c2   = (uint16_t)TIM1->CCR2;
      const int16_t  d1   = mod_diff_u16(c1, prev, enc_cnt_wrap);
      const int16_t  d2   = mod_diff_u16(c2, prev, enc_cnt_wrap);

      if (abs(d1) <= abs(d2)) {
        __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC1);
        __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC1OF);
        const uint8_t prevg = last_ab_isr;
#if ENC_CC1_IS_A
        const uint8_t currg = (uint8_t)(prevg ^ 0x2u); // A toggled
        const uint8_t src   = 1;
#else
        const uint8_t currg = (uint8_t)(prevg ^ 0x1u); // B toggled
        const uint8_t src   = 2;
#endif
#if ENC_DIR_FROM_CNT
        int8_t dir = (d1 > 0) ? +1 : (d1 < 0) ? -1 : enc_latched_dir;
#else
        int8_t dir = dir_from_prev_curr(prevg, currg);
        if (dir == 0) dir = enc_latched_dir; // tolerate skip2 hiccup
#endif
        last_cnt_isr = c1; last_ab_isr = currg;
        enc_latched_dir = dir;
        push_event_isr(dir, 0, c1, src, currg);
      } else {
        __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC2);
        __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC2OF);
        const uint8_t prevg = last_ab_isr;
#if ENC_CC1_IS_A
        const uint8_t currg = (uint8_t)(prevg ^ 0x1u); // B toggled
        const uint8_t src   = 2;
#else
        const uint8_t currg = (uint8_t)(prevg ^ 0x2u); // A toggled
        const uint8_t src   = 1;
#endif
#if ENC_DIR_FROM_CNT
        int8_t dir = (d2 > 0) ? +1 : (d2 < 0) ? -1 : enc_latched_dir;
#else
        int8_t dir = dir_from_prev_curr(prevg, currg);
        if (dir == 0) dir = enc_latched_dir;
#endif
        last_cnt_isr = c2; last_ab_isr = currg;
        enc_latched_dir = dir;
        push_event_isr(dir, 0, c2, src, currg);
      }
      ab_edges_since_z_isr++; z_diag_ab_since_isr = ab_edges_since_z_isr;
      continue;
    }

    if (sr & TIM_SR_CC1IF) {
      const uint16_t c1 = (uint16_t)TIM1->CCR1;
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC1);
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC1OF);
      const uint8_t prevg = last_ab_isr;
#if ENC_CC1_IS_A
      const uint8_t currg = (uint8_t)(prevg ^ 0x2u);  // A toggled
      const uint8_t src   = 1;
#else
      const uint8_t currg = (uint8_t)(prevg ^ 0x1u);  // B toggled
      const uint8_t src   = 2;
#endif
#if ENC_DIR_FROM_CNT
      int16_t step = mod_diff_u16(c1, last_cnt_isr, enc_cnt_wrap);
      int8_t dir = (step > 0) ? +1 : (step < 0) ? -1 : enc_latched_dir;
#else
      int8_t dir = dir_from_prev_curr(prevg, currg);
      if (dir == 0) dir = enc_latched_dir;
#endif
      last_cnt_isr = c1; last_ab_isr = currg;
      enc_latched_dir = dir;
      push_event_isr(dir, 0, c1, src, currg);
      ab_edges_since_z_isr++; z_diag_ab_since_isr = ab_edges_since_z_isr;
    }

    if (sr & TIM_SR_CC2IF) {
      const uint16_t c2 = (uint16_t)TIM1->CCR2;
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC2);
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC2OF);
      const uint8_t prevg = last_ab_isr;
#if ENC_CC1_IS_A
      const uint8_t currg = (uint8_t)(prevg ^ 0x1u);  // B toggled
      const uint8_t src   = 2;
#else
      const uint8_t currg = (uint8_t)(prevg ^ 0x2u);  // A toggled
      const uint8_t src   = 1;
#endif
#if ENC_DIR_FROM_CNT
      int16_t step = mod_diff_u16(c2, last_cnt_isr, enc_cnt_wrap);
      int8_t dir = (step > 0) ? +1 : (step < 0) ? -1 : enc_latched_dir;
#else
      int8_t dir = dir_from_prev_curr(prevg, currg);
      if (dir == 0) dir = enc_latched_dir;
#endif
      last_cnt_isr = c2; last_ab_isr = currg;
      enc_latched_dir = dir;
      push_event_isr(dir, 0, c2, src, currg);
      ab_edges_since_z_isr++; z_diag_ab_since_isr = ab_edges_since_z_isr;
    }
#endif // ENC_IRQ_ONLY_A_RISING

#ifdef TIM_SR_TERRF
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_TERRF);
#endif
#ifdef TIM_SR_IERRF
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IERRF);
#endif
  }
  __DSB();
}
#endif /* ENC_IS_LIVE */

/* ============================ Public API =============================== */

void EncSampler_Init(void) {
  memset(&enc_state, 0, sizeof(enc_state));
  enc_state.last_update_ms    = HAL_GetTick();
  enc_state.baseline_interval = 10.0f;

  enc_state.last_AB_state = (enc_read_AB() & 0x3u);

#if ENC_IS_LIVE
  last_cnt_isr  = (uint16_t)TIM1->CNT;
  enc_cnt_wrap  = (uint32_t)__HAL_TIM_GET_AUTORELOAD(&htim1) + 1u;
  last_ab_isr   = enc_state.last_AB_state;

  EncSampler_ApplyTIM1ICFilter();
  EncSampler_ConfigIRQs();
  __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_TIF | TIM_SR_COMIF);
#endif

  printf("ENC: EDGE=%s EDGES/REV=%lu (CPR=%lu)%s\r\n",
#if ENC_IRQ_ONLY_A_RISING
         "A↑-ONLY",
#else
         "BOTHEDGE",
#endif
         (unsigned long)QUAD_EDGES_PER_REV, (unsigned long)CPR,
#if ENC_IRQ_ONLY_A_RISING
         " [IRQ: A-rising only]"
#else
         ""
#endif
  );
}

#if ENC_IS_LIVE
void EncSampler_Process(void) {
  static uint8_t  win_fill = 0;
  static uint32_t last_ms  = 0;

  static uint8_t  z_latch = 0;
  static uint32_t steps_since_z = 0;
  static uint32_t last_z_ms = 0;

  static uint32_t gray_skip2 = 0;
  static uint8_t  last_src = 0;

  static uint32_t rule_flags_live = 0;
  static int32_t  dir_sum = 0;

  while (event_read != event_write) {
    encoder_event_t evt = event_buffer[event_read];
    event_read = (event_read + 1u) & EVENT_IDX_MASK;

    if (evt.z_pulse) z_latch = 1u;
    const uint8_t is_ab_edge = (evt.src == 1u) || (evt.src == 2u);
    if (!is_ab_edge) continue;

    const uint8_t current_GRAY = (evt.ab_state & 0x3u);
    const uint8_t dir_fwd = (evt.delta > 0);
    const uint8_t dir_bwd = (evt.delta < 0);

    if (evt.delta > 0)      dir_sum += 1;
    else if (evt.delta < 0) dir_sum -= 1;

    const uint8_t chanZ = z_latch; z_latch = 0u;

    const uint8_t src_A = (evt.src == 1u);
    const uint8_t src_B = (evt.src == 2u);
    const uint8_t is_same_src = (last_src != 0 && evt.src == last_src) ? 1u : 0u;

    const uint32_t now_ms = evt.timestamp_ms;
    int32_t dms = (int32_t)(now_ms - last_ms);
    if (dms <= 0) dms = 1;
    const float dt_ms = (float)dms;

    if (enc_state.baseline_interval < 1.0f) enc_state.baseline_interval = dt_ms;
    const float ratio = dt_ms / enc_state.baseline_interval;
    enc_state.speed_change_rate = fabsf(ratio - 1.0f);
    enc_state.baseline_interval = 0.9f * enc_state.baseline_interval + 0.1f * dt_ms;
    last_ms  = now_ms;

    // Z health rules
    uint8_t packZ = 0u;
    if (chanZ) {
      if (steps_since_z < Z_MIN_GAP_EDGES) { rule_flags_live |= WR_ZDOUBLE; }
      packZ = 1u;
      last_z_ms = now_ms;
      steps_since_z = 0;
    } else {
      steps_since_z++;
    }

    if (steps_since_z > Z_MISS_EDGE_LIMIT) { rule_flags_live |= WR_ZMISS; }
#if (Z_MISS_MS_LIMIT > 0)
    if (last_z_ms != 0u && (uint32_t)(now_ms - last_z_ms) > (uint32_t)Z_MISS_MS_LIMIT) {
      rule_flags_live |= WR_ZMISS;
    }
#endif

    z_diag_steps_since_main = steps_since_z;
    z_diag_last_z_ms        = last_z_ms;

    // Adjacent (single-bit) sanity check
    const uint8_t prev_gray = enc_state.last_AB_state;
    const uint8_t diff = (prev_gray ^ current_GRAY) & 3u;
    const uint8_t adjacent = (uint8_t)((diff == 1u) || (diff == 2u));
    if (!adjacent) { gray_skip2++; }

    float *f = feat_win[win_fill];
    f[0] = (float)current_GRAY;        // AB_State
    f[1] = (float)src_A;               // SRC_A
    f[2] = (float)src_B;               // SRC_B
    f[3] = (float)dir_fwd;             // dir_fwd
    f[4] = (float)dir_bwd;             // dir_bwd
    f[5] = enc_state.speed_change_rate;// SCR
    f[6] = (float)packZ;               // Z
    f[7] = (float)steps_since_z;       // SSZ
    f[8] = (float)is_same_src;         // same_src
    f[9] = (float)adjacent;            // adjacent

#if ENABLE_TRACE_WIN
    trace_ab[win_fill]  = (current_GRAY & 3u);
    trace_src[win_fill] = evt.src;
    trace_z[win_fill]   = packZ ? 1u : 0u;
#endif

    last_src = evt.src;

    win_fill++;
    enc_state.last_AB_state = current_GRAY;
    enc_state.last_update_ms = now_ms;

    if (win_fill >= SEQ_LEN) {
      memcpy(win_fifo[wf_w], &feat_win[0][0], sizeof(win_fifo[0]));
      const uint32_t flags = ((gray_skip2 >= 1u) ? WR_SKIP2 : 0u) | rule_flags_live;

      flags_fifo[wf_w] = flags;
      enc_rule_flags   = flags;

#if ENABLE_TRACE_WIN
      memcpy(last_trace_ab,  trace_ab,  SEQ_LEN);
      memcpy(last_trace_src, trace_src, SEQ_LEN);
      memcpy(last_trace_z,   trace_z,   SEQ_LEN);
#endif

      if (dir_sum > 0)      last_window_dir = +1;
      else if (dir_sum < 0) last_window_dir = -1;
      else                  last_window_dir = enc_latched_dir;

      dir_sum = 0;

      wf_w = (wf_w + 1u) & (WINFIFO - 1u);
      if (wf_count < WINFIFO) wf_count++; else wf_r = (wf_r + 1u) & (WINFIFO - 1u);

      win_ready = wf_count;
      win_total++;

      win_fill = 0;
      gray_skip2 = 0;
      rule_flags_live = 0;
      last_src = 0;
    }
  }
}
#endif /* ENC_IS_LIVE */

/* =============================== Copy ================================== */

int EncSampler_CopyWindowLinear(float *dst, uint32_t *out_flags) {
  float    scratch[SEQ_LEN * FEAT_DIM];
  uint32_t flags;

  __disable_irq();
  if (wf_count == 0) { __enable_irq(); return -1; }
  const uint8_t r = wf_r;

  memcpy(scratch, win_fifo[r], sizeof(win_fifo[0]));
  flags = flags_fifo[r];

  wf_r = (wf_r + 1u) & (WINFIFO - 1u);
  wf_count--;
  win_ready = wf_count;
  __enable_irq();

  memcpy(dst, scratch, sizeof(win_fifo[0]));
  win_rule_flags = flags;
  if (out_flags) *out_flags = flags;
  return 0;
}

/* =============================== Stop / Flush =========================== */

void EncSampler_StopHardware(void) {
  __disable_irq();

  if (htim1.Instance) {
    __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2 | TIM_IT_UPDATE | TIM_IT_TRIGGER | TIM_IT_COM);
#ifdef TIM_IT_IDX
    __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_IDX);
#endif
    __HAL_TIM_DISABLE(&htim1);

    __HAL_TIM_CLEAR_FLAG(&htim1,
      TIM_SR_CC1IF | TIM_SR_CC1OF |
      TIM_SR_CC2IF | TIM_SR_CC2OF |
      TIM_SR_UIF   | TIM_SR_TIF   | TIM_SR_COMIF);
#ifdef TIM_SR_IDXF
    __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
#endif
  }

#ifdef TIM1_CC_IRQn
  NVIC_DisableIRQ(TIM1_CC_IRQn);
#endif
#if defined(TIM1_TRG_CCU_IRQn)
  NVIC_DisableIRQ(TIM1_TRG_CCU_IRQn);
#elif defined(TIM1_TRG_COM_IRQn)
  NVIC_DisableIRQ(TIM1_TRG_COM_IRQn);
#endif

  __enable_irq();
}

void EncSampler_FlushWindows(void) {
  __disable_irq();

  wf_w = 0; wf_r = 0; wf_count = 0;
  win_ready = 0; win_total = 0;

  event_read = 0; event_write = 0; event_drops = 0;

  z_last_ms_isr = 0;
  ab_edges_since_z_isr = 0;
  z_diag_isr_seen = 0;
  z_diag_isr_accepted = 0;
  z_diag_ab_since_isr = 0;
  z_diag_steps_since_main = 0;
  z_diag_last_z_ms = 0;

  __enable_irq();
}

