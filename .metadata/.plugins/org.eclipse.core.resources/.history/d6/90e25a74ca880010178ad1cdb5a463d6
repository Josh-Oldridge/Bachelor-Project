/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* Enable the CPU Cache */

  /* Enable I-Cache---------------------------------------------------------*/
  SCB_EnableICache();

  /* Enable D-Cache---------------------------------------------------------*/
  SCB_EnableDCache();

  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_LPUART1_UART_Init();
  MX_CACHEAXI_Init();
  MX_TIM1_Init();
  MX_RAMCFG_Init();
  MX_X_CUBE_AI_Init();
  SystemIsolation_Config();
  /* USER CODE BEGIN 2 */
	EncSampler_Init();

#if (FEED_MODE == FEED_LIVE)
	HAL_TIM_Encoder_Start(&htim1, TIM_CHANNEL_ALL);
	HAL_TIMEx_EnableEncoderIndex(&htim1);
	__HAL_TIM_ENABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2 | TIM_IT_IDX);
	htim1.Instance->CCER |= TIM_CCER_CC1E | TIM_CCER_CC2E; // Force enable captures on CH1/CH2

	printf("ENC MODE: LIVE (TIM1 enabled)\r\n");
#else
  /* Make sure HW is fully quiet and FIFOs are empty in synthetic modes */
  EncSampler_StopHardware();
  EncSampler_FlushWindows();
  printf("ENC MODE: SYNTHETIC (mode=%d)\r\n", (int)FEED_MODE);
#endif

	printf("Init done\r\n");
	uint32_t next_blink_ms = HAL_GetTick() + 250;

	printf("SEQ_LEN=%d FEAT_DIM=%d\r\n", (int) MODEL_SEQ_LEN,
			(int) MODEL_FEAT_DIM);
	rate_t0_ms = HAL_GetTick() + 1000;
  /* USER CODE END 2 */

  /* Initialize leds */
  BSP_LED_Init(LED_BLUE);
  BSP_LED_Init(LED_RED);
  BSP_LED_Init(LED_GREEN);

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
	while (1) {
    /* USER CODE END WHILE */

  MX_X_CUBE_AI_Process();
    /* USER CODE BEGIN 3 */

		if (next_blink_ms == 0)
			next_blink_ms = HAL_GetTick() + 250;
		if ((int32_t) (HAL_GetTick() - next_blink_ms) >= 0) {
			BSP_LED_Toggle(LED_RED);
			next_blink_ms += 250;
		}

		if (inf_total != last_inf_seen) {
			last_inf_seen = inf_total;

			if ((inf_total - last_inf_print) >= INF_PRINT_EVERY) {
				last_inf_print = inf_total;

				int best_raw = 0;
				for (int i = 1; i < MODEL_NUM_CLASSES; ++i)
					if (last_y_raw[i] > last_y_raw[best_raw])
						best_raw = i;

				printf("RAW=%s [%.3f, %.3f, %.3f]  flags(inf)=0x%08lX flags(win)=0x%08lX flags(live)=0x%08lX\r\n",
				       MODEL_CLASSES[best_raw],
				       (double)last_y_raw[0], (double)last_y_raw[1], (double)last_y_raw[2],
				       (unsigned long)last_inf_flags,        // <<< the synthetic window flags (WR_*)
				       (unsigned long)win_rule_flags,        // live FIFO window flags (always 0 in synth)
				       (unsigned long)enc_rule_flags);       // rolling live flags (always 0 in synth)


			}
		}

		if ((int32_t) (HAL_GetTick() - rate_t0_ms) >= 0) {
			uint32_t t7_now = tim7_ticks;
			uint32_t win_now = win_total;
			uint32_t inf_now = inf_total;



			printf(
					"RATES: TIM7=%lu Hz  windows=%lu/s  inferences=%lu/s  fifo_ready=%lu\r\n",
					(unsigned long) (t7_now - t7_prev),
					(unsigned long) (win_now - win_prev),
					(unsigned long) (inf_now - inf_prev),
					(unsigned long) win_ready);

#if (FEED_MODE == FEED_LIVE)
			uint32_t z_pin_state = HAL_GPIO_ReadPin(GPIOE, GPIO_PIN_7);
			printf("DROPS=%lu(+%lu) Z_PIN=%lu\r\n", (unsigned long) event_drops,
					(unsigned long) (event_drops - drops_prev),
					(unsigned long) z_pin_state);

			printf("OVERRUNS: CC1=%lu(+%lu)  CC2=%lu(+%lu)\r\n",
					(unsigned long) cc1_overruns,
					(unsigned long) (cc1_overruns - cc1_prev),
					(unsigned long) cc2_overruns,
					(unsigned long) (cc2_overruns - cc2_prev));

			drops_prev = event_drops;
			cc1_prev = cc1_overruns;
			cc2_prev = cc2_overruns;
#endif
			t7_prev = t7_now;
			win_prev = win_now;
			inf_prev = inf_now;
			rate_t0_ms += 1000;
		}

#if (FEED_MODE == FEED_LIVE)
		if (win_ready == 0)
			__WFI();
#else
  /* In synthetic modes, don’t sleep waiting for encoder windows. */
  HAL_Delay(1);
#endif
	}
  /* USER CODE END 3 */
}

