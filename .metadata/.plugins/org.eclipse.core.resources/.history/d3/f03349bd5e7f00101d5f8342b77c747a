/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* Enable the CPU Cache */

  /* Enable I-Cache---------------------------------------------------------*/
  SCB_EnableICache();

  /* Enable D-Cache---------------------------------------------------------*/
  SCB_EnableDCache();

  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_LPUART1_UART_Init();
  MX_CACHEAXI_Init();
  MX_TIM1_Init();
  MX_TIM7_Init();
  MX_RAMCFG_Init();
  MX_X_CUBE_AI_Init();
  SystemIsolation_Config();
  /* USER CODE BEGIN 2 */
	EncSampler_Init();

	HAL_TIM_Encoder_Start(&htim1, TIM_CHANNEL_ALL);
	HAL_TIMEx_EnableEncoderIndex(&htim1);
	HAL_TIM_Base_Start_IT(&htim7);

	printf("Init done\r\n");
	uint32_t next_blink_ms = HAL_GetTick() + 250;
  /* USER CODE END 2 */

  /* Initialize leds */
  BSP_LED_Init(LED_BLUE);
  BSP_LED_Init(LED_RED);
  BSP_LED_Init(LED_GREEN);

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
	while (1) {
    /* USER CODE END WHILE */

  MX_X_CUBE_AI_Process();
    /* USER CODE BEGIN 3 */

  if (next_blink_ms == 0) next_blink_ms = HAL_GetTick() + 250;
    if ((int32_t)(HAL_GetTick() - next_blink_ms) >= 0) {
      BSP_LED_Toggle(LED_RED);
      next_blink_ms += 250;
    }

    if (inf_total != last_inf_seen) {
        last_inf_seen = inf_total;
        int best_raw = 0, best_final = 0;
        for (int i = 1; i < MODEL_NUM_CLASSES; ++i) {
          if (last_y_raw[i] > last_y_raw[best_raw])   best_raw   = i;
          if (last_y[i]     > last_y[best_final])     best_final = i;
        }
        printf("RAW=%s [%.3f, %.3f, %.3f, %.3f]  "
               "FINAL=%s [%.3f, %.3f, %.3f, %.3f]  "
               "flags(win)=0x%08lX flags(live)=0x%08lX\r\n",
               MODEL_CLASSES[best_raw],
               (double)last_y_raw[0], (double)last_y_raw[1], (double)last_y_raw[2], (double)last_y_raw[3],
               MODEL_CLASSES[best_final],
               (double)last_y[0], (double)last_y[1], (double)last_y[2], (double)last_y[3],
               (unsigned long)win_rule_flags, (unsigned long)enc_rule_flags);
      }

      __WFI();  /* sleep until next IRQ */
  }
  /* USER CODE END 3 */
}

