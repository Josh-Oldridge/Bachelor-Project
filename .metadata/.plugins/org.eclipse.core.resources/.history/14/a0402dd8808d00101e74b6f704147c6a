typedef struct {
  uint8_t  last_AB_state;      /* GRAY digit (bit1=A, bit0=B): 0,1,3,2 */
  float    speed_change_rate;  /* |interval_ratio - 1| */
  uint32_t last_update_ms;     /* ms at last packed feature */
  float    baseline_interval;  /* EWMA baseline step interval (ms) */
} encoder_state_t;

static encoder_state_t enc_state = { 0 };

/* Sticky last direction: +1 = forward, -1 = backward */
static volatile int8_t  enc_latched_dir = +1;
int8_t EncSampler_GetLatchedDir(void) { return enc_latched_dir; }

/* Summarized window direction */
static volatile int8_t last_window_dir = +1;
int8_t EncSampler_GetLastWindowDir(void) { return last_window_dir; }

/* CNT wrap (ARR+1) and last CNT seen (for ordering) */
static volatile uint16_t enc_cnt_wrap = 0;
static volatile uint16_t last_cnt_isr = 0;

/* Last accepted Z CNT (ISR) and a main-thread mirror */
static volatile uint16_t last_z_cnt_isr = 0;
static volatile uint16_t last_z_cnt_pub = 0;

/* Startup warmup timing + Z block */
static volatile uint32_t enc_warmup_min_until_ms = 0;
static volatile uint32_t enc_warmup_max_until_ms = 0;
static volatile uint8_t  enc_block_z = 1;   /* 1 = ignore Z in ISR during warmup */

/* ===================== Synth Gray (for printing only) =================== */
/* Gray ring order with (bit1=A, bit0=B): 0,1,3,2 */
static inline uint8_t gray_to_ring_idx(uint8_t g) {
  switch (g & 3u) { case 0: return 0; case 1: return 1; case 3: return 2; case 2: return 3; default: return 0; }
}
static const uint8_t GRAY_RING[4] = {0, 1, 3, 2};
static volatile uint8_t synth_ring_idx = 0;  /* phase on ring */
static volatile uint8_t synth_gray     = 0;  /* synthesized Gray we print */

/* ============================ Window FIFO ============================== */

#define WINFIFO_LOG2 5
#define WINFIFO      (1u << WINFIFO_LOG2)
static float    win_fifo[WINFIFO][SEQ_LEN * FEAT_DIM];
static uint32_t flags_fifo[WINFIFO];
static uint8_t  wf_w = 0, wf_r = 0, wf_count = 0;

/* ============================ Event ring =============================== */

typedef struct {
  int8_t   delta;           /* +1 / -1 per edge, 0 for Z-only */
  uint8_t  z_pulse;         /* 1 if Z accepted in ISR */
  uint8_t  src;             /* 1=CC1(A), 2=CC2(B), 3=IDX */
  uint8_t  ab_state;        /* Gray at event (bit1=A, bit0=B) */
  uint32_t timestamp_ms;    /* HAL_GetTick at capture */
  uint16_t ccr;             /* CNT snapshot at event */
} encoder_event_t;

#define EVENT_BUF_BITS     12
#define EVENT_BUFFER_SIZE  (1u << EVENT_BUF_BITS)
#define EVENT_IDX_MASK     (EVENT_BUFFER_SIZE - 1u)

static encoder_event_t event_buffer[EVENT_BUFFER_SIZE];
static volatile uint32_t event_write = 0;
static volatile uint32_t event_read  = 0;

/* ISR-side Z acceptance book-keeping */
static volatile uint32_t z_last_ms_isr        = 0;
/* canonical X4 AB edges since Z (DIR-aware) */
static volatile uint32_t ab_edges_since_z_isr = 0;

/* public diagnostics */
volatile uint32_t z_diag_isr_seen         = 0;
volatile uint32_t z_diag_isr_accepted     = 0;
volatile uint32_t z_diag_ab_since_isr     = 0;
/* DEPRECATED: kept as a mirror for compatibility; identical to z_diag_ab_since_isr */
volatile uint32_t z_diag_steps_since_main = 0;
volatile uint32_t z_diag_last_z_ms        = 0;
volatile uint32_t z_diag_last_z_age_ms    = 0;

/* ============================ Helpers ================================== */

static inline float scale_feat(int j, float x) {
  float y = (x - MODEL_FEAT_MIN[j]) * MODEL_FEAT_SCALE[j];
  if (y < 0.f) y = 0.f;
  if (y > 1.f) y = 1.f;
  return y;
}

/* Read present AB from pins (A on bit1, B on bit0) */
static inline uint8_t enc_read_AB(void) {
  const uint8_t a = (HAL_GPIO_ReadPin(ENC_A_GPIO_Port, ENC_A_Pin) != GPIO_PIN_RESET) ? 1u : 0u;
  const uint8_t b = (HAL_GPIO_ReadPin(ENC_B_GPIO_Port, ENC_B_Pin) != GPIO_PIN_RESET) ? 1u : 0u;
  return (uint8_t)((a << 1) | b);  /* Gray digit: 0,1,3,2 */
}

/* wrap-aware signed difference in (-wrap/2, +wrap/2] */
static inline int16_t mod_diff_u16(uint16_t now, uint16_t prev, uint16_t wrap) {
  int32_t d = (int32_t)now - (int32_t)prev;
  if (d >  (int32_t)wrap/2) d -= wrap;
  if (d < -(int32_t)wrap/2) d += wrap;
  return (int16_t)d;
}

/* Apply hardware digital filters on IC1/IC2 (kept at 0 per request) */
#ifndef TIM_CCMR1_IC1F_Pos
#define TIM_CCMR1_IC1F_Pos 4U
#endif
#ifndef TIM_CCMR1_IC2F_Pos
#define TIM_CCMR1_IC2F_Pos 12U
#endif
static inline void EncSampler_ApplyTIM1ICFilter(void) {
  uint32_t ccer = TIM1->CCER;
  TIM1->CCER &= ~(TIM_CCER_CC1E | TIM_CCER_CC2E);
  uint32_t ccmr1 = TIM1->CCMR1;
  ccmr1 &= ~(TIM_CCMR1_IC1F | TIM_CCMR1_IC2F);
  ccmr1 |= ((ENC_IC_FILTER & 0xF) << TIM_CCMR1_IC1F_Pos) |
           ((ENC_IC_FILTER & 0xF) << TIM_CCMR1_IC2F_Pos);
  TIM1->CCMR1 = ccmr1;
  TIM1->CCER = ccer;
}

/* Enable only the IRQs we consume */
static inline void EncSampler_ConfigIRQs(void) {
  __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_CC1 | TIM_IT_CC2);
#if HAVE_Z_INDEX && !FORCE_IGNORE_Z
  __HAL_TIM_ENABLE_IT(&htim1, TIM_IT_IDX);
#endif
  __HAL_TIM_DISABLE_IT(&htim1, TIM_IT_UPDATE | TIM_IT_TRIGGER | TIM_IT_COM);
  __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_UIF | TIM_SR_TIF | TIM_SR_COMIF);
}

/* Direction from hardware DIR bit at capture time */
static inline int8_t dir_from_hw(void) {
  int8_t dir = ((TIM1->CR1 & TIM_CR1_DIR) == 0) ? +1 : -1; /* DIR=0 => up */
#if ENC_DIR_REVERSED
  dir = (int8_t)-dir;
#endif
  return dir;
}

/* Compute (X4) edges since last Z, oriented by DIR (ISR side) */
static inline uint16_t since_z_from_cnt_isr(uint16_t cnt, int8_t dir) {
  const uint16_t base = last_z_cnt_isr;
  uint16_t diff;
  if (dir > 0) { /* UP */
    diff = (cnt >= base) ? (uint16_t)(cnt - base) : (uint16_t)(cnt + enc_cnt_wrap - base);
  } else {       /* DOWN */
    diff = (base >= cnt) ? (uint16_t)(base - cnt) : (uint16_t)(base + enc_cnt_wrap - cnt);
  }
  return diff;
}

/* ======================== IRQ Drain (encoder) ========================== */

#if ENC_IS_LIVE
static volatile uint8_t last_ab_isr = 0;

static inline void push_event_isr(int delta, int z, uint16_t ccr_sample,
                                  uint8_t src, uint8_t ab_state) {
  uint32_t next = (event_write + 1u) & EVENT_IDX_MASK;
  if (next == event_read) { event_drops++; return; }
  encoder_event_t *e = &event_buffer[event_write];
  e->timestamp_ms = HAL_GetTick();
  e->ccr          = ccr_sample;
  e->delta        = (int8_t)delta;
  e->z_pulse      = (uint8_t)z;
  e->src          = src;
  e->ab_state     = ab_state;
  event_write = next;
}

void EncSampler_EncoderIRQ_Drain(void) {
  for (int guard = 0; guard < 256; ++guard) {
    uint32_t sr = TIM1->SR;
    uint32_t pending = sr & (TIM_SR_CC1IF | TIM_SR_CC2IF | TIM_SR_CC1OF | TIM_SR_CC2OF);
#if HAVE_Z_INDEX && !FORCE_IGNORE_Z && defined(TIM_SR_IDXF)
    pending |= (sr & TIM_SR_IDXF);
#endif
    if (!pending) break;

    /* Overcapture flags: count them */
    if (sr & TIM_SR_CC1OF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC1OF); event_drops++; }
    if (sr & TIM_SR_CC2OF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_CC2OF); event_drops++; }

    /* ---- Z FIRST ---- */
#if HAVE_Z_INDEX && defined(TIM_SR_IDXF)
    if (sr & TIM_SR_IDXF) {
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_IDX);
# ifdef TIM_SR_IDXF
      __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IDXF);
# endif
      z_diag_isr_seen++;
# if !FORCE_IGNORE_Z
      const uint32_t now_ms = HAL_GetTick();
      const int32_t  dt_ms  = (int32_t)(now_ms - z_last_ms_isr);
      if (!enc_block_z && (dt_ms >= (int32_t)Z_SOFT_DEBOUNCE_MS) && (ab_edges_since_z_isr >= Z_MIN_AB_EDGES)) {
        const uint16_t ccrz = (uint16_t)TIM1->CNT;      /* CNT at Z */
        const uint8_t  abz  = enc_read_AB() & 0x3u;     /* AB at Z */
        push_event_isr(0, 1, ccrz, 3, abz);             /* src=3 => IDX */
        last_z_cnt_isr   = ccrz;                         /* reset base */
        last_z_cnt_pub   = ccrz;
        z_last_ms_isr    = now_ms;
        z_diag_last_z_ms = now_ms;                      /* publish immediately */
        ab_edges_since_z_isr = 0;
        z_diag_ab_since_isr  = 0;
        z_diag_steps_since_main = 0;                    /* deprecated mirror */
        z_diag_isr_accepted++;
      }
# endif
    }
#endif

    /* Refresh SR after possible Z clear */
    sr = TIM1->SR;

    /* ---- CC1 pending ---- */
    if (sr & TIM_SR_CC1IF) {
      const uint16_t c1 = (uint16_t)TIM1->CCR1;
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC1);
      const uint8_t ab  = enc_read_AB() & 0x3u;         /* real pins */
      const int8_t  dir = dir_from_hw();
      last_cnt_isr = c1; last_ab_isr = ab; enc_latched_dir = dir;
      push_event_isr(dir, 0, c1, 1, ab);
      /* canonical X4 AB edges since Z (for both ISR + main prints) */
      ab_edges_since_z_isr = since_z_from_cnt_isr(c1, dir);
      z_diag_ab_since_isr  = ab_edges_since_z_isr;
      z_diag_steps_since_main = z_diag_ab_since_isr;    /* deprecated mirror */
      continue; /* let loop re-check if CC2 also pending */
    }

    /* ---- CC2 pending ---- */
    if (sr & TIM_SR_CC2IF) {
      const uint16_t c2 = (uint16_t)TIM1->CCR2;
      __HAL_TIM_CLEAR_IT(&htim1, TIM_IT_CC2);
      const uint8_t ab  = enc_read_AB() & 0x3u;         /* real pins */
      const int8_t  dir = dir_from_hw();
      last_cnt_isr = c2; last_ab_isr = ab; enc_latched_dir = dir;
      push_event_isr(dir, 0, c2, 2, ab);
      ab_edges_since_z_isr = since_z_from_cnt_isr(c2, dir);
      z_diag_ab_since_isr  = ab_edges_since_z_isr;
      z_diag_steps_since_main = z_diag_ab_since_isr;    /* deprecated mirror */
      continue;
    }

#ifdef TIM_SR_TERRF
    if (sr & TIM_SR_TERRF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_TERRF); }
#endif
#ifdef TIM_SR_IERRF
    if (sr & TIM_SR_IERRF) { __HAL_TIM_CLEAR_FLAG(&htim1, TIM_SR_IERRF); }
#endif
  }
  __DSB();
}
#endif /* ENC_IS_LIVE */

/* ============================ Public API =============================== */

void EncSampler_Init(void) {
  memset(&enc_state, 0, sizeof(enc_state));
  enc_state.last_update_ms    = HAL_GetTick();
  enc_state.baseline_interval = 10.0f;

  /* tiny settle before enabling IRQs */
#if (ENC_STARTUP_DELAY_MS > 0)
  HAL_Delay(ENC_STARTUP_DELAY_MS);
#endif
  const uint32_t now = HAL_GetTick();
  enc_warmup_min_until_ms = now + ENC_STARTUP_MIN_MS;
  enc_warmup_max_until_ms = now + ENC_STARTUP_MAX_MS;
  enc_block_z = 1;                               /* block Z until warmup exit */

  /* Seed GRAY from real pins so first row matches physical phase */
  enc_state.last_AB_state = (enc_read_AB() & 0x3u);

  /* Seed synthesized Gray (for prints) from real pins */
  {
    uint8_t seed = enc_state.last_AB_state & 3u;
    synth_ring_idx = gray_to_ring_idx(seed);
    synth_gray     = seed;
  }

#if ENC_IS_LIVE
  enc_cnt_wrap   = (uint32_t)__HAL_TIM_GET_AUTORELOAD(&htim1) + 1u;
  last_cnt_isr   = (uint16_t)TIM1->CNT;
  last_ab_isr    = enc_state.last_AB_state;
  last_z_cnt
