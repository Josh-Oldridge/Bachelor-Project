#include "diag_timing.h"
#include <string.h>
#include <stdio.h>

#ifndef CPR
#define CPR 500u
#endif
#ifndef DIAG_EDGES_PER_REV
#define DIAG_EDGES_PER_REV (4u * CPR)
#endif

/* ====== DWT Cycle Counter ====== */
/**
 * @brief Enable DWT CYCCNT on Cortex-M (non-secure if permitted).
 * @note  Requires TRCENA set in DEMCR; leaves CYCCNT running.
 */
static inline void dwt_enable(void) {
	/* Enable DWT CYCCNT on Cortex-M55 (non-secure ok if allowed by secure) */
	CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
	DWT->CYCCNT = 0;
	DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
}

/**
 * @brief Read current DWT cycle counter (wraps at 32 bits).
 * @return Current cycle count.
 */
static inline uint32_t cycles_now(void) {
	return DWT->CYCCNT;
}

/* ====== Timer book-keeping ====== */
/**
 * @brief Internal timer slot: start cycles, running flag, and aggregates.
 */
typedef struct {
	uint32_t t0;            /**< Last start cycles. */
	uint8_t  running;       /**< Guard to ignore double-stops. */
	diag_timer_stat_t stat; /**< Aggregated stats. */
} diag_timer_t;

static diag_timer_t g_timers[DIAG_T__COUNT];

/* health (aggregated since last snapshot) */
static uint32_t g_event_buf_cap = 0, g_event_buf_hwm = 0, g_event_drops = 0;
static uint32_t g_winfifo_cap = 0, g_winfifo_hwm = 0;
static uint32_t g_inferences = 0;
static uint32_t g_win_overwrites = 0;

/* trial state */
static diag_trial_t g_trial;

/* free-running Z-speed */
static td_speed_t g_sz;

/**
 * @brief Convert cycles to nanoseconds (local helper).
 */
static inline uint32_t cycles_to_ns(uint32_t cyc) {
	return (uint32_t) ((uint64_t) cyc * 1000000000ull
			/ (uint64_t) SystemCoreClock);
}

/**
 * @brief Smart cycles→string: ns (int) / us (3dp) / ms (2dp).
 * @param buf Output buffer.
 * @param n   Buffer length.
 * @param cyc Cycle count to format.
 */
static inline void fmt_cycles_smart(char *buf, size_t n, uint32_t cyc) {
    const uint64_t ns64 = ((uint64_t)cyc * 1000000000ull) / (uint64_t)SystemCoreClock;

    if (ns64 < 1000ull) {
        /* < 1 us: integer ns */
        const unsigned long ns = (unsigned long)ns64;
        snprintf(buf, n, "%lu ns", ns);
    } else if (ns64 < 1000000ull) {
        /* [1 us, 1 ms): microseconds with 3 decimals */
        const unsigned long us_int = (unsigned long)(ns64 / 1000ull);
        const unsigned long us_fr3 = (unsigned long)(ns64 % 1000ull); /* ns remainder */
        snprintf(buf, n, "%lu.%03lu us", us_int, us_fr3);
    } else {
        /* >= 1 ms: milliseconds with 2 decimals */
        const uint64_t ms_x100 = ns64 / 10000ull; /* hundredths of ms */
        const unsigned long ms_int = (unsigned long)(ms_x100 / 100ull);
        const unsigned long ms_fr2 = (unsigned long)(ms_x100 % 100ull);
        snprintf(buf, n, "%lu.%02lu ms", ms_int, ms_fr2);
    }
}

/**
 * @brief Average cycles (sum/count) with 0 guard.
 */
static inline uint32_t avg_cyc(uint64_t sum, uint32_t cnt) {
    return cnt ? (uint32_t)(sum / cnt) : 0u;
}


/* ====== API ====== */

void TD_Speed_Reset(void) {
  g_sz.last_z_ms = 0; g_sz.period_ms = 0;
  g_sz.rps_inst = g_sz.rps_ewma = 0.f;
  g_sz.rpm_inst = g_sz.rpm_ewma = 0.f;
}

void TD_Speed_OnZ(uint32_t now_ms) {
  uint32_t prev = g_sz.last_z_ms;
  g_sz.last_z_ms = now_ms;
  if (prev == 0) return;                // first Z: no period yet
  uint32_t dms = now_ms - prev;         // wrap-safe
  if (dms == 0) return;

  g_sz.period_ms = dms;
  float rps = 1000.0f / (float)dms;     // Z-to-Z mechanical RPS
  g_sz.rps_inst = rps;
  g_sz.rpm_inst = rps * 60.0f;

  const float a = 0.2f;                 // EWMA smoothing
  g_sz.rps_ewma = (g_sz.rps_ewma == 0.f) ? rps : (1.f - a)*g_sz.rps_ewma + a*rps;
  g_sz.rpm_ewma = g_sz.rps_ewma * 60.0f;
}

void TD_Speed_Get(float *rps_inst, float *rps_avg, float *rpm_inst, float *rpm_avg) {
  if (rps_inst) *rps_inst = g_sz.rps_inst;
  if (rps_avg)  *rps_avg  = g_sz.rps_ewma;
  if (rpm_inst) *rpm_inst = g_sz.rpm_inst;
  if (rpm_avg)  *rpm_avg  = g_sz.rpm_ewma;
}

/**
 * @brief Initialize timing/health/trial modules; enable DWT CYCCNT.
 * @note  Call once after clocks are configured.
 */
void DiagTiming_Init(void) {
	SystemCoreClockUpdate();
	dwt_enable();
	DiagTiming_ResetTimers();
	Diag_TrialReset();
	TD_Speed_Reset();
}

/** @brief Clear all timer aggregates (min/max/sum/count). */
void DiagTiming_ResetTimers(void) {
	memset(g_timers, 0, sizeof(g_timers));
}

/**
 * @brief Accumulate one sample into timer stats.
 * @param s     Stat slot.
 * @param delta Sample in cycles.
 */
static inline void stat_accum(diag_timer_stat_t *s, uint32_t delta) {
	s->count++;
	s->sum_cycles += (uint64_t) delta;
	if (s->count == 1) {
		s->min_cycles = delta;
		s->max_cycles = delta;
	} else {
		if (delta < s->min_cycles)
			s->min_cycles = delta;
		if (delta > s->max_cycles)
			s->max_cycles = delta;
	}
}

/** @brief Start a timer (non-reentrant per ID). */
void DiagTiming_Start(diag_timer_id_t id) {
	if (id >= DIAG_T__COUNT)
		return;
	diag_timer_t *t = &g_timers[id];
	t->t0 = cycles_now();
	t->running = 1u;
}

/** @brief Stop a timer and accumulate its elapsed cycles. */
void DiagTiming_Stop(diag_timer_id_t id) {
	if (id >= DIAG_T__COUNT)
		return;
	diag_timer_t *t = &g_timers[id];
	if (!t->running)
		return;
	uint32_t t1 = cycles_now();
	uint32_t delta = t1 - t->t0; /* wrap-safe for 32b counter */
	stat_accum(&t->stat, delta);
	t->running = 0u;
}

/* ====== Health ====== */

void Diag_SetEventBufCaps(uint32_t capacity) {
	g_event_buf_cap = capacity;
}
void Diag_ObserveEventBufLevel(uint32_t level) {
	if (level > g_event_buf_hwm)
		g_event_buf_hwm = level;
}
void Diag_AddEventDrops(uint32_t drops) {
	/* If you pass absolute 'event_drops', convert to delta in caller; here we just accumulate */
	g_event_drops += drops;
}
void Diag_SetWinFifoCaps(uint32_t capacity) {
	g_winfifo_cap = capacity;
}
void Diag_ObserveWinFifoLevel(uint32_t level) {
	if (level > g_winfifo_hwm)
		g_winfifo_hwm = level;
}
void Diag_IncInferenceCount(void) {
	g_inferences++;
}

/* ====== Snapshot ====== */

/** @brief Add to window-overwrite counter (FIFO was full). */
void Diag_AddWinOverwrites(uint32_t n) { g_win_overwrites += n; }

/**
 * @brief Capture current stats into @p out and reset incremental counters.
 * @param[out] out Snapshot to fill; ignored if NULL.
 * @note  Timer running states are preserved; only aggregates are reset.
 */
void Diag_GetAndResetSnapshot(diag_snapshot_t *out) {
	if (!out)
		return;
	memset(out, 0, sizeof(*out));
	for (int i = 0; i < DIAG_T__COUNT; ++i) {
		out->timers[i] = g_timers[i].stat;
		/* leave running states alone */
	}

	out->event_buf_cap = g_event_buf_cap;
	out->event_buf_hwm = g_event_buf_hwm;
	out->event_drops = g_event_drops;

	out->winfifo_cap = g_winfifo_cap;
	out->winfifo_hwm = g_winfifo_hwm;

	out->inferences = g_inferences;

	out->win_overwrites = g_win_overwrites;

	/* reset incremental health counters for next period */
	for (int i = 0; i < DIAG_T__COUNT; ++i) {
		g_timers[i].stat.count = 0;
		g_timers[i].stat.sum_cycles = 0;
		g_timers[i].stat.min_cycles = 0;
		g_timers[i].stat.max_cycles = 0;
	}
	g_event_buf_hwm = 0;
	g_event_drops = 0;
	g_winfifo_hwm = 0;
